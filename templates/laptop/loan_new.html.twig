{% extends 'layout/app.html.twig' %}

{% block title %}{{ 'lendLaptopPageHeading'|trans }}{% endblock %}

{% block page_breadcrumb %}
    {% include '_breadcrumb.html.twig' with {segments: [
        {label: 'homeNavLabel'|trans, url: path('app_home')},
        {label: 'ufaNavLabel'|trans, url: path('app_ufa')},
        {label: 'laptopsNavLabel'|trans, url: path('app_laptops_loans')},
        {label: 'laptopsLoanHistoryTabLabel'|trans, url: path('app_laptops_loans')},
        {label: 'lendLaptopPageHeading'|trans, url: app.request.requestUri},
    ]} %}
{% endblock %}
{% block page_title %}{{ 'lendLaptopPageHeading'|trans }}{% endblock %}

{% block main %}
    {# Follows design/design_handoff_ufa/screenshots/25e-pret-formulaire.png: two columns for the
       loan's identity, two columns for the dates, then the equipment condition with its notes on the
       right, and the actions in a separate card footer. #}
    {# The loan type follows from the student's modality; the operator keeps the last word on it. #}
    <div class="card" data-controller="laptop-loan-type"
         data-laptop-loan-type-url-value="{{ path('app_laptops_loans_suggested_type') }}">
        {{ form_start(form) }}
            <div class="card-body">
                {{ form_errors(form) }}
                <h3 class="card-title">{{ 'laptopLoanSectionHeading'|trans }}</h3>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        {# Asterisk: these two fields are mandatory, even though they do not carry the
                           required attribute (their original <select> is hidden by tom-select, which
                           a native control could not bring forward). It is the server that imposes
                           them - Assert\NotNull on the lender, a form error on the laptop - and the
                           rule is the same everywhere: required field, asterisk. #}
                        <label class="form-label required" for="borrower">{{ 'laptopStudentColumnLabel'|trans }}</label>
                        <select id="borrower" name="borrower" class="form-select"
                                data-controller="tom-select"
                                data-action="change->laptop-loan-type#suggest"
                                data-tom-select-url-value="{{ path('app_laptops_loans_student_search') }}"
                                data-tom-select-placeholder-value="{{ 'laptopLoanBorrowerSearchPlaceholder'|trans }}"></select>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label required" for="laptop">{{ 'laptopAvailableFieldLabel'|trans }}</label>
                        <select id="laptop" name="laptop" class="form-select"
                                data-controller="tom-select"
                                data-tom-select-url-value="{{ path('app_laptops_loans_available_search') }}"
                                data-tom-select-placeholder-value="{{ 'laptopLoanAvailableSearchPlaceholder'|trans }}"></select>
                    </div>
                    <div class="col-md-6">{{ form_row(form.loanType, {attr: {'data-laptop-loan-type-target': 'type'}}) }}</div>
                    <div class="col-md-6"></div>
                    <div class="col-md-6">{{ form_row(form.lentAt) }}</div>
                    <div class="col-md-6">{{ form_row(form.dueAt) }}</div>
                </div>
                <hr class="my-4">
                <h3 class="card-title">{{ 'laptopLoanConditionSectionHeading'|trans }}</h3>
                <div class="row">
                    <div class="col-md-3">{{ form_row(form.lentConditionType) }}</div>
                    <div class="col-md-9">{{ form_row(form.lentStateNotes) }}</div>
                </div>
                <hr class="my-4">
                <h3 class="card-title">{{ 'laptopLoanAccessoriesSectionHeading'|trans }}</h3>
                <div class="row">
                    <div class="col-md-3">{{ form_row(form.lentAccessoryConditionType) }}</div>
                    <div class="col-md-9">{{ form_row(form.lentAccessories) }}</div>
                </div>
            </div>
            <div class="card-footer d-flex justify-content-end gap-2">
                <a href="{{ path('app_laptops_loans') }}" class="btn btn-outline-secondary">{{ 'cancelAction'|trans }}</a>
                {{ form_widget(form.submit) }}
            </div>
            {{ form_rest(form) }}
        {{ form_end(form) }}
    </div>
{% endblock %}
