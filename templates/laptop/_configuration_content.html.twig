<div class="form-check form-switch mb-2 mt-2">
    <input class="form-check-input" type="checkbox" id="laptop-configuration-include-inactive" onchange="window.location.href = this.checked ? '{{ path('app_laptops_configuration', {includeInactive: 1}) }}' : '{{ path('app_laptops_configuration') }}'" {{ includeInactive ? 'checked' }}>
    <label class="form-check-label" for="laptop-configuration-include-inactive">{{ 'showInactiveFilterLabel'|trans }}</label>
</div>
<div class="table-responsive">
    <table class="table table-vcenter card-table table-striped">
        <thead>
            <tr>
                {# Largeurs de la maquette 25c : la poignée ne prend que sa place, le nom occupe le
                   reste, couleur et actions sont calées à droite. Sans elles le navigateur répartit
                   les quatre colonnes à parts presque égales et la poignée flotte au milieu. #}
                <th style="width: 26px"></th>
                <th>{{ 'structureNameColumnLabel'|trans }}</th>
                <th style="width: 160px">{{ 'structureColorColumnLabel'|trans }}</th>
                <th class="cm-actions" style="width: 140px"></th>
            </tr>
        </thead>
        <tbody data-controller="sortable-reorder" data-sortable-reorder-url-value="{{ path('app_laptops_configuration_reorder') }}" data-sortable-reorder-token-value="{{ csrf_token('laptop_configuration_reorder') }}">
            {% for conditionType in conditionTypes %}
                {% set isInactive = conditionType.inactiveDate is not null %}
                <tr data-sortable-reorder-id-param="{{ conditionType.id }}">
                    <td>
                        <span class="sortable-reorder-handle cm-grip">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" stroke="none" aria-hidden="true">
                                <circle cx="9" cy="6" r="1.1"/><circle cx="15" cy="6" r="1.1"/>
                                <circle cx="9" cy="12" r="1.1"/><circle cx="15" cy="12" r="1.1"/>
                                <circle cx="9" cy="18" r="1.1"/><circle cx="15" cy="18" r="1.1"/>
                            </svg>
                        </span>
                    </td>
                    {# Pastille devant le nom, nom en gras, code couleur seul dans sa colonne :
                       disposition de design/design_handoff_ufa/screenshots/25c-etats-configuration.png. #}
                    <td>
                        <span class="cm-select-dot cm-select-dot--lg" style="background: {{ conditionType.color }}"></span>
                        <strong>{{ conditionType.name }}</strong>
                        {% if isInactive %}<span class="cm-badge cm-badge--gray ms-2">{{ 'deactivatedStatusLabel'|trans }}</span>{% endif %}
                    </td>
                    <td class="cm-hex">{{ conditionType.color }}</td>
                    <td class="cm-actions">
                        <a href="{{ path('app_laptops_configuration_edit', {id: conditionType.id}) }}" class="cm-action--warning">{{ 'editActionLabel'|trans }}</a>
                        {% if isInactive %}
                            <form method="post" action="{{ path('app_laptops_configuration_reactivate', {id: conditionType.id}) }}" class="d-inline">
                                <input type="hidden" name="_token" value="{{ csrf_token('laptop_configuration_deactivate') }}">
                                {# Réactiver est l'action principale d'une ligne désactivée : bleu, comme Modifier (25c). #}
                                <button type="submit" class="cm-action--warning" style="background: none; border: 0;">{{ 'reactivateActionLabel'|trans }}</button>
                            </form>
                        {% else %}
                            <form method="post" action="{{ path('app_laptops_configuration_deactivate', {id: conditionType.id}) }}" class="d-inline">
                                <input type="hidden" name="_token" value="{{ csrf_token('laptop_configuration_deactivate') }}">
                                <button type="submit" class="cm-action--danger" style="background: none; border: 0;">{{ 'deactivateActionLabel'|trans }}</button>
                            </form>
                        {% endif %}
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="4" class="text-center text-secondary">{{ 'datatableZeroRecordsLabel'|trans }}</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
</div>
<div class="text-secondary small mt-2">{{ 'laptopConditionTypeFooterHelpText'|trans({'%count%': conditionTypes|length}) }}</div>
