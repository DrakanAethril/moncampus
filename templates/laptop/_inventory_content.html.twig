<div data-frankenphp-hot-reload-preserve
     data-controller="datatable"
     data-datatable-url-value="{{ path('app_laptops_data') }}"
     data-datatable-edit-url-template-value="{{ path('app_laptops_edit', {id: '__ID__'}) }}"
     data-datatable-page-length-value="10"
     data-datatable-columns-value="{{ [
         {data: 'assetTag'},
         {data: 'deviceLabel'},
         {data: 'conditionName', render: 'colorBadge', colorField: 'conditionColor'},
         {data: 'availability'},
         {data: null, render: 'actions'},
     ]|json_encode }}"
     data-datatable-edit-label-value="{{ 'editActionLabel'|trans }}"
     data-datatable-language-value="{{ {
         info: 'datatableInfoLabel'|trans,
         infoEmpty: 'datatableInfoEmptyLabel'|trans,
         infoFiltered: 'datatableInfoFilteredLabel'|trans,
         zeroRecords: 'datatableZeroRecordsLabel'|trans,
         processing: 'datatableProcessingLabel'|trans,
         lengthMenu: 'datatableLengthMenuLabel'|trans,
         search: 'datatableSearchLabel'|trans,
         paginate: {
             next: 'datatablePaginateNextLabel'|trans,
             previous: 'datatablePaginatePreviousLabel'|trans,
         },
     }|json_encode }}">
    <div class="form-check form-switch mb-2" data-datatable-target="includeInactiveWrapper">
        <input class="form-check-input" type="checkbox" id="laptops-include-inactive" data-datatable-target="includeInactive" data-action="change->datatable#reload">
        <label class="form-check-label" for="laptops-include-inactive">{{ 'showRetiredFleetFilterLabel'|trans }}</label>
    </div>
    <div class="table-responsive">
        <table class="table table-vcenter card-table table-striped" data-datatable-target="table">
            <thead>
                <tr>
                    <th>{{ 'laptopAssetTagColumnLabel'|trans }}</th>
                    <th>{{ 'laptopBrandModelColumnLabel'|trans }}</th>
                    <th>{{ 'laptopConditionColumnLabel'|trans }}</th>
                    <th>{{ 'laptopAvailabilityColumnLabel'|trans }}</th>
                    <th class="cm-actions"></th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>
</div>

{% if panelForm is defined and panelForm %}
    <a href="{{ path('app_laptops') }}" class="cm-panel-backdrop" aria-label="{{ 'cancelAction'|trans }}"></a>
    <div class="cm-panel" role="dialog" aria-modal="true">
        <div class="cm-panel__header">
            <div class="cm-panel__title">{{ (panelIsEdit ? 'editLaptopPageHeading' : 'newLaptopPageHeading')|trans }}</div>
            <a href="{{ path('app_laptops') }}" class="cm-panel__close" aria-label="{{ 'cancelAction'|trans }}">&times;</a>
        </div>
        {{ form_start(panelForm) }}
            <div class="cm-panel__body">
                {{ form_errors(panelForm) }}
                {{ form_row(panelForm.assetTag) }}
                {{ form_row(panelForm.brand) }}
                {{ form_row(panelForm.model) }}
                {{ form_row(panelForm.currentConditionType) }}
                {{ form_row(panelForm.notes) }}
                {% if panelIsEdit %}
                    <a href="{{ path('app_laptops_history', {id: panelLaptop.id}) }}" class="d-block mt-2">{{ 'laptopHistoryButtonLabel'|trans }}</a>
                {% endif %}
            </div>
            <div class="cm-panel__footer">
                {% if panelIsEdit and panelLaptop.inactiveDate is null %}
                    <form method="post" action="{{ path('app_laptops_deactivate', {id: panelLaptop.id}) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('laptop_deactivate') }}">
                        <button type="submit" class="btn btn-link text-danger p-0">{{ 'deactivateActionLabel'|trans }}</button>
                    </form>
                {% else %}
                    <span></span>
                {% endif %}
                <div class="cm-panel__footer-buttons">
                    <a href="{{ path('app_laptops') }}" class="btn btn-link">{{ 'cancelAction'|trans }}</a>
                    {{ form_widget(panelForm.submit, {'label': panelIsEdit ? 'submitEditAction' : 'submitCreateAction'}) }}
                </div>
            </div>
            {{ form_rest(panelForm) }}
        {{ form_end(panelForm) }}
    </div>
{% endif %}
