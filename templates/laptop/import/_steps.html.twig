{# The three moves of the import, shown on all three screens so the operator always knows where
   they are and what is still ahead. `step` is 1, 2 or 3. Same partial shape as the class import's. #}
<div class="cm-steps">
    {% for index, label in {
        1: 'laptopImportStepFileLabel',
        2: 'laptopImportStepCheckLabel',
        3: 'laptopImportStepRunLabel',
    } %}
        {% if not loop.first %}<span class="cm-steps__arrow" aria-hidden="true">→</span>{% endif %}
        <span class="cm-steps__step{{ index == step ? ' cm-steps__step--on' }}{{ index < step ? ' cm-steps__step--done' }}">
            <b>{{ index < step ? '✓' : index }}</b> {{ label|trans }}
        </span>
    {% endfor %}
</div>
