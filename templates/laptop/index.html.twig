{% extends 'layout/app.html.twig' %}

{% set page_heading_key = {
    loans: 'laptopsLoansPageHeading',
    inventory: 'laptopsInventoryTabLabel',
    configuration: 'laptopsConfigurationTabLabel',
}[activeTab] %}

{% block title %}{{ page_heading_key|trans }}{% endblock %}

{% block page_breadcrumb %}
    {% include '_breadcrumb.html.twig' with {segments: [
        {label: 'homeNavLabel'|trans, url: path('app_home')},
        {label: 'ufaNavLabel'|trans, url: path('app_ufa')},
        {label: 'laptopsNavLabel'|trans, url: path('app_laptops_loans')},
        {label: page_heading_key|trans, url: app.request.requestUri},
    ]} %}
{% endblock %}
{% block page_title %}{{ page_heading_key|trans }}{% endblock %}
{# Pas d'onglets ici, contrairement aux autres écrans à onglets de l'application : le menu UFA >
   Matériel > Ordinateurs portables mène déjà directement à ces trois pages, les onglets n'auraient
   fait que doubler cette navigation. L'action principale remonte donc en tête de page, à la place
   qu'elle occupe sur les maquettes 25a/25c/25d. #}
{% block page_actions %}{% include 'laptop/_' ~ activeTab ~ '_button.html.twig' %}{% endblock %}

{% block main %}
    <div class="card">
        {# DataTables owns this subtree's DOM from here on - see templates/settings/configuration.html.twig
           for the same note on hot-reload and per-tab includes. #}
        {% include 'laptop/_' ~ activeTab ~ '_content.html.twig' %}
    </div>
{% endblock %}
