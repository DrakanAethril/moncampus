{% extends 'layout/app.html.twig' %}

{% block title %}{{ (isEdit ? 'editLoanConditionTypePageHeading' : 'newLoanConditionTypePageHeading')|trans }}{% endblock %}

{% block page_breadcrumb %}
    {% include '_breadcrumb.html.twig' with {segments: [
        {label: 'homeNavLabel'|trans, url: path('app_home')},
        {label: 'ufaNavLabel'|trans, url: path('app_ufa')},
        {label: 'laptopsNavLabel'|trans, url: path('app_laptops_loans')},
        {label: 'laptopsConfigurationTabLabel'|trans, url: path('app_laptops_configuration')},
        {label: (isEdit ? 'editLoanConditionTypePageHeading' : 'newLoanConditionTypePageHeading')|trans, url: app.request.requestUri},
    ]} %}
{% endblock %}
{% block page_title %}{{ (isEdit ? 'editLoanConditionTypePageHeading' : 'newLoanConditionTypePageHeading')|trans }}{% endblock %}

{% block main %}
    <div class="card">
        <div class="card-body">
            {{ form_start(form) }}
                {{ form_errors(form) }}
                <div class="row">
                    <div class="col-md-6">{{ form_row(form.name) }}</div>
                    <div class="col-md-6">{{ form_row(form.color) }}</div>
                </div>
                <div class="d-flex justify-content-between">
                    <a href="{{ path('app_laptops_configuration') }}" class="btn btn-link">{{ 'cancelAction'|trans }}</a>
                    {{ form_widget(form.submit, {'label': isEdit ? 'submitEditAction' : 'submitCreateAction'}) }}
                </div>
                {{ form_rest(form) }}
            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}
