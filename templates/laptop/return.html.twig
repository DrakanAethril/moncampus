{% extends 'layout/app.html.twig' %}

{% block title %}{{ 'returnLaptopPageHeading'|trans }} - {{ laptop.assetTag }}{% endblock %}

{% block page_breadcrumb %}
    {% include '_breadcrumb.html.twig' with {segments: [
        {label: 'homeNavLabel'|trans, url: path('app_home')},
        {label: 'ufaNavLabel'|trans, url: path('app_ufa')},
        {label: 'laptopsNavLabel'|trans, url: path('app_laptops_loans')},
        {label: 'laptopsLoanHistoryTabLabel'|trans, url: path('app_laptops_loans')},
        {label: 'returnLaptopPageHeading'|trans, url: app.request.requestUri},
    ]} %}
{% endblock %}
{% block page_title %}{{ 'returnLaptopPageHeading'|trans }}{% endblock %}

{% block main %}
    {# Conforme à design/design_handoff_ufa/screenshots/25f-retour-formulaire.png : un bandeau
       récapitulatif du prêt en tête, la date et l'état constaté côte à côte, le rappel de l'état
       au prêt en pleine largeur, puis les notes, et les actions dans un pied de carte. #}
    <div class="card">
        {{ form_start(form) }}
            <div class="card-body">
                {{ form_errors(form) }}
                <div class="cm-loan-summary">
                    <div>
                        <span class="cm-loan-summary__label">{{ 'laptopStudentColumnLabel'|trans }}</span>
                        {# Nom et classe, comme sur la maquette : deux prêts se distinguent souvent
                           par la classe plus vite que par le nom. #}
                        <span class="cm-loan-summary__value">{{ loan.borrower.displayName ?? loan.borrower.username }}{% if borrowerProgram %} — {{ borrowerProgram.displayShortName }}{% endif %}</span>
                    </div>
                    <div>
                        <span class="cm-loan-summary__label">{{ 'laptopComputerColumnLabel'|trans }}</span>
                        <span class="cm-loan-summary__value">{{ laptop.assetTag }}{% if laptop.model %} — {{ laptop.model }}{% endif %}</span>
                    </div>
                    <div>
                        <span class="cm-loan-summary__label">{{ 'laptopLentAtColumnLabel'|trans }}</span>
                        <span class="cm-loan-summary__value">{{ loan.lentAt|date('d/m/Y') }}</span>
                    </div>
                    <div>
                        <span class="cm-loan-summary__label">{{ 'laptopDueAtColumnLabel'|trans }}</span>
                        {# Le retard se dit ici, en rouge à côté de l'échéance, plutôt que dans une
                           alerte séparée en haut de carte. #}
                        <span class="cm-loan-summary__value{{ daysOverdue is not null ? ' cm-loan-summary__value--late' }}">
                            {{- loan.dueAt ? loan.dueAt|date('d/m/Y') : '—' }}{% if daysOverdue is not null %} · {{ 'laptopReturnOverdueInlineLabel'|trans({'%days%': daysOverdue}) }}{% endif -%}
                        </span>
                    </div>
                </div>
                <h3 class="card-title mt-4">{{ 'laptopReturnSectionHeading'|trans }}</h3>
                <div class="row">
                    <div class="col-md-3">{{ form_row(form.returnedAt) }}</div>
                    <div class="col-md-3">{{ form_row(form.returnConditionType) }}</div>
                </div>
                <div class="mb-3">
                    <label class="form-label">{{ 'laptopLoanLentConditionReminderLabel'|trans }}</label>
                    <div class="cm-loan-reminder">
                        {% if loan.lentConditionType %}
                            <span class="cm-select-dot" style="background: {{ loan.lentConditionType.color }}"></span>
                            <strong>{{ loan.lentConditionType.name }}</strong>
                        {% endif %}
                        {%- if loan.lentStateNotes %} <span class="text-secondary">— {{ loan.lentStateNotes }}</span>{% endif %}
                    </div>
                </div>
                {{ form_row(form.returnStateNotes) }}
            </div>
            <div class="card-footer d-flex justify-content-end gap-2">
                <a href="{{ path('app_laptops_loans') }}" class="btn btn-outline-secondary">{{ 'cancelAction'|trans }}</a>
                {{ form_widget(form.submit) }}
            </div>
            {{ form_rest(form) }}
        {{ form_end(form) }}
    </div>
{% endblock %}
