{#
   Convention de prêt et formulaire de restitution, modèle UFA (CFA Aspect Aquitaine), version
   V3-Convention-pret-materiel-informatique-01-08-2025.

   Chaque page est le scan 300 dpi de l'original (resources/laptop_loan_documents/ufa-v3-2025-08-01/,
   incrusté en base64 par App\Service\LaptopLoanDocumentExporter) sur lequel on ne pose que les
   valeurs du prêt. Le texte fixe n'est donc jamais recomposé : il est pixel-perfect par
   construction, et les polices commerciales du modèle ne sont pas un problème.

   Les coordonnées ci-dessous sont en millimètres, relevées sur les zones bleu clair du PDF
   d'origine. Elles ne valent que pour cette version du modèle : une V4 les invalide toutes en même
   temps que les fonds, d'où le numéro de version dans le nom du dossier de ressources.

   Signatures, cachet et dates de signature restent volontairement vides : ils sont manuscrits.
#}
{% import _self as zone %}

{% macro field(x, y, w, h, value, align, size) %}
    {%- if value is not empty -%}
        <div class="zone" style="left:{{ x }}mm; top:{{ y }}mm; width:{{ w }}mm; height:{{ h }}mm;
                                 text-align:{{ align|default('left') }}; font-size:{{ size|default(8.5) }}pt">{{ value }}</div>
    {%- endif -%}
{% endmacro %}

{% macro block_field(x, y, w, h, value) %}
    {%- if value is not empty -%}
        <div class="zone zone--block" style="left:{{ x }}mm; top:{{ y }}mm; width:{{ w }}mm; height:{{ h }}mm">{{ value }}</div>
    {%- endif -%}
{% endmacro %}

{#  Une croix tracée en CSS plutôt qu'un glyphe : le conteneur Gotenberg n'a pas les mêmes polices
    que l'application, et un caractère absent s'imprimerait en carré vide. #}
{% macro tick(x, y) %}
    <div class="tick" style="left:{{ x }}mm; top:{{ y }}mm"><i></i><i></i></div>
{% endmacro %}

<!doctype html>
<html lang="fr">
<head>
{# Sans cette ligne, Chromium devine l'encodage du document que Gotenberg lui passe, et il devine
   mal : « Sébastien » est ressorti « S茅bastien », les octets UTF-8 lus comme du GBK. Le texte fixe
   n'y paraissait rien - c'est une image - donc seules les valeurs saisies étaient touchées. #}
<meta charset="utf-8">
<title>Convention de prêt de matériel informatique</title>
<style>
    @page { size: A4; margin: 0; }

    * { box-sizing: border-box; }

    body {
        margin: 0;
        /* Aucune police de l'application ici : Gotenberg rend dans son propre conteneur, qui n'a ni
           Source Sans 3 ni accès au réseau. On demande donc une sans-serif générique, la seule
           chose que ce rendu peut garantir. */
        font-family: Arial, Helvetica, "Liberation Sans", "DejaVu Sans", sans-serif;
        color: #1a1a2e;
    }

    .page {
        position: relative;
        width: 210mm;
        height: 297mm;
        overflow: hidden;
        background-repeat: no-repeat;
        background-position: 0 0;
        background-size: 210mm 297mm;
    }

    .page + .page { break-before: page; }

    .zone {
        position: absolute;
        display: flex;
        align-items: center;
        padding: 0 1mm;
        line-height: 1.1;
        /* Une valeur trop longue est rognée plutôt que de déborder sur le texte imprimé d'à côté :
           la zone du papier fait la largeur qu'elle fait. */
        overflow: hidden;
        white-space: nowrap;
    }

    .zone--block {
        display: block;
        padding: 1mm;
        white-space: pre-wrap;
        font-size: 8.5pt;
    }

    .tick {
        position: absolute;
        width: 5.9mm;
        height: 5.7mm;
    }

    .tick i {
        position: absolute;
        left: 0.9mm;
        top: 2.6mm;
        width: 4.1mm;
        height: 0.5mm;
        background: #1a1a2e;
    }

    .tick i:first-child { transform: rotate(45deg); }
    .tick i:last-child { transform: rotate(-45deg); }
</style>
</head>
<body>

{% if 1 in images|keys %}
    <div class="page" style="background-image: url('{{ images[1] }}')">
        {{ zone.field(32.2, 43.2, 164.8, 5.2, document.ufaName) }}
        {{ zone.field(23.5, 57.4, 80.8, 5.3, document.representativeLastName) }}
        {{ zone.field(124.1, 57.4, 72.9, 5.3, document.representativeFirstName) }}
        {{ zone.field(29.8, 64.2, 167.2, 5.1, document.representativeRole) }}

        {{ zone.field(24.0, 88.2, 74.4, 5.9, document.borrowerLastName) }}
        {{ zone.field(118.2, 88.2, 78.8, 5.8, document.borrowerFirstName) }}
        {{ zone.field(41.3, 95.5, 155.7, 5.8, document.programName) }}
        {{ zone.field(57.9, 102.8, 44.0, 5.7, document.programStartDate) }}
        {{ zone.field(146.6, 102.8, 50.4, 5.7, document.programEndDate) }}

        {# Bloc « Description du premier équipement transmis ». #}
        {{ zone.field(27.8, 125.8, 44.8, 5.8, document.brand) }}
        {{ zone.field(86.0, 125.8, 41.1, 5.8, document.model) }}
        {{ zone.field(157.1, 125.8, 39.9, 5.8, document.serialNumber) }}
        {{ zone.field(40.5, 133.1, 156.5, 5.7, document.conditionName) }}
        {{ zone.field(50.3, 140.4, 146.7, 5.7, document.accessories) }}
        {{ zone.field(65.7, 147.7, 36.2, 5.9, document.lentAt) }}
        {{ zone.field(157.1, 147.7, 39.9, 5.7, document.dueAt) }}

        {# Article 2 : le numéro de série et les accessoires y sont répétés, et le prix de
           remplacement y figure seul. Sa zone ne fait que 13,9 mm, juste avant le « € » imprimé :
           montant calé à droite et un point plus petit que le reste. #}
        {{ zone.field(89.2, 210.0, 46.1, 5.7, document.serialNumber) }}
        {{ zone.field(179.6, 209.8, 13.9, 5.9, document.replacementValue, 'right', 7.5) }}
        {{ zone.field(65.5, 217.1, 131.5, 5.9, document.accessories) }}
    </div>
{% endif %}

{% if 2 in images|keys %}
    {# Articles 4 à 7 : aucune zone à remplir, la page n'est là que pour que la convention imprimée
       soit complète. #}
    <div class="page" style="background-image: url('{{ images[2] }}')"></div>
{% endif %}

{% if 3 in images|keys %}
    <div class="page" style="background-image: url('{{ images[3] }}')">
        {# « Fait en deux exemplaires à » : la ville de l'établissement. Le « le : » juste à droite
           reste vide, comme les signatures et le cachet - c'est la date de signature, manuscrite. #}
        {{ zone.field(57.4, 98.4, 89.2, 5.7, document.city) }}
    </div>
{% endif %}

{% if 4 in images|keys %}
    <div class="page" style="background-image: url('{{ images[4] }}')">
        {{ zone.field(32.2, 43.2, 164.8, 5.2, document.ufaName) }}
        {{ zone.field(23.5, 57.4, 80.8, 5.3, document.representativeLastName) }}
        {{ zone.field(124.1, 57.4, 72.9, 5.3, document.representativeFirstName) }}
        {{ zone.field(29.8, 64.2, 167.2, 5.1, document.representativeRole) }}

        {{ zone.field(24.0, 88.2, 74.4, 5.9, document.borrowerLastName) }}
        {{ zone.field(118.2, 88.2, 78.8, 5.8, document.borrowerFirstName) }}
        {{ zone.field(41.3, 95.7, 155.7, 5.9, document.programName) }}
        {{ zone.field(44.9, 103.3, 44.0, 5.7, document.returnedAt) }}

        {# Les cinq cases de chaque ligne, dans l'ordre du papier : Comme neuf / Parfait état /
           Très bon état / État correct / Détérioré. Aucune case n'est cochée si l'état enregistré
           ne porte aucun de ces cinq noms - la ligne se remplit alors à la main. #}
        {% set tick_columns = [35.7, 70.6, 109.0, 145.2, 177.9] %}
        {% if document.returnConditionSlot is not null %}
            {{ zone.tick(tick_columns[document.returnConditionSlot], 124.5) }}
        {% endif %}
        {% if document.returnAccessoryConditionSlot is not null %}
            {{ zone.tick(tick_columns[document.returnAccessoryConditionSlot], 144.8) }}
        {% endif %}

        {{ zone.block_field(12.7, 165.1, 184.3, 14.4, document.returnNotes) }}
    </div>
{% endif %}
</body>
</html>
