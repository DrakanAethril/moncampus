{# The player page's body (design/conception_serious_games/profil.html), shared by « Ma page joueur »
   and the teachers' reading of a student (serious_game/results/student.html.twig). `own` says whether
   the reader is the player: the gestures - play, wear a pin, change the avatar - are theirs alone.
   It describes, never recommends: no « recommandé pour toi », no days missed. #}
<div class="cm-sg-player">
    <section class="card cm-sg-player__head">
        <span class="cm-sg-player__avatar" data-controller="sg-avatar" data-sg-avatar-config-value="{{ avatar|json_encode }}" data-sg-avatar-size-value="96"></span>
        <div class="cm-sg-player__who">
            <h2 class="cm-sg-player__name">{{ player.displayName ?? player.username }}</h2>
            <p class="cm-sg-player__meta">{{ 'seriousGamePlayerGamesCount'|trans({'%count%': games|filter(g => g.history is not empty)|length}) }}</p>
        </div>
        {% if own %}
            <a class="cm-sg-pill" href="{{ path('app_serious_games_avatar') }}">{{ 'seriousGameEditAvatarAction'|trans }}</a>
        {% endif %}
    </section>

    {% for row in games %}
        {% set game = row.game %}
        {% set progress = row.progress %}
        {% set words = serious_game_words(game) %}
        <section class="card cm-sg-player__game">
            <div class="cm-sg-player__game-head">
                <div>
                    <h2 class="cm-sg-player__game-title">{{ game.title }}</h2>
                    <p class="cm-sg-player__grade">{{ progress.grade }} · {{ progress.lit }}/{{ progress.total }} {{ game.unitLabel }}</p>
                    <p class="cm-sg-player__statement">
                        {{ row.statement.key|trans(row.statement.params) }}
                        {% if row.statement.finish %}{{ 'seriousGameStatementFinish'|trans({'%finish%': ('seriousGameFinish' ~ row.statement.finish|capitalize)|trans}) }}{% endif %}
                    </p>
                </div>
                {% if row.canPlay %}
                    <twig:Cm:Button variant="primary" data-controller="sg-launch" data-action="sg-launch#enter" href="{{ path('app_serious_games_play', {slug: game.slug}) }}">{{ (progress.lit == 0 ? 'seriousGameCtaNew' : (progress.finished ? 'seriousGameCtaDone' : 'seriousGameCtaProgress'))|trans }}</twig:Cm:Button>
                {% endif %}
            </div>

            <div class="cm-sg-player__chapters">
                {% for chapter in progress.chapters %}
                    <div class="cm-sg-player__chapter {{ chapter.total > 0 and chapter.lit >= chapter.total ? 'is-complete' }}">
                        <div class="cm-sg-player__chapter-name">{{ chapter.label }} <span>{{ chapter.lit }}/{{ chapter.total }}</span></div>
                        <ul class="cm-sg-stars">
                            {% for unit in progress.units|filter(u => u.chapter == chapter.code) %}
                                <li class="cm-sg-star cm-sg-star--{{ unit.brightness ?? (unit.series > 0 ? 'tried' : 'never') }} {{ unit.hidden ? 'is-hidden' }}"
                                    title="{{ unit.label }} — {{ unit.brightness ? words.brightness[unit.brightness]|capitalize : (unit.series > 0 ? 'seriousGameUnitTried'|trans({'%lit%': words.lit}) : 'seriousGameUnitNever'|trans) }}{{ unit.best is not null ? ' · ' ~ 'seriousGameBestSeries'|trans({'%best%': unit.best}) }}">
                                    <span class="cm-sg-star__dot" aria-hidden="true"></span>
                                    <span class="cm-sg-star__label">{{ unit.label }}</span>
                                </li>
                            {% endfor %}
                        </ul>
                    </div>
                {% endfor %}
            </div>

            <div class="cm-sg-player__columns">
                <div>
                    <h3 class="cm-sg-player__h3">{{ 'seriousGamePlayedHeading'|trans }}</h3>
                    {% if row.history is empty %}
                        <p class="text-secondary">{{ 'seriousGameNothingPlayed'|trans }}</p>
                    {% else %}
                        <ul class="cm-sg-history">
                            {% for party in row.history %}
                                <li>
                                    <span class="cm-sg-history__date">{{ party.endedAt|date('d/m') }}</span>
                                    <span class="cm-sg-history__what">{{ party.mode == 'series' ? party.unit : (party.mode == 'final' ? progress.final.label : 'seriousGameCometStudyLabel'|trans({'%comet%': words.comet|capitalize, '%unit%': party.unit})) }}</span>
                                    <span class="cm-sg-history__score">{{ party.score }}/{{ party.size }}</span>
                                </li>
                            {% endfor %}
                        </ul>
                    {% endif %}
                </div>
                <div>
                    <h3 class="cm-sg-player__h3">{{ words.comets|capitalize }}</h3>
                    {% if row.comets is empty %}
                        <p class="text-secondary">{{ 'seriousGameNoComet'|trans({'%comet%': words.comet}) }}</p>
                    {% else %}
                        <ul class="cm-sg-comets">
                            {% for comet in row.comets %}
                                <li>
                                    <strong>{{ comet.label }}</strong>
                                    <span class="text-secondary">· {{ comet.unit }}</span>
                                    {% if comet.state == 'solved' %}<twig:Cm:Badge tone="green">{{ words.cometSolved|capitalize }}</twig:Cm:Badge>{% else %}<twig:Cm:Badge tone="gold">{{ words.cometInView|capitalize }}</twig:Cm:Badge>{% endif %}
                                </li>
                            {% endfor %}
                        </ul>
                    {% endif %}
                </div>
            </div>
        </section>
    {% endfor %}

    {% if collects %}
        <section class="card cm-sg-showcase" id="vitrine">
            {{ component('Cm:Subhead', {title: 'seriousGameShowcaseHeading'|trans, hint: 'seriousGameShowcaseHint'|trans}) }}
            {% for shelf in showcase %}
                {% if showcase|length > 1 %}<h3 class="cm-sg-player__h3 cm-sg-showcase__game">{{ shelf.game.title }}</h3>{% endif %}
                <div class="cm-sg-showcase__shelf">
                    {% for piece in shelf.pieces|filter(p => p.kind != 'pin') %}
                        <figure class="cm-sg-piece {{ piece.held ? '' : 'is-locked' }}">
                            <span data-controller="sg-reward" data-sg-reward-kind-value="{{ piece.kind }}" data-sg-reward-code-value="{{ piece.code }}"
                                  data-sg-reward-finish-value="{{ piece.finish ?? '' }}" data-sg-reward-locked-value="{{ piece.held ? 'false' : 'true' }}"
                                  data-sg-reward-size-value="{{ piece.kind == 'trophy' ? 110 : 84 }}"></span>
                            <figcaption>
                                <b>{{ piece.name }}</b>
                                {% if piece.kind == 'trophy' and piece.held %}<span>{{ ('seriousGameFinish' ~ (piece.finish ?? 'brass')|capitalize)|trans }}</span>{% endif %}
                            </figcaption>
                        </figure>
                    {% endfor %}
                </div>
                <div class="cm-sg-showcase__pins">
                    <h3 class="cm-sg-player__h3">{{ 'seriousGamePinsHeading'|trans }}</h3>
                    {% for piece in shelf.pieces|filter(p => p.kind == 'pin') %}
                        <div class="cm-sg-pin-row">
                            <span data-controller="sg-reward" data-sg-reward-kind-value="pin" data-sg-reward-code-value="{{ piece.code }}" data-sg-reward-locked-value="{{ piece.held ? 'false' : 'true' }}" data-sg-reward-size-value="44"></span>
                            <span>{{ piece.name }}</span>
                            {% if own and piece.held %}
                                <form method="post" action="{{ path('app_serious_games_me_pin') }}">
                                    <input type="hidden" name="_token" value="{{ csrf_token('serious-games') }}">
                                    <input type="hidden" name="pin" value="{{ avatar.pin == piece.code ? '' : piece.code }}">
                                    <twig:Cm:Button variant="outline" size="sm" type="submit">{{ (avatar.pin == piece.code ? 'seriousGamePinRemoveAction' : 'seriousGamePinWearAction')|trans }}</twig:Cm:Button>
                                </form>
                            {% elseif not piece.held %}
                                <span class="text-secondary small">{{ 'seriousGamePinHint'|trans }}</span>
                            {% elseif avatar.pin == piece.code %}
                                <twig:Cm:Badge tone="green">{{ 'seriousGamePinWornLabel'|trans }}</twig:Cm:Badge>
                            {% endif %}
                        </div>
                    {% endfor %}
                </div>
            {% endfor %}
        </section>
    {% endif %}

    <p class="cm-sg-player__readers">{{ (own ? 'seriousGameReadersNoteOwn' : 'seriousGameReadersNoteReader')|trans }}</p>
</div>
