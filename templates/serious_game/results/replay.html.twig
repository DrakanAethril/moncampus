{% extends 'layout/app.html.twig' %}

{% block title %}{{ 'seriousGameReplayHeading'|trans }}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="/serious-games/shared/fonts.css">
{% endblock %}

{% block page_breadcrumb %}
    {{ component('Cm:Breadcrumb', {segments: [
        {label: 'seriousGameResultsHeading'|trans, url: path('app_serious_games_results')},
        {label: player.displayName ?? player.username, url: path('app_serious_games_results_student', {user: player.id})},
        {label: 'seriousGameReplayHeading'|trans, url: app.request.requestUri},
    ]}) }}
{% endblock %}

{% block page_title %}{{ 'seriousGameReplayHeading'|trans }}{% endblock %}

{% block main %}
    {# The question exactly as the student had it: its seed and its template version give it back. #}
    <section class="card cm-sg-replay">
        <div class="card-body">
            <p class="text-secondary">{{ unitName }} · {{ answer.answeredAt|date('d/m/Y') }} · {{ 'seriousGameReplayVersion'|trans({'%version%': answer.templateVersion}) }}</p>
            <div class="cm-sg-sample__prompt">{{ question.prompt|raw }}</div>
            {% if question.figure %}<div class="cm-sg-sample__figure">{{ question.figure|raw }}</div>{% endif %}
            <dl class="cm-sg-replay__facts">
                <dt>{{ 'seriousGameReplayInput'|trans }}</dt>
                <dd>{% if answer.dontKnow %}{{ 'seriousGameDontKnowLabel'|trans }}{% else %}<code>{{ answer.input }}</code>{% endif %}
                    {% if answer.ok %}<twig:Cm:Badge tone="green">{{ 'seriousGameAnswerRight'|trans }}</twig:Cm:Badge>{% elseif misconceptionLabel %}<twig:Cm:Badge tone="red">{{ misconceptionLabel }}</twig:Cm:Badge>{% endif %}</dd>
                <dt>{{ 'seriousGameExpectedAnswer'|trans }}</dt>
                <dd>{{ question.answerDisplay|raw }}</dd>
                <dt>{{ 'seriousGameReplayMethod'|trans }}</dt>
                <dd>{{ question.method|raw }}</dd>
            </dl>
        </div>
    </section>
{% endblock %}
