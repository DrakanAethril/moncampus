{# Screens 8b and 8f - writing the practice application (design_handoff_postulation_redaction).

   The compose screen of the school mailbox, with one difference that changes everything: the "To"
   is an offer, not an address, and the mail is never sent. The notice says so rather than letting
   the student find out.

   The two créas are one screen: 8b shows it once the files are joined, 8f while they are being
   joined. Only 8f carries the way in ("Joindre un fichier"), and since the handoff also rules that
   there is exactly one such way in, always available, 8f's layout is the one built - it holds
   everything 8b shows and the add button besides. #}
{% extends 'layout/app.html.twig' %}

{% block title %}{{ 'trainingApplyPageHeading'|trans({'%offer%': offer.title}) }}{% endblock %}

{% block page_breadcrumb %}
    {% include '_breadcrumb.html.twig' with {segments: [
        {label: 'homeNavLabel'|trans, url: path('app_home')},
        {label: 'trainingValidationBreadcrumbLabel'|trans, url: path('app_training_validation')},
        {label: 'trainingApplyBreadcrumbLabel'|trans, url: app.request.requestUri},
    ]} %}
{% endblock %}

{% block page_title %}
    {{ 'trainingApplyPageHeading'|trans({'%offer%': offer.title}) }}
    <span class="cm-training-badge">{{ 'trainingApplyTrainingBadge'|trans }}</span>
{% endblock %}

{% block main %}
    <div class="cm-training-notice">
        <span class="cm-training-notice__icon" aria-hidden="true">i</span>
        <span>{{ 'trainingApplyNoticeText'|trans|raw }}</span>
    </div>

    <form method="post" action="{{ path('app_training_apply', {id: offer.id}) }}" enctype="multipart/form-data"
          class="cm-postul" data-controller="training-attachments"
          data-training-attachments-remove-label-value="{{ 'trainingApplyRemoveAttachmentAction'|trans }}">
        <input type="hidden" name="_token" value="{{ csrf_token('training_apply') }}">

        {% if error %}
            <div class="cm-postul__error" role="alert">{{ error|trans }}</div>
        {% endif %}

        <div class="cm-postul__fields">
            <div class="cm-postul__row">
                <span class="cm-postul__label">{{ 'schoolMailComposeToLabel'|trans }}</span>
                {# An offer, not an address: there is nowhere for this mail to go, and no mailbox is
                   ever shown to the student - "aucune adresse mail n'est jamais exposée". #}
                <span class="cm-training-chip">{{ 'trainingApplyOfferChipLabel'|trans({'%offer%': offer.title}) }}</span>
            </div>

            <div class="cm-postul__row">
                <label class="cm-postul__label" for="training-apply-subject">{{ 'schoolMailComposeSubjectLabel'|trans }}</label>
                <input type="text" id="training-apply-subject" name="subject" value="{{ values.subject }}" required class="cm-postul__input">
            </div>
        </div>

        {# No placeholder: the opening line is the student's to write. #}
        <textarea name="body" rows="12" required class="cm-postul__textarea" aria-label="{{ 'trainingApplyBodyLabel'|trans }}">{{ values.body }}</textarea>

        {# Generated, never editable here, and carrying no mention of anything else: read inside the
           block, a stray line would pass for part of the signature. #}
        <div class="cm-postul__signature">
            <b>{{ signature.name }}</b>
            {% if signature.formation %}<br>{{ signature.formation }} — Institution Beaupeyrat{% endif %}
            {% if signature.address or signature.phone %}
                <br>{{ [signature.address, signature.phone]|filter(v => v)|join(' · ') }}
            {% endif %}
            {% if signature.linkedin or signature.github %}
                <br>{{ [signature.linkedin, signature.github]|filter(v => v)|join(' · ') }}
            {% endif %}
        </div>

        <div class="cm-postul__attachments">
            <div class="cm-postul__attachhead">
                <span class="cm-postul__attachlabel">{{ 'trainingApplyAttachmentsLabel'|trans }}</span>
                {# Always active: no count of files, and no kind of file, is ever a condition to send. #}
                <button type="submit" class="cm-postul__send">{{ 'trainingApplySubmitAction'|trans }}</button>
            </div>
            <div class="cm-postul__chips" data-training-attachments-target="chips">
                <button type="button" class="cm-postul__attach" data-action="training-attachments#pick">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 5v14M5 12h14"></path></svg>
                    {{ 'trainingApplyAttachAction'|trans }}
                </button>
            </div>
            {# The one and only file field, kept out of sight: the student goes through "Joindre un
               fichier", and the chips above are what they read afterwards. Hidden by a class rather
               than the `hidden` attribute, which Bootstrap's display utilities would override. #}
            <input type="file" name="attachments[]" multiple accept="application/pdf"
                   class="cm-postul__file"
                   data-training-attachments-target="input"
                   data-action="change->training-attachments#added"
                   aria-label="{{ 'trainingApplyAttachAction'|trans }}">
        </div>
    </form>

    <p class="cm-postul__note">
        {{ 'trainingApplySignatureNoticeLabel'|trans }}
        <a href="{{ path('app_school_mail_signature') }}">{{ 'trainingApplyEditSignatureAction'|trans }}</a>.
    </p>
{% endblock %}
