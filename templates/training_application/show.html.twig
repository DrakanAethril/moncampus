{# Screen 8e - the feedback on a practice application, and the resend
   (design_handoff_workflow_postulation).

   The compose screen of screen 8b, filled in with what was sent, and the validator's answer beside
   it. Reading the remark and correcting the paragraph it speaks about are the same gesture, so they
   are the same screen: the mail is rewritten where it was written, not described in a box.

   Nothing here recounts the exchanges. A student has one thing to do - fix what came back - and a
   dated list of who validated what on which version answers a question they are not asking. #}
{% extends 'layout/app.html.twig' %}

{% block title %}{{ 'trainingApplicationPageHeading'|trans }}{% endblock %}

{% block page_breadcrumb %}
    {% include '_breadcrumb.html.twig' with {segments: [
        {label: 'homeNavLabel'|trans, url: path('app_home')},
        {label: 'schoolMailPageHeading'|trans, url: path('app_school_mail')},
        {label: 'trainingValidationBreadcrumbLabel'|trans, url: path('app_training_validation')},
        {label: application.offer.title, url: app.request.requestUri},
    ]} %}
{% endblock %}

{% block page_title %}
    {{ 'trainingApplicationPageHeading'|trans }}
    <span class="cm-jobapp-chip cm-jobapp-chip--{{ application.state.chipVariant }}">{{ application.state.labelKey|trans }}</span>
    <span class="cm-training-badge">{{ 'trainingApplicationVersionLabel'|trans({'%version%': application.versionNumber}) }}</span>
{% endblock %}

{% block main %}
    <div class="cm-sheet">
        <div class="cm-sheet__main">
            {# The resend posts the whole mail again, so the fields carry the last round's text
               rather than starting empty - what is not corrected has to travel back unchanged. When
               the ball is not in the student's court, the same card is read-only: there is nothing
               to send, and the controller would refuse it anyway. #}
            <form method="post" action="{{ path('app_training_application_resubmit', {id: application.id}) }}"
                  enctype="multipart/form-data" class="cm-postul" data-controller="training-attachments"
                  data-training-attachments-remove-label-value="{{ 'trainingApplyRemoveAttachmentAction'|trans }}">
                <input type="hidden" name="_token" value="{{ csrf_token('training_resubmit') }}">

                <div class="cm-postul__fields">
                    <div class="cm-postul__row">
                        <span class="cm-postul__label">{{ 'schoolMailComposeToLabel'|trans }}</span>
                        <span class="cm-training-chip">{{ 'trainingApplyOfferChipLabel'|trans({'%offer%': application.offer.title}) }}</span>
                    </div>

                    <div class="cm-postul__row">
                        <label class="cm-postul__label" for="training-resend-subject">{{ 'schoolMailComposeSubjectLabel'|trans }}</label>
                        <input type="text" id="training-resend-subject" name="subject" value="{{ values.subject }}"
                               required class="cm-postul__input"{{ canResend ? '' : ' readonly' }}>
                    </div>
                </div>

                <textarea name="body" rows="14" required class="cm-postul__textarea"
                          aria-label="{{ 'trainingApplyBodyLabel'|trans }}"{{ canResend ? '' : ' readonly' }}>{{ values.body }}</textarea>

                {# The signature as it reads today, since that is the one the resend will carry - the
                   link under the card is what changes it. #}
                <div class="cm-postul__signature">
                    <b>{{ signature.name }}</b>
                    {% if signature.formation %}<br>{{ signature.formation }} — Institution Beaupeyrat{% endif %}
                    {% if signature.address or signature.phone %}
                        <br>{{ [signature.address, signature.phone]|filter(v => v)|join(' · ') }}
                    {% endif %}
                    {% if signature.linkedin or signature.github %}
                        <br>{{ [signature.linkedin, signature.github]|filter(v => v)|join(' · ') }}
                    {% endif %}
                </div>

                <div class="cm-postul__attachments">
                    <div class="cm-postul__attachhead">
                        <span class="cm-postul__attachlabel">{{ 'trainingApplyAttachmentsLabel'|trans }}</span>
                        {% if canResend %}
                            <button type="submit" class="cm-postul__send">{{ 'trainingApplicationResubmitAction'|trans }}</button>
                        {% endif %}
                    </div>
                    <div class="cm-postul__chips" data-training-attachments-target="chips">
                        {# What was already read, each one openable: a remark on a document is acted
                           on by re-reading that document, and the student should not have to go
                           looking for their own file elsewhere to answer it.

                           The × removes it from the next send, and the hidden field is what says so:
                           a chip that survives posts its id, so an empty list means "I took them all
                           off" rather than "the screen said nothing". #}
                        {% for attachment in application.currentVersion.attachments %}
                            <span class="cm-postul__chip cm-postul__chip--sent">
                                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><path d="M14 2v6h6"></path></svg>
                                <a class="cm-postul__chiplink" target="_blank" rel="noopener"
                                   href="{{ path('app_training_application_document', {id: application.id, attachmentId: attachment.id}) }}">{{ attachment.name }}</a>
                                {% if canResend %}
                                    <input type="hidden" name="keep[]" value="{{ attachment.id }}">
                                    <button type="button" class="cm-postul__chipremove"
                                            data-action="training-attachments#drop"
                                            title="{{ 'trainingApplyRemoveAttachmentAction'|trans }}"
                                            aria-label="{{ 'trainingApplyRemoveAttachmentAction'|trans }} {{ attachment.name }}">×</button>
                                {% endif %}
                            </span>
                        {% endfor %}
                        {% if canResend %}
                            <button type="button" class="cm-postul__attach" data-action="training-attachments#pick">
                                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 5v14M5 12h14"></path></svg>
                                {{ 'trainingApplyAttachAction'|trans }}
                            </button>
                        {% endif %}
                    </div>
                    {% if canResend %}
                        <input type="file" name="attachments[]" multiple accept="application/pdf"
                               class="cm-postul__file"
                               data-training-attachments-target="input"
                               data-action="change->training-attachments#added"
                               aria-label="{{ 'trainingApplyAttachAction'|trans }}">
                        <p class="cm-postul__note">{{ 'trainingApplicationAttachmentsHintLabel'|trans }}</p>
                    {% endif %}
                </div>
            </form>

            <p class="cm-postul__note">
                {{ 'trainingApplySignatureNoticeLabel'|trans }}
                <a href="{{ path('app_school_mail_signature') }}">{{ 'trainingApplyEditSignatureAction'|trans }}</a>.
            </p>
        </div>

        <aside class="cm-sheet__side">
            <div class="card">
                <div class="cm-jobapp-head">
                    <span class="cm-jobapp-head__title">{{ 'trainingApplicationFeedbackTitle'|trans }}</span>
                    <span class="cm-training-badge ms-auto">{{ application.validatedCount }} / {{ elements|length }}</span>
                </div>

                {% for element in elements %}
                    {% set review = application.getReviewFor(element) %}
                    {% set validated = application.isValidated(element) %}
                    {% set refused = application.isRefused(element) %}
                    <div class="cm-training-verdict{{ validated ? ' is-validated' }}">
                        <div class="cm-training-verdict__head">
                            <span class="cm-training-check__icon{{ validated ? ' is-validated' : (refused ? ' is-refused' : '') }}">{{ validated ? '✓' : (refused ? '!' : '·') }}</span>
                            <b>{{ element.labelKey|trans }}</b>
                            <span class="cm-training-verdict__state{{ refused ? ' is-refused' : (validated ? '' : ' is-pending') }}">
                                {{ element.stateLabelKey(validated ? 'validated' : (refused ? 'correction' : 'pending'))|trans }}
                            </span>
                        </div>
                        {% if review and review.remark %}
                            <p class="cm-training-verdict__remark">« {{ review.remark }} »</p>
                        {% elseif not validated and not refused %}
                            <p class="cm-training-verdict__remark cm-training-verdict__remark--muted">{{ 'trainingElementPendingHintLabel'|trans }}</p>
                        {% endif %}
                    </div>
                {% endfor %}

                <div class="cm-compose__footer">
                    <span class="cm-compose__notes">
                        {% if canResend %}
                            {{ 'trainingApplicationResubmitHintLabel'|trans }}
                        {% elseif application.state.value == 'validated' %}
                            {{ 'trainingApplicationValidatedText'|trans }}
                        {% else %}
                            {{ 'trainingApplicationAwaitingReviewText'|trans }}
                        {% endif %}
                    </span>
                </div>
            </div>
        </aside>
    </div>
{% endblock %}
