{# Screen 7c - creating or editing a fictitious offer (design_handoff_workflow_postulation).

   Two panels side by side, as the mockup lays them out: what the offer is on the left (title, PDF,
   validators), who sees it on the right. The split is not decoration - the left is what an offer
   says, the right is who it says it to, and they are decided separately.

   The save bar sits in its own card at the foot, and says what saving does. #}
{% extends 'layout/app.html.twig' %}

{% set is_new = offer.id is null %}

{% block title %}{{ (is_new ? 'trainingOfferNewPageHeading' : 'trainingOfferEditPageHeading')|trans }}{% endblock %}

{% block page_breadcrumb %}
    {% include '_breadcrumb.html.twig' with {segments: [
        {label: 'homeNavLabel'|trans, url: path('app_home')},
        {label: 'gestionNavLabel'|trans, url: path('app_training_offers')},
        {label: 'internshipAlternanceGroupNavLabel'|trans, url: path('app_training_offers')},
        {label: 'trainingOffersPageHeading'|trans, url: path('app_training_offers')},
        {label: is_new ? 'trainingOfferNewPageHeading'|trans : offer.title, url: app.request.requestUri},
    ]} %}
{% endblock %}

{% block page_title %}{{ (is_new ? 'trainingOfferNewPageHeading' : 'trainingOfferEditPageHeading')|trans }}{% endblock %}

{% block main %}
    <form method="post" enctype="multipart/form-data"
          action="{{ is_new ? path('app_training_offer_new') : path('app_training_offer_edit', {id: offer.id}) }}">
        <input type="hidden" name="_token" value="{{ csrf_token('training_offer') }}">

        {% if error %}
            <div class="cm-compose__error cm-offerform__error" role="alert">{{ error|trans }}</div>
        {% endif %}

        <div class="cm-offerform">
            <div class="cm-offerform__panel">
                <label class="cm-offerform__field">
                    <span class="cm-offerform__label">{{ 'trainingOfferTitleLabel'|trans }}</span>
                    <input type="text" name="title" value="{{ offer.title }}" required autocomplete="off" class="cm-offerform__input">
                </label>

                <div class="cm-offerform__field">
                    <span class="cm-offerform__label">{{ 'trainingOfferDocumentLabel'|trans }}</span>
                    {# The app's own dropzone, the one the messaging compose screen uses: same click
                       or drag-and-drop behaviour, so nothing new to learn here. #}
                    <div data-controller="file-dropzone" data-file-dropzone-max-size-value="10485760"
                         data-file-dropzone-too-large-text-value="{{ 'trainingOfferDocumentTooLargeLabel'|trans }}">
                        <label class="cm-offerform__dropzone" data-file-dropzone-target="zone">
                            <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" style="color:var(--cm-brand-strong)"><path d="M12 16.5V5"></path><path d="m7.5 9.5 4.5-4.5 4.5 4.5"></path><path d="M4.5 18.5h15"></path></svg>
                            <span class="cm-offerform__dropzone-title">{{ 'trainingOfferDocumentDropzoneTitle'|trans|raw }}</span>
                            <span class="cm-offerform__dropzone-hint">{{ 'trainingOfferDocumentHintLabel'|trans }}</span>
                            <input type="file" name="document" accept="application/pdf" class="d-none"
                                   data-file-dropzone-target="input" data-action="change->file-dropzone#update">
                        </label>
                        <div data-file-dropzone-target="list"></div>
                    </div>
                    {% if offer.documentName %}
                        <span class="cm-offerform__hint">{{ 'trainingOfferCurrentDocumentLabel'|trans({'%name%': offer.documentName}) }}</span>
                    {% endif %}
                </div>

                <div class="cm-offerform__field" data-controller="chip-picker">
                    <span class="cm-offerform__label">{{ 'trainingOfferValidatorsLabel'|trans }}</span>
                    {# Tom Select renders its picks as removable chips, which is exactly the mockup's
                       row of names with a × and an "+ Ajouter" affordance at the end. #}
                    <select name="validators[]" multiple required class="cm-offerform__validators"
                            data-controller="tom-select"
                            data-tom-select-url-value="{{ path('app_training_offer_teachers') }}"
                            data-tom-select-minimum-input-length-value="2"
                            data-tom-select-placeholder-value="{{ 'trainingOfferValidatorsAddLabel'|trans }}">
                        {% for validator in offer.validators %}
                            {# Named by first name and last name, as the mockup shows: a chip reading
                               "stharaud" tells a teacher nothing about who will review. #}
                            <option value="{{ validator.id }}" selected>{{ (validator.firstname ~ ' ' ~ validator.lastname)|trim ?: validator.username }}</option>
                        {% endfor %}
                    </select>
                    <span class="cm-offerform__hint">{{ 'trainingOfferValidatorsHintLabel'|trans }}</span>
                </div>
            </div>

            <div class="cm-offerform__panel">
                <div class="cm-offerform__field">
                    <span class="cm-offerform__label">{{ 'trainingOfferVisibilityLabel'|trans }}</span>
                    <span class="cm-offerform__hint">{{ 'trainingOfferVisibilityHintLabel'|trans|raw }}</span>
                </div>

                {% set selected = offer.visibilityGroups|map(g => g.id) %}
                {% for bucket in groupsByType %}
                    <div class="cm-offerform__bucket">
                        <div class="cm-offerform__bucket-label">{{ bucket.label ?? ('trainingOfferGroupsUncategorisedLabel'|trans) }}</div>
                        <div class="cm-offerform__groups">
                            {% for group in bucket.groups %}
                                <label class="cm-offerform__group">
                                    <input type="checkbox" name="groups[]" value="{{ group.id }}"{{ group.id in selected ? ' checked' }}>
                                    <span class="cm-offerform__box" aria-hidden="true">✓</span>
                                    <span>{{ group.name }}</span>
                                </label>
                            {% endfor %}
                        </div>
                    </div>
                {% endfor %}
            </div>
        </div>

        <div class="cm-offerform__actions">
            <span class="cm-offerform__hint">{{ 'trainingOfferSaveHintLabel'|trans }}</span>
            <div class="cm-offerform__actions-group">
                <a class="cm-btn cm-btn--outline" href="{{ path('app_training_offers') }}">{{ 'cancelAction'|trans }}</a>
                <button type="submit" class="cm-btn cm-btn--primary">{{ 'trainingOfferSaveAction'|trans }}</button>
            </div>
        </div>
    </form>
{% endblock %}
