{# The article card of screens 2a/2b: tag, title, teaser, then author and date pushed to the bottom.
   The status is written nowhere except when it is not « published » - only a manager then sees the
   chip, since they alone see those articles. #}
<a class="cm-doc-card" href="{{ path('app_documentation_article', {id: article.id}) }}">
    {% set firstTag = article.tags|first %}
    <span class="cm-doc-card__tag">{{ firstTag ? firstTag.label : '' }}</span>
    <span class="cm-doc-card__title">{{ article.title }}</span>
    <span class="cm-doc-card__excerpt">{{ article.excerpt }}</span>
    <span class="cm-doc-card__foot">
        <span class="cm-doc-card__author">{{ article.author ? (article.author.displayName ?? article.author.username) : '' }}</span>
        <span class="cm-doc-card__date">
            {% if article.status.value != 'published' %}
                <span class="cm-doc-card__status cm-doc-card__status--{{ article.status.value }}">{{ article.status.labelKey|trans }}</span>
            {% endif %}
            {{ (article.publishedAt ?? article.updatedAt)|localized_date('d MMMM yyyy') }}
        </span>
    </span>
</a>
