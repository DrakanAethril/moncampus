{% extends 'layout/app.html.twig' %}

{% block title %}{{ 'homePageHeading'|trans }}{% endblock %}

{% block page_header %}
    <div class="page-header d-print-none">
        <div class="container-xl">
            {# One lone segment, and it is the page itself: the dashboard is a menu root, so there is
               nothing above it to climb back to. It is here to give every screen the same starting
               line, not to navigate. #}
            {% include '_breadcrumb.html.twig' with {segments: [
                {label: 'homeNavLabel'|trans, url: path('app_home')},
            ]} %}
            <div class="row g-2 align-items-center">
                <div class="col">
                    {# "Bonjour" alone for the student, "Bonjour <Prénom>" for the internal profiles
                       (shared grammar §1.1). #}
                    {% set is_internal = teacher is defined or staff is defined or admin is defined %}
                    <h2 class="page-title">{{ is_internal ? 'homeGreetingNamed'|trans({'%firstname%': user.firstname ?? (user.displayName ?? user.username)}) : 'homeGreeting'|trans }}</h2>
                    {% if student is defined %}
                        <div class="cm-dash-head__sub">
                            {% if student.programs|length > 1 %}
                                {{ 'homeStudentTwoFormationsSubtitle'|trans({
                                    '%year%': student.programs[0].schoolYear ? (student.programs[0].schoolYear.startDate|date('Y') ~ '-' ~ student.programs[0].schoolYear.endDate|date('Y')) : '',
                                    '%first%': student.programs[0].displayShortName,
                                    '%second%': student.programs[1].displayShortName,
                                }) }}
                            {% elseif student.programs|length == 1 %}
                                {% set program = student.programs[0] %}
                                {{ program.displayShortName }}
                                {%- if student.alternance and student.alternance.tutorLink.enterprise %} · {{ 'homeStudentAlternantSubtitle'|trans({'%enterprise%': student.alternance.tutorLink.enterprise.name}) }}
                                {%- elseif program.schoolYear %} · {{ 'homeStudentPromotionSubtitle'|trans({'%year%': program.schoolYear.startDate|date('Y') ~ '-' ~ program.schoolYear.endDate|date('Y')}) }}
                                {%- endif %}
                            {% endif %}
                        </div>
                    {% endif %}
                </div>
                {% if staff is defined or admin is defined %}
                    <div class="col-auto ms-auto">
                        {# "Accès rapides": a dropdown at title level, not a card (staff-b). #}
                        <div class="dropdown">
                            <button class="btn btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">{{ 'homeQuickAccessLabel'|trans }}</button>
                            <div class="dropdown-menu dropdown-menu-end">
                                <a class="dropdown-item" href="{{ path('app_agenda_new') }}">{{ 'homeQuickAccessNewEventLabel'|trans }}</a>
                                <a class="dropdown-item" href="{{ path('app_tickets_new') }}">{{ 'homeQuickAccessNewTicketLabel'|trans }}</a>
                                <a class="dropdown-item" href="{{ path('app_directory_users_new') }}">{{ 'homeQuickAccessNewStudentLabel'|trans }}</a>
                                <a class="dropdown-item" href="{{ path('app_ufa_alternance_new') }}">{{ 'homeQuickAccessNewAlternanceLabel'|trans }}</a>
                                <a class="dropdown-item" href="{{ path('app_directory_users') }}">{{ 'homeQuickAccessUserListLabel'|trans }}</a>
                            </div>
                        </div>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
{% endblock %}

{% block main %}
    {% if user.contactEmail is null and user.pendingContactEmail is null %}
        <div class="alert alert-warning" role="alert">
            {{ 'contactEmailMissingBannerMessage'|trans }}
            <a href="{{ path('app_profile') }}">{{ 'contactEmailBannerLinkLabel'|trans }}</a>
        </div>
    {% elseif user.pendingContactEmail is not null %}
        <div class="alert alert-warning" role="alert">
            {{ 'contactEmailPendingBannerMessage'|trans({'%email%': user.pendingContactEmail}) }}
            <a href="{{ path('app_profile') }}">{{ 'contactEmailBannerLinkLabel'|trans }}</a>
        </div>
    {% endif %}

    {% include 'home/_pending_surveys_card.html.twig' %}

    {% if admin is defined %}
        <div class="cm-role-switch">
            {% for role in admin.availableRoles %}
                <a href="{{ path('app_home', {role: role}) }}" class="cm-role-switch__btn {{ admin.activeRole == role ? 'is-active' }}">
                    {{ ('homeRole' ~ (role|capitalize) ~ 'Label')|trans }}
                </a>
            {% endfor %}
        </div>
    {% endif %}

    {% if administration is defined %}
        {% include 'home/_administration_dashboard.html.twig' %}
    {% endif %}

    {% if staff is defined %}
        {% include 'home/_staff_dashboard.html.twig' %}
    {% endif %}

    {% if teacher is defined %}
        {% include 'home/_teacher_dashboard.html.twig' %}
    {% endif %}

    {% if student is defined %}
        {# A student+teacher hybrid stacks both dashboards - the events strip renders once. #}
        {% include 'home/_student_dashboard.html.twig' with {show_events: teacher is not defined} %}
    {% endif %}

    {# Last thing on the page, full width, for the two roles that meet the equipment rather than
       administer it. Once for a hybrid, and never for staff or admins, who reach the queue itself
       from Gestion. #}
    {% if (teacher is defined or student is defined) and feature('support') %}
        {% include 'home/_report_problem.html.twig' %}
    {% endif %}
{% endblock %}
