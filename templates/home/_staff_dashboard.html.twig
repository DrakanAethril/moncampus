{# Staff (staff-a/b) - banner relances, events, all-classes day matrix with formation colors. #}

{% if staff.banner %}
    <div class="cm-dash-banner">
        <span class="cm-dash-banner__icon"><twig:ux:icon name="alert-circle" width="20" height="20"/></span>
        <span class="cm-dash-banner__body">
            {# One line, no count and no subtitle: the banner says that something is pending and
               points at the screen that names it; the detail belongs on /ufa/reminders, which
               resolves it properly rather than from two SQL counts. #}
            <span class="cm-dash-banner__title">{{ 'homeStaffBannerEvaluationsTitle'|trans }}</span>
        </span>
        <span class="cm-dash-banner__action">
            <a href="{{ path('app_ufa_alternance_reminders') }}" class="cm-btn cm-btn--gold">{{ 'homeStaffBannerEvaluationsAction'|trans }}</a>
        </span>
    </div>
{% endif %}

{# The CFC is the 3rd and last signatory of making the booklet available, the one who opens the
   evaluation periods. A banner distinct from the reminders one above: both can be true at the same
   time, and this one cannot be chased by mail (no recipient for this step), which is what one learns
   here. #}
{% if staff.engagementBanner %}
    <div class="cm-dash-banner">
        <span class="cm-dash-banner__icon"><twig:ux:icon name="pencil" width="20" height="20" stroke-width="1.7"/></span>
        <span class="cm-dash-banner__body">
            <span class="cm-dash-banner__title">{{ 'homeStaffBannerEngagementTitle'|trans({'%count%': staff.engagementBanner.count}) }}</span>
            <span class="cm-dash-banner__text">
                {%- if staff.engagementBanner.tutorLink -%}
                    {{ 'homeStaffBannerEngagementTextSingle'|trans({
                        '%student%': staff.engagementBanner.tutorLink.student.displayName ?? staff.engagementBanner.tutorLink.student.username,
                        '%formation%': staff.engagementBanner.tutorLink.program.displayShortName,
                    }) }}
                {%- else -%}
                    {{ 'homeStaffBannerEngagementText'|trans({'%count%': staff.engagementBanner.count}) }}
                {%- endif -%}
            </span>
        </span>
        <span class="cm-dash-banner__action">
            {% if staff.engagementBanner.tutorLink %}
                <a href="{{ path('app_ufa_alternance_engagement', {id: staff.engagementBanner.tutorLink.id}) }}" class="cm-btn cm-btn--gold">{{ 'homeStaffBannerEngagementAction'|trans }}</a>
            {% else %}
                <a href="{{ path('app_ufa') }}" class="cm-btn cm-btn--gold">{{ 'homeStaffBannerEngagementActionAll'|trans }}</a>
            {% endif %}
        </span>
    </div>
{% endif %}

{% if feature('agenda') %}{% include 'home/_events_row.html.twig' with {events: events} %}{% endif %}

{# Its own turbo-frame: the ‹ / › arrows and the date picker repaint the matrix alone, leaving the
   banner and the events row above untouched. #}
{# The establishment-wide timetable board. Same reading as the two dashboards above: with
   « Emploi du temps » switched off there is nothing behind it, and its own route answers 404. #}
{% if feature('timetable') %}{% include 'home/_staff_timetable.html.twig' with {timetable: staff.timetable} only %}{% endif %}
