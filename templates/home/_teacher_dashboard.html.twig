{# Teacher (ens-a/b) - équipe pédagogique banner, events, day sessions + Mes classes. #}
{% set weekday_labels = ['mondayLabel', 'tuesdayLabel', 'wednesdayLabel', 'thursdayLabel', 'fridayLabel', 'saturdayLabel', 'sundayLabel'] %}

{% if teacher.pendingTeam is not empty %}
    {% set first_pending = teacher.pendingTeam|first %}
    <div class="cm-dash-banner">
        <span class="cm-dash-banner__icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><path d="M12 8v5"></path><path d="M12 16.5v.01"></path><circle cx="12" cy="12" r="9"></circle></svg></span>
        <span class="cm-dash-banner__body">
            <span class="cm-dash-banner__title">{{ 'homeTeacherBannerLivretsTitle'|trans({'%count%': teacher.pendingTeam|length}) }}</span>
            <span class="cm-dash-banner__text">
                {{ first_pending.evaluation.evaluationPeriod.name }} —
                {# Parentheses required, not style: Twig 3.15 deprecates leaving "??" unparenthesised
                   inside an arrow function, because the next major changes its precedence against
                   the arrow - "item => (a ?? b)" today, "(item => a) ?? b" tomorrow. #}
                {{ teacher.pendingTeam|map(item => (item.evaluation.student.displayName ?? item.evaluation.student.username))|join(', ') }},
                {{ 'homeTeacherBannerLivretsDeadline'|trans({'%date%': first_pending.evaluation.evaluationPeriod.endDate|date('d/m/Y')}) }}
            </span>
        </span>
        <span class="cm-dash-banner__action">
            <a href="{{ path('app_ufa_alternance_period_equipe', {id: first_pending.tutorLink.id, periodId: first_pending.evaluation.evaluationPeriod.id, step: 'comportement'}) }}" class="cm-btn cm-btn--gold">{{ 'homeTeacherBannerLivretsAction'|trans }}</a>
        </span>
    </div>
{% endif %}

{# The events row belongs to the agenda, not to the dashboard: with the agenda switched off it
   goes with it, rather than leaving a strip whose « Voir l'agenda » link answers 404. #}
{% if feature('agenda') %}{% include 'home/_events_row.html.twig' with {events: events} %}{% endif %}

{# Both columns read the timetable: the teacher's own day, and the next session of each of their
   classes. With « Emploi du temps » switched off there is no timetable to read them from - the
   establishment keeps it elsewhere - so the strip goes rather than showing hours nobody maintains
   here, with a « Cahier de texte » link that would answer 404 on top. #}
{% if feature('timetable') %}
<div class="cm-dash-cols">
    <div class="card">
        <div class="card-header">
            {# The day column falls back to the next teaching day when today is free (see
               HomeController::buildTeacherData) - the year is spelled out then, since that day
               can be weeks away and "mardi 4 août" alone would read as this week. #}
            <h3 class="card-title">{{ 'homeTeacherNextDayCardTitle'|trans }} <span class="text-secondary fw-normal" style="font-size: 12.5px;">{{ weekday_labels[teacher.day|date('N') - 1]|trans|lower }} {{ teacher.day|date('j') }} {{ ('monthFull' ~ teacher.day|date('n') ~ 'Label')|trans }}{% if not teacher.dayIsToday %} {{ teacher.day|date('Y') }}{% endif %}</span></h3>
        </div>
        <div class="card-body">
            {% if teacher.daySessions is empty %}
                <p class="text-secondary mb-0">{{ 'homeNoSessionsTodayMessage'|trans }}</p>
            {% else %}
                <div class="cm-sched">
                    {% for session in teacher.daySessions %}
                        {% set start = session.startHour|date('H:i') %}
                        {% set end = session.endHour|date('H:i') %}
                        {% set now_time = now|date('H:i') %}
                        {% set is_past = teacher.dayIsToday and now_time > end %}
                        {% set is_current = teacher.dayIsToday and now_time >= start and now_time <= end %}
                        <div class="cm-sched__row">
                            <span class="cm-sched__time {{ is_current ? 'cm-sched__time--current' }}">{{ start }} – {{ end }}</span>
                            <span class="cm-sched__bar" style="background: {{ is_past ? 'var(--cm-border)' : (is_current ? 'var(--cm-brand)' : 'var(--cm-gold)') }}"></span>
                            <span class="cm-sched__body">
                                <span class="cm-sched__title {{ is_past ? 'cm-sched__title--past' }}">{{ session.displayName }} — {{ session.program.displayShortName }}</span>
                                <span class="cm-sched__meta">{% if session.classRoom %}{{ session.classRoom.name }}{% endif %}</span>
                            </span>
                            {% if feature('lesson_log') %}
                                <span class="cm-sched__side">
                                    <a href="{{ path('app_program_timetable_session_log', {id: session.program.id, sessionId: session.id}) }}" class="small fw-bold text-decoration-none">{{ 'homeTeacherLessonLogLabel'|trans }}</a>
                                </span>
                            {% endif %}
                        </div>
                    {% endfor %}
                </div>
            {% endif %}
        </div>
    </div>
    <div class="card">
        <div class="card-header"><h3 class="card-title">{{ 'homeTeacherNextSessionsByClassCardTitle'|trans }}</h3></div>
        <div class="card-body">
            {% if teacher.classes is empty %}
                <p class="text-secondary mb-0">{{ 'homeTeacherNoUpcomingSessionsMessage'|trans }}</p>
            {% else %}
                <div class="d-flex flex-column gap-3">
                    {# One row per class, and only classes that still have a session ahead - the
                       matière/date/salle shown are that session's, not the class's in general. #}
                    {% for class in teacher.classes %}
                        {% set program = class.program %}
                        {% set session = class.nextSession %}
                        <div class="d-flex align-items-start gap-3">
                            <span class="cm-matrix__class-code">{{ program.displayShortName|slice(0, 5) }}</span>
                            <span class="d-flex flex-column min-w-0">
                                <span class="fw-bold" style="color: var(--cm-ink); font-size: 13.5px;">{{ session.topic ? session.topic.name : session.displayName }}</span>
                                <span class="text-secondary" style="font-size: 12px;">{{ 'homeTeacherStudentCountLabel'|trans({'%count%': class.studentCount}) }}</span>
                                <span class="text-secondary" style="font-size: 12px;">
                                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" style="vertical-align: -1px;"><circle cx="12" cy="12" r="9"></circle><path d="M12 7v5l3 2"></path></svg>
                                    {% if session.day|date('Y-m-d') == today|date('Y-m-d') %}
                                        <strong>{{ 'homeTeacherNextSessionTodayLabel'|trans }} {{ session.startHour|date('H:i') }}</strong>
                                    {% else %}
                                        <strong>{{ weekday_labels[session.day|date('N') - 1]|trans }} {{ session.day|date('j') }} {{ ('monthFull' ~ session.day|date('n') ~ 'Label')|trans }} {{ session.day|date('Y') }} · {{ session.startHour|date('H:i') }}</strong>
                                    {% endif %}
                                    {% if session.classRoom %} · {{ session.classRoom.name }}{% endif %}
                                </span>
                            </span>
                            <span class="ms-auto">
                                <div class="dropdown">
                                    <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">{{ 'homeTeacherQuickLinksLabel'|trans }}</button>
                                    <div class="dropdown-menu dropdown-menu-end">
                                        <h6 class="dropdown-header">{{ 'homeTeacherQuickLinksLabel'|trans }}</h6>
                                        <a class="dropdown-item" href="{{ path('app_program_students', {id: program.id}) }}">{{ 'programStudentsNavLabel'|trans }}</a>
                                        <a class="dropdown-item" href="{{ path('app_program_teachers', {id: program.id}) }}">{{ 'programTeachersNavLabel'|trans }}</a>
                                        {% if feature('timetable') and program.timetableManagementEnabled and visibility_allows(program.timetableVisibility) %}
                                            <a class="dropdown-item" href="{{ path('app_program_timetable', {id: program.id}) }}">{{ 'programTimetableNavLabel'|trans }}</a>
                                        {% endif %}
                                        {# « Carnet de notes » - the establishment keeps its grades elsewhere, so this
                                           entry goes with the feature rather than with the timetable flag it was
                                           historically tied to (design/validated/feature-access.md §7.3). #}
                                        {% if feature('gradebook_entry') and program.timetableManagementEnabled %}
                                            <a class="dropdown-item" href="{{ path('app_program_gradebook', {id: program.id}) }}">{{ 'gradebookNavLabel'|trans }}</a>
                                        {% endif %}
                                        {% if feature('my_alternance') and visibility_allows(program.alternanceCalendarVisibility) %}
                                            <a class="dropdown-item" href="{{ path('app_program_alternance_calendar_pdf', {id: program.id}) }}"{% if program.alternanceCalendarMode.value == 'file' %} target="_blank" rel="noopener"{% endif %}>{{ 'programAlternanceCalendarNavLabel'|trans }}</a>
                                        {% endif %}
                                        {% if feature('class_tools') %}
                                            <a class="dropdown-item" href="{{ path('app_program_tools_random_draw', {id: program.id}) }}">{{ 'programToolsNavLabel'|trans }}</a>
                                        {% endif %}
                                        {% if feature('progression') and visibility_allows(program.syllabusVisibility) %}
                                            <a class="dropdown-item" href="{{ path('app_program_syllabus', {id: program.id}) }}"{% if program.syllabusMode.value == 'file' %} target="_blank" rel="noopener"{% endif %}>{{ 'programSyllabusNavLabel'|trans }}</a>
                                        {% endif %}
                                    </div>
                                </div>
                            </span>
                        </div>
                        {% if not loop.last %}<div style="height: 1px; background: var(--cm-border-soft);"></div>{% endif %}
                    {% endfor %}
                </div>
            {% endif %}
        </div>
    </div>
</div>
{% endif %}
