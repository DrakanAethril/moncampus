{% extends 'base.html.twig' %}

{% block body %}
    <div class="page">
        {% set current_route = app.request.attributes.get('_route') %}
        {% set current_program_section_id = structure_nav_current_program_section_id() %}
        {% set unread_message_count = unread_message_thread_count(app.user) %}
        {# navbar-expand-xxl (1400px), not the original -md (768px): with the wider brand block
           (medallion+divider+"depuis 1634") and the full nav item list this app actually has
           (more items than the design mockup's simplified example), the inline nav genuinely
           overflows the bar between roughly 768px and 1250px - confirmed by measuring
           document.documentElement.scrollWidth across that range, up to 167px of overflow at
           992px. Tabler's own navbar-expand-* tiers are the only breakpoints its interconnected
           collapse/dropdown-positioning/mobile-stacking CSS is written for, so widening the
           threshold to a larger STOCK tier (rather than hand-rolling a custom breakpoint) keeps
           all of that already-tested machinery intact - see assets/styles/app.css's own comment
           on this class for why a custom breakpoint isn't worth the reimplementation risk. #}
        <header class="navbar navbar-expand-xxl d-print-none cm-topbar" data-controller="nav-submenu-placement">
            <div class="container-xl">
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbar-menu" aria-controls="navbar-menu" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <h1 class="navbar-brand d-none-navbar-horizontal pe-0 pe-md-3">
                    <a href="{{ path('app_home') }}" class="cm-topbar__brand">
                        <span class="cm-topbar__medallion"><img src="{{ asset('images/embleme-white.png') }}" alt="Institution Beaupeyrat"></span>
                        <span class="cm-topbar__text">
                            <span class="cm-topbar__name">Institution Beaupeyrat</span>
                            <span class="cm-topbar__since"><i></i><b>{{ 'authSinceLabel'|trans }}</b><i></i></span>
                        </span>
                    </a>
                </h1>
                <span class="cm-topbar__divider"></span>
                <div class="navbar-nav flex-row order-md-last cm-topbar__right">
                    {% set current_theme = app.user.themePreference %}
                    {# Visual-only gate (no backend/route change): the icon that opens Messagerie is
                       hidden in the menu for everyone but admins, per explicit product request -
                       app_messages itself stays reachable by anyone who already has the URL. #}
                    {% if is_granted('ROLE_ADMIN') and feature('messaging') %}
                        {% set messaging_is_active = current_route starts with 'app_messages' %}
                        <div class="nav-item">
                            <a href="{{ path('app_messages') }}" class="cm-mail {{ messaging_is_active ? 'is-active' }}" title="{{ 'messagingNavLabel'|trans }}" aria-label="{{ 'messagingUnreadAriaLabel'|trans({'%count%': unread_message_count}) }}"{{ messaging_is_active ? ' aria-current="page"' }}>
                                <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="2.5" y="5" width="19" height="14" rx="3"></rect><path d="M3.5 7.5 10.4 12.6a2.7 2.7 0 0 0 3.2 0L20.5 7.5"></path></svg>
                                {% if unread_message_count > 0 %}
                                    <span class="cm-mail__badge">{{ unread_message_count > 99 ? '99+' : unread_message_count }}</span>
                                {% endif %}
                            </a>
                        </div>
                    {% endif %}
                    <div class="nav-item dropdown">
                        {% set navbar_avatar_url = avatar_url(app.user) %}
                        {# The campus game's badge, when this person plays one (design/validated/
                           gamification.md, screen 4 - the handoff's #3c kept as it is). The ring says
                           the level of the whole cursus, the band underneath turns into a filled bar
                           carrying the way to the next one, and the second line under the name
                           becomes the displayed title instead of the login. Nobody else's bar
                           changes: game_badge() answers null for a teacher, for a staff account and
                           for every formation that has not switched its game on. #}
                        {% set game_user_badge = game_badge(app.user) %}
                        <a href="#" class="nav-link d-flex align-items-center lh-1 text-reset p-0 cm-user__toggle" data-bs-toggle="dropdown" aria-label="{{ 'openUserMenuLabel'|trans }}">
                            <div class="d-none d-xl-block cm-user__id">
                                <div class="cm-user__name">{{ app.user.displayName ?? app.user.username }}</div>
                                <div class="cm-user__login">{{ game_user_badge ? game_user_badge.title : app.user.username }}</div>
                            </div>
                            {% if game_user_badge %}
                                <span class="cm-user__avatar cm-user__avatar--game">
                                    {% include 'game/_avatar.html.twig' with {badge: game_user_badge, small: true, progress: true} %}
                                </span>
                            {% else %}
                                <span class="cm-user__avatar"{% if navbar_avatar_url %} style="background-image: url({{ navbar_avatar_url }})"{% endif %}>{% if not navbar_avatar_url %}{{ app.user.initials|default((app.user.displayName ?? app.user.username)|slice(0, 1)|upper) }}{% endif %}</span>
                            {% endif %}
                        </a>
                        {# No name/identity header inside this menu: the bar already shows who is
                           logged in right next to the avatar, and repeating it here only forced the
                           menu wider than its own entries. #}
                        <div class="dropdown-menu dropdown-menu-end dropdown-menu-arrow cm-user__menu">
                            <a href="{{ path('app_profile') }}" class="dropdown-item">{{ 'profileNavLabel'|trans }}</a>
                            {# « Leveling » sits with the profile because that is what it is: the
                               student's own reading of their own game. It appears only for somebody
                               who actually plays one - game_badge() answers null otherwise. #}
                            {% if game_user_badge %}
                                <a href="{{ path('app_game_leveling') }}" class="dropdown-item">{{ 'gameLevelingHeading'|trans }}</a>
                            {% endif %}
                            {% if is_granted('ROLE_TEACHER') and feature('timetable') %}
                                <a href="{{ path('app_teacher_timetable') }}" class="dropdown-item">{{ 'teacherTimetableNavLabel'|trans }}</a>
                            {% endif %}
                            {# « Mes machines virtuelles » for a teacher who is not an administrator:
                               an administrator reaches every machine through Infrastructure, and two
                               doors to two different screens is how somebody ends up on the wrong
                               one. Students read the same entry from the Ressources dropdown, which
                               is their whole navigation. Shown only to somebody who has a machine. #}
                            {% if is_granted('ROLE_TEACHER') and not is_granted('ROLE_ADMIN') and feature('my_vms') and has_virtual_machines(app.user) %}
                                <a href="{{ path('app_my_machines') }}" class="dropdown-item">{{ 'myMachinesNavLabel'|trans }}</a>
                            {% endif %}
                            {# Séquences/Séances, Progression pédagogique and Quiz used to sit here.
                               They moved to the top bar's "Outils" menu (design_handoff_menu_outils,
                               "Migration depuis la section Profil") and are deliberately NOT left
                               behind here as well: one entry point per tool, and this menu is about
                               the account, not about teaching. #}
                            <div class="dropdown-divider"></div>
                            <div class="cm-usermenu__theme"
                                 data-controller="theme"
                                 data-theme-authenticated-value="true"
                                 data-theme-save-url-value="{{ path('app_profile_theme') }}"
                                 data-theme-token-value="{{ csrf_token('profile_theme') }}">
                                <span>{{ 'themeNavLabel'|trans }}</span>
                                <span class="cm-theme">
                                    <button type="button" class="{{ current_theme != 'dark' ? 'is-on' }}" data-action="theme#setLight" aria-pressed="{{ current_theme != 'dark' ? 'true' : 'false' }}" aria-label="{{ 'themeLightLabel'|trans }}">☀</button>
                                    <button type="button" class="{{ current_theme == 'dark' ? 'is-on' }}" data-action="theme#setDark" aria-pressed="{{ current_theme == 'dark' ? 'true' : 'false' }}" aria-label="{{ 'themeDarkLabel'|trans }}">☾</button>
                                </span>
                            </div>
                            <div class="dropdown-divider"></div>
                            {# "À propos" carries the AGPL §13 source-code offer (see
                               App\Controller\AboutController), so it has to be reachable from every
                               authenticated page - this menu is the one element present on all of
                               them. Kept out of the theme block above and separated from Déconnexion
                               below so it reads as its own entry. #}
                            {# "Aide" sits right above "À propos", in the same group
                               (design_handoff_aide, créa 1c: one entry, in the profile menu, and
                               nowhere else). Teachers, staff and admins only for now: articles
                               addressed to students and tutors can already be written, but neither
                               role is given a way in yet. /help itself stays open to any
                               authenticated user and simply shows them nothing. #}
                            {% if (is_granted('ROLE_TEACHER') or is_staff()) and feature('help') %}
                                <a href="{{ path('app_help') }}" class="dropdown-item">{{ 'helpPageHeading'|trans }}</a>
                            {% endif %}
                            {# "Changelog" stays in English on purpose - see App\Controller\ChangelogController. #}
                            <a href="{{ path('app_changelog') }}" class="dropdown-item">{{ 'changelogPageHeading'|trans }}</a>
                            {# Open to every role: the source is public and the school teaches the BTS SIO,
                               so the students using this app are also its readership. #}
                            <a href="{{ path('app_technical') }}" class="dropdown-item">{{ 'technicalPageHeading'|trans }}</a>
                            <a href="{{ path('app_about') }}" class="dropdown-item">{{ 'aboutNavLabel'|trans }}</a>
                            <div class="dropdown-divider"></div>
                            {# data-turbo-prefetch="false": Turbo prefetches a link's href on hover by
                               default - for most links that's harmless, but /logout is a GET route
                               that destroys the session immediately, so hovering alone would log the
                               user out (silently, until their next click reveals it). #}
                            <a href="{{ path('app_logout') }}" class="dropdown-item text-danger" data-turbo-prefetch="false">{{ 'logoutAction'|trans }}</a>
                        </div>
                    </div>
                </div>
                <div class="collapse navbar-collapse" id="navbar-menu">
                    {# Per-role bars, design_handoff_dashboards §3: étudiant = Accueil · Emploi du
                       temps · Travail à faire · Outils ▾ · Agenda · Support · (Mon alternance);
                       enseignant = Accueil · Campus ▾ · Support · Agenda; staff = Campus ▾ · UFA ▾ ·
                       Support · Agenda · Gestion ▾ · Configuration ▾; admin = barre complète sans
                       Support (tickets via Gestion), avec e-CO/Ressources/messagerie.

                       Text labels only, no icons: the rule already held for the dropdowns (see
                       "Outils" further down), and the few flat entries that still carried one fell
                       in line on 2026-08-08. The one exception is a Section's icon in the Campus
                       menu, which is data entered in the settings screens, not decoration. #}
                    {% set is_pure_student = is_granted('ROLE_STUDENT') and not is_staff() and not is_granted('ROLE_TEACHER') %}
                    <ul class="navbar-nav" aria-label="{{ 'mainNavLabel'|trans }}">
                        {# Hidden (menu-only, no route/backend change) for admin/staff/staff-lead per
                           explicit product request - staff land on Gestion/Campus instead. #}
                        {% if not (is_granted('ROLE_ADMIN') or is_granted('ROLE_STAFF') or is_granted('ROLE_STAFF-LEAD')) %}
                            <li class="nav-item {{ current_route == 'app_home' ? 'active' }}">
                                <a class="nav-link" href="{{ path('app_home') }}"{{ current_route == 'app_home' ? ' aria-current="page"' }}>
                                    <span class="nav-link-title">{{ 'homeNavLabel'|trans }}</span>
                                </a>
                            </li>
                        {% endif %}
                        {% set student_programs = is_granted('ROLE_STUDENT') and not is_staff() ? student_nav_programs() : [] %}
                        {% set student_has_timetable = feature('timetable') and student_programs|filter(p => p.timetableManagementEnabled)|length > 0 %}
                        {% if student_has_timetable %}
                            <li class="nav-item {{ current_route == 'app_my_timetable' or current_route == 'app_program_timetable' ? 'active' }}">
                                <a class="nav-link" href="{{ path('app_my_timetable') }}"{{ current_route == 'app_my_timetable' ? ' aria-current="page"' }}>
                                    <span class="nav-link-title">{{ 'programTimetableNavLabel'|trans }}</span>
                                </a>
                            </li>
                        {% endif %}
                        {# Right after "Emploi du temps", where mockup 3c puts it. Students only:
                           staff have the Travaux list on the Campus side, which is neither the same
                           screen nor the same question. #}
                        {# Only when the screen behind it has something on it: the tab is the student's
                           second most used, and one that opens on « rien à rendre » every day of a
                           quiet fortnight is one they stop reading. student_has_work() asks the same
                           builder the screen is drawn from, so the two cannot disagree. #}
                        {% if is_granted('ROLE_STUDENT') and not is_staff() and feature('student_work') and student_has_work() %}
                            <li class="nav-item {{ current_route starts with 'app_student_work' ? 'active' }}">
                                <a class="nav-link" href="{{ path('app_student_work') }}"{{ current_route starts with 'app_student_work' ? ' aria-current="page"' }}>
                                    <span class="nav-link-title">{{ 'studentWorkNavLabel'|trans }}</span>
                                </a>
                            </li>
                        {% endif %}
                        {# « Ma progression », right after « Travail à faire » exactly as the mockup's
                           bar draws it. Shown only to somebody whose own formation actually plays:
                           game_badge() answers null unless the feature is on *and* the formation has
                           declared itself, which is the strict conjunction of §4, decision 1. #}
                        {% if is_granted('ROLE_STUDENT') and not is_staff() and game_user_badge %}
                            <li class="nav-item {{ current_route starts with 'app_game' ? 'active' }}">
                                <a class="nav-link" href="{{ path('app_game') }}"{{ current_route starts with 'app_game' ? ' aria-current="page"' }}>
                                    <span class="nav-link-title">{{ 'gameProgressHeading'|trans }}</span>
                                </a>
                            </li>
                        {% endif %}
                        {# The student bar stops here, at Accueil · Emploi du temps · Travail à faire,
                           and everything else they read moved into "Ressources" further down
                           (2026-08-17). Three entries left the top level in that move: "Mes cours",
                           now "Séquences de l'année"; and the whole "Outils" dropdown, whose two
                           entries - Courrier école and Candidatures - are resources like the rest.
                           The bar had grown to seven items for the role that navigates least. #}
                        {% if not is_pure_student %}
                        {% for section in structure_nav_sections() %}
                            {% set section_school_year_groups = structure_nav_school_year_groups(section) %}
                            {# A Section appears when it leads somewhere, for everybody - staff included
                               since 2026-08-25. A student/teacher only ever saw the Sections holding a
                               Program they are linked to (structure_nav_school_year_groups() filters down
                               to those, see App\Security\StructureAccessChecker::isProgramVisible());
                               staff used to see the empty ones too, which drew a menu that opened on
                               nothing. A Section with no Program is administered from Paramètres >
                               Configuration, which is where it is created. #}
                            {% if section_school_year_groups|length > 0 %}
                                <li class="nav-item dropdown {{ current_program_section_id == section.id ? 'active' }}">
                                    <a class="nav-link dropdown-toggle" href="#nav-section-{{ section.id }}" data-bs-toggle="dropdown" data-bs-auto-close="outside" role="button" aria-expanded="false"{{ current_program_section_id == section.id ? ' aria-current="page"' }}>
                                        {% if section.icon %}
                                            <span class="nav-link-icon">
                                                <svg class="icon"><use href="{{ asset('icons/tabler-sprite.svg') }}#tabler-icon-{{ section.icon }}"></use></svg>
                                            </span>
                                        {% endif %}
                                        <span class="nav-link-title">{{ section.name }}</span>
                                    </a>
                                    <div class="dropdown-menu">
                                        {# A Section lists its Programs and nothing else. The multi-class
                                           "Travaux" view used to open this menu; it is reached from
                                           "Outils" instead, where the other cross-class teaching screens
                                           already live. #}
                                        {% for group in section_school_year_groups %}
                                            {% if group.schoolYear %}
                                                <h6 class="dropdown-header">{{ group.schoolYear.startDate|date('Y') }} - {{ group.schoolYear.endDate|date('Y') }}</h6>
                                            {% else %}
                                                <h6 class="dropdown-header">{{ 'testZoneNavLabel'|trans }}</h6>
                                            {% endif %}
                                            {% for program in group.programs %}
                                                <div class="dropend">
                                                    <a class="dropdown-item dropdown-toggle {{ current_route starts with 'app_program_' and app.request.attributes.get('id') == program.id ? 'active' }}" href="#nav-program-{{ program.id }}" data-bs-toggle="dropdown" data-bs-auto-close="outside" role="button" aria-expanded="false">
                                                        {{ program.displayShortName }}
                                                    </a>
                                                    <div class="dropdown-menu">
                                                        {# The two lists are administrators' screens since 2026-08-25: they
                                                           hold the class's people, which is the establishment's own directory
                                                           rather than a teaching tool. A teacher reaches their students
                                                           through the tools that need them. The routes themselves are
                                                           unchanged - this hides the door, it does not lock it. #}
                                                        {% if is_granted('ROLE_ADMIN') %}
                                                            <a class="dropdown-item {{ current_route == 'app_program_students' and app.request.attributes.get('id') == program.id ? 'active' }}" href="{{ path('app_program_students', {id: program.id}) }}">{{ 'programStudentsNavLabel'|trans }}</a>
                                                            <a class="dropdown-item {{ current_route == 'app_program_teachers' and app.request.attributes.get('id') == program.id ? 'active' }}" href="{{ path('app_program_teachers', {id: program.id}) }}">{{ 'programTeachersNavLabel'|trans }}</a>
                                                        {% endif %}
                                                        {% if feature('timetable') and program.timetableManagementEnabled and visibility_allows(program.timetableVisibility) %}
                                                            <a class="dropdown-item {{ current_route == 'app_program_timetable' and app.request.attributes.get('id') == program.id ? 'active' }}" href="{{ path('app_program_timetable', {id: program.id}) }}">{{ 'programTimetableNavLabel'|trans }}</a>
                                                        {% endif %}
                                                        {# No teaching tool is left in a class's submenu: the carnet de notes, the
                                                           tirage/groupes/audio sub-submenu, the suivi des recherches and the
                                                           launched quizzes all moved to the top bar's "Outils". A class lists what
                                                           it *is* - its people, its timetable, its calendars, its settings; what
                                                           one *does* with a class is one menu up. The quizzes went one step
                                                           further and are not merely moved: Outils > Quiz par classes shows the
                                                           classes one TEACHES (App\Controller\QuizTrackingController), so a staff
                                                           member no longer reads a teacher's quizzes and their students' answers
                                                           from a class screen. #}
                                                        {# The campus game, gathered under one entry rather than scattered among
                                                           the class's own: five screens that all answer the same question and
                                                           that a class which does not play must not have to read past. The
                                                           frontier of the formation is what the placement says first - no
                                                           ranking, no relevé and no gesture crosses it (§4, decision 1).

                                                           « Réglages » is deliberately outside program.gameEnabled, unlike the
                                                           four others: it is the screen that switches the formation on, and one
                                                           reachable only once it already is could never be reached at all. #}
                                                        {% set game_plays = feature('game') and program.gameEnabled and is_program_teacher(program) %}
                                                        {# Settling the game - the barème, and the catalogue it hands out - is the
                                                           administration's while the game is being settled (2026-08-28), so that the
                                                           feature can be taken away from teachers entirely without leaving a menu
                                                           entry that leads to a 403. #}
                                                        {% set game_settles = feature('game') and is_granted('ROLE_ADMIN') %}
                                                        {% if game_plays or game_settles %}
                                                            <div class="dropend">
                                                                <a class="dropdown-item dropdown-toggle {{ current_route starts with 'app_program_game' or current_route starts with 'app_game_engagements' or current_route == 'app_program_settings_game' ? 'active' }}" href="#nav-program-game-{{ program.id }}" data-bs-toggle="dropdown" data-bs-auto-close="outside" role="button" aria-expanded="false">
                                                                    {{ 'gameNavGroupLabel'|trans }}
                                                                </a>
                                                                <div class="dropdown-menu">
                                                                    {% if game_plays %}
                                                                        <a class="dropdown-item {{ current_route starts with 'app_program_game_statement' ? 'active' }}" href="{{ path('app_program_game_statements', {id: program.id}) }}">{{ 'gameStatementsHeading'|trans }}</a>
                                                                        <a class="dropdown-item {{ current_route starts with 'app_program_game_gestures' ? 'active' }}" href="{{ path('app_program_game_gestures', {id: program.id}) }}">{{ 'gameGesturesHeading'|trans }}</a>
                                                                        <a class="dropdown-item {{ current_route starts with 'app_game_engagements' and app.request.query.get('program') == program.id ? 'active' }}" href="{{ path('app_game_engagements', {program: program.id}) }}">{{ 'engagementQueueHeading'|trans }}</a>
                                                                    {% endif %}
                                                                    {% if game_settles %}
                                                                        <a class="dropdown-item {{ current_route starts with 'app_program_game_rewards' ? 'active' }}" href="{{ path('app_program_game_rewards', {id: program.id}) }}">{{ 'gameRewardsHeading'|trans }}</a>
                                                                        <a class="dropdown-item {{ current_route == 'app_program_settings_game' ? 'active' }}" href="{{ path('app_program_settings_game', {id: program.id}) }}">{{ 'gameSettingsHeading'|trans }}</a>
                                                                    {% endif %}
                                                                </div>
                                                            </div>
                                                        {% endif %}
                                                        {% if feature('my_alternance') and visibility_allows(program.alternanceCalendarVisibility) %}
                                                            {# Same route in both alternanceCalendarMode cases - the controller redirects to the
                                                               uploaded PDF instead of generating one when mode is File - so still no "active"
                                                               state to track here, unlike the page-based nav entries around it. Opens in a new
                                                               tab only in File mode, since that's a redirect straight out to an external S3/
                                                               CloudFront URL, not an in-app page. #}
                                                            <a class="dropdown-item" href="{{ path('app_program_alternance_calendar_pdf', {id: program.id}) }}"{% if program.alternanceCalendarMode.value == 'file' %} target="_blank" rel="noopener"{% endif %}>{{ 'programAlternanceCalendarNavLabel'|trans }}</a>
                                                        {% endif %}
                                                        {# Administrators only since 2026-08-25, and **deliberately no longer
                                                           reading program.syllabusVisibility**: the setting stays in Formation >
                                                           Paramétrage, where it was configured, but nothing applies it for now.
                                                           Removing the field would throw away what each class had already been
                                                           set to, and the day the syllabus opens up again that is exactly what
                                                           would have to be entered a second time. #}
                                                        {% if is_granted('ROLE_ADMIN') and feature('progression') %}
                                                            <a class="dropdown-item {{ current_route == 'app_program_syllabus' and app.request.attributes.get('id') == program.id ? 'active' }}" href="{{ path('app_program_syllabus', {id: program.id}) }}"{% if program.syllabusMode.value == 'file' %} target="_blank" rel="noopener"{% endif %}>{{ 'programSyllabusNavLabel'|trans }}</a>
                                                        {% endif %}
                                                        {% if is_granted('ROLE_ADMIN') and feature('progression') and program.timetableManagementEnabled %}
                                                            <a class="dropdown-item {{ current_route starts with 'app_program_sequence' and app.request.attributes.get('id') == program.id ? 'active' }}" href="{{ path('app_program_sequences', {id: program.id}) }}">{{ 'programSequencesNavLabel'|trans }}</a>
                                                        {% endif %}
                                                        {% if is_staff() %}
                                                            {% if feature('program_reporting') and program.financialManagementEnabled %}
                                                                <a class="dropdown-item {{ current_route == 'app_program_reporting' and app.request.attributes.get('id') == program.id ? 'active' }}" href="{{ path('app_program_reporting', {id: program.id}) }}">{{ 'programReportingNavLabel'|trans }}</a>
                                                            {% endif %}
                                                            {% if feature('program_exports') %}<a class="dropdown-item {{ current_route starts with 'app_program_exports' and app.request.attributes.get('id') == program.id ? 'active' }}" href="{{ path('app_program_exports', {id: program.id}) }}">{{ 'programExportsNavLabel'|trans }}</a>{% endif %}
                                                            <div class="dropend">
                                                                <a class="dropdown-item dropdown-toggle {{ (current_route starts with 'app_program_settings' or current_route starts with 'app_program_timetable_settings') and app.request.attributes.get('id') == program.id ? 'active' }}" href="#nav-program-settings-{{ program.id }}" data-bs-toggle="dropdown" data-bs-auto-close="outside" role="button" aria-expanded="false">
                                                                    {{ 'programSettingsNavLabel'|trans }}
                                                                </a>
                                                                <div class="dropdown-menu">
                                                                    <a class="dropdown-item {{ current_route starts with 'app_program_settings' and app.request.attributes.get('id') == program.id ? 'active' }}" href="{{ path('app_program_settings', {id: program.id}) }}">{{ 'programSettingsProgramNavLabel'|trans }}</a>
                                                                    {% if feature('timetable_settings') and program.timetableManagementEnabled %}
                                                                        <a class="dropdown-item {{ current_route starts with 'app_program_timetable_settings' and app.request.attributes.get('id') == program.id ? 'active' }}" href="{{ path('app_program_timetable_settings', {id: program.id}) }}">{{ 'programSettingsTimetableTabLabel'|trans }}</a>
                                                                    {% endif %}
                                                                </div>
                                                            </div>
                                                        {% endif %}
                                                        {% if is_granted('ROLE_STUDENT') and feature('ufa_booklet') and program.internshipManagementEnabled %}
