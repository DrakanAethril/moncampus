                                    {% if feature('audio') %}<a class="dropdown-item {{ current_route starts with 'app_audio_recording' ? 'active' }}" href="{{ path('app_audio_recordings') }}">{{ 'audioRecordingsNavLabel'|trans }}</a>{% endif %}
                                    {% endif %}
                                    {% if tools_follow %}
