{% extends 'base.html.twig' %}

{% block body %}
    <div class="page">
        {% set current_route = app.request.attributes.get('_route') %}
        {% set current_program_section_id = structure_nav_current_program_section_id() %}
        {% set unread_message_count = unread_message_thread_count(app.user) %}
        {# navbar-expand-xxl (1400px), not the original -md (768px): with the wider brand block
           (medallion+divider+"depuis 1634") and the full nav item list this app actually has
           (more items than the design mockup's simplified example), the inline nav genuinely
           overflows the bar between roughly 768px and 1250px - confirmed by measuring
           document.documentElement.scrollWidth across that range, up to 167px of overflow at
           992px. Tabler's own navbar-expand-* tiers are the only breakpoints its interconnected
           collapse/dropdown-positioning/mobile-stacking CSS is written for, so widening the
           threshold to a larger STOCK tier (rather than hand-rolling a custom breakpoint) keeps
           all of that already-tested machinery intact - see assets/styles/app.css's own comment
           on this class for why a custom breakpoint isn't worth the reimplementation risk. #}
        <header class="navbar navbar-expand-xxl d-print-none cm-topbar" data-controller="nav-submenu-placement">
            <div class="container-xl">
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbar-menu" aria-controls="navbar-menu" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <h1 class="navbar-brand d-none-navbar-horizontal pe-0 pe-md-3">
                    <a href="{{ path('app_home') }}" class="cm-topbar__brand">
                        <span class="cm-topbar__medallion"><img src="{{ asset('images/embleme-white.png') }}" alt="Institution Beaupeyrat"></span>
                        <span class="cm-topbar__text">
                            <span class="cm-topbar__name">Institution Beaupeyrat</span>
                            <span class="cm-topbar__since"><i></i><b>{{ 'authSinceLabel'|trans }}</b><i></i></span>
                        </span>
                    </a>
                </h1>
                <span class="cm-topbar__divider"></span>
                <div class="navbar-nav flex-row order-md-last cm-topbar__right">
                    {% set current_theme = app.user.themePreference %}
                    {# Visual-only gate (no backend/route change): the icon that opens Messagerie is
                       hidden in the menu for everyone but admins, per explicit product request -
                       app_messages itself stays reachable by anyone who already has the URL. #}
                    {% if is_granted('ROLE_ADMIN') %}
                        {% set messaging_is_active = current_route starts with 'app_messages' %}
                        <div class="nav-item">
                            <a href="{{ path('app_messages') }}" class="cm-mail {{ messaging_is_active ? 'is-active' }}" title="{{ 'messagingNavLabel'|trans }}" aria-label="{{ 'messagingUnreadAriaLabel'|trans({'%count%': unread_message_count}) }}"{{ messaging_is_active ? ' aria-current="page"' }}>
                                <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="2.5" y="5" width="19" height="14" rx="3"></rect><path d="M3.5 7.5 10.4 12.6a2.7 2.7 0 0 0 3.2 0L20.5 7.5"></path></svg>
                                {% if unread_message_count > 0 %}
                                    <span class="cm-mail__badge">{{ unread_message_count > 99 ? '99+' : unread_message_count }}</span>
                                {% endif %}
                            </a>
                        </div>
                    {% endif %}
                    <div class="nav-item dropdown">
                        {% set navbar_avatar_url = avatar_url(app.user) %}
                        <a href="#" class="nav-link d-flex align-items-center lh-1 text-reset p-0 cm-user__toggle" data-bs-toggle="dropdown" aria-label="{{ 'openUserMenuLabel'|trans }}">
                            <div class="d-none d-xl-block cm-user__id">
                                <div class="cm-user__name">{{ app.user.displayName ?? app.user.username }}</div>
                                <div class="cm-user__login">{{ app.user.username }}</div>
                            </div>
                            <span class="cm-user__avatar"{% if navbar_avatar_url %} style="background-image: url({{ navbar_avatar_url }})"{% endif %}>{% if not navbar_avatar_url %}{{ app.user.initials|default((app.user.displayName ?? app.user.username)|slice(0, 1)|upper) }}{% endif %}</span>
                        </a>
                        {# No name/identity header inside this menu: the bar already shows who is
                           logged in right next to the avatar, and repeating it here only forced the
                           menu wider than its own entries. #}
                        <div class="dropdown-menu dropdown-menu-end dropdown-menu-arrow cm-user__menu">
                            <a href="{{ path('app_profile') }}" class="dropdown-item">{{ 'profileNavLabel'|trans }}</a>
                            {% if is_granted('ROLE_TEACHER') %}
                                <a href="{{ path('app_teacher_timetable') }}" class="dropdown-item">{{ 'teacherTimetableNavLabel'|trans }}</a>
                            {% endif %}
                            {# Séquences/Séances, Progression pédagogique and Quiz used to sit here.
                               They moved to the top bar's "Outils" menu (design_handoff_menu_outils,
                               "Migration depuis la section Profil") and are deliberately NOT left
                               behind here as well: one entry point per tool, and this menu is about
                               the account, not about teaching. #}
                            <div class="dropdown-divider"></div>
                            <div class="cm-usermenu__theme"
                                 data-controller="theme"
                                 data-theme-authenticated-value="true"
                                 data-theme-save-url-value="{{ path('app_profile_theme') }}"
                                 data-theme-token-value="{{ csrf_token('profile_theme') }}">
                                <span>{{ 'themeNavLabel'|trans }}</span>
                                <span class="cm-theme">
                                    <button type="button" class="{{ current_theme != 'dark' ? 'is-on' }}" data-action="theme#setLight" aria-pressed="{{ current_theme != 'dark' ? 'true' : 'false' }}" aria-label="{{ 'themeLightLabel'|trans }}">☀</button>
                                    <button type="button" class="{{ current_theme == 'dark' ? 'is-on' }}" data-action="theme#setDark" aria-pressed="{{ current_theme == 'dark' ? 'true' : 'false' }}" aria-label="{{ 'themeDarkLabel'|trans }}">☾</button>
                                </span>
                            </div>
                            <div class="dropdown-divider"></div>
                            {# "À propos" carries the AGPL §13 source-code offer (see
                               App\Controller\AboutController), so it has to be reachable from every
                               authenticated page - this menu is the one element present on all of
                               them. Kept out of the theme block above and separated from Déconnexion
                               below so it reads as its own entry. #}
                            {# "Aide" sits right above "À propos", in the same group
                               (design_handoff_aide, créa 1c: one entry, in the profile menu, and
                               nowhere else). Teachers, staff and admins only for now: articles
                               addressed to students and tutors can already be written, but neither
                               role is given a way in yet. /help itself stays open to any
                               authenticated user and simply shows them nothing. #}
                            {% if is_granted('ROLE_TEACHER') or is_staff() %}
                                <a href="{{ path('app_help') }}" class="dropdown-item">{{ 'helpPageHeading'|trans }}</a>
                            {% endif %}
                            <a href="{{ path('app_about') }}" class="dropdown-item">{{ 'aboutNavLabel'|trans }}</a>
                            <div class="dropdown-divider"></div>
                            {# data-turbo-prefetch="false": Turbo prefetches a link's href on hover by
                               default - for most links that's harmless, but /logout is a GET route
                               that destroys the session immediately, so hovering alone would log the
                               user out (silently, until their next click reveals it). #}
                            <a href="{{ path('app_logout') }}" class="dropdown-item text-danger" data-turbo-prefetch="false">{{ 'logoutAction'|trans }}</a>
                        </div>
                    </div>
                </div>
                <div class="collapse navbar-collapse" id="navbar-menu">
                    {# Per-role bars, design_handoff_dashboards §3: étudiant = Accueil · Emploi du
                       temps · Travail à faire · Outils ▾ · Agenda · Support · (Mon alternance);
                       enseignant = Accueil · Campus ▾ · Support · Agenda; staff = Campus ▾ · UFA ▾ ·
                       Support · Agenda · Gestion ▾ · Configuration ▾; admin = barre complète sans
                       Support (tickets via Gestion), avec e-CO/Ressources/messagerie.

                       Text labels only, no icons: the rule already held for the dropdowns (see
                       "Outils" further down), and the few flat entries that still carried one fell
                       in line on 2026-08-08. The one exception is a Section's icon in the Campus
                       menu, which is data entered in the settings screens, not decoration. #}
                    {% set is_pure_student = is_granted('ROLE_STUDENT') and not is_staff() and not is_granted('ROLE_TEACHER') %}
                    <ul class="navbar-nav" aria-label="{{ 'mainNavLabel'|trans }}">
                        {# Hidden (menu-only, no route/backend change) for admin/staff/staff-lead per
                           explicit product request - staff land on Gestion/Campus instead. #}
                        {% if not (is_granted('ROLE_ADMIN') or is_granted('ROLE_STAFF') or is_granted('ROLE_STAFF-LEAD')) %}
                            <li class="nav-item {{ current_route == 'app_home' ? 'active' }}">
                                <a class="nav-link" href="{{ path('app_home') }}"{{ current_route == 'app_home' ? ' aria-current="page"' }}>
                                    <span class="nav-link-title">{{ 'homeNavLabel'|trans }}</span>
                                </a>
                            </li>
                        {% endif %}
                        {% set student_programs = is_granted('ROLE_STUDENT') and not is_staff() ? student_nav_programs() : [] %}
                        {% set student_has_timetable = student_programs|filter(p => p.timetableManagementEnabled)|length > 0 %}
                        {% if student_has_timetable %}
                            <li class="nav-item {{ current_route == 'app_my_timetable' or current_route == 'app_program_timetable' ? 'active' }}">
                                <a class="nav-link" href="{{ path('app_my_timetable') }}"{{ current_route == 'app_my_timetable' ? ' aria-current="page"' }}>
                                    <span class="nav-link-title">{{ 'programTimetableNavLabel'|trans }}</span>
                                </a>
                            </li>
                        {% endif %}
                        {# Right after "Emploi du temps", where mockup 3c puts it. Students only:
                           staff have the Travaux list on the Campus side, which is neither the same
                           screen nor the same question. #}
                        {% if is_granted('ROLE_STUDENT') and not is_staff() %}
                            <li class="nav-item {{ current_route starts with 'app_student_work' ? 'active' }}">
                                <a class="nav-link" href="{{ path('app_student_work') }}"{{ current_route starts with 'app_student_work' ? ' aria-current="page"' }}>
                                    <span class="nav-link-title">{{ 'studentWorkNavLabel'|trans }}</span>
                                </a>
                            </li>
                        {% endif %}
                        {% if is_pure_student %}
                            {# The "Tools" entry of the School mail mockup (screen 3a): the external
                               mailbox and the application tracking, student-only - these are their
                               mails and their applications; staff see them through the class
                               screens (1a/2a). Sits between "Travail à faire" and "Agenda", the
                               student bar reading Accueil · Emploi du temps · Travail à faire ·
                               Outils · Agenda · Support. #}
                            {% set student_tools_is_active = current_route starts with 'app_school_mail' or current_route starts with 'app_training_' or current_route == 'app_my_job_applications' %}
                            <li class="nav-item dropdown {{ student_tools_is_active ? 'active' }}">
                                <a class="nav-link dropdown-toggle" href="#navbar-student-tools" data-bs-toggle="dropdown" data-bs-auto-close="outside" role="button" aria-expanded="false"{{ student_tools_is_active ? ' aria-current="page"' }}>
                                    <span class="nav-link-title">{{ 'studentToolsNavLabel'|trans }}</span>
                                </a>
                                <div class="dropdown-menu">
                                    <a class="dropdown-item {{ current_route starts with 'app_school_mail' or current_route starts with 'app_training_' ? 'active' }}" href="{{ path('app_school_mail') }}">{{ 'schoolMailNavLabel'|trans }}</a>
                                    <a class="dropdown-item {{ current_route == 'app_my_job_applications' ? 'active' }}" href="{{ path('app_my_job_applications') }}">{{ 'jobApplicationsNavLabel'|trans }}</a>
                                </div>
                            </li>
                        {% endif %}
                        {% if not is_pure_student %}
                        {% for section in structure_nav_sections() %}
                            {% set section_school_year_groups = structure_nav_school_year_groups(section) %}
                            {# Staff see every Section unconditionally (even an empty one); a student/teacher
                               only sees a Section that leads to at least one Program they're actually linked
                               to - structure_nav_school_year_groups() already filters down to those, see
                               App\Security\StructureAccessChecker::isProgramVisible(). #}
                            {% if is_staff() or section_school_year_groups|length > 0 %}
                                <li class="nav-item dropdown {{ current_program_section_id == section.id ? 'active' }}">
                                    <a class="nav-link dropdown-toggle" href="#nav-section-{{ section.id }}" data-bs-toggle="dropdown" data-bs-auto-close="outside" role="button" aria-expanded="false"{{ current_program_section_id == section.id ? ' aria-current="page"' }}>
                                        {% if section.icon %}
                                            <span class="nav-link-icon">
                                                <svg class="icon"><use href="{{ asset('icons/tabler-sprite.svg') }}#tabler-icon-{{ section.icon }}"></use></svg>
                                            </span>
                                        {% endif %}
                                        <span class="nav-link-title">{{ section.name }}</span>
                                    </a>
                                    <div class="dropdown-menu">
                                        {# « Travaux » (design_handoff_creation_travail 2b) ouvre le menu, avant les
                                           formations : c'est une vision multiclasse, elle ne se range donc sous
                                           aucune d'elles. Réservée à qui donne du travail - enseignants et
                                           personnel - les étudiants ayant leur propre entrée « Mon travail »
                                           dans le sous-menu de leur formation. #}
                                        {% if loop.first and (is_granted('ROLE_TEACHER') or is_staff()) %}
                                            <a class="dropdown-item {{ current_route starts with 'app_assignment' ? 'active' }}" href="{{ path('app_assignments') }}">{{ 'assignmentsListPageHeading'|trans }}</a>
                                            <div class="dropdown-divider"></div>
                                        {% endif %}
                                        {% for group in section_school_year_groups %}
                                            {% if group.schoolYear %}
                                                <h6 class="dropdown-header">{{ group.schoolYear.startDate|date('Y') }} - {{ group.schoolYear.endDate|date('Y') }}</h6>
                                            {% else %}
                                                <h6 class="dropdown-header">{{ 'testZoneNavLabel'|trans }}</h6>
                                            {% endif %}
                                            {% for program in group.programs %}
                                                <div class="dropend">
                                                    <a class="dropdown-item dropdown-toggle {{ current_route starts with 'app_program_' and app.request.attributes.get('id') == program.id ? 'active' }}" href="#nav-program-{{ program.id }}" data-bs-toggle="dropdown" data-bs-auto-close="outside" role="button" aria-expanded="false">
                                                        {{ program.displayShortName }}
                                                    </a>
                                                    <div class="dropdown-menu">
                                                        <a class="dropdown-item {{ current_route == 'app_program_students' and app.request.attributes.get('id') == program.id ? 'active' }}" href="{{ path('app_program_students', {id: program.id}) }}">{{ 'programStudentsNavLabel'|trans }}</a>
                                                        <a class="dropdown-item {{ current_route == 'app_program_teachers' and app.request.attributes.get('id') == program.id ? 'active' }}" href="{{ path('app_program_teachers', {id: program.id}) }}">{{ 'programTeachersNavLabel'|trans }}</a>
                                                        {% if program.timetableManagementEnabled and visibility_allows(program.timetableVisibility) %}
                                                            <a class="dropdown-item {{ current_route == 'app_program_timetable' and app.request.attributes.get('id') == program.id ? 'active' }}" href="{{ path('app_program_timetable', {id: program.id}) }}">{{ 'programTimetableNavLabel'|trans }}</a>
                                                        {% endif %}
                                                        {# Staff-only since the per-role bars: the teacher Campus menu is limited to the
                                                           seven rubriques of design_handoff_dashboards §2 (Étudiants, Enseignants, EDT,
                                                           Carnet de notes, Calendrier d'alternance, Outils, Syllabus) - teachers still
                                                           run quizzes from the Bibliothèque quiz in the user menu. #}
                                                        {% if is_staff() and program_has_quiz_instances(program) %}
                                                            <a class="dropdown-item {{ current_route == 'app_program_quiz' or current_route == 'app_program_quiz_show' ? 'active' }}" href="{{ path('app_program_quiz', {id: program.id}) }}">{{ 'programQuizNavLabel'|trans }}</a>
                                                        {% endif %}
                                                        {# Same route for teacher (editable grid) and student (read-only carnet) - ProgramGradebookController::grid() branches by role itself, so this one flat entry (no is_program_teacher/ROLE_STUDENT split, unlike the Outils/My-* entries around it) covers both. #}
                                                        {% if program.timetableManagementEnabled %}
                                                            <a class="dropdown-item {{ current_route starts with 'app_program_gradebook' and app.request.attributes.get('id') == program.id ? 'active' }}" href="{{ path('app_program_gradebook', {id: program.id}) }}">{{ 'gradebookNavLabel'|trans }}</a>
                                                        {% endif %}
                                                        {% if visibility_allows(program.alternanceCalendarVisibility) %}
                                                            {# Same route in both alternanceCalendarMode cases - the controller redirects to the
                                                               uploaded PDF instead of generating one when mode is File - so still no "active"
                                                               state to track here, unlike the page-based nav entries around it. Opens in a new
                                                               tab only in File mode, since that's a redirect straight out to an external S3/
                                                               CloudFront URL, not an in-app page. #}
                                                            <a class="dropdown-item" href="{{ path('app_program_alternance_calendar_pdf', {id: program.id}) }}"{% if program.alternanceCalendarMode.value == 'file' %} target="_blank" rel="noopener"{% endif %}>{{ 'programAlternanceCalendarNavLabel'|trans }}</a>
                                                        {% endif %}
                                                        {# Screen 1a: a whole class's correspondence with companies, so staff and
                                                           teachers only - never the students it is about. #}
                                                        {% if is_staff() or is_program_teacher(program) %}
                                                            <a class="dropdown-item {{ current_route starts with 'app_program_job_search' and app.request.attributes.get('id') == program.id ? 'active' }}" href="{{ path('app_program_job_searches', {id: program.id}) }}">{{ 'jobSearchTrackingNavLabel'|trans }}</a>
                                                        {% endif %}
                                                        {% if is_program_teacher(program) %}
                                                            <div class="dropend">
                                                                <a class="dropdown-item dropdown-toggle {{ current_route starts with 'app_program_tools' and app.request.attributes.get('id') == program.id ? 'active' }}" href="#nav-program-tools-{{ program.id }}" data-bs-toggle="dropdown" data-bs-auto-close="outside" role="button" aria-expanded="false">
                                                                    {{ 'programToolsNavLabel'|trans }}
                                                                </a>
                                                                <div class="dropdown-menu">
                                                                    <a class="dropdown-item {{ current_route == 'app_program_tools_random_draw' and app.request.attributes.get('id') == program.id ? 'active' }}" href="{{ path('app_program_tools_random_draw', {id: program.id}) }}">{{ 'programToolsRandomDrawNavLabel'|trans }}</a>
                                                                    <a class="dropdown-item {{ current_route == 'app_program_tools_group_creation' and app.request.attributes.get('id') == program.id ? 'active' }}" href="{{ path('app_program_tools_group_creation', {id: program.id}) }}">{{ 'programToolsGroupCreationNavLabel'|trans }}</a>
                                                                    {# The second way into audio recordings: the class is known, so the list is filtered on it
                                                                       and step 1 of creation preselects it. #}
                                                                    <a class="dropdown-item {{ current_route == 'app_program_tools_audio_recordings' and app.request.attributes.get('id') == program.id ? 'active' }}" href="{{ path('app_program_tools_audio_recordings', {id: program.id}) }}">{{ 'audioRecordingsNavLabel'|trans }}</a>
                                                                </div>
                                                            </div>
                                                        {% endif %}
                                                        {% if visibility_allows(program.syllabusVisibility) %}
                                                            <a class="dropdown-item {{ current_route == 'app_program_syllabus' and app.request.attributes.get('id') == program.id ? 'active' }}" href="{{ path('app_program_syllabus', {id: program.id}) }}"{% if program.syllabusMode.value == 'file' %} target="_blank" rel="noopener"{% endif %}>{{ 'programSyllabusNavLabel'|trans }}</a>
                                                        {% endif %}
                                                        {% if is_granted('ROLE_ADMIN') and program.timetableManagementEnabled %}
                                                            <a class="dropdown-item {{ current_route starts with 'app_program_sequence' and app.request.attributes.get('id') == program.id ? 'active' }}" href="{{ path('app_program_sequences', {id: program.id}) }}">{{ 'programSequencesNavLabel'|trans }}</a>
                                                        {% endif %}
                                                        {% if is_staff() %}
                                                            {% if program.financialManagementEnabled %}
                                                                <a class="dropdown-item {{ current_route == 'app_program_reporting' and app.request.attributes.get('id') == program.id ? 'active' }}" href="{{ path('app_program_reporting', {id: program.id}) }}">{{ 'programReportingNavLabel'|trans }}</a>
                                                            {% endif %}
                                                            <a class="dropdown-item {{ current_route starts with 'app_program_exports' and app.request.attributes.get('id') == program.id ? 'active' }}" href="{{ path('app_program_exports', {id: program.id}) }}">{{ 'programExportsNavLabel'|trans }}</a>
                                                            <div class="dropend">
                                                                <a class="dropdown-item dropdown-toggle {{ (current_route starts with 'app_program_settings' or current_route starts with 'app_program_timetable_settings') and app.request.attributes.get('id') == program.id ? 'active' }}" href="#nav-program-settings-{{ program.id }}" data-bs-toggle="dropdown" data-bs-auto-close="outside" role="button" aria-expanded="false">
                                                                    {{ 'programSettingsNavLabel'|trans }}
                                                                </a>
                                                                <div class="dropdown-menu">
                                                                    <a class="dropdown-item {{ current_route starts with 'app_program_settings' and app.request.attributes.get('id') == program.id ? 'active' }}" href="{{ path('app_program_settings', {id: program.id}) }}">{{ 'programSettingsProgramNavLabel'|trans }}</a>
                                                                    {% if program.timetableManagementEnabled %}
                                                                        <a class="dropdown-item {{ current_route starts with 'app_program_timetable_settings' and app.request.attributes.get('id') == program.id ? 'active' }}" href="{{ path('app_program_timetable_settings', {id: program.id}) }}">{{ 'programSettingsTimetableTabLabel'|trans }}</a>
                                                                    {% endif %}
                                                                    {% if program.assignmentManagementEnabled %}
                                                                        <a class="dropdown-item {{ current_route starts with 'app_program_assignments' and app.request.attributes.get('id') == program.id ? 'active' }}" href="{{ path('app_program_assignments', {id: program.id}) }}">{{ 'programAssignmentsNavLabel'|trans }}</a>
                                                                    {% endif %}
                                                                </div>
                                                            </div>
                                                        {% endif %}
                                                        {% if is_granted('ROLE_STUDENT') and program.internshipManagementEnabled %}
                                                            <a class="dropdown-item {{ current_route starts with 'app_program_internship_my_evaluation' and app.request.attributes.get('id') == program.id ? 'active' }}" href="{{ path('app_program_internship_my_evaluations', {id: program.id}) }}">{{ 'programInternshipMyEvaluationsNavLabel'|trans }}</a>
                                                        {% endif %}
                                                        {% if is_granted('ROLE_STUDENT') and program.assignmentManagementEnabled %}
                                                            <a class="dropdown-item {{ current_route starts with 'app_program_my_assignment' and app.request.attributes.get('id') == program.id ? 'active' }}" href="{{ path('app_program_my_assignments', {id: program.id}) }}">{{ 'programMyAssignmentsNavLabel'|trans }}</a>
                                                        {% endif %}
                                                        {% if is_granted('ROLE_STUDENT') and program_has_quiz_instances(program) %}
                                                            <a class="dropdown-item {{ current_route starts with 'app_program_quiz_' and current_route != 'app_program_quiz_show' and app.request.attributes.get('id') == program.id ? 'active' }}" href="{{ path('app_program_quiz_mine', {id: program.id}) }}">{{ 'programQuizNavLabel'|trans }}</a>
                                                        {% endif %}
                                                    </div>
                                                </div>
                                            {% endfor %}
                                        {% endfor %}
                                    </div>
                                </li>
                            {% endif %}
                        {% endfor %}
                        {% endif %}
                        {% if is_granted('ROLE_ADMIN') or is_granted('ROLE_STAFF') or is_granted('ROLE_STAFF-LEAD') %}
                            <li class="nav-item dropdown {{ current_route starts with 'app_ufa' or current_route starts with 'app_laptops' ? 'active' }}">
                                <a class="nav-link dropdown-toggle" href="#navbar-ufa" data-bs-toggle="dropdown" data-bs-auto-close="outside" role="button" aria-expanded="false"{{ (current_route starts with 'app_ufa' or current_route starts with 'app_laptops') ? ' aria-current="page"' }}>
                                    <span class="nav-link-title">{{ 'ufaNavLabel'|trans }}</span>
                                </a>
                                <div class="dropdown-menu">
                                    <a class="dropdown-item {{ current_route == 'app_ufa' ? 'active' }}" href="{{ path('app_ufa') }}">{{ 'ufaDashboardNavLabel'|trans }}</a>
                                    {% set ufa_formations_list = ufa_nav_formations() %}
                                    {# Purement une liste : aucune entrée "Nouvelle UFA" ici, on ne crée pas d'UFA.
                                       Une UFA est une formation portant la modalité alternance, donc elle naît des
                                       écrans de paramétrage pédagogique et apparaît ici toute seule. #}
                                    <div class="dropend">
                                        <a class="dropdown-item dropdown-toggle {{ current_route starts with 'app_ufa_formation' ? 'active' }}" href="#navbar-ufa-formations" data-bs-toggle="dropdown" data-bs-auto-close="outside" role="button" aria-expanded="false">
                                            {{ 'ufaFormationsNavLabel'|trans }}
                                        </a>
                                        <div class="dropdown-menu">
                                            {# Formations réelles, puis les formations de test isolées sous leur
                                               propre en-tête - même disposition que les groupes du menu Section
                                               plus haut. L'en-tête n'apparaît que s'il y a quelque chose dessous. #}
                                            {% for formation in ufa_formations_list.regular %}
                                                <a class="dropdown-item {{ current_route starts with 'app_ufa_formation' and app.request.attributes.get('id') == formation.id ? 'active' }}" href="{{ path('app_ufa_formation_evaluation_periods', {id: formation.id}) }}">{{ formation.displayShortName }}</a>
                                            {% endfor %}
                                            {% if ufa_formations_list.test|length > 0 %}
                                                <h6 class="dropdown-header">{{ 'testZoneNavLabel'|trans }}</h6>
                                                {% for formation in ufa_formations_list.test %}
                                                    <a class="dropdown-item {{ current_route starts with 'app_ufa_formation' and app.request.attributes.get('id') == formation.id ? 'active' }}" href="{{ path('app_ufa_formation_evaluation_periods', {id: formation.id}) }}">{{ formation.displayShortName }}</a>
                                                {% endfor %}
                                            {% endif %}
                                        </div>
                                    </div>
                                    <div class="dropend">
                                        <a class="dropdown-item dropdown-toggle {{ current_route starts with 'app_ufa_configuration' ? 'active' }}" href="#navbar-ufa-configuration" data-bs-toggle="dropdown" data-bs-auto-close="outside" role="button" aria-expanded="false">
                                            {{ 'ufaConfigurationNavLabel'|trans }}
                                        </a>
                                        <div class="dropdown-menu">
                                            <a class="dropdown-item {{ current_route starts with 'app_ufa_configuration_formation_center' ? 'active' }}" href="{{ path('app_ufa_configuration_formation_center') }}">{{ 'ufaConfigurationFormationCenterNavLabel'|trans }}</a>
                                            <a class="dropdown-item {{ current_route starts with 'app_ufa_configuration_contract_modalities' ? 'active' }}" href="{{ path('app_ufa_configuration_contract_modalities') }}">{{ 'ufaConfigurationContractModalitiesNavLabel'|trans }}</a>
                                            <a class="dropdown-item {{ current_route starts with 'app_ufa_configuration_behavior' ? 'active' }}" href="{{ path('app_ufa_configuration_behavior') }}">{{ 'ufaConfigurationBehaviorNavLabel'|trans }}</a>
                                        </div>
                                    </div>
                                    <h6 class="dropdown-header">{{ 'ufaEquipmentGroupLabel'|trans }}</h6>
                                    <div class="dropend">
                                        <a class="dropdown-item dropdown-toggle {{ current_route starts with 'app_laptops' ? 'active' }}" href="#navbar-ufa-laptops" data-bs-toggle="dropdown" data-bs-auto-close="outside" role="button" aria-expanded="false">
                                            {{ 'ufaLaptopsNavLabel'|trans }}
                                        </a>
                                        <div class="dropdown-menu">
                                            <a class="dropdown-item {{ current_route starts with 'app_laptops_loans' ? 'active' }}" href="{{ path('app_laptops_loans') }}">{{ 'ufaLaptopsLoansNavLabel'|trans }}</a>
                                            <a class="dropdown-item {{ current_route == 'app_laptops' ? 'active' }}" href="{{ path('app_laptops') }}">{{ 'ufaLaptopsInventoryNavLabel'|trans }}</a>
                                            <a class="dropdown-item {{ current_route starts with 'app_laptops_configuration' ? 'active' }}" href="{{ path('app_laptops_configuration') }}">{{ 'ufaLaptopsConfigurationNavLabel'|trans }}</a>
                                        </div>
                                    </div>
                                </div>
                            </li>
                        {% endif %}
                        {# The teacher's tool menu (handoff design_handoff_menu_outils): ONE flat panel,
                           no submenu, split into three named groups - what one runs live in class,
                           what one prepares beforehand, what one follows up afterwards. Text labels
                           only, no icons, per the main-menu rule.

                           Some of these tools are multi-class by nature and open straight from here
                           (audio recordings, progression, the sequence and quiz libraries, the student
                           work list); the others only work on one class and go through
                           App\Controller\ToolsController's picker first, since the top bar does not
                           know which class is meant. Reached from a class's own submenu instead, they
                           get it from the URL and never pass through the picker.

                           Gated to teachers and staff, not merely "not a student": every entry here
                           is a teaching tool, and its own controller already refuses anyone else -
                           showing the menu to, say, a tutor only bought them a 403.

                           Namesake of the student "Outils" menu further down, which has nothing to do
                           with this one - the two never show for the same person. #}
                        {% if is_granted('ROLE_TEACHER') or is_staff() %}
                            {% set tools_is_active = current_route starts with 'app_tools_'
                                or current_route starts with 'app_audio_recording'
                                or current_route starts with 'app_progression'
                                or current_route starts with 'app_library_' %}
                            <li class="nav-item dropdown {{ tools_is_active ? 'active' }}">
                                <a class="nav-link dropdown-toggle" href="#navbar-tools" data-bs-toggle="dropdown" data-bs-auto-close="outside" role="button" aria-expanded="false"{{ tools_is_active ? ' aria-current="page"' }}>
                                    <span class="nav-link-title">{{ 'toolsNavLabel'|trans }}</span>
                                </a>
                                <div class="dropdown-menu cm-toolsmenu">
                                    <h6 class="dropdown-header">{{ 'toolsGroupRunClassLabel'|trans }}</h6>
                                    <a class="dropdown-item {{ current_route == 'app_tools_random_draw' ? 'active' }}" href="{{ path('app_tools_random_draw') }}">{{ 'programToolsRandomDrawNavLabel'|trans }}</a>
                                    <a class="dropdown-item {{ current_route == 'app_tools_group_creation' ? 'active' }}" href="{{ path('app_tools_group_creation') }}">{{ 'programToolsGroupCreationNavLabel'|trans }}</a>
                                    <div class="dropdown-divider"></div>
                                    <h6 class="dropdown-header">{{ 'toolsGroupPrepareContentLabel'|trans }}</h6>
                                    <a class="dropdown-item {{ current_route starts with 'app_progression' ? 'active' }}" href="{{ path('app_progression') }}">{{ 'progressionNavLabel'|trans }}</a>
                                    <a class="dropdown-item {{ current_route starts with 'app_library_sequences' or current_route starts with 'app_library_seances' or current_route starts with 'app_library_phases' ? 'active' }}" href="{{ path('app_library_sequences') }}">{{ 'libraryNavLabel'|trans }}</a>
                                    <a class="dropdown-item {{ current_route starts with 'app_library_quiz' ? 'active' }}" href="{{ path('app_library_quiz') }}">{{ 'libraryQuizNavLabel'|trans }}</a>
                                    <a class="dropdown-item {{ current_route starts with 'app_audio_recording' ? 'active' }}" href="{{ path('app_audio_recordings') }}">{{ 'audioRecordingsNavLabel'|trans }}</a>
                                    <div class="dropdown-divider"></div>
                                    <h6 class="dropdown-header">{{ 'toolsGroupFollowStudentsLabel'|trans }}</h6>
                                    <a class="dropdown-item {{ current_route == 'app_tools_lesson_log' ? 'active' }}" href="{{ path('app_tools_lesson_log') }}">{{ 'lessonLogPageHeading'|trans }}</a>
                                    <a class="dropdown-item" href="{{ path('app_assignments') }}">{{ 'toolsStudentWorkNavLabel'|trans }}</a>
                                    <a class="dropdown-item {{ current_route == 'app_tools_gradebook' ? 'active' }}" href="{{ path('app_tools_gradebook') }}">{{ 'gradebookNavLabel'|trans }}</a>
                                </div>
                            </li>
                        {% endif %}
                        {# "Support mène à la vue utilisateur des tickets, pas à la console" (§3) -
                           top-level for étudiant/enseignant/staff; the admin bar has no Support tab
                           (tickets stay reachable via Gestion). Before Agenda for enseignant/staff,
                           after it for the étudiant, matching the per-profile bar order. #}
                        {% set support_is_active = current_route starts with 'app_tickets' and current_route != 'app_tickets_queue' and current_route != 'app_tickets_queue_categories' %}
                        {% if not is_granted('ROLE_ADMIN') and not is_pure_student %}
                            <li class="nav-item {{ support_is_active ? 'active' }}">
                                <a class="nav-link" href="{{ path('app_tickets') }}"{{ support_is_active ? ' aria-current="page"' }}>
                                    <span class="nav-link-title">{{ 'supportNavLabel'|trans }}</span>
                                </a>
                            </li>
                        {% endif %}
                        <li class="nav-item {{ current_route starts with 'app_agenda' ? 'active' }}">
                            <a class="nav-link" href="{{ path('app_agenda') }}"{{ current_route starts with 'app_agenda' ? ' aria-current="page"' }}>
                                <span class="nav-link-title">{{ 'agendaNavLabel'|trans }}</span>
                            </a>
                        </li>
                        {% if is_pure_student %}
                            <li class="nav-item {{ support_is_active ? 'active' }}">
                                <a class="nav-link" href="{{ path('app_tickets') }}"{{ support_is_active ? ' aria-current="page"' }}>
                                    <span class="nav-link-title">{{ 'supportNavLabel'|trans }}</span>
                                </a>
                            </li>
                            {% set student_alternance_program = student_nav_alternance_program() %}
                            {% if student_alternance_program %}
                                <li class="nav-item {{ current_route starts with 'app_my_alternance' ? 'active' }}">
                                    <a class="nav-link" href="{{ path('app_my_alternance') }}"{{ current_route starts with 'app_my_alternance' ? ' aria-current="page"' }}>
                                        <span class="nav-link-title">{{ 'myAlternanceNavLabel'|trans }}</span>
                                    </a>
                                </li>
                            {% endif %}
                        {% endif %}
                        {# Top-level item, deliberately not nested under Gestion (unlike the mockup's generic
                           header) - visual-only, menu-only gate to ROLE_ADMIN per explicit product request
                           (tighter than EcoParcoursController's own ROLE_ECO/staff access-control, which is
                           unchanged - this only hides the link, it doesn't restrict the route). #}
                        {% if is_granted('ROLE_ADMIN') %}
                            <li class="nav-item {{ current_route starts with 'app_eco_' ? 'active' }}">
                                <a class="nav-link" href="{{ path('app_eco_parcours') }}"{{ current_route starts with 'app_eco_' ? ' aria-current="page"' }}>
                                    <span class="nav-link-title">{{ 'ecoNavLabel'|trans }}</span>
                                </a>
                            </li>
                        {% endif %}
                        {# Whole dropdown (including "Application mobile", previously visible to everyone)
                           is now visual-only, menu-only gated to ROLE_ADMIN per explicit product request -
                           ResourcesController's own routes are unchanged/still reachable directly. #}
                        {% if is_granted('ROLE_ADMIN') %}
                            <li class="nav-item dropdown {{ current_route starts with 'app_resources_' ? 'active' }}">
                                <a class="nav-link dropdown-toggle" href="#navbar-resources" data-bs-toggle="dropdown" data-bs-auto-close="outside" role="button" aria-expanded="false"{{ current_route starts with 'app_resources_' ? ' aria-current="page"' }}>
                                    <span class="nav-link-title">{{ 'resourcesNavLabel'|trans }}</span>
                                </a>
                                <div class="dropdown-menu">
                                    <a class="dropdown-item {{ current_route == 'app_resources_mobile' ? 'active' }}" href="{{ path('app_resources_mobile') }}">{{ 'resourcesMobileAppNavLabel'|trans }}</a>
                                    <a class="dropdown-item {{ current_route == 'app_resources_eco' ? 'active' }}" href="{{ path('app_resources_eco') }}">{{ 'resourcesEcoAppNavLabel'|trans }}</a>
                                </div>
                            </li>
                        {% endif %}
                        {# Staff/admin only since the per-role bars (§3) - étudiant/enseignant reach
                           their tickets through the top-level Support tab instead, and lose the
                           other Gestion entries entirely. Active state deliberately excludes the
                           user-facing app_tickets* routes, which now light the Support tab. #}
                        {% if is_granted('ROLE_ADMIN') or is_granted('ROLE_STAFF') or is_granted('ROLE_STAFF-LEAD') %}
                        {% set gestion_is_active = current_route in ['app_tickets_queue', 'app_tickets_queue_categories'] or (is_granted('ROLE_ADMIN') and support_is_active) or current_route starts with 'app_directory_' or current_route starts with 'app_signup_lists' or current_route starts with 'app_school_mail_unlinked' or current_route starts with 'app_training_offer' %}
                        <li class="nav-item dropdown {{ gestion_is_active ? 'active' }}">
                            <a class="nav-link dropdown-toggle" href="#navbar-gestion" data-bs-toggle="dropdown" data-bs-auto-close="outside" role="button" aria-expanded="false"{{ gestion_is_active ? ' aria-current="page"' }}>
                                <span class="nav-link-title">{{ 'gestionNavLabel'|trans }}</span>
                            </a>
                            <div class="dropdown-menu">
                                {# Stage/Alternance, added for the practice application workflow
                                   (design_handoff_workflow_postulation, screen 7a): the fictitious
                                   offers students apply to in order to unlock their mailbox. #}
                                {% set internship_group_is_active = current_route starts with 'app_training_offer' or current_route starts with 'app_school_mail_unlinked' %}
                                <div class="dropend">
                                    <a class="dropdown-item dropdown-toggle {{ internship_group_is_active ? 'active' }}" href="#gestion-internship" data-bs-toggle="dropdown" data-bs-auto-close="outside" role="button" aria-expanded="false">
                                        {{ 'internshipAlternanceGroupNavLabel'|trans }}
                                    </a>
                                    <div class="dropdown-menu">
                                        <a class="dropdown-item {{ current_route starts with 'app_training_offer' ? 'active' }}" href="{{ path('app_training_offers') }}">{{ 'trainingOffersNavLabel'|trans }}</a>
                                        {# Screen 5a: admins only, as the mockup states in as many words -
                                           this queue holds other people's incoming mail. It belongs to the
                                           same corner of the app as the offers: everything school mail. #}
                                        {% if is_granted('ROLE_ADMIN') %}
                                            <a class="dropdown-item {{ current_route starts with 'app_school_mail_unlinked' ? 'active' }}" href="{{ path('app_school_mail_unlinked') }}">{{ 'schoolMailUnlinkedNavLabel'|trans }}</a>
                                        {% endif %}
                                    </div>
                                </div>
                                <div class="dropend">
                                    <a class="dropdown-item dropdown-toggle {{ current_route starts with 'app_tickets' ? 'active' }}" href="#gestion-tickets" data-bs-toggle="dropdown" data-bs-auto-close="outside" role="button" aria-expanded="false">
                                        {{ 'ticketsGroupNavLabel'|trans }}
                                    </a>
                                    <div class="dropdown-menu">
                                        <a class="dropdown-item {{ current_route starts with 'app_tickets' and current_route != 'app_tickets_queue' and current_route != 'app_tickets_queue_categories' ? 'active' }}" href="{{ path('app_tickets') }}">{{ 'myTicketsNavLabel'|trans }}</a>
                                        {% if is_granted('ROLE_ADMIN') or is_granted('ROLE_STAFF') or is_granted('ROLE_STAFF-LEAD') or is_granted('ROLE_SUPPORT-TECH') %}
                                            <a class="dropdown-item {{ current_route == 'app_tickets_queue' or current_route == 'app_tickets_queue_categories' ? 'active' }}" href="{{ path('app_tickets_queue') }}">{{ 'ticketQueueNavLabel'|trans }}</a>
                                        {% endif %}
                                    </div>
                                </div>
                                {# Deliberately a flat link outside the staff-only block below, unlike Laptops/
                                   Directory - students/teachers need to reach it too, to register/view lists
                                   they're eligible for (see App\Controller\SignupListController), not just staff
                                   to manage them. #}
                                <a class="dropdown-item {{ current_route starts with 'app_signup_lists' ? 'active' }}" href="{{ path('app_signup_lists') }}">{{ 'signupListsNavLabel'|trans }}</a>
                                {% if is_granted('ROLE_ADMIN') or is_granted('ROLE_STAFF') or is_granted('ROLE_STAFF-LEAD') %}
                                    <div class="dropend">
                                        <a class="dropdown-item dropdown-toggle {{ current_route starts with 'app_directory_' ? 'active' }}" href="#gestion-directory" data-bs-toggle="dropdown" data-bs-auto-close="outside" role="button" aria-expanded="false">
                                            {{ 'directoryNavLabel'|trans }}
                                        </a>
                                        <div class="dropdown-menu">
                                            <a class="dropdown-item" href="{{ path('app_directory_groups') }}">{{ 'directoryGroupsNavLabel'|trans }}</a>
                                            <a class="dropdown-item" href="{{ path('app_directory_users') }}">{{ 'directoryUsersNavLabel'|trans }}</a>
                                            <a class="dropdown-item" href="{{ path('app_directory_passwords') }}">{{ 'directoryPasswordsNavLabel'|trans }}</a>
                                            {# Admin-only, stricter than the rest of this dropend (staff/staff-lead too) - see
                                               DirectoryServiceController/DirectoryComputerController. #}
                                            {% if is_granted('ROLE_ADMIN') %}
                                                <a class="dropdown-item" href="{{ path('app_directory_services') }}">{{ 'directoryServicesNavLabel'|trans }}</a>
                                                <a class="dropdown-item" href="{{ path('app_directory_computers') }}">{{ 'directoryComputersNavLabel'|trans }}</a>
                                            {% endif %}
                                        </div>
                                    </div>
                                {% endif %}
                            </div>
                        </li>
                        {% endif %}
                        {% if is_granted('ROLE_ADMIN') or is_granted('ROLE_STAFF') or is_granted('ROLE_STAFF-LEAD') %}
                            <li class="nav-item dropdown {{ current_route starts with 'app_settings_' ? 'active' }}">
                                <a class="nav-link dropdown-toggle" href="#navbar-settings" data-bs-toggle="dropdown" data-bs-auto-close="outside" role="button" aria-expanded="false"{{ current_route starts with 'app_settings_' ? ' aria-current="page"' }}>
                                    <span class="nav-link-title">{{ 'settingsNavLabel'|trans }}</span>
                                </a>
                                <div class="dropdown-menu">
                                    <a class="dropdown-item {{ current_route in ['app_settings_structure_sections', 'app_settings_structure_tracks', 'app_settings_structure_cohorts', 'app_settings_structure_rooms', 'app_settings_structure_options', 'app_settings_structure_modalities', 'app_settings_structure_lesson_types', 'app_settings_structure_skill_levels'] ? 'active' }}" href="{{ path('app_settings_configuration') }}">{{ 'settingsConfigurationNavLabel'|trans }}</a>
                                    <a class="dropdown-item {{ current_route in ['app_settings_structure_school_years', 'app_settings_structure_programs', 'app_settings_structure_periods'] ? 'active' }}" href="{{ path('app_settings_pedagogique') }}">{{ 'settingsPedagogiqueNavLabel'|trans }}</a>
                                    {% if is_granted('ROLE_ADMIN') %}
                                        <a class="dropdown-item {{ current_route starts with 'app_settings_groups' ? 'active' }}" href="{{ path('app_settings_groups') }}">{{ 'settingsGroupsNavLabel'|trans }}</a>
                                    {% endif %}
                                </div>
                            </li>
                        {% endif %}
                    </ul>
                </div>
            </div>
        </header>
        {% set current_test_program = structure_nav_current_test_program() %}
        {% if current_test_program %}
            {# .alert (Tabler) is display:flex, so text-center alone doesn't center a lone <strong>
               flex item - justify-content-center is what actually centers it. #}
            <div class="alert alert-warning mb-0 rounded-0 text-center justify-content-center d-print-none" role="alert">
                <strong>{{ 'testProgramBannerText'|trans({'%name%': current_test_program.displayShortName}) }}</strong>
            </div>
        {% endif %}
        <div class="page-wrapper">
            {% block page_header %}
                <div class="page-header d-print-none">
                    <div class="container-xl">
                        {# Every screen, root pages included since 2026-08-05: the dashboard opens on a
                           lone "Accueil" segment, and a menu root on "Accueil › <page>", so that no
                           page starts lower on the screen than its neighbours. Each segment,
                           including the current page, is a real <a href> (design/design_campus_manager
                           convention: "chaque segment est un lien cliquable, y compris le dernier"). #}
                        {% block page_breadcrumb %}{% endblock %}
                        <div class="row g-2 align-items-center">
                            <div class="col">
                                <h2 class="page-title">{% block page_title %}{{ 'homePageHeading'|trans }}{% endblock %}</h2>
                            </div>
                            <div class="col-auto ms-auto">
                                <div class="btn-list">
                                    {% block page_actions %}{% endblock %}
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            {% endblock %}
            <div class="page-body">
                <div class="container-xl">
                    {% for label, messages in app.flashes %}
                        {% for message in messages %}
                            <div class="alert alert-{{ label == 'error' ? 'danger' : label }} alert-dismissible" role="alert">
                                {{ message|trans }}
                                <a class="btn-close" data-bs-dismiss="alert" aria-label="close"></a>
                            </div>
                        {% endfor %}
                    {% endfor %}
                    {% block main %}{% endblock %}
                </div>
            </div>
        </div>
    </div>
{% endblock %}
