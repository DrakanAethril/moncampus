                            {% set settings_is_active = current_route starts with 'app_settings_' or current_route starts with 'app_features' %}
                            <li class="nav-item dropdown {{ settings_is_active ? 'active' }}">
                                <a class="nav-link dropdown-toggle" href="#navbar-settings" data-bs-toggle="dropdown" data-bs-auto-close="outside" role="button" aria-expanded="false"{{ settings_is_active ? ' aria-current="page"' }}>
                                    <span class="nav-link-title">{{ 'settingsNavLabel'|trans }}</span>
                                </a>
                                <div class="dropdown-menu">
                                    <a class="dropdown-item {{ current_route in ['app_settings_structure_sections', 'app_settings_structure_tracks', 'app_settings_structure_cohorts', 'app_settings_structure_rooms', 'app_settings_structure_options', 'app_settings_structure_modalities', 'app_settings_structure_lesson_types', 'app_settings_structure_skill_levels'] ? 'active' }}" href="{{ path('app_settings_configuration') }}">{{ 'settingsConfigurationNavLabel'|trans }}</a>
                                    <a class="dropdown-item {{ current_route in ['app_settings_structure_school_years', 'app_settings_structure_programs', 'app_settings_structure_periods'] ? 'active' }}" href="{{ path('app_settings_pedagogique') }}">{{ 'settingsPedagogiqueNavLabel'|trans }}</a>
                                    {% if is_granted('ROLE_ADMIN') %}
                                        <a class="dropdown-item {{ current_route starts with 'app_settings_groups' ? 'active' }}" href="{{ path('app_settings_groups') }}">{{ 'settingsGroupsNavLabel'|trans }}</a>
                                        {# Administrators only, and it carries no feature guard of its
                                           own: no setting made here may close the screen the settings
                                           are made on (design/validated/feature-access.md §8.8), which
                                           is why the "admin has everything" rule is not negotiable. #}
                                        <a class="dropdown-item {{ current_route starts with 'app_features' ? 'active' }}" href="{{ path('app_features') }}">{{ 'featuresNavLabel'|trans }}</a>
                                        {% if feature('game') %}
                                            <a class="dropdown-item {{ current_route == 'app_settings_game_levels' ? 'active' }}" href="{{ path('app_settings_game_levels') }}">{{ 'gameLevelLabelsHeading'|trans }}</a>
                                            <a class="dropdown-item {{ current_route starts with 'app_settings_game_figures' ? 'active' }}" href="{{ path('app_settings_game_figures') }}">{{ 'gameFiguresHeading'|trans }}</a>
                                        {% endif %}
                                    {% endif %}
                                </div>
                            </li>
                        {% endif %}
                    </ul>
                </div>
            </div>
        </header>
        {# Students and teachers only, and permanently: the establishment keeps its school records in
           another tool, and this platform is the pedagogical one. Staff and administrators are the
           people who already know that, so the bar would only take a strip of screen from them.
           It sits above the « ZONE DE TEST » bar because it is a statement about the whole platform,
           not about the program being looked at. #}
        {% if is_granted('ROLE_STUDENT') or is_granted('ROLE_TEACHER') %}
            <div class="cm-globalnotice d-print-none" role="note">{{ 'pedagogicalUseBannerHtml'|trans|raw }}</div>
        {% endif %}
        {% set current_test_program = structure_nav_current_test_program() %}
        {% if current_test_program %}
            {# .alert (Tabler) is display:flex, so text-center alone doesn't center a lone <strong>
               flex item - justify-content-center is what actually centers it. #}
            <div class="alert alert-warning mb-0 rounded-0 text-center justify-content-center d-print-none" role="alert">
                <strong>{{ 'testProgramBannerText'|trans({'%name%': current_test_program.displayShortName}) }}</strong>
            </div>
        {% endif %}
        <div class="page-wrapper">
            {% block page_header %}
                <div class="page-header d-print-none">
                    <div class="container-xl">
                        {# Every screen, root pages included since 2026-08-05: the dashboard opens on a
                           lone "Accueil" segment, and a menu root on "Accueil › <page>", so that no
                           page starts lower on the screen than its neighbours. Each segment,
                           including the current page, is a real <a href> (design/design_campus_manager
                           convention: "chaque segment est un lien cliquable, y compris le dernier"). #}
                        {% block page_breadcrumb %}{% endblock %}
                        <div class="row g-2 align-items-center">
                            <div class="col">
                                <h2 class="page-title">{% block page_title %}{{ 'homePageHeading'|trans }}{% endblock %}</h2>
                            </div>
                            <div class="col-auto ms-auto">
                                <div class="btn-list">
                                    {% block page_actions %}{% endblock %}
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            {% endblock %}
            <div class="page-body">
                {# The one screen that needs the whole window rather than the reading column is the
                   machine console: a terminal is measured in columns, and a 1 200 px column would
                   cap it at about 130 of them whatever the screen. Overridable rather than a second
                   layout, so that every other screen keeps container-xl by simply not saying
                   anything - see templates/console/index.html.twig. #}
                <div class="{% block page_body_container %}container-xl{% endblock %}">
                    {% for label, messages in app.flashes %}
                        {% for message in messages %}
                            <div class="alert alert-{{ label == 'error' ? 'danger' : label }} alert-dismissible" role="alert">
                                {{ message|trans }}
                                <a class="btn-close" data-bs-dismiss="alert" aria-label="close"></a>
                            </div>
                        {% endfor %}
                    {% endfor %}
                    {% block main %}{% endblock %}
                </div>
            </div>
        </div>
    </div>
{% endblock %}
