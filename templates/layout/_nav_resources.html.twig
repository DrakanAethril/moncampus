{# The "Ressources" dropdown, included twice by layout/app.html.twig and rendered once.

   It is a partial because the entry sits in **two different places in the bar**: a pure student
   reads it right after « Travail à faire », the dropdown being the whole of their navigation since
   2026-08-17, while every other role keeps it after Agenda/Support where it has always been. Two
   positions, one menu - duplicating the block would let the two drift, and the drift would only
   show for the role that navigates least.

   The dropdown is open to everyone since the Base documentaire arrived
   (design_handoff_base_documentaire): the base is read by every role, and the menu that carries it
   must be too. Each entry keeps its own gate.

   Parameters (passed with `only`): current_route, is_pure_student. #}
{% set resources_is_active = current_route starts with 'app_resources_' or current_route starts with 'app_documentation' or current_route starts with 'app_wiki'
    or current_route starts with 'app_student_shared_document' or current_route starts with 'app_school_mail' or current_route starts with 'app_training_'
    or current_route == 'app_my_job_applications' or current_route starts with 'app_my_courses' %}
{# Each entry's condition is read once into a variable, and the same variables decide both whether
   the entry renders and whether the dropdown renders at all. Written the other way round - a
   summary boolean beside the conditions it summarises - the two drift the first time an entry is
   added, and the drift shows as a menu that opens on nothing. That case is no longer theoretical:
   with the wiki off for teachers, every entry below is student-only or off by default, so a
   teacher's Ressources is empty. #}
{% set resources_shared_documents = is_granted('ROLE_STUDENT') and not is_staff() and feature('shared_documents') %}
{% set resources_my_vms = is_pure_student and feature('my_vms') and has_virtual_machines(app.user) %}
{% set resources_school_mail = is_pure_student and feature('school_mail') %}
{# « Candidatures » follows « Courrier école », condition for condition: an application is a mail
   sent from the student's mailbox, and that screen is the list of those mails grouped by company.
   One source rather than two identical expressions that would drift - see
   App\Controller\MyJobApplicationController for the same decision on the route itself. #}
{% set resources_job_applications = resources_school_mail %}
{% set resources_wiki = not is_granted('ROLE_TUTOR') and not is_granted('ROLE_EXTERNAL') and feature('wiki') %}
{% set resources_course_space = is_granted('ROLE_STUDENT') and not is_staff() and feature('course_space') %}
{% set resources_documentation = feature('documentation') %}
{% set resources_apps = is_granted('ROLE_ADMIN') %}
{% if resources_shared_documents or resources_my_vms or resources_school_mail or resources_job_applications
    or resources_wiki or resources_course_space or resources_documentation or resources_apps %}
<li class="nav-item dropdown {{ resources_is_active ? 'active' }}">
    <a class="nav-link dropdown-toggle" href="#navbar-resources" data-bs-toggle="dropdown" data-bs-auto-close="outside" role="button" aria-expanded="false"{{ resources_is_active ? ' aria-current="page"' }}>
        <span class="nav-link-title">{{ 'resourcesNavLabel'|trans }}</span>
    </a>
    <div class="dropdown-menu">
        {# First entry, and the reason this dropdown became the student's main door: the documents
           their teachers put at the class's disposal. Shown to students only - a teacher shares
           from their own file library, and reads the result back through the file's utilisations. #}
        {% if resources_shared_documents %}
            <a class="dropdown-item {{ current_route starts with 'app_student_shared_document' ? 'active' }}" href="{{ path('app_student_shared_documents') }}">{{ 'sharedDocumentNavLabel'|trans }}</a>
        {% endif %}
        {# The two entries of the retired student "Outils" dropdown - their mailbox and their
           applications. Still student-only: staff reach both through the class screens, which is
           not the same screen. #}
        {# Only for somebody who actually has one: an entry leading to « aucune machine » for every
           student of the school is an entry they learn to ignore. Students read it here; a teacher
           who is not an administrator reads the same screen from the profile menu, that menu being
           where their own account's things live. #}
        {% if resources_my_vms %}
            <a class="dropdown-item {{ current_route starts with 'app_my_machines' ? 'active' }}" href="{{ path('app_my_machines') }}">{{ 'myMachinesNavLabel'|trans }}</a>
        {% endif %}
        {% if resources_school_mail %}
            <a class="dropdown-item {{ current_route starts with 'app_school_mail' or current_route starts with 'app_training_' ? 'active' }}" href="{{ path('app_school_mail') }}">{{ 'schoolMailNavLabel'|trans }}</a>
        {% endif %}
        {% if resources_job_applications %}
            <a class="dropdown-item {{ current_route == 'app_my_job_applications' ? 'active' }}" href="{{ path('app_my_job_applications') }}">{{ 'jobApplicationsNavLabel'|trans }}</a>
        {% endif %}
        {# Wikis, unfolding into the three questions a user actually asks. Same dropend shape as
           UFA > Formations and Gestion > Annuaire - Bootstrap disables Popper inside a .navbar, so
           placement is CSS-only and nav_submenu_placement_controller.js reframes what overflows;
           with three short entries the overflow it exists for cannot occur here.

           Hidden from tutors and the other outside accounts, which are excluded from the feature
           entirely - the same posture messaging takes, and enforced again at the controller's
           door. #}
        {% if resources_wiki %}
            <div class="dropend">
                <a class="dropdown-item dropdown-toggle {{ current_route starts with 'app_wiki' ? 'active' }}" href="#navbar-resources-wikis" data-bs-toggle="dropdown" data-bs-auto-close="outside" role="button" aria-expanded="false">
                    {{ 'wikiNavLabel'|trans }}
                </a>
                <div class="dropdown-menu">
                    <a class="dropdown-item {{ current_route == 'app_wiki_personal' ? 'active' }}" href="{{ path('app_wiki_personal') }}">{{ 'wikiPersonalNavLabel'|trans }}</a>
                    {# Only for somebody who actually has one - same posture as « Mes machines
                       virtuelles » above. Nothing is created from that screen: a shared wiki comes
                       from a class or from a colleague adding you, so an entry opening on « aucun
                       wiki » would never become useful by being clicked. #}
                    {% if has_shared_wikis() %}
                        <a class="dropdown-item {{ current_route == 'app_wiki_shared' ? 'active' }}" href="{{ path('app_wiki_shared') }}">{{ 'wikiSharedNavLabel'|trans }}</a>
                    {% endif %}
                    {% if is_granted('ROLE_TEACHER') or is_staff() %}
                        <a class="dropdown-item {{ current_route == 'app_wiki_students' ? 'active' }}" href="{{ path('app_wiki_students') }}">{{ 'wikiStudentsNavLabel'|trans }}</a>
                    {% endif %}
                </div>
            </div>
        {% endif %}
        {# « Mes cours » under its real name: what the student reads there is the year's séquences,
           and the old label promised a course space that this screen is only one face of. #}
        {% if resources_course_space %}
            <a class="dropdown-item {{ current_route starts with 'app_my_courses' ? 'active' }}" href="{{ path('app_my_courses') }}">{{ 'courseSpaceNavLabel'|trans }}</a>
        {% endif %}
        {% if resources_documentation %}
            <a class="dropdown-item {{ current_route starts with 'app_documentation' ? 'active' }}" href="{{ path('app_documentation') }}">{{ 'documentationNavLabel'|trans }}</a>
        {% endif %}
        {# The two app-download entries keep the ROLE_ADMIN gate they were given by explicit product
           request. #}
        {% if resources_apps %}
            <a class="dropdown-item {{ current_route == 'app_resources_mobile' ? 'active' }}" href="{{ path('app_resources_mobile') }}">{{ 'resourcesMobileAppNavLabel'|trans }}</a>
            <a class="dropdown-item {{ current_route == 'app_resources_eco' ? 'active' }}" href="{{ path('app_resources_eco') }}">{{ 'resourcesEcoAppNavLabel'|trans }}</a>
        {% endif %}
    </div>
</li>
{% endif %}
