{% extends 'base.html.twig' %}

{# Shell for the ROLE_TUTOR (entreprise tutor) area - same cm-topbar as layout/app.html.twig
   but with the single "Mes alternants" tab and the reduced user menu (Profil, Thème,
   Déconnexion) of design_handoff_dashboards 35a-35e. #}
{% block body %}
    <div class="page">
        {% set current_route = app.request.attributes.get('_route') %}
        <header class="navbar navbar-expand-md d-print-none cm-topbar">
            <div class="container-xl">
                <h1 class="navbar-brand d-none-navbar-horizontal pe-0 pe-md-3">
                    <a href="{{ path('app_internship_tutor_home') }}" class="cm-topbar__brand">
                        <span class="cm-topbar__medallion"><img src="{{ asset('images/embleme-white.png') }}" alt="Institution Beaupeyrat"></span>
                        <span class="cm-topbar__text">
                            <span class="cm-topbar__name">Institution Beaupeyrat</span>
                            <span class="cm-topbar__since"><i></i><b>{{ 'authSinceLabel'|trans }}</b><i></i></span>
                        </span>
                    </a>
                </h1>
                <span class="cm-topbar__divider"></span>
                <div class="navbar-nav flex-row order-md-last cm-topbar__right">
                    {% set current_theme = app.user.themePreference %}
                    <div class="nav-item dropdown">
                        {% set navbar_avatar_url = avatar_url(app.user) %}
                        <a href="#" class="nav-link d-flex align-items-center lh-1 text-reset p-0 cm-user__toggle" data-bs-toggle="dropdown" aria-label="{{ 'openUserMenuLabel'|trans }}">
                            <div class="d-none d-md-block cm-user__id">
                                <div class="cm-user__name">{{ app.user.displayName ?? app.user.username }}</div>
                                <div class="cm-user__login">{{ app.user.username }}</div>
                            </div>
                            <span class="cm-user__avatar"{% if navbar_avatar_url %} style="background-image: url({{ navbar_avatar_url }})"{% endif %}>{% if not navbar_avatar_url %}{{ app.user.initials|default((app.user.displayName ?? app.user.username)|slice(0, 1)|upper) }}{% endif %}</span>
                        </a>
                        <div class="dropdown-menu dropdown-menu-end dropdown-menu-arrow">
                            <div class="cm-user__menu-head">
                                <div class="fw-bold" style="color: var(--cm-ink); font-size: 13.5px;">{{ app.user.displayName ?? app.user.username }}</div>
                            </div>
                            <a href="{{ path('app_profile') }}" class="dropdown-item">{{ 'profileNavLabel'|trans }}</a>
                            <div class="dropdown-divider"></div>
                            <div class="cm-usermenu__theme"
                                 data-controller="theme"
                                 data-theme-authenticated-value="true"
                                 data-theme-save-url-value="{{ path('app_profile_theme') }}"
                                 data-theme-token-value="{{ csrf_token('profile_theme') }}">
                                <span>{{ 'themeNavLabel'|trans }}</span>
                                <span class="cm-theme">
                                    <button type="button" class="{{ current_theme != 'dark' ? 'is-on' }}" data-action="theme#setLight" aria-pressed="{{ current_theme != 'dark' ? 'true' : 'false' }}" aria-label="{{ 'themeLightLabel'|trans }}">☀</button>
                                    <button type="button" class="{{ current_theme == 'dark' ? 'is-on' }}" data-action="theme#setDark" aria-pressed="{{ current_theme == 'dark' ? 'true' : 'false' }}" aria-label="{{ 'themeDarkLabel'|trans }}">☾</button>
                                </span>
                            </div>
                            <div class="dropdown-divider"></div>
                            {# data-turbo-prefetch="false" - see templates/layout/app.html.twig's identical logout link for why. #}
                            <a href="{{ path('app_logout') }}" class="dropdown-item text-danger" data-turbo-prefetch="false">{{ 'logoutAction'|trans }}</a>
                        </div>
                    </div>
                </div>
                <div class="navbar-collapse">
                    <ul class="navbar-nav" aria-label="{{ 'mainNavLabel'|trans }}">
                        <li class="nav-item {{ current_route starts with 'app_internship_tutor' ? 'active' }}">
                            <a class="nav-link" href="{{ path('app_internship_tutor_home') }}"{{ current_route == 'app_internship_tutor_home' ? ' aria-current="page"' }}>
                                <span class="nav-link-icon">
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 20V6.5A1.5 1.5 0 0 1 5.5 5H12v15"></path><path d="M12 10h6.5A1.5 1.5 0 0 1 20 11.5V20"></path><path d="M3 20h18"></path></svg>
                                </span>
                                <span class="nav-link-title">{{ 'internshipTutorMyAlternantsNavLabel'|trans }}</span>
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </header>
        <div class="page-wrapper">
            {% block page_header %}
                <div class="page-header d-print-none">
                    <div class="container-xl">
                        <h2 class="page-title">{% block page_title %}{% endblock %}</h2>
                    </div>
                </div>
            {% endblock %}
            <div class="page-body">
                <div class="container-xl">
                    {% for label, messages in app.flashes %}
                        {% for message in messages %}
                            <div class="alert alert-{{ label == 'error' ? 'danger' : label }} alert-dismissible" role="alert">
                                {{ message|trans }}
                                <a class="btn-close" data-bs-dismiss="alert" aria-label="close"></a>
                            </div>
                        {% endfor %}
                    {% endfor %}
                    {% block main %}{% endblock %}
                </div>
            </div>
        </div>
    </div>
{% endblock %}
