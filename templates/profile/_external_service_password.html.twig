{# The password of one external service (App\Controller\ProfileExternalServiceController). Its hash is
   all that is kept, so the block can only say whether one is set, and since when - never show it.
   `id` is the anchor the consent screen and the redirects point at. #}
<div id="external-service-{{ service.value }}" class="cm-external-service-password">
    <h3 class="cm-external-service-password__title">{{ 'externalServicePasswordTitle'|trans }}</h3>
    {% if servicePassword %}
        <p class="text-secondary small mb-2">
            {{ 'externalServicePasswordSetOnLabel'|trans({'%date%': servicePassword.updatedAt|localized_date('d MMMM y')}) }}
            {% if servicePassword.lastUsedAt %}· {{ 'externalServicePasswordLastUsedLabel'|trans({'%date%': servicePassword.lastUsedAt|localized_date('d MMMM y, HH:mm')}) }}{% endif %}
        </p>
    {% else %}
        <p class="text-secondary small mb-2">{{ 'externalServicePasswordMissingLabel'|trans }}</p>
    {% endif %}

    <form method="post" action="{{ path('app_profile_external_service_password', {service: service.value}) }}" class="row g-2 align-items-end">
        <input type="hidden" name="_token" value="{{ csrf_token('external_service_password_' ~ service.value) }}">
        <div class="col-md-5">
            <label class="form-label" for="external-service-{{ service.value }}-password">{{ servicePassword ? 'externalServicePasswordNewLabel'|trans : 'externalServicePasswordLabel'|trans }}</label>
            <input type="password" class="form-control" id="external-service-{{ service.value }}-password" name="password" autocomplete="new-password" minlength="12" required>
        </div>
        <div class="col-md-5">
            <label class="form-label" for="external-service-{{ service.value }}-confirmation">{{ 'newPasswordConfirmationFieldLabel'|trans }}</label>
            <input type="password" class="form-control" id="external-service-{{ service.value }}-confirmation" name="confirmation" autocomplete="new-password" minlength="12" required>
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-primary w-100">{{ 'submitSaveAction'|trans }}</button>
        </div>
    </form>
    <p class="text-secondary small mt-2 mb-0">{{ 'externalServicePasswordRulesHint'|trans }}</p>

    {% if servicePassword %}
        <form method="post" action="{{ path('app_profile_external_service_password_remove', {service: service.value}) }}" class="mt-2">
            <input type="hidden" name="_token" value="{{ csrf_token('external_service_password_' ~ service.value) }}">
            <button type="submit" class="btn btn-link p-0 text-danger">{{ 'externalServicePasswordRemoveAction'|trans }}</button>
        </form>
    {% endif %}
</div>
