{# The Numérique / Calculée panel of the question editor. Submitted as raw numeric[...] fields,
   resolved by App\Controller\QuizLibraryController::applyNumeric().

   A calculée is a numérique whose expected value is computed instead of typed, so the two share
   this one panel and only the top block swaps: an "Answer" field for a numérique, a formula plus
   one row per {variable} of the statement for a calculée. The variable rows are derived live from
   the statement by assets/controllers/quiz_numeric_editor_controller.js - the text is the single
   source of truth for which variables exist, exactly like the blanks and the zones. #}
{# Both blocks are always rendered and only one is shown: the panel has to follow the type the
   teacher just picked in the select, not the one the question was last *saved* as. Rendering from
   the saved type left a question switched to "calculée" with no formula field until it was saved
   once - which is not something a teacher can be expected to guess. #}
{% set variables = {} %}
{% for variable in question.numericVariables %}
    {% set variables = variables|merge({(variable.name): variable}) %}
{% endfor %}
<div class="d-flex flex-column gap-3" data-controller="quiz-numeric-editor"
     data-action="quiz-question-editor:typeChanged@window->quiz-numeric-editor#typeChanged"
     data-quiz-numeric-editor-variables-value="{{ variables|json_encode(constant('JSON_FORCE_OBJECT')) }}"
     data-quiz-numeric-editor-count-template-value="{{ 'quizNumericVariableCountTemplate'|trans }}"
     data-quiz-numeric-editor-count-empty-text-value="{{ 'quizNumericNoVariableText'|trans }}"
     data-quiz-numeric-editor-min-label-value="{{ 'quizNumericMinLabel'|trans }}"
     data-quiz-numeric-editor-max-label-value="{{ 'quizNumericMaxLabel'|trans }}"
     data-quiz-numeric-editor-step-label-value="{{ 'quizNumericStepLabel'|trans }}"
     data-quiz-numeric-editor-decimals-label-value="{{ 'quizNumericDecimalsLabel'|trans }}">

    <div class="d-flex flex-column gap-3" data-quiz-numeric-editor-target="formulaPanel">
        <div class="d-flex flex-column gap-1">
            <label class="form-label mb-0" for="quiz-numeric-formula">
                {{ 'quizNumericFormulaFieldLabel'|trans }}
                <span class="fw-normal text-secondary">— {{ 'quizNumericFormulaFieldHint'|trans }}</span>
            </label>
            <input type="text" id="quiz-numeric-formula" class="form-control" name="numeric[formula]"
                   value="{{ question.numericFormula }}" placeholder="v * t"
                   style="font-family: ui-monospace, Menlo, Consolas, monospace;"
                   data-quiz-numeric-editor-target="formulaInput"
                   data-action="input->quiz-numeric-editor#refresh">
            <div class="cm-blanks-count" data-quiz-numeric-editor-target="formulaState"
                 data-missing-template="{{ 'quizNumericFormulaUnknownNamesTemplate'|trans }}"></div>
        </div>

        <div class="d-flex flex-column gap-2">
            <label class="form-label mb-0">
                {{ 'quizNumericVariablesFieldLabel'|trans }}
                <span class="fw-normal text-secondary">— {{ 'quizNumericVariablesFieldHint'|trans }}</span>
            </label>
            {# Filled by the controller: one row per {name} the statement carries. #}
            <div class="cm-zone-editor__rows" data-quiz-numeric-editor-target="rows"></div>
            <div class="cm-blanks-count" data-quiz-numeric-editor-target="count"></div>
        </div>
    </div>

    <div class="d-flex align-items-center gap-2" data-quiz-numeric-editor-target="answerPanel">
        <label class="form-label mb-0" for="quiz-numeric-answer">{{ 'quizNumericAnswerFieldLabel'|trans }}</label>
        <input type="number" id="quiz-numeric-answer" class="form-control" style="width: 180px; flex: none;"
               name="numeric[answer]" step="any" value="{{ question.numericAnswer }}">
    </div>

    <div class="row g-3">
        <div class="col-12 col-md-6 d-flex flex-column gap-2">
            <label class="form-label mb-0" for="quiz-numeric-tolerance">{{ 'quizNumericToleranceFieldLabel'|trans }}</label>
            <div class="d-flex align-items-center gap-2">
                <input type="number" id="quiz-numeric-tolerance" class="form-control" style="width: 110px; flex: none;"
                       name="numeric[tolerance]" min="0" step="0.01" value="{{ question.numericTolerance }}">
                <div class="cm-chip-list">
                    {% for mode in tolerance_modes %}
                        <label class="cm-radiocard cm-radiocard--inline">
                            <input type="radio" name="numeric[toleranceMode]" value="{{ mode.value }}"
                                   {{ question.numericToleranceMode == mode ? 'checked' }}>
                            <span class="cm-radiocard__dot"></span>
                            <span class="cm-radiocard__title">{{ mode.labelKey|trans }}</span>
                        </label>
                    {% endfor %}
                </div>
            </div>
            <div class="text-secondary small">{{ 'quizNumericToleranceZeroHint'|trans }}</div>
        </div>
        <div class="col-12 col-md-6 d-flex flex-column gap-2">
            <label class="form-label mb-0" for="quiz-numeric-unit">{{ 'quizNumericUnitFieldLabel'|trans }}</label>
            <input type="text" id="quiz-numeric-unit" class="form-control" name="numeric[unit]"
                   value="{{ question.numericUnit }}" placeholder="km, m/s, °C…">
            <label class="d-flex align-items-center gap-2">
                <input type="checkbox" name="numeric[unitRequired]" value="1" {{ question.isNumericUnitRequired ? 'checked' }}>
                <span class="small">{{ 'quizNumericUnitRequiredLabel'|trans }}</span>
            </label>
            <div class="text-secondary small">{{ 'quizNumericUnitHint'|trans }}</div>
        </div>
    </div>

    <div class="d-flex align-items-center gap-3 flex-wrap">
        <div class="d-flex align-items-center gap-2">
            <label class="form-label mb-0" for="quiz-numeric-decimals">{{ 'quizNumericDecimalsFieldLabel'|trans }}</label>
            <input type="number" id="quiz-numeric-decimals" class="form-control" style="width: 80px; flex: none;"
                   name="numeric[decimals]" min="0" max="6" step="1" value="{{ question.numericDecimals }}">
        </div>
        <div class="d-flex align-items-center gap-2">
            <label class="form-label mb-0" for="quiz-numeric-points">{{ 'quizBlankPointsFieldLabel'|trans }}</label>
            <input type="number" id="quiz-numeric-points" class="form-control" style="width: 90px; flex: none;" name="numeric[points]"
                   min="0.25" max="100" step="0.25" value="{{ question.points }}">
        </div>
    </div>

    <div class="cm-note cm-note--gold">
        <span class="cm-note__icon">!</span>
        {# Same live-contest exclusion notice as the other config-driven types. #}
        <div>{{ 'quizNumericLiveExcludedNotice'|trans|raw }}</div>
    </div>
</div>
