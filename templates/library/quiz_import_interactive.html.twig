{% extends 'layout/app.html.twig' %}

{% block title %}{{ 'quizImportPastePageHeading'|trans }}{% endblock %}

{% block page_breadcrumb %}
    {% include '_breadcrumb.html.twig' with {segments: [
        {label: 'homeNavLabel'|trans, url: path('app_home')},
        {label: 'quizLibraryPageHeading'|trans, url: path('app_library_quiz')},
        {label: 'zoneImportBreadcrumbLabel'|trans, url: app.request.requestUri},
    ]} %}
{% endblock %}
{% block page_title %}{{ 'quizImportPastePageHeading'|trans }}{% endblock %}

{% block main %}
    {# The prompt fragments are deliberately inline rather than translation keys: each is a working
       document addressed to an assistant that will produce French questions - translating one would
       change what gets generated. They are assembled here rather than in PHP for the same reason the
       four family prompts were: this is the text itself, not a message about it. #}
    {% set prompt_envelope %}
Tu vas produire des questions de quiz au format JSON « moncampus-quiz/1 ».
Réponds UNIQUEMENT par le JSON, sans commentaire autour.

# L'enveloppe
{"format":"moncampus-quiz/1","template":{"name":"…","subject":"…"},"questions":[…]}
Chaque question porte son "type", son "label" (l'énoncé, en français, précis et autoportant),
sa "difficulty" ("facile" | "moyen" | "difficile") et son "explanation" (la règle à retenir,
affichée en correction).
    {%- endset %}

    {% set prompt_closing %}
# Le choix du type
Choisis pour CHAQUE question la forme la plus adaptée à la notion, parmi les types ci-dessus et
eux seuls. Varie : jamais plus de deux questions consécutives du même type.
Gradue : commence par les notions simples, termine par les distinctions fines.

# Ma demande
Matière : [Réseaux]
Notions travaillées : [VLAN, trunk, 802.1Q]
Public : [BTS SIO 2e année, SISR]
Nombre de questions : [15]
Support de cours (optionnel) :
[coller ici]
    {%- endset %}

    {% set fragment_qcm %}- "qcm" : une seule bonne réponse parmi 3 ou 4.
  "answers":["…","…","…"], "correct":[2] — le rang de la bonne réponse, à partir de 1.
  Les mauvaises réponses sont des erreurs plausibles d'étudiants, jamais des absurdités.{% endset %}

    {% set fragment_qcm_multi %}- "qcm_multi" : plusieurs bonnes réponses. Même forme, "correct":[1,3].
  Seulement si plusieurs réponses sont vraies pour des raisons différentes — pas pour rendre un QCM plus dur.{% endset %}

    {% set fragment_vrai_faux %}- "vrai_faux" : une affirmation tranchée, ni nuancée ni double.
  "correct":true si l'affirmation est vraie. N'écris pas "answers" : les deux options sont posées par l'application.{% endset %}

    {% set fragment_image %}- "image" : quand une des images jointes porte la question elle-même.
  Même forme que "qcm", plus "media":{"ref":"img1"}. Ne décris pas l'image : désigne-la par sa clé.{% endset %}

    {% set fragment_ordre %}- "ordre" : remettre des éléments en séquence.
  "answers" dans le désordre, "correct":[2,4,1,3] = l'ordre attendu, exprimé en rangs de "answers".
  Seulement s'il existe UN ordre indiscutable (chronologie, étapes d'un protocole).{% endset %}

    {% set fragment_texte_a_trous %}- "texte_a_trous" : "label" avec ... à l'endroit de chaque trou,
  "blanks":[["prepare","prepare()"],["execute"]] — un tableau par trou, dans l'ordre, avec toutes les
  orthographes acceptées ; "mode":"banque" (les mots sont proposés) ou "libre" (l'étudiant tape).
  Seulement si le trou porte sur un mot précis et non ambigu.{% endset %}

    {% set fragment_zone %}- "zone" : cliquer la ou les bonnes zones d'un support.
  "support":{"kind":"code"|"texte","language":"…","content":"…"} dont le contenu porte les zones
  cliquables par marqueurs inline [[id|texte de la zone]] ; "correct":["z2"] ;
  "feedback":{"z1":"pourquoi cette zone est fausse","*":"message par défaut"}.
  Seulement si tu fournis toi-même le support texte ou code.{% endset %}

    {% set fragment_legende %}- "legende" : placer des étiquettes sur les zones d'un support.
  Même "support" que "zone", plus "labels":{"z1":"Étiquette"} et "distractors":["étiquettes en trop"].
  Seulement sur un support que tu écris toi-même.{% endset %}

    {% set fragment_apparier %}- "apparier" : relier les éléments de deux colonnes.
  "columns":{"left":"…","right":"…"}, "pairs":[{"id":"p1","left":"…","right":"…"}], 3 à 6 couples,
  "distractors":["éléments de droite en trop"] (1 à 3).
  Seulement s'il existe 3 à 6 couples naturels : n'en fabrique pas artificiellement.{% endset %}

    {% set fragment_numerique %}- "numerique" : la réponse est un nombre, le même pour tous.
  "answer":4094, "tolerance":2 avec "toleranceMode":"percent" (défaut) ou "absolute",
  "unit":"km" et "unitRequired":true si l'étudiant doit écrire l'unité.{% endset %}

    {% set fragment_calculee %}- "calculee" : chaque étudiant reçoit ses propres valeurs.
  "label" avec les variables écrites {v}, {t}… aux endroits où les nombres apparaissent,
  "variables":[{"name":"v","min":80,"max":160,"step":10,"decimals":0}], "formula":"…" sur ces variables.
  Toute variable de la formule est déclarée, et toute variable déclarée apparaît dans l'énoncé.
  Seulement si l'énoncé comporte de vraies grandeurs numériques.{% endset %}

    {% set fragment_reponse_courte %}- "reponse_courte" : "answers":["802.1Q","IEEE 802.1Q","dot1q"] —
  TOUTES les formulations acceptées, la plus canonique en premier ; "tolerateTypo":true pour pardonner
  une faute de frappe. Seulement si la réponse tient en un mot ou une courte expression dont les
  variantes s'énumèrent.{% endset %}

    {% set fragments = {
        'qcm': fragment_qcm,
        'qcm_multi': fragment_qcm_multi,
        'vrai_faux': fragment_vrai_faux,
        'image': fragment_image,
        'ordre': fragment_ordre,
        'texte_a_trous': fragment_texte_a_trous,
        'zone': fragment_zone,
        'legende': fragment_legende,
        'apparier': fragment_apparier,
        'numerique': fragment_numerique,
        'calculee': fragment_calculee,
        'reponse_courte': fragment_reponse_courte,
    } %}

    {# Two ways in, two screens, one tab bar - a pasted document and a spreadsheet file have nothing
       in common but their destination. The per-family tabs that used to sit here are gone: the
       document names its own format, and the prompt is now built from the types below. #}
    <div class="cm-tabs mb-3">
        <span class="cm-tabs__tab is-active">{{ 'quizImportTabPasteLabel'|trans }}</span>
        <a class="cm-tabs__tab" href="{{ path('app_library_quiz_import') }}">{{ 'quizImportTabCsvLabel'|trans }}</a>
    </div>

    {# Outside the paste form on purpose: a form inside a form is not a form (see the CSRF/nested
       form gotchas in CLAUDE.md), and the deposit is its own POST-and-redirect. #}
    <div class="card cm-audio-card">
        <div class="cm-audio-card__head">
            <span class="cm-audio-card__label">{{ 'quizImportImagesSectionTitle'|trans }}</span>
            <span class="cm-audio-card__count">{{ 'quizImportImagesSectionHint'|trans }}</span>
            <form method="post" action="{{ path('app_library_quiz_import_image_add') }}" enctype="multipart/form-data"
                  class="ms-auto" data-controller="auto-submit">
                <input type="hidden" name="_token" value="{{ csrf_token('quiz_import_images') }}">
                <label class="cm-audio-record">
                    <span class="cm-audio-record__dot"></span>{{ 'quizImportImageAddLabel'|trans }}
                    <input type="file" name="image" accept="image/png,image/jpeg,image/webp" hidden
                           data-action="change->auto-submit#submit">
                </label>
            </form>
        </div>
        <div class="cm-audio-card__body">
            {% if depositedImages is empty %}
                <div class="text-secondary small">{{ 'quizImportImagesEmptyText'|trans }}</div>
            {% else %}
                <div class="cm-qimport-images">
                    {% for image in depositedImages %}
                        <figure class="cm-qimport-image">
                            <img src="{{ file_url(image.key) }}" alt="{{ image.name }}">
                            <figcaption>
                                <span class="cm-qimport-image__ref">{{ image.ref }}</span>
                                <span class="cm-qimport-image__name" title="{{ image.name }}">{{ image.name }}</span>
                            </figcaption>
                            <form method="post" action="{{ path('app_library_quiz_import_image_remove') }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('quiz_import_images') }}">
                                <input type="hidden" name="ref" value="{{ image.ref }}">
                                <button type="submit" class="cm-audio-file__delete" title="{{ 'deleteAction'|trans }}">✕</button>
                            </form>
                        </figure>
                    {% endfor %}
                </div>
            {% endif %}
            <div class="cm-note">
                <span class="cm-note__icon">i</span>
                <div>{{ 'quizImportImagesPrivacyNote'|trans }}</div>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            {{ form_start(form) }}
            {{ form_errors(form) }}
            <div class="row g-4 align-items-start">
                <div class="col-12 col-lg-6 d-flex flex-column gap-3">
                    <div class="cm-subhead">
                        <div class="cm-subhead__title">{{ 'quizImportDocumentSectionTitle'|trans }}</div>
                        <div class="cm-subhead__hint">{{ 'quizImportDocumentSectionHint'|trans }}</div>
                    </div>
                    {{ form_row(form.json) }}
                    <div class="d-flex align-items-center gap-2 flex-wrap">
                        <span class="text-secondary small">{{ 'zoneImportExamplesLabel'|trans }}</span>
                        {% for key, labelKey in exampleLabels %}
                            <a class="btn btn-sm" href="{{ path('app_library_quiz_import_interactive', {example: key}) }}">{{ labelKey|trans }}</a>
                        {% endfor %}
                    </div>
                    <div class="cm-note">
                        <span class="cm-note__icon">i</span>
                        <div>{{ 'quizImportNoWriteNoteText'|trans }}</div>
                    </div>
                </div>

                <div class="col-12 col-lg-6 d-flex flex-column gap-3"
                     data-controller="copy-block quiz-prompt-builder"
                     data-quiz-prompt-builder-envelope-value="{{ prompt_envelope }}"
                     data-quiz-prompt-builder-closing-value="{{ prompt_closing }}"
                     data-quiz-prompt-builder-fragments-value="{{ fragments|json_encode }}"
                     data-quiz-prompt-builder-images-value="{{ depositedImages|json_encode }}"
                     data-quiz-prompt-builder-count-template-value="{{ 'quizImportPromptCountTemplate'|trans }}"
                     data-quiz-prompt-builder-images-title-value="{{ 'quizImportPromptImagesTitle'|trans }}"
                     data-quiz-prompt-builder-empty-value="{{ 'quizImportPromptEmptyText'|trans }}">
                    <div class="cm-subhead">
                        <div class="cm-subhead__title">{{ 'quizImportPromptSectionTitle'|trans }}</div>
                        <div class="cm-subhead__hint">{{ 'quizImportPromptSectionHint'|trans }}</div>
                    </div>

                    {# Ticking is not a convenience: the twelve fragments concatenated make a prompt
                       nobody can use, and a single ticked type gives exactly the "prompt for that
                       type" that was asked for. One mechanism, both needs. #}
                    <div class="cm-grp-segmented">
                        <button type="button" class="cm-grp-segmented__opt is-active" data-action="quiz-prompt-builder#selectAll" data-quiz-prompt-builder-target="allButton">{{ 'quizImportPromptFilterAllLabel'|trans }}</button>
                        <button type="button" class="cm-grp-segmented__opt" data-action="quiz-prompt-builder#selectLive" data-quiz-prompt-builder-target="liveButton">{{ 'quizImportPromptFilterLiveLabel'|trans }}</button>
                    </div>
                    <div class="cm-audio-options">
                        {% for type in promptTypes %}
                            <label class="cm-audio-option">
                                <input type="checkbox" checked
                                       value="{{ type.value }}"
                                       data-quiz-prompt-builder-target="type"
                                       data-live="{{ type.live ? '1' : '0' }}"
                                       data-action="change->quiz-prompt-builder#refresh">
                                {{ type.label }}
                            </label>
                        {% endfor %}
                    </div>

                    <div class="d-flex align-items-center gap-2">
                        <span class="cm-audio-card__count" data-quiz-prompt-builder-target="count"></span>
                        <button type="button" class="btn btn-sm ms-auto" data-action="click->copy-block#copy"
                                data-copy-block-done-label-param="{{ 'zoneImportPromptCopiedLabel'|trans }}">{{ 'zoneImportPromptCopyLabel'|trans }}</button>
                    </div>
                    <pre class="cm-qimport-prompt" data-copy-block-target="source" data-quiz-prompt-builder-target="output"></pre>
                </div>
            </div>
            <div class="cm-actionbar">
                <div class="cm-actionbar__buttons">
                    <a href="{{ path('app_library_quiz') }}" class="btn btn-link">{{ 'cancelAction'|trans }}</a>
                    <button type="submit" class="btn btn-primary">{{ 'quizImportAnalyseButtonLabel'|trans }}</button>
                </div>
            </div>
            {{ form_rest(form) }}
            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}
