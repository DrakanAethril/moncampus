    {# The prompt is a long working document per family - deliberately inline rather than a
       translation key, since translating it would change what gets generated. #}
    {% set prompts = {'zones': zone_prompt, 'apparier': matching_prompt, 'numerique': numeric_prompt} %}

    <div class="card">
        <div class="card-body">
            {# Several families, one screen: the paste field accepts any of the formats whatever tab
               is open (the document names its own format) - these only switch the prompt and the
               ready-made examples shown alongside. The list comes from the importer registry, so a
               new family appears here on its own. #}
            <div class="cm-chip-list mb-3">
                {% for one in families %}
                    <a class="btn btn-sm {{ one == family ? 'btn-primary' : '' }}"
                       href="{{ path('app_library_quiz_import_interactive', {family: one}) }}">{{ ('zoneImportFamily' ~ one|capitalize ~ 'Label')|trans }}</a>
                {% endfor %}
            </div>
            {{ form_start(form) }}
            {{ form_errors(form) }}
            <div class="row g-4 align-items-start">
                <div class="col-12 col-lg-6 d-flex flex-column gap-3">
                    <div class="cm-subhead">
                        <div class="cm-subhead__title">{{ 'zoneImportPasteSectionTitle'|trans }}</div>
                        <div class="cm-subhead__hint">{{ 'zoneImportPasteSectionHint'|trans }}</div>
                    </div>
                    {{ form_row(form.json) }}
                    <div class="d-flex align-items-center gap-2 flex-wrap">
                        <span class="text-secondary small">{{ 'zoneImportExamplesLabel'|trans }}</span>
                        {% for key, labelKey in exampleLabels %}
                            <a class="btn btn-sm" href="{{ path('app_library_quiz_import_interactive', {family: family, example: key}) }}">{{ labelKey|trans }}</a>
                        {% endfor %}
                    </div>
                    <div class="cm-note">
                        <span class="cm-note__icon">i</span>
                        <div>{{ 'quizImportNoWriteNoteText'|trans }}</div>
                    </div>
                </div>
                <div class="col-12 col-lg-6 d-flex flex-column gap-2">
                    <div class="cm-subhead">
                        <div class="cm-subhead__title">{{ 'zoneImportPromptSectionTitle'|trans }}</div>
                        <div class="cm-subhead__hint">{{ 'zoneImportPromptSectionHint'|trans }}</div>
                    </div>
                    <div data-controller="copy-block" class="d-flex flex-column gap-2 align-items-start">
                        <button type="button" class="btn btn-sm" data-action="click->copy-block#copy"
                                data-copy-block-done-label-param="{{ 'zoneImportPromptCopiedLabel'|trans }}">{{ 'zoneImportPromptCopyLabel'|trans }}</button>
                        <pre data-copy-block-target="source" style="max-height: 420px; overflow: auto; width: 100%; background: var(--cm-surface-alt); border: 1px solid var(--cm-border-soft); border-radius: 10px; padding: 14px 16px; font-size: 11.5px; line-height: 1.6; white-space: pre-wrap;">{{ prompts[family]|default(zone_prompt) }}</pre>
                    </div>
                </div>
            </div>
            <div class="cm-actionbar">
                <div class="cm-actionbar__buttons">
                    <a href="{{ path('app_library_quiz') }}" class="btn btn-link">{{ 'cancelAction'|trans }}</a>
                    <button type="submit" class="btn btn-primary">{{ 'quizImportAnalyseButtonLabel'|trans }}</button>
                </div>
            </div>
            {{ form_rest(form) }}
            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}
