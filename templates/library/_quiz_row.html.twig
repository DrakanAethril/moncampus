{# One quiz of the listing. The row menu carries what the old table's four buttons carried, plus the
   two acts the classement adds - « Déplacer vers… » and, on the folder rows, « Renommer ».

   The kebab replaces the four inline buttons on purpose: at two hundred quizzes the actions column
   was wider than the name it acted on. #}
{% set quizDescription = row.quiz.description|default('')|trim %}
<tr class="cm-qlib__row" data-quiz-id="{{ row.quiz.id }}" data-name="{{ row.quiz.name }}" draggable="true">
    <td>
        <span class="cm-qlib__name">
            <span class="cm-qlib__ext cm-qlib__ext--quiz" aria-hidden="true">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M9 9a3 3 0 1 1 3 3v2"></path><circle cx="12" cy="18" r="1" fill="currentColor" stroke="none"></circle></svg>
            </span>
            <a href="{{ path('app_library_quiz_questions', {id: row.quiz.id}) }}"{% if quizDescription %} title="{{ quizDescription }}"{% endif %}>{{ row.quiz.name }}</a>
        </span>
    </td>
    <td class="cm-qlib__muted">{{ row.quiz.subject|default('') ?: '—' }}</td>
    <td class="cm-qlib__num">{{ row.questionCount }}</td>
    <td class="cm-qlib__muted">{{ row.difficultyLabel }}</td>
    <td class="cm-qlib__num">{{ (row.quiz.lastUpdatedDate ?? row.quiz.creationDate)|date('d/m/Y') }}</td>
    <td class="cm-qlib__menu">
        <div class="dropdown">
            <button type="button" class="cm-qlib__kebab" data-bs-toggle="dropdown" aria-expanded="false"
                    data-bs-boundary="viewport"
                    data-bs-popper-config='{"strategy":"fixed"}'
                    aria-label="{{ 'quizLibraryRowMenuLabel'|trans }}">⋮</button>
            <ul class="dropdown-menu dropdown-menu-end">
                <li><a class="dropdown-item" href="{{ path('app_library_quiz_launch', {id: row.quiz.id}) }}">{{ 'quizActionLaunchLabel'|trans }}</a></li>
                <li><a class="dropdown-item" href="{{ path('app_library_quiz_questions', {id: row.quiz.id}) }}">{{ 'quizLibraryEditQuestionsAction'|trans }}</a></li>
                <li><a class="dropdown-item" href="{{ path('app_library_quiz_settings', {id: row.quiz.id}) }}">{{ 'quizLibrarySettingsAction'|trans }}</a></li>
                <li><button type="button" class="dropdown-item" data-action="quiz-library#openMove">{{ 'quizLibraryMoveAction'|trans }}</button></li>
                <li><button type="button" class="dropdown-item" data-action="quiz-library#duplicate">{{ 'quizActionDuplicateLabel'|trans }}</button></li>
                <li><button type="button" class="dropdown-item text-danger" data-action="quiz-library#remove">{{ 'quizActionRemoveLabel'|trans }}</button></li>
            </ul>
        </div>
    </td>
</tr>
