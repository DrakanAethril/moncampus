{# One question of the verification screen, rendered from the transient entity the reader just built
   - never from the raw payload. That is what makes this preview the question the student will get,
   and what makes a wrong type chosen by a model visible *before* anything is written; it is the
   safety net that makes letting an AI pick the type acceptable at all.

   One partial for the twelve types, rather than one branch per family: the four family branches this
   replaces rendered the same three things (index, badge, statement) around their own body, and a
   mixed document interleaves families anyway. Each body is the very partial the passation or the
   correction uses, in reveal mode - the answer is what a teacher checks here. #}
{% set is_zone = question.type.usesZoneConfig %}
{% set is_numeric = question.type.usesNumericConfig %}

<div class="card">
    <div class="card-body py-3 d-flex flex-column gap-2">
        <div class="d-flex align-items-center gap-2">
            <span class="cm-qbank__index">{{ number }}</span>
            <span class="badge bg-blue-lt">{{ question.type.shortLabelKey|trans }}</span>
            <span class="cm-diffdots">
                {% for i in 1..3 %}<span class="{{ i <= question.effectiveDifficulty.dotCount ? 'is-filled' }}"></span>{% endfor %}
            </span>
            {% if gap is not null %}
                <span class="cm-audio-pill cm-audio-pill--draft ms-auto">{{ gap.labelKey|trans }}</span>
            {% endif %}
        </div>

        {# A numérique IS its own statement (it carries the drawn values), so it is not repeated
           above its body - same rule as the passation's own screens. #}
        {% if not is_numeric %}
            <div style="font-weight: 600;">{{ question.label }}</div>
        {% endif %}

        {% if question.imageStorageKey and not is_zone %}
            <img src="{{ file_url(question.imageStorageKey) }}" alt="" style="max-width: 320px; border-radius: 8px;">
        {% elseif gap is not null and question.expectedMediaName %}
            {# Named, not attached: the question is created all the same and says what it waits for. #}
            <div class="text-secondary small">{{ 'quizImportPreviewAwaitedMediaTemplate'|trans({'%name%': question.expectedMediaName}) }}</div>
        {% endif %}

        {% if is_zone %}
            {% set states = {} %}
            {% for zoneId in question.zoneCorrectIds %}
                {% set states = states|merge({(zoneId): 'good'}) %}
            {% endfor %}
            {% include 'quiz/_zone_support.html.twig' with {
                question: question,
                states: states,
                image_url: question.imageStorageKey ? file_url(question.imageStorageKey) : null,
            } only %}
            {% if question.type.value == 'legende' %}
                <div class="small text-secondary">
                    {{ 'zoneImportPreviewLabelsTemplate'|trans({'%labels%': question.legendeChoices|map(c => c.text)|join(', ')}) }}
                </div>
            {% endif %}
        {% elseif is_numeric %}
            {% set midpoints = {} %}
            {% for variable in question.numericVariables %}
                {% set midpoints = midpoints|merge({(variable.name): (variable.min + variable.max) / 2}) %}
            {% endfor %}
            {% include 'quiz/_numeric_review.html.twig' with {
                question: question,
                variables: numeric_display_variables(question, midpoints),
                raw: null,
                expected: numeric_expected(question, midpoints),
                margin: numeric_margin(question, midpoints),
                is_correct: true,
                hide_answer_given: true,
            } only %}
            {% if question.numericFormula %}
                <div class="small text-secondary" style="font-family: ui-monospace, Menlo, Consolas, monospace;">
                    {{ 'numericImportPreviewFormulaTemplate'|trans({'%formula%': question.numericFormula}) }}
                </div>
            {% endif %}
        {% elseif question.type.value == 'apparier' %}
            {% include 'quiz/_matching_board.html.twig' with {question: question, reveal: true} only %}
            {% if question.matchingDistractors is not empty %}
                <div class="small text-secondary">
                    {{ 'matchingImportPreviewDistractorsTemplate'|trans({'%items%': question.matchingDistractors|join(', ')}) }}
                </div>
            {% endif %}
        {% elseif question.type.value == 'reponse_courte' %}
            {# What a teacher checks on this type is the question against its accepted variants: the
               variants are the marking scheme. #}
            <div class="cm-blank-expected">
                {{ 'quizShortAnswerAcceptedTemplate'|trans({'%answers%': (question.blankAnswers[0]|default([]))|join(', ')}) }}
            </div>
            <div class="small text-secondary">
                {{ (question.isIgnoreCase ? 'quizShortAnswerPreviewCaseOnText' : 'quizShortAnswerPreviewCaseOffText')|trans }}
                {{ (question.isTolerateTypo ? 'quizShortAnswerPreviewTypoOnText' : 'quizShortAnswerPreviewTypoOffText')|trans }}
            </div>
        {% elseif question.type.value == 'texte_a_trous' %}
            <ul class="list-unstyled mb-0 small text-secondary">
                {% for variants in question.blankAnswers %}
                    <li>{{ 'quizImportPreviewBlankTemplate'|trans({'%index%': loop.index, '%variants%': variants|join(' / ')}) }}</li>
                {% endfor %}
            </ul>
        {% else %}
            <ul class="list-unstyled mb-0 small">
                {% for answer in question.answers %}
                    <li class="{{ answer.correct ? 'text-success fw-medium' : 'text-secondary' }}">
                        {%- if question.type.value == 'ordre' %}{{ loop.index }}. {% endif -%}
                        {{ answer.label }}{{ answer.correct ? ' ✓' }}
                    </li>
                {% endfor %}
            </ul>
        {% endif %}

        {% if question.explanation %}
            <div class="small text-secondary">{{ 'quizImportPreviewExplanationTemplate'|trans({'%text%': question.explanation}) }}</div>
        {% endif %}
    </div>
</div>
