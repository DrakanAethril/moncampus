<form method="post" action="{{ path('app_library_quiz_questions_new', {id: quizTemplate.id}) }}">
    <input type="hidden" name="_token" value="{{ csrf_token('library_quiz_questions_new') }}">
    <button type="submit" class="btn btn-primary">
        <twig:ux:icon name="plus" class="icon" width="24" height="24"/>
        {{ 'quizQuestionNewButtonLabel'|trans }}
    </button>
</form>
