{# One folder of the rail, recursing into its children - the file library's `_rail_node` shape
   (templates/file_library/_rail_node.html.twig), because there must not be two vocabularies for one
   tree in this application.

   **What is open by default**: the branch leading to the folder being browsed, and that folder's own
   direct children. The rule needs no state and no round trip - the materialized path already says
   who is an ancestor of the current folder, so the server answers it while rendering.

   There is **no re-order drag** here, so a node carries no `data-parent-id`: dropping means "into
   this folder" and nothing else. #}
{% set hasChildren = row.children is not empty %}
{% set expanded = hasChildren and currentFolder and (currentFolder.id == row.id or ('/' ~ row.id ~ '/') in currentFolder.path) %}
<li class="cm-qlib__node{{ hasChildren and not expanded ? ' is-collapsed' }}"
    data-quiz-library-tree-target="node"
    {# `data-name` is what the rename prompt opens on: the controller reads it off the closest
       element carrying a folder id, and the rail is one of the two places that element is a folder. #}
    data-folder-id="{{ row.id }}" data-name="{{ row.name }}" draggable="true">
    <div class="cm-qlib__node-row">
        <span class="cm-qlib__node-grip" aria-hidden="true">
            <twig:ux:icon name="grip" width="10" height="14"/>
        </span>

        {% if hasChildren %}
            {# One triangle, rotated by CSS: the two states cannot drift apart the way two glyphs would. #}
            <button type="button" class="cm-qlib__node-toggle"
                    aria-expanded="{{ expanded ? 'true' : 'false' }}"
                    aria-label="{{ 'quizFolderToggleBranchAction'|trans({'%name%': row.name}) }}"
                    data-action="quiz-library-tree#toggleBranch">
                <twig:ux:icon name="caret-right" width="9" height="9"/>
            </button>
        {% else %}
            <span class="cm-qlib__node-toggle cm-qlib__node-toggle--empty" aria-hidden="true"></span>
        {% endif %}

        <a class="cm-qlib__node-link{{ currentFolder and currentFolder.id == row.id ? ' is-current' }}"
           href="{{ path('app_library_quiz_folder', {folderId: row.id}) }}" title="{{ row.name }}">
            <span class="cm-qlib__node-ico" aria-hidden="true">
                <twig:ux:icon name="folder" width="15" height="15"/>
            </span>
            <span class="cm-qlib__node-title">{{ row.name }}</span>
        </a>

        {# The two acts that change the tree, at the row they act on rather than in a bar at the top -
           the file library's rail, which has carried both since it was written.

           Renaming rather than the « + » this used to carry: a sub-folder is created from the foot's
           button, which already asks where, whereas renaming a folder had no gesture at all outside
           the listing's row menu - and a rail row is where a badly named folder is actually noticed. #}
        <span class="cm-qlib__node-actions">
            {# Hidden where the `quiz-library` controller is not mounted - the search screen. A button that
               does nothing is worse than an absent one. Deleting stays: it is a plain form. #}
            {% if not readonly|default(false) %}
                <button type="button" class="cm-qlib__node-action"
                        title="{{ 'quizFolderRenameAction'|trans }}"
                        aria-label="{{ 'quizFolderRenameNamedAction'|trans({'%name%': row.name}) }}"
                        data-action="quiz-library#promptRenameFolder">
                    <twig:ux:icon name="pencil" width="14" height="14"/>
                </button>
            {% endif %}

            <form method="post" action="{{ path('app_library_quiz_folder_delete', {folderId: row.id}) }}">
                <input type="hidden" name="_token" value="{{ csrf_token('quiz_folder') }}">
                {# The confirmation says what becomes of the content rather than just naming the folder:
                   deleting one **never deletes a quiz** here, everything inside moves up one level,
                   and that is not what a file manager teaches. #}
                <button type="submit" class="cm-qlib__node-action cm-qlib__node-action--danger"
                        title="{{ 'quizFolderDeleteAction'|trans }}"
                        aria-label="{{ 'quizFolderDeleteNamedAction'|trans({'%name%': row.name}) }}"
                        data-controller="confirm-submit"
                        data-confirm-submit-message-value="{{ 'quizFolderDeleteConfirmText'|trans({'%name%': row.name}) }}"
                        data-action="click->confirm-submit#confirm">
                    <twig:ux:icon name="trash" width="14" height="14"/>
                </button>
            </form>
        </span>
    </div>

    {% if hasChildren %}
        <ul class="cm-qlib__tree cm-qlib__tree--nested">
            {% for child in row.children %}
                {% include 'library/_quiz_rail_node.html.twig' with {row: child, currentFolder: currentFolder, readonly: readonly|default(false)} only %}
            {% endfor %}
        </ul>
    {% endif %}
</li>
