{% extends 'layout/app.html.twig' %}

{% block title %}{{ 'quizImportPageHeading'|trans }}{% endblock %}

{% block page_breadcrumb %}
    {% include '_breadcrumb.html.twig' with {segments: [
        {label: 'homeNavLabel'|trans, url: path('app_home')},
        {label: 'quizLibraryPageHeading'|trans, url: path('app_library_quiz')},
        {label: 'quizImportBreadcrumbLabel'|trans, url: app.request.requestUri},
    ]} %}
{% endblock %}
{% block page_title %}{{ 'quizImportPageHeading'|trans }}{% endblock %}

{% block main %}
    <div class="card">
        <div class="card-body">
            {{ form_start(form) }}
            {{ form_errors(form) }}
            <div class="row g-4 align-items-start">
                <div class="col-12 col-lg-7 d-flex flex-column gap-3">
                    <div class="cm-subhead">
                        <div class="cm-subhead__title">{{ 'quizImportFileSectionTitle'|trans }}</div>
                        <div class="cm-subhead__hint">{{ 'quizImportFileSectionHint'|trans }}</div>
                    </div>
                    <div style="max-width: 520px;">
                        {{ form_row(form.file) }}
                    </div>
                    <div class="cm-note">
                        <span class="cm-note__icon">i</span>
                        <div>{{ 'quizImportNoWriteNoteText'|trans }}</div>
                    </div>
                </div>
                <div class="col-12 col-lg-5 d-flex flex-column gap-2">
                    <div class="cm-subhead">
                        <div class="cm-subhead__title">{{ 'quizImportFormatSectionTitle'|trans }}</div>
                        <div class="cm-subhead__hint">{{ 'quizImportFormatSectionHint'|trans }}</div>
                    </div>
                    <div class="d-flex flex-column align-items-start gap-1">
                        <a href="{{ path('app_library_quiz_import_help') }}">{{ 'quizImportHelpLinkLabel'|trans }}</a>
                        <a href="{{ path('app_library_quiz_import_example') }}">{{ 'quizImportExampleDownloadLabel'|trans }}</a>
                    </div>
                </div>
            </div>
            <div class="cm-actionbar">
                <div class="cm-actionbar__buttons">
                    <a href="{{ path('app_library_quiz') }}" class="btn btn-link">{{ 'cancelAction'|trans }}</a>
                    <button type="submit" class="btn btn-primary">{{ 'quizImportAnalyseButtonLabel'|trans }}</button>
                </div>
            </div>
            {{ form_rest(form) }}
            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}
