{% extends 'layout/app.html.twig' %}

{% block title %}{{ 'quizImportPageHeading'|trans }}{% endblock %}

{% block page_breadcrumb %}
    {% include '_breadcrumb.html.twig' with {segments: [
        {label: 'homeNavLabel'|trans, url: path('app_home')},
        {label: 'quizLibraryPageHeading'|trans, url: path('app_library_quiz')},
        {label: 'quizImportBreadcrumbLabel'|trans, url: app.request.requestUri},
    ]} %}
{% endblock %}
{% block page_title %}{{ 'quizImportPageHeading'|trans }}{% endblock %}

{% block main %}
    {# The two file formats, side by side. They used to be two entries of the library's import menu,
       and the tab pair here paired a file with the paste screen - which is a step of the assistant
       now, not a screen. What is left is the one choice this screen really offers: our own CSV, or a
       Kahoot game report, which is a report and not a format of ours. #}
    <div class="cm-tabs mb-3">
        <a class="cm-tabs__tab{{ source == 'csv' ? ' is-active' }}" href="{{ path('app_library_quiz_import') }}">{{ 'quizImportSourceCsvLabel'|trans }}</a>
        <a class="cm-tabs__tab{{ source == 'kahoot' ? ' is-active' }}" href="{{ path('app_library_quiz_import_kahoot') }}">{{ 'quizImportSourceKahootLabel'|trans }}</a>
    </div>
    <p class="text-secondary">
        <a href="{{ path('app_library_quiz_assistant') }}">{{ 'quizAssistantBackActionLabel'|trans }}</a>
    </p>
    <div class="card">
        <div class="card-body">
            {{ form_start(form) }}
            {{ form_errors(form) }}
            <div class="row g-4 align-items-start">
                <div class="col-12 col-lg-7 d-flex flex-column gap-3">
                    <div class="cm-subhead">
                        <div class="cm-subhead__title">{{ 'quizImportFileSectionTitle'|trans }}</div>
                        <div class="cm-subhead__hint">{{ 'quizImportFileSectionHint'|trans }}</div>
                    </div>
                    <div style="max-width: 520px;">
                        {{ form_row(form.file) }}
                    </div>
                    <div class="cm-note">
                        <span class="cm-note__icon">i</span>
                        <div>{{ 'quizImportNoWriteNoteText'|trans }}</div>
                    </div>
                </div>
                {# The « format » block only applies to the CSV: a Kahoot report is not written, it is
                   exported as it stands from Kahoot. #}
                <div class="col-12 col-lg-5 d-flex flex-column gap-2">
                    <div class="cm-subhead">
                        <div class="cm-subhead__title">{{ (source == 'kahoot' ? 'quizImportKahootFormatSectionTitle' : 'quizImportFormatSectionTitle')|trans }}</div>
                        <div class="cm-subhead__hint">{{ (source == 'kahoot' ? 'quizImportKahootFormatSectionHint' : 'quizImportFormatSectionHint')|trans }}</div>
                    </div>
                    <div class="d-flex flex-column align-items-start gap-1">
                        {% if source != 'kahoot' %}
                            <a href="{{ path('app_library_quiz_import_help') }}">{{ 'quizImportHelpLinkLabel'|trans }}</a>
                            <a href="{{ path('app_library_quiz_import_example') }}">{{ 'quizImportExampleDownloadLabel'|trans }}</a>
                        {% endif %}
                    </div>
                </div>
            </div>
            <div class="cm-actionbar">
                <div class="cm-actionbar__buttons">
                    <a href="{{ path('app_library_quiz') }}" class="btn btn-link">{{ 'cancelAction'|trans }}</a>
                    <button type="submit" class="btn btn-primary">{{ 'quizImportAnalyseButtonLabel'|trans }}</button>
                </div>
            </div>
            {{ form_rest(form) }}
            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}
