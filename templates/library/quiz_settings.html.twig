{% extends 'layout/app.html.twig' %}

{% block title %}{{ quizTemplate.name }}{% endblock %}

{% block page_breadcrumb %}
    {% include '_breadcrumb.html.twig' with {segments: [
        {label: 'homeNavLabel'|trans, url: path('app_home')},
        {label: 'quizLibraryPageHeading'|trans, url: path('app_library_quiz')},
        {label: quizTemplate.name, url: app.request.requestUri},
    ]} %}
{% endblock %}
{% block page_title %}{{ quizTemplate.name }}{% endblock %}

{% block main %}
    {% include '_tabs.html.twig' with {
        tabs: isNew
            ? [{url: path('app_library_quiz_new'), label: 'quizTabSettingsLabel'|trans, active: true}]
            : [
                {url: path('app_library_quiz_settings', {id: quizTemplate.id}), label: 'quizTabSettingsLabel'|trans, active: true},
                {url: path('app_library_quiz_questions', {id: quizTemplate.id}), label: 'quizTabQuestionsLabel'|trans, active: false},
                {url: path('app_library_quiz_test', {id: quizTemplate.id}), label: 'quizTabTestLabel'|trans, active: false},
            ],
        tabs_action: 'library/_quiz_settings_save_button.html.twig',
    } %}
    <div class="card cm-card--tabbed">
        <div class="card-body">
            {{ form_start(form, {attr: {id: 'quiz-settings-form'}}) }}
            {{ form_errors(form) }}
            <div class="row g-4 align-items-start">
                <div class="col-12 col-lg-6 d-flex flex-column gap-3">
                    <div class="cm-subhead">
                        <div class="cm-subhead__title">{{ 'quizSettingsIdentityTitle'|trans }}</div>
                        <div class="cm-subhead__hint">{{ 'quizSettingsIdentityHint'|trans }}</div>
                    </div>
                    <div style="max-width: 420px;">
                        {{ form_row(form.name) }}
                    </div>
                    <div style="max-width: 280px;">
                        {{ form_row(form.subject) }}
                    </div>
                    {{ form_row(form.description) }}
                </div>
                <div class="col-12 col-lg-6 d-flex flex-column gap-3">
                    <div class="cm-subhead">
                        <div class="cm-subhead__title">{{ 'quizSettingsDefaultsTitle'|trans }}</div>
                        <div class="cm-subhead__hint">{{ 'quizSettingsDefaultsHint'|trans }}</div>
                    </div>
                    <div class="row g-3">
                        <div class="col-6">{{ form_row(form.defaultQuestionCount) }}</div>
                        {# The seconds field is hidden rather than removed from the DOM: the server
                           is what decides whether to read it (the form's PRE_SUBMIT listener), the
                           class is only a typing comfort. #}
                        <div class="col-6" data-controller="radio-reveal">
                            {{ form_label(form.defaultTimeMode) }}
                            {# Same shape as the per-question field of quiz_questions.html.twig: the
                               bootstrap_5 theme's radio_widget already emits its own .form-check
                               wrapper and label, so a hand-written one rendered the label twice -
                               beside the radio and again underneath. .cm-choice-group keeps the
                               single asterisk on the legend rather than one per choice. #}
                            <div class="cm-choice-group d-flex gap-3 mb-2">
                                {% for choice in form.defaultTimeMode %}
                                    {{ form_widget(choice, {
                                        parent_label_class: 'radio-inline',
                                        attr: {'data-radio-reveal-target': 'radio', 'data-action': 'change->radio-reveal#refresh'},
                                    }) }}
                                {% endfor %}
                            </div>
                            {% do form.defaultTimeMode.setRendered %}
                            <div data-radio-reveal-target="panel" data-radio-reveal-for="fixed">
                                {{ form_row(form.defaultSecondsPerQuestion, {label: false}) }}
                            </div>
                        </div>
                    </div>
                    <div class="d-flex flex-column gap-2">
                        {{ form_row(form.defaultSameQuestionsForAll, {row_attr: {class: 'form-switch'}}) }}
                        {{ form_row(form.defaultQuestionOrderPerStudent, {row_attr: {class: 'form-switch'}}) }}
                        {{ form_row(form.defaultAnswerOrderPerStudent, {row_attr: {class: 'form-switch'}}) }}
                    </div>
                    <div class="cm-note">
                        <span class="cm-note__icon">i</span>
                        <div>{{ 'quizSettingsDefaultsNoteText'|trans }}</div>
                    </div>
                    {% if isNew %}
                        <div class="cm-note">
                            <span class="cm-note__icon">i</span>
                            <div>
                                {{ 'quizSettingsImportNoteText'|trans }}
                                <a href="{{ path('app_library_quiz_import') }}">{{ 'quizImportButtonLabel'|trans }}</a>
                            </div>
                        </div>
                    {% endif %}
                </div>
            </div>
            <div class="cm-actionbar">
                {% include '_last_modified_meta.html.twig' with {entity: quizTemplate} %}
                <div class="cm-actionbar__buttons">
                    <a href="{{ path('app_library_quiz') }}" class="btn btn-link">{{ 'cancelAction'|trans }}</a>
                </div>
            </div>
            {{ form_rest(form) }}
            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}
