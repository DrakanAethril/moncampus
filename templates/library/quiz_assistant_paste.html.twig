{% extends 'layout/app.html.twig' %}

{% block title %}{{ 'quizAssistantPastePageHeading'|trans }}{% endblock %}

{% block page_breadcrumb %}
    {{ component('Cm:Breadcrumb', {segments: [
        {label: 'toolsNavLabel'|trans, url: path('app_library_quiz')},
        {label: 'quizLibraryPageHeading'|trans, url: path('app_library_quiz')},
        {label: 'quizAssistantBreadcrumbLabel'|trans, url: path('app_library_quiz_assistant')},
        {label: 'quizAssistantPasteBreadcrumbLabel'|trans, url: app.request.requestUri},
    ]}) }}
{% endblock %}
{% block page_title %}{{ 'quizAssistantPastePageHeading'|trans }}{% endblock %}

{% block main %}
    {% include '_wizard_steps.html.twig' with {stepCaptionKey: 'quizAssistantStepCaptionLabel'} %}

    <div class="card">
        <div class="card-body">
            {# One box, full frame. The document names its own format, so there is nothing to choose
               here - the four older formats stay readable because the application emitted them. #}
            <form method="post" action="{{ path('app_library_quiz_assistant_paste') }}" class="d-flex flex-column gap-3">
                <input type="hidden" name="_token" value="{{ csrf_token('quiz_assistant_paste') }}">

                <twig:Cm:Subhead :title="'quizImportDocumentSectionTitle'|trans" :hint="'quizImportDocumentSectionHint'|trans"/>

                {# Several documents one under another are read as a batch, which is the ordinary
                   shape of an answer that produced a term's worth of quizzes at once. Nothing to
                   tick: the box counts what it finds, and one document keeps the screen it has. #}
                <div class="cm-note">
                    <span class="cm-note__icon">i</span>
                    <div>{{ 'quizBatchPasteHintTemplate'|trans({'%max%': maxDocuments}) }}</div>
                </div>

                {% if error %}
                    {# Rendered with a 422, never a 200: a POST answered 200 is thrown away by Turbo
                       and the teacher would watch this message never appear. #}
                    <div class="alert alert-danger" role="alert">{{ error }}</div>
                {% endif %}

                <textarea class="form-control font-monospace" name="json" rows="16"
                          placeholder="{{ 'quizAssistantPastePlaceholder'|trans }}" autofocus>{{ json }}</textarea>

                <div class="d-flex align-items-center gap-2 flex-wrap">
                    <span class="text-secondary small">{{ 'zoneImportExamplesLabel'|trans }}</span>
                    {% for key, labelKey in exampleLabels %}
                        <a class="btn btn-sm" href="{{ path('app_library_quiz_assistant_paste', {example: key}) }}">{{ labelKey|trans }}</a>
                    {% endfor %}
                </div>

                <div class="cm-note">
                    <span class="cm-note__icon">i</span>
                    <div>{{ 'quizImportNoWriteNoteText'|trans }}</div>
                </div>

                <twig:Cm:ActionBar>
                    <a href="{{ path('app_library_quiz_assistant_prompt') }}" class="btn btn-link">{{ 'quizAssistantBackToPromptActionLabel'|trans }}</a>
                    <button type="submit" class="btn btn-primary">{{ 'quizImportAnalyseButtonLabel'|trans }}</button>
                </twig:Cm:ActionBar>
            </form>
        </div>
    </div>

    {# The same step by the other door. A sibling form rather than a second field of the one above:
       the file is staged (and scanned) by App\Form\FilePickerType before its action is reached, and
       one <form> answering to two submits would have to tell them apart on every render. #}
    <div class="card mt-3">
        <div class="card-body">
            <twig:Cm:Subhead :title="'quizBatchArchiveSectionTitle'|trans" :hint="'quizBatchArchiveSectionHint'|trans"/>

            {{ form_start(archiveForm, {action: path('app_library_quiz_assistant_archive'), attr: {class: 'd-flex flex-column gap-3'}}) }}
                {{ form_errors(archiveForm) }}
                {{ form_row(archiveForm.file) }}
                <twig:Cm:ActionBar>
                    <button type="submit" class="btn btn-primary">{{ 'quizImportAnalyseButtonLabel'|trans }}</button>
                </twig:Cm:ActionBar>
            {{ form_end(archiveForm) }}
        </div>
    </div>
{% endblock %}
