{# The quiz library's trail. It always opens on Accueil with the house pictogram, then Outils, then
   the library, then one entry per folder being opened - depth follows navigation, and a classement
   three folders deep is three real levels. #}
{% set segments = [
    {label: 'homeNavLabel'|trans, url: path('app_home')},
    {label: 'toolsNavLabel'|trans, url: path('app_library_quiz')},
    {label: 'quizLibraryPageHeading'|trans, url: path('app_library_quiz')},
] %}

{% for ancestor in ancestors|default([]) %}
    {% set segments = segments|merge([{label: ancestor.name, url: path('app_library_quiz_folder', {folderId: ancestor.id})}]) %}
{% endfor %}

{% if currentFolder is defined and currentFolder %}
    {% set segments = segments|merge([{label: currentFolder.name, url: path('app_library_quiz_folder', {folderId: currentFolder.id})}]) %}
{% elseif searchTerms is defined %}
    {% set segments = segments|merge([{label: 'quizLibrarySearchResultsHeading'|trans, url: path('app_library_quiz_search', {q: searchTerms})}]) %}
{% endif %}

{% include '_breadcrumb.html.twig' with {segments: segments} %}
