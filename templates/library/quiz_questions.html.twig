{% extends 'layout/app.html.twig' %}

{% block title %}{{ quizTemplate.name }}{% endblock %}

{% block page_breadcrumb %}
    {% include 'library/_quiz_trail.html.twig' with {folderTrail: folderTrail, tail: [
        {label: quizTemplate.name, url: app.request.requestUri},
    ]} only %}
{% endblock %}
{% block page_title %}{{ quizTemplate.name }}{% endblock %}

{% block main %}
    {% include '_tabs.html.twig' with {
        tabs: [
            {url: path('app_library_quiz_settings', {id: quizTemplate.id}), label: 'quizTabSettingsLabel'|trans, active: false},
            {url: path('app_library_quiz_questions', {id: quizTemplate.id}), label: 'quizTabQuestionsLabel'|trans, active: true},
            {url: path('app_library_quiz_test', {id: quizTemplate.id}), label: 'quizTabTestLabel'|trans, active: false},
        ],
        tabs_action: 'library/_quiz_questions_new_button.html.twig',
    } %}
    <div class="card cm-card--tabbed">
        <div class="card-body">
            <div class="row g-4">
                <div class="col-12 col-lg-5 d-flex flex-column gap-2">
                    <div class="d-flex align-items-center gap-2">
                        <span class="fw-bold">{{ totalQuestions }} {{ 'quizQuestionsCountLabel'|trans }}</span>
                        <form method="get" class="ms-auto d-flex gap-2">
                            <select name="difficulty" class="form-select form-select-sm" onchange="this.form.submit()">
                                <option value="">{{ 'quizFilterAllDifficultiesLabel'|trans }}</option>
                                <option value="facile" {{ difficultyFilter and difficultyFilter.value == 'facile' ? 'selected' }}>{{ 'questionDifficultyFacileLabel'|trans }}</option>
                                <option value="moyen" {{ difficultyFilter and difficultyFilter.value == 'moyen' ? 'selected' }}>{{ 'questionDifficultyMoyenLabel'|trans }}</option>
                                <option value="difficile" {{ difficultyFilter and difficultyFilter.value == 'difficile' ? 'selected' }}>{{ 'questionDifficultyDifficileLabel'|trans }}</option>
                            </select>
                            <select name="type" class="form-select form-select-sm" onchange="this.form.submit()">
                                <option value="">{{ 'quizFilterAllTypesLabel'|trans }}</option>
                                <option value="qcm" {{ typeFilter and typeFilter.value == 'qcm' ? 'selected' }}>{{ 'questionTypeQcmLabel'|trans }}</option>
                                <option value="qcm_multi" {{ typeFilter and typeFilter.value == 'qcm_multi' ? 'selected' }}>{{ 'questionTypeQcmMultiLabel'|trans }}</option>
                                <option value="vrai_faux" {{ typeFilter and typeFilter.value == 'vrai_faux' ? 'selected' }}>{{ 'questionTypeVraiFauxLabel'|trans }}</option>
                                <option value="image" {{ typeFilter and typeFilter.value == 'image' ? 'selected' }}>{{ 'questionTypeImageLabel'|trans }}</option>
                                <option value="ordre" {{ typeFilter and typeFilter.value == 'ordre' ? 'selected' }}>{{ 'questionTypeOrdreLabel'|trans }}</option>
                                <option value="texte_a_trous" {{ typeFilter and typeFilter.value == 'texte_a_trous' ? 'selected' }}>{{ 'questionTypeTexteATrousLabel'|trans }}</option>
                                <option value="zone" {{ typeFilter and typeFilter.value == 'zone' ? 'selected' }}>{{ 'questionTypeZoneLabel'|trans }}</option>
                                <option value="legende" {{ typeFilter and typeFilter.value == 'legende' ? 'selected' }}>{{ 'questionTypeLegendeLabel'|trans }}</option>
                                <option value="apparier" {{ typeFilter and typeFilter.value == 'apparier' ? 'selected' }}>{{ 'questionTypeApparierLabel'|trans }}</option>
                                <option value="numerique" {{ typeFilter and typeFilter.value == 'numerique' ? 'selected' }}>{{ 'questionTypeNumeriqueLabel'|trans }}</option>
                                <option value="calculee" {{ typeFilter and typeFilter.value == 'calculee' ? 'selected' }}>{{ 'questionTypeCalculeeLabel'|trans }}</option>
                                <option value="reponse_courte" {{ typeFilter and typeFilter.value == 'reponse_courte' ? 'selected' }}>{{ 'questionTypeReponseCourteLabel'|trans }}</option>
                            </select>
                        </form>
                    </div>
                    {% if incompleteCount > 0 %}
                        {# The questions that are not playable yet, named rather than removed: the
                           launch screen refuses to start while one is left, and a question that
                           disappeared from a draw without saying so would read as a bug. #}
                        <div class="cm-audio-warn">{{ 'quizQuestionsIncompleteBannerTemplate'|trans({'%count%': incompleteCount}) }}</div>
                    {% endif %}
                    <div class="cm-qbank">
                        {# `questions` is one page, keyed by position in the full filtered bank, so
                           the index column keeps counting 12, 13, 14… across pages. #}
                        {% for position, question in questions %}
                            <a href="{{ path('app_library_quiz_questions', {id: quizTemplate.id, question: question.id}) }}" class="cm-qbank__row{{ selectedQuestion and selectedQuestion.id == question.id ? ' is-active' }}">
                                <span class="cm-qbank__index">{{ position + 1 }}</span>
                                <span class="badge bg-blue-lt">{{ question.type.shortLabelKey|trans }}</span>
                                <span class="cm-qbank__label">{{ question.label|length ? question.label : '—' }}</span>
                                {% if gapsByQuestion[question.id] is defined %}
                                    <span class="cm-audio-pill cm-audio-pill--draft">{{ gapsByQuestion[question.id].labelKey|trans }}</span>
                                {% endif %}
                                <span class="cm-qbank__dots cm-diffdots">
                                    {% for i in 1..3 %}<span class="{{ i <= question.effectiveDifficulty.dotCount ? 'is-filled' }}"></span>{% endfor %}
                                </span>
                            </a>
                        {% else %}
                            <div class="p-3 text-secondary">{{ 'quizQuestionsEmptyMessage'|trans }}</div>
                        {% endfor %}
                    </div>
                    {% if pageCount > 1 %}
                        <div class="d-flex align-items-center gap-2">
                            <span class="text-secondary small">{{ 'quizQuestionsBankRangeTemplate'|trans({
                                '%from%': questions|keys|first + 1,
                                '%to%': questions|keys|last + 1,
                                '%total%': totalQuestions,
                            }) }}</span>
                            <div class="ms-auto d-flex gap-1">
                                {% for target in 1..pageCount %}
                                    <a href="{{ path('app_library_quiz_questions', {id: quizTemplate.id, page: target, difficulty: difficultyFilter ? difficultyFilter.value, type: typeFilter ? typeFilter.value}) }}"
                                       class="btn btn-sm {{ target == page ? 'btn-primary' : 'btn-outline-secondary' }}">{{ target }}</a>
                                {% endfor %}
                            </div>
                        </div>
                    {% endif %}
                    <div class="text-secondary small">{{ 'quizQuestionsBankHintText'|trans }}</div>
                    <div class="d-flex gap-3 flex-wrap">
                        {# One file for the whole bank, whatever its questions are made of - it used
                           to take four downloads and still could not carry a mixed quiz. #}
                        <a class="small" href="{{ path('app_library_quiz_export', {id: quizTemplate.id}) }}">{{ 'quizExportLinkLabel'|trans }}</a>
                    </div>
                </div>
                <div class="col-12 col-lg-7">
                    {% if selectedQuestion %}
                        {{ form_start(form, {action: path('app_library_quiz_questions_save', {id: quizTemplate.id, questionId: selectedQuestion.id})}) }}
                        {{ form_errors(form) }}
                        <div class="d-flex align-items-baseline border-bottom pb-2 mb-3">
                            <div>
                                <div style="font: 600 16px var(--cm-font-title); color: var(--cm-ink);">{{ 'quizQuestionHeadingTemplate'|trans({'%number%': selectedQuestionNumber}) }}</div>
                                <div class="text-secondary small">{{ selectedQuestion.type.labelKey|trans }}</div>
                            </div>
                            <div class="ms-auto d-flex gap-3">
                                <button type="submit" form="quiz-question-duplicate-{{ selectedQuestion.id }}" class="cm-action--neutral" style="background:none;border:0;padding:0;">{{ 'quizActionDuplicateLabel'|trans }}</button>
                                <button type="submit" form="quiz-question-remove-{{ selectedQuestion.id }}" class="cm-action--danger" style="background:none;border:0;padding:0;" onclick="return confirm('{{ 'quizQuestionRemoveConfirmMessage'|trans|e('js') }}')">{{ 'quizActionRemoveLabel'|trans }}</button>
                            </div>
                        </div>
                        {# Field order follows the créa (1b/2a): Type + Difficulté, then the
                           statement, then whatever that type needs below it. #}
                        <div data-controller="quiz-question-editor"
                             data-action="quiz-zone-editor:kindChanged@window->quiz-question-editor#applyTypeMode"
                             data-quiz-question-editor-true-label-value="{{ 'answerTrueLabel'|trans }}"
                             data-quiz-question-editor-false-label-value="{{ 'answerFalseLabel'|trans }}"
                             data-quiz-question-editor-hint-default-value="{{ 'quizQuestionAnswersFieldHint'|trans }}"
                             data-quiz-question-editor-hint-ordre-value="{{ 'quizQuestionAnswersFieldHintOrdre'|trans }}"
                             data-quiz-question-editor-label-enonce-value="{{ 'quizQuestionLabelFieldLabel'|trans }}"
                             data-quiz-question-editor-label-blanks-value="{{ 'quizBlankTextFieldLabel'|trans }}"
                             data-quiz-question-editor-label-calculee-value="{{ 'quizNumericStatementFieldLabel'|trans }}"
                             data-quiz-question-editor-hint-calculee-value="{{ 'quizNumericStatementFieldHint'|trans }}"
                             class="d-flex flex-column gap-3">
                            <div class="row g-3">
                                <div class="col-6 d-flex flex-column gap-1">
                                    {{ form_label(form.type) }}
                                    {{ form_widget(form.type, {attr: {'data-quiz-question-editor-target': 'typeSelect', 'data-action': 'change->quiz-question-editor#typeChanged'}}) }}
                                </div>
                                <div class="col-6 d-flex flex-column gap-1">
                                    {{ form_label(form.difficulty) }}
                                    <div class="cm-diffpicker">{{ form_widget(form.difficulty) }}</div>
                                </div>
                                {# Time for THIS question. « Valeur du quiz » by default: the quiz's own
                                   setting stays the answer as long as it is not contradicted here. The
                                   entry in seconds only appears for « Défini ». #}
                                <div class="col-12 d-flex flex-column gap-1" data-controller="radio-reveal">
                                    {{ form_label(form.timeMode) }}
                                    <div class="cm-choice-group d-flex flex-wrap align-items-center gap-3">
                                        {# The bootstrap_5 theme's radio_widget already emits its own
                                           .form-check wrapper and label - adding one here rendered the
                                           label twice, beside the radio and again underneath. #}
                                        {% for choice in form.timeMode %}
                                            {{ form_widget(choice, {
                                                parent_label_class: 'radio-inline',
                                                attr: {'data-radio-reveal-target': 'radio', 'data-action': 'change->radio-reveal#refresh'},
                                            }) }}
                                        {% endfor %}
                                        {% do form.timeMode.setRendered %}
                                        <div data-radio-reveal-target="panel" data-radio-reveal-for="fixed" style="max-width: 220px;">
                                            {{ form_row(form.timeSeconds, {label: false}) }}
                                        </div>
                                    </div>
                                </div>
                            </div>

                            {# The statement and the "texte à compléter" are the same field: for a
                               texte à trous the wrapper gains .is-blanks, which reveals the layer
                               that paints the "..." markers as chips behind the textarea. #}
                            <div data-controller="quiz-blanks-editor quiz-zone-editor"
                                 data-action="quiz-question-editor:typeChanged@window->quiz-zone-editor#typeChanged"
                                 data-quiz-zone-editor-correct-value="{{ selectedQuestion.zoneCorrectIds|json_encode }}"
                                 data-quiz-zone-editor-hint-value="{{ selectedQuestion.zoneHintIds|json_encode }}"
                                 {# JSON_FORCE_OBJECT: an empty PHP array encodes as [], which a
                                    Stimulus Object value refuses to parse (known gotcha). These
                                    three are maps, so forcing the object shape is always right. #}
                                 data-quiz-zone-editor-feedback-value="{{ (selectedQuestion.zoneConfig.feedback|default({}))|json_encode(constant('JSON_FORCE_OBJECT')) }}"
                                 data-quiz-zone-editor-labels-value="{{ selectedQuestion.zoneLabels|json_encode(constant('JSON_FORCE_OBJECT')) }}"
                                 data-quiz-zone-editor-markers-value="{{ selectedQuestion.zoneMarkers|json_encode(constant('JSON_FORCE_OBJECT')) }}"
                                 data-quiz-zone-editor-count-template-value="{{ 'quizZoneDetectedCountTemplate'|trans }}"
                                 data-quiz-zone-editor-count-empty-text-value="{{ 'quizZoneNoneDetectedText'|trans }}"
                                 data-quiz-zone-editor-feedback-placeholder-value="{{ 'quizZoneFeedbackPlaceholder'|trans }}"
                                 data-quiz-zone-editor-label-placeholder-value="{{ 'quizZoneLabelPlaceholder'|trans }}"
                                 data-quiz-zone-editor-hint-zone-text-value="{{ 'quizZoneRowsHintZone'|trans }}"
                                 data-quiz-zone-editor-hint-legende-text-value="{{ 'quizZoneRowsHintLegende'|trans }}"
                                 data-quiz-zone-editor-remove-label-value="{{ 'quizActionRemoveLabel'|trans }}"
                                 data-quiz-blanks-editor-blank-label-value="{{ 'quizBlankIndexLabel'|trans }}"
                                 data-quiz-blanks-editor-count-template-value="{{ 'quizBlankDetectedCountTemplate'|trans }}"
                                 data-quiz-blanks-editor-count-empty-text-value="{{ 'quizBlankNoneDetectedText'|trans }}"
                                 data-quiz-blanks-editor-variant-add-label-value="{{ 'quizBlankAddVariantLabel'|trans }}"
                                 data-quiz-blanks-editor-distractor-add-label-value="{{ 'quizBlankAddDistractorLabel'|trans }}"
                                 data-quiz-blanks-editor-answer-placeholder-value="{{ 'quizBlankAnswerPlaceholder'|trans }}"
                                 data-quiz-blanks-editor-word-placeholder-value="{{ 'quizBlankWordPlaceholder'|trans }}"
                                 data-quiz-blanks-editor-answers-hint-banque-value="{{ 'quizBlankAnswersFieldHintBanque'|trans }}"
                                 data-quiz-blanks-editor-answers-hint-libre-value="{{ 'quizBlankAnswersFieldHintLibre'|trans }}"
                                 data-quiz-blanks-editor-answers-value="{{ selectedQuestion.blankAnswers|json_encode }}"
                                 data-quiz-blanks-editor-distractor-list-value="{{ selectedQuestion.distractors|json_encode }}"
                                 class="d-flex flex-column gap-3">
                                <div class="d-flex flex-column gap-1">
                                    <label class="form-label mb-0" for="{{ form.label.vars.id }}">
                                        <span data-quiz-question-editor-target="labelText">{{ 'quizQuestionLabelFieldLabel'|trans }}</span>
                                        <span class="fw-normal text-secondary" data-quiz-question-editor-target="labelHint">{{ 'quizBlankTextFieldHint'|trans }}</span>
                                    </label>
                                    <div class="cm-blanks-field" data-quiz-question-editor-target="labelField">
                                        <div class="cm-blanks-field__highlight" data-quiz-blanks-editor-target="highlight" aria-hidden="true"></div>
                                        {{ form_widget(form.label, {attr: {
                                            class: 'cm-blanks-field__input',
                                            rows: 3,
                                            'data-quiz-blanks-editor-target': 'input',
                                            'data-action': 'input->quiz-blanks-editor#refresh',
                                        }}) }}
                                    </div>
                                    {{ form_errors(form.label) }}
                                    <div class="cm-blanks-count" data-quiz-blanks-editor-target="count" data-quiz-question-editor-target="blankCount"></div>
                                </div>

                                <div data-quiz-question-editor-target="blanksSection" class="d-none">
                                    {% include 'library/_quiz_blanks_editor.html.twig' with {question: selectedQuestion, blank_modes: blank_modes} only %}
                                </div>

                                <div data-quiz-question-editor-target="zoneSection" class="d-none">
                                    {% include 'library/_quiz_zone_editor.html.twig' with {question: selectedQuestion, zone_kinds: zone_kinds} only %}
                                </div>

                                <div data-quiz-question-editor-target="matchingSection" class="d-none">
                                    {% include 'library/_quiz_matching_editor.html.twig' with {question: selectedQuestion, matching_side_kinds: matching_side_kinds} only %}
                                </div>

                                <div data-quiz-question-editor-target="numericSection" class="d-none">
                                    {% include 'library/_quiz_numeric_editor.html.twig' with {question: selectedQuestion, tolerance_modes: tolerance_modes} only %}
                                </div>

                                <div data-quiz-question-editor-target="shortAnswerSection" class="d-none">
                                    {% include 'library/_quiz_short_answer_editor.html.twig' with {question: selectedQuestion} only %}
                                </div>

                                {# Shared by the classic types AND the zones types' image support -
                                   which is why it sits outside classicSection (a form field can
                                   only render once). #}
                                <div class="d-flex flex-column gap-1" data-quiz-question-editor-target="imageSection">
                                    {% if selectedQuestion.expectedMediaName %}
                                        {# The name an import was given for a picture it could not
                                           deposit. Attaching a file here is what closes it. #}
                                        <div class="cm-audio-warn">{{ 'quizQuestionAwaitedMediaTemplate'|trans({'%name%': selectedQuestion.expectedMediaName}) }}</div>
                                    {% endif %}
                                    {# The editor's own image drop zone gave way to the platform's one
                                       component (App\Form\FilePickerType). What is lost is the local
                                       preview before saving; what is gained is that the image is
                                       already deposited, typed and scanned by the time the question
                                       is saved, instead of being refused afterwards. #}
                                    {{ form_widget(form.imageFile) }}
                                    {% if selectedQuestion.imageStorageKey %}
                                        <img src="{{ file_url(selectedQuestion.imageStorageKey) }}" alt="" class="cm-imagedrop__preview" data-quiz-question-editor-target="imagePreview">
                                        <div>{{ form_row(form.removeImage) }}</div>
                                    {% else %}
                                        <img src="" alt="" class="cm-imagedrop__preview" data-quiz-question-editor-target="imagePreview" hidden>
                                        {# No image to remove - still render the (unmapped) field so form_rest() below doesn't fall back to rendering it unstyled. #}
                                        <div hidden>{{ form_widget(form.removeImage) }}</div>
                                    {% endif %}
                                </div>

                                <div data-quiz-question-editor-target="classicSection">
                                    <div class="d-flex flex-column gap-3">
                                        <div class="d-flex flex-column gap-2">
                                            <label class="form-label mb-0">{{ 'quizQuestionAnswersFieldLabel'|trans }} <span class="text-secondary fw-normal">— <span data-quiz-question-editor-target="hintText">{{ (selectedQuestion.type.value == 'ordre' ? 'quizQuestionAnswersFieldHintOrdre' : 'quizQuestionAnswersFieldHint')|trans }}</span></span></label>
                                            <div class="cm-answers" data-quiz-question-editor-target="answerList">
                                                {% for answer in selectedQuestion.answers %}
                                                    <div class="cm-answer-row" data-quiz-question-editor-target="answerRow">
                                                        <button type="button" class="cm-answer-toggle{{ answer.correct ? ' is-correct' }}" data-quiz-question-editor-target="correctToggle" data-action="click->quiz-question-editor#toggleCorrect">✓</button>
                                                        <input type="hidden" name="answers[{{ loop.index0 }}][correct]" value="{{ answer.correct ? '1' : '0' }}" data-quiz-question-editor-target="correctInput">
                                                        <input type="text" class="cm-answer-input" name="answers[{{ loop.index0 }}][label]" value="{{ answer.label }}" placeholder="{{ 'quizAnswerTextPlaceholder'|trans }}"{{ selectedQuestion.type.value == 'vrai_faux' ? ' readonly' }}>
                                                        <select class="form-select form-select-sm cm-answer-position" data-quiz-question-editor-target="positionSelect" data-action="change->quiz-question-editor#positionChanged"></select>
                                                        <button type="button" class="cm-answer-move" data-action="click->quiz-question-editor#moveUp">▲</button>
                                                        <button type="button" class="cm-answer-move" data-action="click->quiz-question-editor#moveDown">▼</button>
                                                        <button type="button" class="cm-answer-remove" data-action="click->quiz-question-editor#removeAnswer">✕</button>
                                                    </div>
                                                {% endfor %}
                                            </div>
                                            <button type="button" class="btn btn-link p-0 align-self-start" data-quiz-question-editor-target="addAnswerButton" data-action="click->quiz-question-editor#addAnswer">{{ 'quizAnswerAddButtonLabel'|trans }}</button>
                                            <template data-quiz-question-editor-target="answerTemplate">
                                                <div class="cm-answer-row" data-quiz-question-editor-target="answerRow">
                                                    <button type="button" class="cm-answer-toggle" data-quiz-question-editor-target="correctToggle" data-action="click->quiz-question-editor#toggleCorrect">✓</button>
                                                    <input type="hidden" value="0" data-quiz-question-editor-target="correctInput" data-name-template="answers[__INDEX__][correct]">
                                                    <input type="text" class="cm-answer-input" placeholder="{{ 'quizAnswerTextPlaceholder'|trans }}" data-name-template="answers[__INDEX__][label]">
                                                    <select class="form-select form-select-sm cm-answer-position" data-quiz-question-editor-target="positionSelect" data-action="change->quiz-question-editor#positionChanged"></select>
                                                    <button type="button" class="cm-answer-move" data-action="click->quiz-question-editor#moveUp">▲</button>
                                                    <button type="button" class="cm-answer-move" data-action="click->quiz-question-editor#moveDown">▼</button>
                                                    <button type="button" class="cm-answer-remove" data-action="click->quiz-question-editor#removeAnswer">✕</button>
                                                </div>
                                            </template>
                                        </div>
                                    </div>
                                </div>

                                {# Last, and shared by every type: it is about the correction, not
                                   about answering, so it never sits between the statement and its
                                   answers. #}
                                {{ form_row(form.explanation) }}
                            </div>
                        </div>
                        <div class="cm-actionbar">
                            {% include '_last_modified_meta.html.twig' with {entity: quizTemplate} %}
                            <div class="cm-actionbar__buttons">
                                <a href="{{ path('app_library_quiz_questions', {id: quizTemplate.id}) }}" class="btn btn-link">{{ 'cancelAction'|trans }}</a>
                                {{ form_widget(form.submit) }}
                            </div>
                        </div>
                        {{ form_rest(form) }}
                        {{ form_end(form) }}

                        <form id="quiz-question-duplicate-{{ selectedQuestion.id }}" method="post" action="{{ path('app_library_quiz_questions_duplicate', {id: quizTemplate.id, questionId: selectedQuestion.id}) }}" hidden>
                            <input type="hidden" name="_token" value="{{ csrf_token('library_quiz_questions_duplicate') }}">
                        </form>
                        <form id="quiz-question-remove-{{ selectedQuestion.id }}" method="post" action="{{ path('app_library_quiz_questions_remove', {id: quizTemplate.id, questionId: selectedQuestion.id}) }}" hidden>
                            <input type="hidden" name="_token" value="{{ csrf_token('library_quiz_questions_remove') }}">
                        </form>
                    {% else %}
                        <div class="text-secondary">{{ 'quizQuestionsNoSelectionMessage'|trans }}</div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
{% endblock %}
