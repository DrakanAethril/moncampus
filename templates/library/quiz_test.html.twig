{% extends 'layout/app.html.twig' %}

{% block title %}{{ quizTemplate.name }}{% endblock %}

{% block page_breadcrumb %}
    {% include '_breadcrumb.html.twig' with {segments: [
        {label: 'homeNavLabel'|trans, url: path('app_home')},
        {label: 'quizLibraryPageHeading'|trans, url: path('app_library_quiz')},
        {label: quizTemplate.name, url: app.request.requestUri},
    ]} %}
{% endblock %}
{% block page_title %}{{ quizTemplate.name }}{% endblock %}

{% block main %}
    {% include '_tabs.html.twig' with {
        tabs: [
            {url: path('app_library_quiz_settings', {id: quizTemplate.id}), label: 'quizTabSettingsLabel'|trans, active: false},
            {url: path('app_library_quiz_questions', {id: quizTemplate.id}), label: 'quizTabQuestionsLabel'|trans, active: false},
            {url: path('app_library_quiz_test', {id: quizTemplate.id}), label: 'quizTabTestLabel'|trans, active: true},
        ],
    } %}
    <div class="card cm-card--tabbed">
        <div class="card-body">
            {% if questions|length == 0 %}
                <div class="text-secondary">{{ 'quizTestEmptyMessage'|trans }}</div>
            {% else %}
                {% if submitted %}
                    <div class="cm-note mb-3">
                        <span class="cm-note__icon">i</span>
                        <div>{{ 'quizTestScoreSummaryTemplate'|trans({'%correct%': correctCount, '%total%': questions|length}) }}</div>
                    </div>
                {% endif %}
                <form method="get" action="{{ path('app_library_quiz_test', {id: quizTemplate.id}) }}" class="d-flex flex-column gap-4">
                    <input type="hidden" name="submitted" value="1">
                    {% for question in questions %}
                        {% set result = results[question.id] ?? null %}
                        <div class="d-flex flex-column gap-2 {{ not loop.last ? 'border-bottom pb-4' }}">
                            <div class="d-flex align-items-baseline gap-2">
                                <div style="font: 600 15px var(--cm-font-title); color: var(--cm-ink);">{{ 'quizQuestionHeadingTemplate'|trans({'%number%': loop.index}) }}</div>
                                {% if result %}
                                    <span class="badge {{ result.isCorrect ? 'bg-success-lt' : 'bg-danger-lt' }}">{{ (result.isCorrect ? 'quizTestCorrectBadgeLabel' : 'quizTestIncorrectBadgeLabel')|trans }}</span>
                                {% endif %}
                            </div>
                            {% if question.type.value != 'texte_a_trous' %}
                                <div>{{ question.label }}</div>
                                {% if question.imageStorageKey %}
                                    <img src="{{ file_url(question.imageStorageKey) }}" alt="" style="max-height:200px;border-radius:8px;">
                                {% endif %}
                            {% endif %}

                            {% if question.type.value == 'texte_a_trous' %}
                                {% if submitted %}
                                    {# Reveal mode: the statement replayed with what was typed, plus every accepted variant. #}
                                    {% set blankResults = blank_results(question, result.blankResponses) %}
                                    <div class="cm-blanks-text">
                                        {%- for segment in question.blankSegments -%}
                                            {%- if segment.type == 'text' -%}
                                                {{- segment.value -}}
                                            {%- else -%}
                                                <span class="cm-blank-slot {{ blankResults[segment.index] ? 'cm-blank-slot--correct' : 'cm-blank-slot--wrong' }}">
                                                    {{- result.blankResponses[segment.index]|default('') ?: '—' -}}
                                                </span>
                                            {%- endif -%}
                                        {%- endfor -%}
                                    </div>
                                    {% for index, variants in question.blankAnswers %}
                                        <div class="cm-blank-expected">
                                            {{ 'quizBlankIndexLabel'|trans({'%number%': index + 1}) }} — {{ 'quizBlankExpectedAnswersTemplate'|trans({'%answers%': variants|join(', ')}) }}
                                        </div>
                                    {% endfor %}
                                {% else %}
                                    <div data-controller="quiz-blanks-take"
                                         data-quiz-blanks-take-mode-value="{{ question.blankMode.value }}"
                                         data-quiz-blanks-take-count-template-value="{{ 'quizBlankFilledCountTemplate'|trans }}"
                                         class="d-flex flex-column gap-3">
                                        {% include 'program/_quiz_blanks_take.html.twig' with {
                                            question: question,
                                            word_bank: wordBanks[question.id]|default([]),
                                            field_prefix: 'blanks[' ~ question.id ~ ']',
                                        } only %}
                                    </div>
                                {% endif %}
                            {% elseif question.type.value in ['zone', 'legende'] %}
                                {% if submitted %}
                                    {# Reveal mode: the support with the expected zones in green, a
                                       wrongly clicked/placed one in red - through the same partial
                                       and the same rules as the real passation. #}
                                    {% set states = {} %}
                                    {% set placed = {} %}
                                    {% if question.type.value == 'zone' %}
                                        {% for zoneId in question.zoneCorrectIds %}
                                            {% set states = states|merge({(zoneId): 'good'}) %}
                                        {% endfor %}
                                        {% for zoneId in result.zoneResponses %}
                                            {% if zoneId not in question.zoneCorrectIds %}
                                                {% set states = states|merge({(zoneId): 'bad'}) %}
                                            {% endif %}
                                        {% endfor %}
                                    {% else %}
                                        {% set zoneResults = zone_results(question, result.zoneResponses) %}
                                        {% set choiceTexts = {} %}
                                        {% for choice in question.legendeChoices %}
                                            {% set choiceTexts = choiceTexts|merge({(choice.key): choice.text}) %}
                                        {% endfor %}
                                        {% for zoneId, isRight in zoneResults %}
                                            {% set states = states|merge({(zoneId): isRight ? 'good' : 'bad'}) %}
                                            {% if result.zoneResponses[zoneId]|default('') is not empty %}
                                                {% set placed = placed|merge({(zoneId): choiceTexts[result.zoneResponses[zoneId]]|default('—')}) %}
                                            {% endif %}
                                        {% endfor %}
                                    {% endif %}
                                    {% include 'quiz/_zone_support.html.twig' with {
                                        question: question,
                                        states: states,
                                        placed: placed,
                                        image_url: question.imageStorageKey ? file_url(question.imageStorageKey) : null,
                                    } only %}
                                {% elseif question.type.value == 'zone' %}
                                    <div data-controller="quiz-zone-take"
                                         data-quiz-zone-take-field-name-value="zones[{{ question.id }}]"
                                         data-quiz-zone-take-hint-ids-value="[]"
                                         class="d-flex flex-column gap-3">
                                        {% include 'program/_quiz_zone_take.html.twig' with {
                                            question: question,
                                            image_url: question.imageStorageKey ? file_url(question.imageStorageKey) : null,
                                            hint_ids: [],
                                        } only %}
                                    </div>
                                {% else %}
                                    <div data-controller="quiz-legende-take"
                                         data-quiz-legende-take-field-name-value="placements[{{ question.id }}]"
                                         data-quiz-legende-take-count-template-value="{{ 'quizLegendePlacedCountTemplate'|trans }}"
                                         class="d-flex flex-column gap-3">
                                        {% include 'program/_quiz_legende_take.html.twig' with {
                                            question: question,
                                            image_url: question.imageStorageKey ? file_url(question.imageStorageKey) : null,
                                            zone_choices: zoneChoiceSets[question.id]|default([]),
                                        } only %}
                                    </div>
                                {% endif %}
                            {% elseif question.type.value == 'apparier' %}
                                {% if submitted %}
                                    {# Reveal mode: each pair with what was placed on it, green or
                                       red, the expected item beside it - through the same partial
                                       and the same rules as the real passation. #}
                                    {% set matchingResults = matching_results(question, result.matchingResponses) %}
                                    {% set choicesByKey = {} %}
                                    {% for choice in question.matchingChoices %}
                                        {% set choicesByKey = choicesByKey|merge({(choice.key): choice}) %}
                                    {% endfor %}
                                    {% set placed = {} %}
                                    {% for pairId, key in result.matchingResponses %}
                                        {% set placed = placed|merge({(pairId): choicesByKey[key]|default({text: '—', image: null})}) %}
                                    {% endfor %}
                                    {% include 'quiz/_matching_board.html.twig' with {
                                        question: question,
                                        results: matchingResults,
                                        placed: placed,
                                        reveal: true,
                                    } only %}
                                {% else %}
                                    <div data-controller="quiz-apparier-take"
                                         data-quiz-apparier-take-field-name-value="pairs[{{ question.id }}]"
                                         data-quiz-apparier-take-count-template-value="{{ 'quizApparierPlacedCountTemplate'|trans }}"
                                         class="d-flex flex-column gap-3">
                                        {% include 'program/_quiz_apparier_take.html.twig' with {
                                            question: question,
                                            matching_pairs: matchingPairSets[question.id]|default([]),
                                            matching_choices: matchingChoiceSets[question.id]|default([]),
                                        } only %}
                                    </div>
                                {% endif %}
                            {% elseif submitted %}
                                {# Reveal mode - question.answers is always orderIndex ASC, which for "ordre" is exactly the correct sequence. #}
                                <div class="d-flex flex-column gap-2">
                                    {% for answer in question.answers %}
                                        <div class="cm-answer-row{{ (question.type.value == 'ordre' or answer.correct) ? ' border-success' }}">
                                            {% if question.type.value == 'ordre' %}<span class="cm-qbank__index">{{ loop.index }}</span>{% endif %}
                                            <span class="cm-answer-input" style="cursor:default;">{{ answer.label }}</span>
                                            {% if answer.correct %}<span class="text-success">✓</span>{% endif %}
                                        </div>
                                    {% endfor %}
                                </div>
                            {% elseif question.type.value == 'ordre' %}
                                <div class="cm-answers" data-controller="quiz-reorder">
                                    {% for answer in ordreAnswerOrder[question.id] %}
                                        <div class="cm-answer-row" data-quiz-reorder-target="row">
                                            <span class="cm-qbank__index">{{ loop.index }}</span>
                                            <span class="cm-answer-input" style="cursor:default;">{{ answer.label }}</span>
                                            <input type="hidden" name="answers[{{ question.id }}][]" value="{{ answer.id }}" data-quiz-reorder-target="input">
                                            <button type="button" class="cm-answer-move" data-action="click->quiz-reorder#moveUp">▲</button>
                                            <button type="button" class="cm-answer-move" data-action="click->quiz-reorder#moveDown">▼</button>
                                        </div>
                                    {% endfor %}
                                </div>
                                <div class="text-secondary small">{{ 'programQuizOrdreHintText'|trans }}</div>
                            {% else %}
                                {% set inputType = question.type.value == 'qcm_multi' ? 'checkbox' : 'radio' %}
                                <div class="d-flex flex-column gap-2">
                                    {% for answer in question.answers %}
                                        <label class="cm-radiocard">
                                            <input type="{{ inputType }}" name="answers[{{ question.id }}][]" value="{{ answer.id }}" class="form-check-input" style="position:absolute;opacity:0;width:1px;height:1px;">
                                            <span class="cm-radiocard__dot" style="{{ inputType == 'checkbox' ? 'border-radius:5px;' }}"></span>
                                            <span class="cm-radiocard__title" style="font-weight:400;">{{ answer.label }}</span>
                                        </label>
                                    {% endfor %}
                                </div>
                            {% endif %}
                        </div>
                    {% endfor %}

                    {% if not submitted %}
                        <div class="cm-actionbar">
                            <div class="cm-actionbar__buttons ms-auto">
                                <button type="submit" class="btn btn-primary">{{ 'quizTestSubmitAction'|trans }}</button>
                            </div>
                        </div>
                    {% endif %}
                </form>
            {% endif %}
        </div>
    </div>
{% endblock %}
