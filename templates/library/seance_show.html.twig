{% extends 'layout/app.html.twig' %}

{% block title %}{{ seanceTemplate.titre }} - {{ sequenceTemplate.titre }}{% endblock %}
{% block page_title %}{{ seanceTemplate.titre }}{% endblock %}

{% block page_actions %}
    {% if canEdit %}
        {# The same menu as the séquence's, scoped to this séance: what the prompt carries is this
           séance's objectives and its own déroulé, not the whole séquence's. #}
        <div class="dropdown d-inline-block">
            <button class="btn btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                {{ 'librarySequenceQuizMenuLabel'|trans }}
            </button>
            <ul class="dropdown-menu">
                <li><a class="dropdown-item" href="{{ path('app_library_quiz_assistant', {seance: seanceTemplate.id, mode: 'transpose'}) }}">{{ 'librarySequenceQuizTransposeActionLabel'|trans }}</a></li>
                <li><a class="dropdown-item" href="{{ path('app_library_quiz_assistant', {seance: seanceTemplate.id}) }}">{{ 'librarySeanceQuizGenerateActionLabel'|trans }}</a></li>
                <li><a class="dropdown-item" href="{{ path('app_library_quiz_assistant', {seance: seanceTemplate.id, live: 1}) }}">{{ 'librarySequenceQuizLiveActionLabel'|trans }}</a></li>
            </ul>
        </div>
        {# A séance alone is a real thing teachers exchange, so it carries its own « Partager » - and
           its own audience, separate from the séquence's
           (design/validated/content-sharing-between-teachers.md). canShare is the narrower of the
           two, so sitting inside canEdit costs nobody the button. #}
        {% if canShare %}
            <button type="button" class="btn btn-outline-secondary ms-2" data-bs-toggle="modal" data-bs-target="#content-share-modal">{{ 'contentShareAction'|trans }}</button>
        {% endif %}
        <a href="{{ path('app_library_seances_edit', {sequenceId: sequenceTemplate.id, id: seanceTemplate.id}) }}" class="btn btn-outline-secondary ms-2">{{ 'editActionLabel'|trans }}</a>
    {% endif %}
{% endblock %}

{% block main %}
    <div class="mb-3">
        <a href="{{ path('app_library_sequences_show', {id: sequenceTemplate.id}) }}" class="btn btn-link ps-0">{{ 'backToSequenceAction'|trans }}</a>
    </div>

    <div class="card mb-3">
        <div class="card-body">
            <dl class="row mb-0">
                <dt class="col-3">{{ 'seanceTemplateDureeFieldLabel'|trans }}</dt>
                <dd class="col-9">{{ seanceTemplate.duree ? seanceTemplate.duree|round|duration_minutes : '—' }}</dd>
                <dt class="col-3">{{ 'seanceTemplateEvaluationNatureFieldLabel'|trans }}</dt>
                <dd class="col-9">
                    {% if seanceTemplate.evaluationNature %}
                        <span class="cm-prog-tag cm-prog-tag--eval cm-prog-eval--{{ seanceTemplate.evaluationNature.slug }}" style="margin-left: 0;">{{ seanceTemplate.evaluationNature.labelKey|trans }}</span>
                    {% else %}
                        {{ 'seanceTemplateNoEvaluationLabel'|trans }}
                    {% endif %}
                </dd>
                {% if seanceTemplate.objectifs %}
                    <dt class="col-3">{{ 'seanceTemplateObjectifsFieldLabel'|trans }}</dt>
                    <dd class="col-9" style="white-space: pre-wrap;">{{ seanceTemplate.objectifs }}</dd>
                {% endif %}
                {% if seanceTemplate.avantDescription %}
                    <dt class="col-3">{{ 'seanceTemplateAvantDescriptionFieldLabel'|trans }}</dt>
                    <dd class="col-9" style="white-space: pre-wrap;">{{ seanceTemplate.avantDescription }}</dd>
                {% endif %}
                {% if seanceTemplate.apresDescription %}
                    <dt class="col-3">{{ 'seanceTemplateApresDescriptionFieldLabel'|trans }}</dt>
                    <dd class="col-9" style="white-space: pre-wrap;">{{ seanceTemplate.apresDescription }}</dd>
                {% endif %}
                {% if seanceTemplate.materials %}
                    <dt class="col-3">{{ 'seanceTemplateMaterialsFieldLabel'|trans }}</dt>
                    <dd class="col-9" style="white-space: pre-wrap;">{{ seanceTemplate.materials }}</dd>
                {% endif %}
                {% if seanceTemplate.watchPoints %}
                    <dt class="col-3">{{ 'seanceTemplateWatchPointsFieldLabel'|trans }}</dt>
                    <dd class="col-9" style="white-space: pre-wrap;">{{ seanceTemplate.watchPoints }}</dd>
                {% endif %}
                {% if seanceTemplate.cahierDeTexteDescription %}
                    <dt class="col-3">{{ 'seanceTemplateCahierDeTexteDescriptionFieldLabel'|trans }}</dt>
                    {# The only field of the séance entered as rich text: it is rendered as is, with no
                       pre-wrap, the formatting being carried by the HTML itself. #}
                    <dd class="col-9">{{ seanceTemplate.cahierDeTexteDescription|raw }}</dd>
                {% endif %}
            </dl>
        </div>
    </div>

    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h3 class="card-title mb-0">{{ 'libraryPhasesSectionTitle'|trans }}</h3>
            {% if canEdit %}
                <a href="{{ path('app_library_phases_new', {sequenceId: sequenceTemplate.id, seanceId: seanceTemplate.id}) }}" class="btn btn-sm btn-primary">{{ 'seancePhaseTemplateNewButtonLabel'|trans }}</a>
            {% endif %}
        </div>
        <div class="table-responsive">
            <table class="table table-vcenter card-table">
                <thead>
                    <tr>
                        <th class="w-1">{{ 'seancePhaseTemplateOrdreFieldLabel'|trans }}</th>
                        <th>{{ 'seancePhaseTemplateNomFieldLabel'|trans }}</th>
                        <th>{{ 'seancePhaseTemplateDureeFieldLabel'|trans }}</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody{% if canEdit %} data-controller="sortable-reorder" data-sortable-reorder-url-value="{{ path('app_library_phases_reorder', {sequenceId: sequenceTemplate.id, seanceId: seanceTemplate.id}) }}" data-sortable-reorder-token-value="{{ csrf_token('library_phases_reorder') }}"{% endif %}>
                    {% for phase in seanceTemplate.seancePhaseTemplates %}
                        <tr{% if canEdit %} data-sortable-reorder-id-param="{{ phase.id }}"{% endif %}>
                            <td>
                                {% if canEdit %}<span class="sortable-reorder-handle" style="cursor: grab; color: var(--cm-faint, #8a99a6); margin-right: 6px;">⠿</span>{% endif %}{{ phase.ordre }}
                            </td>
                            <td><a href="{{ path('app_library_phases_show', {sequenceId: sequenceTemplate.id, seanceId: seanceTemplate.id, id: phase.id}) }}">{{ phase.nom }}</a></td>
                            <td>{{ phase.duree ? phase.duree|round|duration_minutes : '—' }}</td>
                            <td class="cm-actions">
                                {% if canEdit %}
                                    <a href="{{ path('app_library_phases_edit', {sequenceId: sequenceTemplate.id, seanceId: seanceTemplate.id, id: phase.id}) }}" class="cm-action--warning">{{ 'editActionLabel'|trans }}</a>
                                    <form method="post" action="{{ path('app_library_phases_remove', {sequenceId: sequenceTemplate.id, seanceId: seanceTemplate.id, id: phase.id}) }}" onsubmit="return confirm('{{ 'removeSeancePhaseTemplateConfirmMessage'|trans|e('js') }}')">
                                        <input type="hidden" name="_token" value="{{ csrf_token('library_phases_remove') }}">
                                        <button type="submit" class="cm-action--danger">{{ 'removeActionLabel'|trans }}</button>
                                    </form>
                                {% endif %}
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="4" class="text-secondary">{{ 'libraryPhasesEmptyMessage'|trans }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

    {# « Quiz de la séance », the same card as the séquence's, scoped to this séance. What its
       « Détacher » leaves behind is the whole difference between the two levels: it removes this
       séance's link and nothing else, so a quiz the séquence names as well stays named by it
       (App\Service\SequenceQuizLinker). The badge says which ones those are.

       These quizzes are raised into the séquence's own card, deduplicated - a quiz attached to both
       levels is listed once there (App\Service\SequenceQuizBoard). #}
    <div class="card mt-3">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h3 class="card-title mb-0">{{ 'librarySeanceQuizSectionTitle'|trans }}</h3>
            {% if canEdit %}
                <a href="#library-seance-quiz-attach" class="btn btn-sm btn-outline-secondary" data-bs-toggle="collapse">↑ {{ 'libraryQuizAttachToggleLabel'|trans }}</a>
            {% endif %}
        </div>
        <div class="card-body">
            {% if quizBoard.quizzes is empty %}
                <div class="text-secondary">{{ 'librarySeanceQuizEmptyMessage'|trans }}</div>
            {% else %}
                <div class="list-group list-group-flush">
                    {% for row in quizBoard.quizzes %}
                        {% set quizDescription = row.quiz.description|default('')|trim %}
                        <div class="list-group-item d-flex justify-content-between align-items-center px-0">
                            <div>
                                <a href="{{ path('app_library_quiz_questions', {id: row.quiz.id}) }}"{% if quizDescription %} title="{{ quizDescription }}"{% endif %}>{{ row.quiz.name }}</a>
                                {# Said here because it is what this card's « Détacher » will leave behind. #}
                                {% if row.onSequence %}<span class="badge bg-secondary-lt ms-2">{{ 'librarySeanceQuizAlsoOnSequenceLabel'|trans }}</span>{% endif %}
                            </div>
                            {% if canEdit %}
                                <form method="post" action="{{ path('app_library_seances_quiz_detach', {sequenceId: sequenceTemplate.id, seanceId: seanceTemplate.id, quizId: row.quiz.id}) }}" class="cm-actions" onsubmit="return confirm('{{ 'libraryQuizDetachFromSeanceConfirmMessage'|trans|e('js') }}')">
                                    <input type="hidden" name="_token" value="{{ csrf_token('library_quiz_detach') }}">
                                    <button type="submit" class="cm-action--danger">{{ 'libraryQuizDetachActionLabel'|trans }}</button>
                                </form>
                            {% endif %}
                        </div>
                    {% endfor %}
                </div>
            {% endif %}

            {% if canEdit %}
                {% include 'library/_quiz_attach_form.html.twig' with {
                    collapseId: 'library-seance-quiz-attach',
                    actionRoute: 'app_library_seances_quiz_attach',
                    actionParams: {sequenceId: sequenceTemplate.id, seanceId: seanceTemplate.id},
                    pickableQuizzes: pickableQuizzes,
                    attachedIds: attachedQuizIds,
                } only %}
            {% endif %}
        </div>
    </div>

    {% include 'library/_resources.html.twig' with {
        resources: seanceTemplate.libraryResources,
        canEdit: canEdit,
        resourceForm: resourceForm,
        tagOptions: tagOptions,
        addRouteName: 'app_library_seances_resources_new',
        addRouteParams: {sequenceId: sequenceTemplate.id, id: seanceTemplate.id},
        deleteRouteName: 'app_library_seances_resources_delete',
        deleteRouteParams: {sequenceId: sequenceTemplate.id, id: seanceTemplate.id},
    } only %}

    {% if canEdit %}
        <form method="post" action="{{ path('app_library_seances_remove', {sequenceId: sequenceTemplate.id, id: seanceTemplate.id}) }}" class="mt-3" onsubmit="return confirm('{{ 'removeSeanceTemplateConfirmMessage'|trans|e('js') }}')">
            <input type="hidden" name="_token" value="{{ csrf_token('library_seances_remove') }}">
            <button type="submit" class="btn btn-ghost-danger">{{ 'removeActionLabel'|trans }}</button>
        </form>
    {% endif %}

    {% if canShare %}
        {% include 'content_share/_modal.html.twig' with {
            subjectType: 'seance',
            subjectId: seanceTemplate.id,
            subjectTitle: seanceTemplate.titre,
            subjectDetail: 'contentSharePhaseCountLabel'|trans({'%count%': seanceTemplate.seancePhaseTemplates|length}),
            groups: shareGroups,
            shares: shares,
            memberCounts: shareMemberCounts,
        } only %}
    {% endif %}
{% endblock %}
