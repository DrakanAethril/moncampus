{% extends 'layout/app.html.twig' %}

{% block title %}{{ (isEdit ? 'editSeanceTemplatePageHeading' : 'newSeanceTemplatePageHeading')|trans }} - {{ sequenceTemplate.titre }}{% endblock %}
{% block page_title %}{{ (isEdit ? 'editSeanceTemplatePageHeading' : 'newSeanceTemplatePageHeading')|trans }} - {{ sequenceTemplate.titre }}{% endblock %}

{% block main %}
    <div class="mb-2">
        <a href="{{ isEdit ? path('app_library_seances_show', {sequenceId: sequenceTemplate.id, id: form.vars.data.id}) : path('app_library_sequences_show', {id: sequenceTemplate.id}) }}" class="text-secondary text-uppercase small" style="letter-spacing: .4px; text-decoration: none;">{{ sequenceTemplate.titre }}</a>
    </div>
    <div class="card">
        <div class="card-body">
            {{ form_start(form) }}
                {{ form_errors(form) }}
                <div class="row">
                    <div class="col-md-6">{{ form_row(form.titre) }}</div>
                    <div class="col-md-3">{{ form_row(form.ordre) }}</div>
                    <div class="col-md-3">{{ form_row(form.duree) }}</div>
                    <div class="col-md-6">{{ form_row(form.objectifs) }}</div>
                    <div class="col-md-6">{{ form_row(form.avantDescription) }}</div>
                    <div class="col-md-6">{{ form_row(form.apresDescription) }}</div>
                    <div class="col-md-6">{{ form_row(form.materials) }}</div>
                    <div class="col-md-6">{{ form_row(form.watchPoints) }}</div>
                    {# Texte enrichi, et donc pleine largeur : c'est le contenu que l'enseignant
                       reprendra tel quel dans son cahier de texte, mise en forme comprise. Le champ
                       d'origine reste dans le DOM (HugeRTE le synchronise), d'où le d-none - même
                       montage que la description d'un compte rendu. #}
                    <div class="col-12">{{ form_row(form.cahierDeTexteDescription, {attr: {class: 'd-none', 'data-controller': 'hugerte-editor'}}) }}</div>
                    <div class="col-md-6">
                        {{ form_row(form.isOptional) }}
                        {{ form_row(form.optionalNote) }}
                    </div>
                    {# The nature select only appears once the box is ticked - it is required from
                       that moment (SequenceLibraryController::seanceForm() enforces it server-side,
                       the reveal here is only the affordance). #}
                    <div class="col-md-6" data-controller="checkbox-reveal">
                        {{ form_row(form.hasEvaluation, {attr: {'data-checkbox-reveal-target': 'toggle', 'data-action': 'change->checkbox-reveal#refresh'}}) }}
                        <div data-checkbox-reveal-target="panel">
                            {{ form_row(form.evaluationNature) }}
                        </div>
                    </div>
                </div>
                <div class="d-flex justify-content-between">
                    <a href="{{ isEdit ? path('app_library_seances_show', {sequenceId: sequenceTemplate.id, id: form.vars.data.id}) : path('app_library_sequences_show', {id: sequenceTemplate.id}) }}" class="btn btn-link">{{ 'cancelAction'|trans }}</a>
                    {{ form_widget(form.submit) }}
                </div>
                {{ form_rest(form) }}
            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}
