{# « Déplacer vers… » - the folder tree as a flat, clickable list.

   It exists **alongside** the drag onto the rail, not instead of it. The drag is the quick gesture
   for a folder that is already open in front of you; this is the one that still works when the target
   is collapsed three branches away, on a touch screen, or from the keyboard. Same endpoint either
   way, so there is one rule about where a quiz may go and not two. #}
{% macro branch(rows, depth) %}
    {% for row in rows %}
        <li>
            <button type="button" class="cm-qlib__move-item" style="padding-left: {{ 10 + depth * 16 }}px"
                    data-action="quiz-library#moveTo" data-target-id="{{ row.id }}">
                <span class="cm-qlib__node-ico" aria-hidden="true">
                    <twig:ux:icon name="folder" width="14" height="14"/>
                </span>
                {{ row.name }}
            </button>
        </li>
        {% if row.children is not empty %}
            {{ _self.branch(row.children, depth + 1) }}
        {% endif %}
    {% endfor %}
{% endmacro %}

<div class="cm-qlib__move" data-quiz-library-target="move" hidden>
    <div class="cm-qlib__move-box">
        <div class="cm-qlib__move-head">
            <h2 class="cm-qlib__move-title" data-quiz-library-target="moveTitle"></h2>
            <button type="button" class="cm-qlib__move-close" data-action="quiz-library#closeMove" aria-label="{{ 'fileLibraryCloseAction'|trans }}">&times;</button>
        </div>
        <ul class="cm-qlib__move-list">
            <li>
                <button type="button" class="cm-qlib__move-item" data-action="quiz-library#moveTo" data-target-id="">
                    <span class="cm-qlib__node-ico" aria-hidden="true">
                        <twig:ux:icon name="home" width="14" height="14"/>
                    </span>
                    {{ 'quizFolderRootLabel'|trans }}
                </button>
            </li>
            {{ _self.branch(rail, 0) }}
        </ul>
    </div>
</div>
