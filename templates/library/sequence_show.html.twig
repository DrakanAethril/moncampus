{% extends 'layout/app.html.twig' %}

{% block title %}{{ sequenceTemplate.titre }}{% endblock %}
{% block page_title %}{{ sequenceTemplate.titre }}{% endblock %}

{% block page_actions %}
    {% if canEdit %}
        {# The "Quiz" menu asks the same question as the séquence assistant's step 1, and each entry is
           a link that answers it - the mode (and the live filter) travel in the query string, so the
           menu is the question and the screen it opens is already on the right answer. #}
        <div class="dropdown d-inline-block">
            <button class="btn btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                {{ 'librarySequenceQuizMenuLabel'|trans }}
            </button>
            <ul class="dropdown-menu">
                <li><a class="dropdown-item" href="{{ path('app_library_quiz_assistant', {sequence: sequenceTemplate.id, mode: 'transpose'}) }}">{{ 'librarySequenceQuizTransposeActionLabel'|trans }}</a></li>
                <li><a class="dropdown-item" href="{{ path('app_library_quiz_assistant', {sequence: sequenceTemplate.id}) }}">{{ 'librarySequenceQuizGenerateActionLabel'|trans }}</a></li>
                <li><a class="dropdown-item" href="{{ path('app_library_quiz_assistant', {sequence: sequenceTemplate.id, live: 1}) }}">{{ 'librarySequenceQuizLiveActionLabel'|trans }}</a></li>
            </ul>
        </div>
        {# The two ways out of the séquence, neither of which writes anything: a critique to read, and
           the séquence itself in the format it was imported in - which is what makes revision possible. #}
        <div class="dropdown d-inline-block ms-2">
            <button class="btn btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                {{ 'librarySequenceAiMenuLabel'|trans }}
            </button>
            <ul class="dropdown-menu">
                <li><a class="dropdown-item" href="{{ path('app_library_sequences_review', {id: sequenceTemplate.id}) }}">{{ 'sequenceReviewActionLabel'|trans }}</a></li>
                <li><a class="dropdown-item" href="{{ path('app_library_sequences_export', {id: sequenceTemplate.id}) }}">{{ 'sequenceExportActionLabel'|trans }}</a></li>
            </ul>
        </div>
        {# « Partager » hangs on canShare and not on canEdit: sharing is an act of authorship, so a
           staff member reading a colleague's séquence does not get to hand it around on their behalf
           (design/validated/content-sharing-between-teachers.md). canShare is the narrower of the
           two, so sitting inside canEdit costs nobody the button. #}
        {% if canShare %}
            <button type="button" class="btn btn-outline-secondary ms-2" data-bs-toggle="modal" data-bs-target="#content-share-modal">{{ 'contentShareAction'|trans }}</button>
        {% endif %}
        <a href="{{ path('app_library_sequences_edit', {id: sequenceTemplate.id}) }}" class="btn btn-outline-secondary ms-2">{{ 'editActionLabel'|trans }}</a>
        <a href="{{ path('app_library_sequences_instantiate', {id: sequenceTemplate.id}) }}" class="btn btn-primary ms-2">{{ 'sequenceInstantiateAction'|trans }}</a>
    {% endif %}
{% endblock %}

{% block main %}
    <div class="mb-2">
        <a href="{{ path('app_library_sequences') }}" class="text-secondary text-uppercase small" style="letter-spacing: .4px; text-decoration: none;">{{ 'backToLibraryAction'|trans }}</a>
    </div>

    <div class="card mb-3">
        <div class="card-body">
            <dl class="row mb-0">
                <dt class="col-3">{{ 'sequenceTemplateNiveauFieldLabel'|trans }}</dt>
                <dd class="col-9">{{ sequenceTemplate.niveau ? sequenceTemplate.niveau.label : '—' }}</dd>
                <dt class="col-3">{{ 'sequenceTemplateOptionFieldLabel'|trans }}</dt>
                <dd class="col-9">{{ sequenceTemplate.option ? sequenceTemplate.option.label : '—' }}</dd>
                {% if sequenceTemplate.blocs is not empty %}
                    <dt class="col-3">{{ 'sequenceTemplateBlocsFieldLabel'|trans }}</dt>
                    <dd class="col-9">
                        {% for bloc in sequenceTemplate.blocs %}<span class="badge bg-blue-lt me-1">{{ bloc.label }}</span>{% endfor %}
                    </dd>
                {% endif %}
                {# The eight text fields, in the order SequenceTemplateType lays them out, so that
                   reading a séquence and editing it follow the same thread. Each one is skipped when
                   empty rather than shown as a dash: a séquence sheet is filled in over time, and a
                   column of empty labels reads as a form to complete rather than as a document.

                   All eight are plain text (escaped, `white-space: pre-wrap`), unlike the séance's
                   cahier de texte which is HTML - see App\Util\MarkdownRenderer. That is also what
                   keeps a Markdown table pasted by the séquence import readable here: its pipe rows
                   survive as lines. #}
                {% if sequenceTemplate.capacitesAttendues %}
                    <dt class="col-3">{{ 'sequenceTemplateCapacitesAttenduesFieldLabel'|trans }}</dt>
                    <dd class="col-9" style="white-space: pre-wrap;">{{ sequenceTemplate.capacitesAttendues }}</dd>
                {% endif %}
                {% if sequenceTemplate.preRequis %}
                    <dt class="col-3">{{ 'sequenceTemplatePreRequisFieldLabel'|trans }}</dt>
                    <dd class="col-9" style="white-space: pre-wrap;">{{ sequenceTemplate.preRequis }}</dd>
                {% endif %}
                {% if sequenceTemplate.objectifs %}
                    <dt class="col-3">{{ 'sequenceTemplateObjectifsFieldLabel'|trans }}</dt>
                    <dd class="col-9" style="white-space: pre-wrap;">{{ sequenceTemplate.objectifs }}</dd>
                {% endif %}
                {% if sequenceTemplate.transversalites %}
                    <dt class="col-3">{{ 'sequenceTemplateTransversalitesFieldLabel'|trans }}</dt>
                    <dd class="col-9" style="white-space: pre-wrap;">{{ sequenceTemplate.transversalites }}</dd>
                {% endif %}
                {% if sequenceTemplate.situationProblematique %}
                    <dt class="col-3">{{ 'sequenceTemplateSituationProblematiqueFieldLabel'|trans }}</dt>
                    <dd class="col-9" style="white-space: pre-wrap;">{{ sequenceTemplate.situationProblematique }}</dd>
                {% endif %}
                {% if sequenceTemplate.supportsGeneraux %}
                    <dt class="col-3">{{ 'sequenceTemplateSupportsGenerauxFieldLabel'|trans }}</dt>
                    <dd class="col-9" style="white-space: pre-wrap;">{{ sequenceTemplate.supportsGeneraux }}</dd>
                {% endif %}
                {% if sequenceTemplate.differentiation %}
                    <dt class="col-3">{{ 'sequenceTemplateDifferentiationFieldLabel'|trans }}</dt>
                    <dd class="col-9" style="white-space: pre-wrap;">{{ sequenceTemplate.differentiation }}</dd>
                {% endif %}
                {% if sequenceTemplate.watchPoints %}
                    <dt class="col-3">{{ 'sequenceTemplateWatchPointsFieldLabel'|trans }}</dt>
                    <dd class="col-9" style="white-space: pre-wrap;">{{ sequenceTemplate.watchPoints }}</dd>
                {% endif %}
            </dl>
        </div>
    </div>

    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h3 class="card-title mb-0">{{ 'librarySeancesSectionTitle'|trans }}</h3>
            {% if canEdit %}
                <a href="{{ path('app_library_seances_new', {sequenceId: sequenceTemplate.id}) }}" class="btn btn-sm btn-primary">{{ 'seanceTemplateNewButtonLabel'|trans }}</a>
            {% endif %}
        </div>
        <div class="table-responsive">
            <table class="table table-vcenter card-table">
                <thead>
                    <tr>
                        <th class="w-1">{{ 'seanceTemplateOrdreFieldLabel'|trans }}</th>
                        <th>{{ 'seanceTemplateTitreFieldLabel'|trans }}</th>
                        <th>{{ 'seanceTemplateDureeFieldLabel'|trans }}</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody{% if canEdit %} data-controller="sortable-reorder" data-sortable-reorder-url-value="{{ path('app_library_seances_reorder', {id: sequenceTemplate.id}) }}" data-sortable-reorder-token-value="{{ csrf_token('library_seances_reorder') }}"{% endif %}>
                    {% for seanceTemplate in sequenceTemplate.seanceTemplates %}
                        <tr{% if canEdit %} data-sortable-reorder-id-param="{{ seanceTemplate.id }}"{% endif %}>
                            <td>
                                {% if canEdit %}<span class="sortable-reorder-handle" style="cursor: grab; color: var(--cm-faint, #8a99a6); margin-right: 6px;">⠿</span>{% endif %}{{ seanceTemplate.ordre }}
                            </td>
                            <td>
                                <a href="{{ path('app_library_seances_show', {sequenceId: sequenceTemplate.id, id: seanceTemplate.id}) }}">{{ seanceTemplate.titre }}</a>
                                {% if seanceTemplate.isOptional %}<span class="badge bg-secondary-lt ms-1">{{ 'seanceTemplateIsOptionalBadge'|trans }}</span>{% endif %}
                            </td>
                            <td>{{ seanceTemplate.duree ? seanceTemplate.duree|round|duration_minutes : '—' }}{% if seanceTemplate.evaluationNature %} <span class="cm-prog-tag cm-prog-tag--eval cm-prog-eval--{{ seanceTemplate.evaluationNature.slug }}">{{ seanceTemplate.evaluationNature.initial }}</span>{% endif %}</td>
                            <td class="cm-actions">
                                {% if canEdit %}
                                    <a href="{{ path('app_library_seances_edit', {sequenceId: sequenceTemplate.id, id: seanceTemplate.id}) }}" class="cm-action--warning">{{ 'editActionLabel'|trans }}</a>
                                {% endif %}
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="4" class="text-secondary">{{ 'librarySeancesEmptyMessage'|trans }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

    {# « Quiz de la séquence »: one row per quiz, whatever level it hangs from - séance-level quizzes
       are raised here and deduplicated (App\Service\SequenceQuizBoard). Each row says where it hangs,
       which is what makes its « Détacher » honest: it removes every link the row shows, séance links
       included (App\Service\SequenceQuizLinker).

       And the number the card exists for: « 2 séances sur 4 ». That number is what made the two links
       relation tables rather than nullable foreign keys - it measures usage, which is multiple on both
       sides (see App\Entity\QuizTemplate::$seanceTemplates).

       There is deliberately no « Lancer » button here: a launch needs a Program, so it lives on the
       séquence instantiated into a formation, which finds the same quizzes back through
       SeanceInstance::$sourceTemplate. #}
    <div class="card mt-3">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h3 class="card-title mb-0">{{ 'libraryQuizSectionTitle'|trans }}</h3>
            <div class="d-flex align-items-center gap-2">
                {% if quizBoard.totalSeances > 0 %}
                    {# Green only when every séance is covered: a partial count is information, not a
                       failure, so it wears the neutral badge rather than a warning colour. #}
                    <span class="cm-badge cm-badge--{{ quizBoard.coveredSeances == quizBoard.totalSeances ? 'green' : 'gray' }}">
                        {{ 'libraryQuizCoverageTemplate'|trans({'%covered%': quizBoard.coveredSeances, '%total%': quizBoard.totalSeances}) }}
                    </span>
                {% endif %}
                {% if canEdit %}
                    <a href="#library-sequence-quiz-attach" class="btn btn-sm btn-outline-secondary" data-bs-toggle="collapse">↑ {{ 'libraryQuizAttachToggleLabel'|trans }}</a>
                {% endif %}
            </div>
        </div>
        <div class="card-body">
            {% if not quizBoard.hasAnyQuiz %}
                <div class="text-secondary">{{ 'libraryQuizEmptyMessage'|trans }}</div>
            {% else %}
                <div class="list-group list-group-flush">
                    {% for row in quizBoard.quizzes %}
                        {% set quizDescription = row.quiz.description|default('')|trim %}
                        <div class="list-group-item d-flex justify-content-between align-items-center px-0">
                            <div>
                                <a href="{{ path('app_library_quiz_questions', {id: row.quiz.id}) }}"{% if quizDescription %} title="{{ quizDescription }}"{% endif %}>{{ row.quiz.name }}</a>
                                {# Where this quiz hangs: the séquence itself, and/or the séances using
                                   it - one row however many there are. #}
                                {% if row.onSequence %}<span class="badge bg-secondary-lt ms-2">{{ 'libraryQuizWholeSequenceLabel'|trans }}</span>{% endif %}
                                {% for seance in row.seances %}
                                    <a class="badge bg-blue-lt ms-1" href="{{ path('app_library_seances_show', {sequenceId: sequenceTemplate.id, id: seance.id}) }}">{{ seance.ordre }} · {{ seance.titre }}</a>
                                {% endfor %}
                            </div>
                            {% if canEdit %}
                                <form method="post" action="{{ path('app_library_sequences_quiz_detach', {sequenceId: sequenceTemplate.id, quizId: row.quiz.id}) }}" class="cm-actions" onsubmit="return confirm('{{ 'libraryQuizDetachFromSequenceConfirmMessage'|trans|e('js') }}')">
                                    <input type="hidden" name="_token" value="{{ csrf_token('library_quiz_detach') }}">
                                    <button type="submit" class="cm-action--danger">{{ 'libraryQuizDetachActionLabel'|trans }}</button>
                                </form>
                            {% endif %}
                        </div>
                    {% endfor %}
                </div>
            {% endif %}

            {% if canEdit %}
                {% include 'library/_quiz_attach_form.html.twig' with {
                    collapseId: 'library-sequence-quiz-attach',
                    actionRoute: 'app_library_sequences_quiz_attach',
                    actionParams: {sequenceId: sequenceTemplate.id},
                    pickableQuizzes: pickableQuizzes,
                    attachedIds: attachedQuizIds,
                } only %}
            {% endif %}
        </div>
    </div>

    {% include 'library/_resources.html.twig' with {
        resources: sequenceTemplate.libraryResources,
        canEdit: canEdit,
        resourceForm: resourceForm,
        tagOptions: tagOptions,
        addRouteName: 'app_library_sequences_resources_new',
        addRouteParams: {id: sequenceTemplate.id},
        deleteRouteName: 'app_library_sequences_resources_delete',
        deleteRouteParams: {id: sequenceTemplate.id},
    } only %}

    {% if canEdit %}
        <form method="post" action="{{ path('app_library_sequences_remove', {id: sequenceTemplate.id}) }}" class="mt-3" onsubmit="return confirm('{{ 'removeSequenceTemplateConfirmMessage'|trans|e('js') }}')">
            <input type="hidden" name="_token" value="{{ csrf_token('library_sequences_remove') }}">
            <button type="submit" class="btn btn-ghost-danger">{{ 'removeActionLabel'|trans }}</button>
        </form>
    {% endif %}

    {% if canShare %}
        {% include 'content_share/_modal.html.twig' with {
            subjectType: 'sequence',
            subjectId: sequenceTemplate.id,
            subjectTitle: sequenceTemplate.titre,
            subjectDetail: 'contentShareSeanceCountLabel'|trans({'%count%': sequenceTemplate.seanceTemplates|length}),
            groups: shareGroups,
            shares: shares,
            memberCounts: shareMemberCounts,
        } only %}
    {% endif %}
{% endblock %}
