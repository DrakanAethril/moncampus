{% extends 'layout/app.html.twig' %}

{# Every interactive family comes back to its own screen; the CSV/Kahoot ones don't. `family` is
   null for those two. #}
{% set isInteractive = family|default(null) is not null %}

{% block title %}{{ 'quizImportPreviewPageHeading'|trans }}{% endblock %}

{% block page_breadcrumb %}
    {% include '_breadcrumb.html.twig' with {segments: [
        {label: 'homeNavLabel'|trans, url: path('app_home')},
        {label: 'quizLibraryPageHeading'|trans, url: path('app_library_quiz')},
        {label: (isInteractive ? 'zoneImportBreadcrumbLabel' : 'quizImportBreadcrumbLabel')|trans, url: path(isInteractive ? 'app_library_quiz_assistant_paste' : 'app_library_quiz_import')},
        {label: 'quizImportPreviewBreadcrumbLabel'|trans, url: app.request.requestUri},
    ]} %}
{% endblock %}
{% block page_title %}{{ 'quizImportPreviewPageHeading'|trans }}{% endblock %}

{% block main %}
    <div class="card">
        <div class="card-body">
            {{ form_start(form) }}
            {{ form_errors(form) }}

            <div class="cm-note mb-3">
                <span class="cm-note__icon">i</span>
                <div>{{ 'quizImportPreviewIntroTemplate'|trans({
                    '%count%': payload.questions|length,
                    '%file%': payload.fileName,
                }) }}</div>
            </div>

            {% if payload.errors is not empty %}
                {# Lines the reader could not use. They are listed rather than blocking the import:
                   one bad row must not cost the teacher the rest of the file. #}
                <div class="alert alert-warning" role="alert">
                    <div class="fw-medium mb-1">{{ 'quizImportPreviewSkippedTitleTemplate'|trans({'%count%': payload.errors|length}) }}</div>
                    <ul class="mb-0 ps-3">
                        {% for error in payload.errors|slice(0, 20) %}
                            <li>{{ error }}</li>
                        {% endfor %}
                    </ul>
                    {% if payload.errors|length > 20 %}
                        <div class="small mt-1">{{ 'quizImportPreviewSkippedMoreTemplate'|trans({'%count%': payload.errors|length - 20}) }}</div>
                    {% endif %}
                </div>
            {% endif %}

            {% if incompleteCount > 0 %}
                {# A warning, never a refusal: an incomplete question must be importable, or
                   generating questions by AI loses its point as soon as one carries an image. The
                   lock is at launch, where a missing media would really break a passation. #}
                <div class="cm-audio-warn">{{ 'quizImportPreviewIncompleteWarningTemplate'|trans({'%count%': incompleteCount}) }}</div>
            {% endif %}

            {# The destination comes before everything else: this screen used to create a new quiz
               and nothing else, and a bank is built in several goes. The controller wraps the whole
               form body because its panels, its radios and its confirm button are three different
               places on the screen. #}
            <div data-controller="quiz-import-destination">
            <div class="cm-subhead">
                <div class="cm-subhead__title">{{ 'quizImportDestinationSectionTitle'|trans }}</div>
            </div>
            <div class="cm-audio-modes mb-3">
                {% for choice in form.destination %}
                    <label class="cm-audio-mode">
                        {{ form_widget(choice, {attr: {'data-action': 'change->quiz-import-destination#refresh', 'data-quiz-import-destination-target': 'choice'}}) }}
                        <span class="cm-audio-mode__dot"></span>
                        <span>
                            <span class="cm-audio-mode__label">{{ choice.vars.label|trans }}</span>
                            <span class="d-block text-secondary small">{{ (choice.vars.value == 'new' ? 'quizImportDestinationNewHint' : 'quizImportDestinationExistingHint')|trans }}</span>
                        </span>
                    </label>
                {% endfor %}
            </div>

            {# The extra destination, and it is a second question rather than a third radio: where the
               questions *land* (a new quiz, or an existing one) and what the quiz is *used by* are
               independent - a quiz joining an existing bank can still serve this séance. Pre-checked
               because a quiz generated from a séance is usually for it, and one click undoes that. #}
            {% if attachTo %}
                <div class="cm-note mb-3">
                    <span class="cm-note__icon">i</span>
                    <div>
                        {{ form_row(form.attach, {label: (attachTo.scope == 'seance' ? 'quizImportAttachSeanceTemplate' : 'quizImportAttachSequenceTemplate')|trans({'%title%': attachTo.title}), row_attr: {class: 'mb-0'}}) }}
                        <div class="text-secondary small">{{ 'quizImportAttachHint'|trans }}</div>
                    </div>
                </div>
            {% endif %}

            <div class="row g-4 align-items-start">
                <div class="col-12 col-lg-5 d-flex flex-column gap-3">
                    {# Two panels, one visible at a time: the settings of a quiz about to be created,
                       or the quiz the questions are joining. Its own settings are deliberately left
                       alone - the default-draw adjustment below only makes sense at creation. #}
                    <div data-quiz-import-destination-target="existingPanel" hidden>
                        {{ form_row(form.targetTemplate) }}
                        {% if existingTemplates is empty %}
                            <div class="text-secondary small">{{ 'quizImportDestinationNoQuizText'|trans }}</div>
                        {% endif %}
                        <div class="cm-note">
                            <span class="cm-note__icon">i</span>
                            <div>{{ 'quizImportDestinationSnapshotNote'|trans }}</div>
                        </div>
                    </div>

                    <div data-quiz-import-destination-target="newPanel">
                        <div class="cm-subhead">
                            <div class="cm-subhead__title">{{ 'quizSettingsIdentityTitle'|trans }}</div>
                            <div class="cm-subhead__hint">{{ 'quizImportPreviewIdentityHint'|trans }}</div>
                        </div>
                        {{ form_row(form.name) }}
                        {{ form_row(form.subject) }}
                        {{ form_row(form.description) }}

                        <div class="cm-subhead">
                            <div class="cm-subhead__title">{{ 'quizSettingsDefaultsTitle'|trans }}</div>
                            <div class="cm-subhead__hint">{{ 'quizSettingsDefaultsHint'|trans }}</div>
                        </div>
                        <div class="row g-3">
                            <div class="col-6">{{ form_row(form.defaultQuestionCount) }}</div>
                            <div class="col-6">{{ form_row(form.defaultSecondsPerQuestion) }}</div>
                        </div>
                        {# Rendered here rather than left to form_rest(), which was dropping it
                           unstyled below the action bar. #}
                        {{ form_row(form.defaultTimeMode) }}
                        <div class="d-flex flex-column gap-2">
                            {{ form_row(form.defaultSameQuestionsForAll, {row_attr: {class: 'form-switch'}}) }}
                            {{ form_row(form.defaultQuestionOrderPerStudent, {row_attr: {class: 'form-switch'}}) }}
                            {{ form_row(form.defaultAnswerOrderPerStudent, {row_attr: {class: 'form-switch'}}) }}
                        </div>
                    </div>
                </div>

                <div class="col-12 col-lg-7 d-flex flex-column gap-2">
                    <div class="cm-subhead">
                        <div class="cm-subhead__title">{{ 'quizImportPreviewQuestionsTitleTemplate'|trans({'%count%': payload.questions|length}) }}</div>
                        <div class="cm-subhead__hint">{{ 'quizImportPreviewQuestionsHint'|trans }}</div>
                    </div>
                    {# One rendering for the twelve types, from real transient entities - see the
                       partial's own note. #}
                    <div class="d-flex flex-column gap-2" style="max-height: 640px; overflow-y: auto;">
                        {% for question in previewQuestions %}
                            {% include 'library/_quiz_import_preview_question.html.twig' with {
                                question: question,
                                number: loop.index,
                                gap: gaps[loop.index0]|default(null),
                            } only %}
                        {% endfor %}
                    </div>
                    <div class="text-secondary small">{{ 'quizImportPreviewEditLaterHint'|trans }}</div>
                </div>
            </div>

            <div class="cm-actionbar">
                <div class="cm-actionbar__buttons">
                    <a href="{{ path(isInteractive ? 'app_library_quiz_assistant_paste' : 'app_library_quiz_import') }}" class="btn btn-link">{{ 'quizImportPreviewBackLabel'|trans }}</a>
                    {# The button names where the questions are going - never a bare "Valider". #}
                    <button type="submit" class="btn btn-primary" data-quiz-import-destination-target="submit"
                            data-new-label="{{ 'quizImportPreviewConfirmTemplate'|trans({'%count%': payload.questions|length}) }}"
                            data-existing-label="{{ 'quizImportPreviewConfirmIntoTemplate'|trans({'%count%': payload.questions|length, '%name%': '__NAME__'}) }}">{{ 'quizImportPreviewConfirmTemplate'|trans({'%count%': payload.questions|length}) }}</button>
                </div>
            </div>
            </div>
            {{ form_rest(form) }}
            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}
