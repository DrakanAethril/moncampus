{# Une ligne « quiz ajouté » du vivier (écran 1c). Le même gabarit sert aux lignes déjà soumises et
   au prototype cloné par quiz_pool_controller.js, d'où l'include plutôt qu'un form_row. #}
<div class="cm-quizpool__row" data-quiz-pool-row>
    {{ form_widget(entry, {attr: {class: 'cm-select cm-quizpool__select', 'data-quiz-pool-target': 'select', 'data-action': 'change->quiz-pool#update'}}) }}
    <button type="button" class="cm-quizpool__remove" data-action="quiz-pool#remove" aria-label="{{ 'quizLaunchRemoveTemplateAction'|trans }}">&times;</button>
</div>
