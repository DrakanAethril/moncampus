{# One « quiz added » row of the pool (screen 1c). The same template serves the rows already submitted
   and the prototype cloned by quiz_pool_controller.js, hence the include rather than a form_row.

   The select is behind the picker modal (templates/_library_picker_field.html.twig): it keeps the
   field's name, its choices and the pool's own change listener, and the teacher reads a button. #}
<div class="cm-quizpool__row" data-quiz-pool-row>
    {% include '_library_picker_field.html.twig' with {
        field: entry,
        placeholder: 'quizLaunchAdditionalTemplatePlaceholder'|trans,
        select_attr: {'data-quiz-pool-target': 'select', 'data-action': 'change->quiz-pool#update'},
    } only %}
    <button type="button" class="cm-quizpool__remove" data-action="quiz-pool#remove" aria-label="{{ 'quizLaunchRemoveTemplateAction'|trans }}">&times;</button>
</div>
