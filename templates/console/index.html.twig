{% extends 'layout/app.html.twig' %}

{% block title %}{{ 'consoleHeading'|trans({'%name%': machineName}) }}{% endblock %}

{% block page_breadcrumb %}
    {# La profondeur suit la navigation, pas l'URL : l'enseignant vient de sa carte, l'administrateur
       vient de la liste des machines de l'hôte. Deux portes, deux fils. #}
    {% if fromAdmin %}
        {% include '_breadcrumb.html.twig' with {segments: [
            {label: 'homeNavLabel'|trans, url: path('app_home')},
            {label: 'infrastructureNavLabel'|trans, url: path('app_infrastructure')},
            {label: 'infrastructureGuestsNavLabel'|trans, url: path('app_infrastructure_guests', {host: host.id})},
            {label: machineName, url: app.request.pathInfo},
        ]} %}
    {% else %}
        {% include '_breadcrumb.html.twig' with {segments: [
            {label: 'homeNavLabel'|trans, url: path('app_home')},
            {label: 'myMachinesHeading'|trans, url: path('app_my_machines')},
            {label: machineName, url: app.request.pathInfo},
        ]} %}
    {% endif %}
{% endblock %}

{% block page_title %}{{ machineName }}{% endblock %}

{# L'écran sort de la colonne de lecture : un terminal se mesure en colonnes, et une colonne de
   1 200 px le plafonnerait à cent trente quel que soit l'écran. Gouttière de 24 px, min-width de
   1 024 px, défilement horizontal en dessous. #}
{% block page_body_container %}cm-console-bleed{% endblock %}

{% block main %}
    <div class="cm-console"
         data-controller="console"
         data-console-exchange-url-value="{{ path('app_console_exchange', {id: session.id}) }}"
         data-console-close-url-value="{{ path('app_console_close', {id: session.id}) }}"
         data-console-token-value="{{ csrf_token('console_exchange') }}"
         data-console-connected-text-value="{{ 'consoleConnectedLabel'|trans }}"
         data-console-lost-text-value="{{ 'consoleLostLabel'|trans }}"
         data-console-palette-url-value="{{ path('app_console_palette', {id: session.id}) }}"
         data-console-snippet-url-value="{{ path('app_console_snippet_add', {id: session.id}) }}"
         {# Un gabarit de route plutôt qu'une découpe de chaîne : le jeton est en minuscules pour
            satisfaire l'exigence [a-z0-9_.-] de la route, sans quoi la génération échouerait ici et
            mettrait tout l'écran en 500. #}
         data-console-become-url-value="{{ path('app_console_become', {id: session.id, login: 'zzlogin'}) }}"
         data-console-file-url-value="{{ path('app_console_file_send', {id: session.id}) }}"
         data-console-fetch-url-value="{{ path('app_console_file_fetch', {id: session.id}) }}"
         data-console-search-url-value="{{ path('app_console_search', {id: session.id}) }}"
         data-console-arm-url-value="{{ path('app_console_arm', {id: session.id}) }}"
         data-console-broadcast-url-value="{{ path('app_console_broadcast', {id: session.id}) }}"
         data-console-armed-value="{{ session.isBroadcastArmed ? 'true' : 'false' }}"
         data-console-armed-machines-value="{{ broadcastMachines }}"
         data-confirm-text="{{ 'consoleBroadcastConfirmText'|trans({'%count%': '%count%', '%command%': '%command%'}) }}"
         data-disarm-text="{{ 'consoleBroadcastCountdownText'|trans({'%minutes%': '%minutes%'}) }}"
         data-console-platform-account-value="moncampus"
         data-sending-text="{{ 'consoleFileSendingMessage'|trans }}"
         data-became-text="{{ 'consoleBecameMessage'|trans({'%login%': '%login%'}) }}"
         data-action="dragover->console#dragOver dragleave->console#dragLeave drop->console#dropFile">

        <div class="cm-console__status">
            {# Armée, la barre d'état nomme le lot et le nombre : « diffusion — lot X (8 machines) ». #}
            <span class="cm-console__armband" data-console-target="armBand"{{ session.isBroadcastArmed ? '' : ' hidden' }}>
                {{ 'consoleBroadcastArmedLabel'|trans({'%label%': batchLabel ?? '', '%count%': broadcastMachines}) }}
            </span>
            <span class="cm-console__name">{{ machineName }}</span>
            <span class="cm-console__dim">{{ ip }}</span>
            <span class="cm-console__sep">·</span>
            {# Sous quelle identité on parle. Vert tant que c'est le compte de plateforme ; il
               changera de couleur et de nom dès qu'on deviendra quelqu'un d'autre. #}
            <span class="cm-console__id" data-console-target="identity" data-host="{{ machineName }}">{{ unixUser }}@{{ machineName }}</span>
            {% if batchLabel %}
                <span class="cm-console__sep">·</span>
                <span class="cm-console__dim">{{ 'consoleBatchLabel'|trans({'%label%': batchLabel}) }}</span>
            {% endif %}
            <span class="cm-console__right">
                {% for other in others %}
                    {% set who = other.openedBy %}
                    <span class="cm-console__with">
                        <span class="cm-console__ava">{{ (who.displayName ?? who.username)|slice(0, 2)|upper }}</span>
                        {{ 'consoleAlsoConnectedLabel'|trans({'%name%': who.displayName ?? who.username}) }}
                    </span>
                {% endfor %}
                <span class="cm-console__dim" data-console-target="armCountdown"></span>
                <span class="cm-console__dim" data-console-target="size">—</span>
                <span class="cm-console__live" data-console-target="state" data-state="opening">{{ 'consoleOpeningLabel'|trans }}</span>
            </span>
        </div>

        {# Fermer l'onglet n'arrête rien : c'est la conséquence directe du tmux, et il faut le dire,
           sinon la personne relance ce qui tourne déjà. #}
        {% if resumedMinutes %}
            <div class="cm-console__resume">
                {{ 'consoleResumedText'|trans({'%minutes%': resumedMinutes})|raw }}
            </div>
        {% endif %}

        {# Ce que MonCampus a fait *dans* le terminal - pris une identité, déposé un fichier - dit
           en cuivre et hors du panneau. Hors du panneau volontairement : écrire une ligne dans le
           tmux voudrait dire y envoyer des touches, et des touches envoyées pendant que quelqu'un
           tape une commande la corrompent. #}
        <div class="cm-console__notice" data-console-target="notice" hidden>
            <span data-console-target="noticeText"></span>
        </div>

        <div class="cm-console__pane">
            <div class="cm-console__screen" data-console-target="screen"></div>

            {# La palette : un champ, une liste, trois sources fusionnées et étiquetées. #}
            <div class="cm-console__palette" data-console-target="palette" hidden>
                <div class="cm-console__palbox">
                    <div class="cm-console__palquery">
                        <span aria-hidden="true">⌕</span>
                        <input type="search" data-console-target="paletteInput"
                               data-action="input->console#loadPalette keydown->console#paletteKey"
                               placeholder="{{ 'consolePalettePlaceholder'|trans }}" autocomplete="off">
                    </div>
                    <div class="cm-console__pallist" data-console-target="paletteList"
                         data-console-snippets="{{ 'consolePaletteMineLabel'|trans }}"
                         data-console-catalog="{{ 'consolePaletteCatalogLabel'|trans }}"
                         data-console-history="{{ 'consolePaletteHistoryLabel'|trans }}"
                         data-console-no-command="{{ 'consoleSnippetNoCommandMessage'|trans }}"></div>
                    {# Entrée insère, Alt+Entrée exécute. L'ordre compte : on relit avant de lancer. #}
                    <div class="cm-console__palfoot">
                        <span><kbd>{{ 'consoleKeyEnterLabel'|trans }}</kbd> {{ 'consolePaletteInsertsLabel'|trans }}</span>
                        <span><kbd>Alt ⏎</kbd> {{ 'consolePaletteRunsLabel'|trans }}</span>
                        <span><kbd>Ctrl S</kbd> {{ 'consolePaletteSaveLabel'|trans }}</span>
                    </div>
                </div>
            </div>

            {# Ctrl+F : les 3 000 dernières lignes, lues dans le tmux de la machine. #}
            <div class="cm-console__search" data-console-target="search" hidden>
                <input type="search" data-console-target="searchInput" data-action="keydown->console#runSearch"
                       placeholder="{{ 'consoleSearchPlaceholder'|trans }}" autocomplete="off">
                <div class="cm-console__searchlist" data-console-target="searchList"
                     data-console-no-match="{{ 'consoleSearchEmptyText'|trans }}"></div>
            </div>
            <div class="cm-console__overlay" data-console-target="overlay" hidden>
                <p class="cm-console__overlaytext" data-console-target="overlayText"></p>
                {% if not fromAdmin and account is not null %}
                    {# « Éteinte » porte le bouton Démarrer, au même endroit que sur la carte : deux
                       de ces écrans donnent le geste suivant au lieu de l'erreur. #}
                    <a class="cm-btn cm-btn--primary" href="{{ path('app_my_machines') }}">{{ 'consoleGoToMachinesAction'|trans }}</a>
                {% elseif fromAdmin %}
                    <a class="cm-btn cm-btn--primary" href="{{ path('app_infrastructure_guests', {host: host.id}) }}">{{ 'consoleBackToGuestsAction'|trans }}</a>
                {% endif %}
            </div>
        </div>

        {# Ce qui est envoyé est **une ligne complète**, pas des frappes : on ne diffuse pas une
           session interactive, on diffuse une commande. #}
        <div class="cm-console__bcast" data-console-target="broadcast"{{ session.isBroadcastArmed ? '' : ' hidden' }}>
            <label for="broadcast-line">{{ 'consoleBroadcastLineLabel'|trans }}</label>
            <input id="broadcast-line" type="text" data-console-target="broadcastInput"
                   data-action="keydown->console#sendBroadcast" autocomplete="off"
                   placeholder="{{ 'consoleBroadcastPlaceholder'|trans }}">
            <button type="button" class="cm-console__chip cm-console__chip--on" data-action="console#sendBroadcast">
                {{ 'consoleBroadcastSendAction'|trans }}
            </button>
        </div>

        <div class="cm-console__bresult" data-console-target="broadcastResult" hidden>
            <div class="cm-console__bhead">
                <b data-console-summary></b>
                <span class="cm-console__bcmd" data-console-command></span>
            </div>
            <div class="cm-console__blist" data-console-target="broadcastList"></div>
        </div>

        <div class="cm-console__acts">
            <button type="button" class="cm-console__chip cm-console__chip--pri" data-action="console#openPalette">
                {{ 'consolePaletteAction'|trans }} <span class="cm-console__key">Ctrl K</span>
            </button>

            {# La diffusion ne s'offre que là où elle a un sens : une console d'administrateur sur une
               machine hors lot n'a aucun lot à qui diffuser. #}
            {% if broadcastMachines > 0 %}
                <button type="button" class="cm-console__chip{{ session.isBroadcastArmed ? ' cm-console__chip--on' }}"
                        data-console-target="armChip" data-action="console#toggleArm">
                    {{ 'consoleBroadcastAction'|trans }} <span class="cm-console__key">Ctrl ⌥ B</span>
                </button>
                <a class="cm-console__chip" href="{{ path('app_console_wall', {id: session.guestAccount.batch.id}) }}">{{ 'consoleWallAction'|trans }}</a>
            {% endif %}

            {# « Devenir » : la liste des comptes de la machine est déjà connue, un clic suffit. #}
            <span class="cm-console__menuwrap">
                <button type="button" class="cm-console__chip" data-console-target="becomeChip" data-action="console#toggleBecome"
                        {{ machineAccounts is empty ? 'disabled' }}>{{ 'consoleBecomeAction'|trans }}</button>
                <div class="cm-console__menu" data-console-target="become" hidden>
                    <div class="cm-console__menuhead">{{ 'consoleBecomeHeading'|trans }}</div>
                    {% for account in machineAccounts %}
                        <button type="button" class="cm-console__menuitem" data-login="{{ account.login }}" data-action="console#become">
                            {{ account.login }}{% if account.name %} <span>· {{ account.name }}</span>{% endif %}
                        </button>
                    {% endfor %}
                    <div class="cm-console__menusep"></div>
                    <button type="button" class="cm-console__menuitem" data-login="moncampus" data-action="console#become">
                        {{ 'consoleBecomeBackAction'|trans }}
                    </button>
                </div>
            </span>

            <span class="cm-console__menuwrap">
                <button type="button" class="cm-console__chip" data-action="console#toggleFileMenu">{{ 'consoleFileAction'|trans }}</button>
                <div class="cm-console__menu" data-console-target="fileMenu" hidden>
                    <div class="cm-console__menuhead">{{ 'consoleFileSendHeading'|trans }}</div>
                    <button type="button" class="cm-console__menuitem" data-action="console#pickFile">
                        {{ 'consoleFileFromComputerAction'|trans }}
                        <span>{{ 'consoleFileDropHint'|trans }}</span>
                    </button>
                    <input type="file" hidden data-console-target="fileInput" data-action="change->console#uploadFile">
                    <div class="cm-console__menusep"></div>
                    <div class="cm-console__menuhead">{{ 'consoleFileFetchHeading'|trans }}</div>
                    <div class="cm-console__menufetch">
                        <input type="text" data-console-fetch-path placeholder="/home/mdupont/travail.txt" autocomplete="off">
                        <button type="button" class="cm-console__chip" data-action="console#fetchFile">{{ 'consoleFileFetchAction'|trans }}</button>
                    </div>
                </div>
            </span>

            <button type="button" class="cm-console__chip" data-action="console#toggleSearch">
                {{ 'consoleSearchAction'|trans }} <span class="cm-console__key">Ctrl F</span>
            </button>

            {# Le geste qui termine une séance : le cahier de texte du jour, déjà rempli. #}
            {% if batchLabel %}
                <a class="cm-console__chip" href="{{ path('app_console_lesson_log', {id: session.id}) }}">{{ 'consoleLessonLogAction'|trans }}</a>
            {% endif %}

            <a class="cm-console__chip" href="{{ path('app_console_snippets') }}">{{ 'consoleSnippetsAction'|trans }}</a>

            <button type="button" class="cm-console__chip" data-action="console#fullscreen">
                {{ 'consoleFullscreenAction'|trans }} <span class="cm-console__key">Ctrl ⌥ F</span>
            </button>
            <span class="cm-console__right">
                <span class="cm-console__zoom">
                    <button type="button" data-action="console#zoomOut" aria-label="{{ 'consoleZoomOutAction'|trans }}">A−</button>
                    <button type="button" data-action="console#zoomIn" aria-label="{{ 'consoleZoomInAction'|trans }}">A+</button>
                </span>
                <a class="cm-console__chip" href="{{ fromAdmin ? path('app_infrastructure_guests', {host: host.id}) : path('app_my_machines') }}">{{ 'consoleCloseAction'|trans }}</a>
            </span>
        </div>
    </div>
{% endblock %}
