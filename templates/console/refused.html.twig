{% extends 'layout/app.html.twig' %}

{% block title %}{{ 'consoleRefusedHeading'|trans }}{% endblock %}

{% block page_breadcrumb %}
    {% include '_breadcrumb.html.twig' with {segments: [
        {label: 'homeNavLabel'|trans, url: path('app_home')},
        {label: 'consoleRefusedHeading'|trans, url: app.request.pathInfo},
    ]} %}
{% endblock %}

{% block page_title %}{{ 'consoleRefusedHeading'|trans }}{% endblock %}

{% block main %}
    <div class="cm-note cm-note--gold">
        <span class="cm-note__icon">!</span>
        <span>{{ message }}</span>
    </div>

    {# Un plafond anonyme est une panne, un plafond nommé est une conversation. #}
    {% if holders is not empty %}
        <ul class="cm-console__holders">
            {% for holder in holders %}
                <li>{{ holder }}</li>
            {% endfor %}
        </ul>
    {% endif %}

    <a class="cm-btn cm-btn--outline" href="{{ path('app_my_machines') }}">{{ 'consoleGoToMachinesAction'|trans }}</a>
{% endblock %}
