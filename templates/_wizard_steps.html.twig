{#
    The step row + progress bar of every wizard: the four UFA evaluation-period wizards
    (tuteur/alternant/équipe/chargé de suivi) and the séquence import assistant.

    Expects:
      stepLabels        list of step names, any length - the bar is a share of it, not a fixed four.
      currentStepIndex  1-based. A step below it is done, the step itself is current.
      stepCaptionKey    optional; a translation key taking %step%, %total% and %name%.
      skippedSteps      optional list of 1-based indexes shown as skipped rather than future or done.
                        The séquence assistant uses it for the "convertir" step a teacher who already
                        holds the JSON walks past: the pastille has to stay in the row, or the
                        remaining steps renumber themselves and the parcours stops being readable.
#}
{% set skipped = skippedSteps|default([]) %}
<div class="cm-stepper">
    <div class="cm-stepper__steps">
        {% for label in stepLabels %}
            {% set index = loop.index %}
            {% if not loop.first %}
                <div class="cm-stepper__rule{{ index - 1 < currentStepIndex ? ' cm-stepper__rule--done' }}"></div>
            {% endif %}
            <div class="cm-stepper__step">
                <span class="cm-stepper__step-circle {{ index in skipped ? 'cm-stepper__step-circle--skipped' : (index < currentStepIndex ? 'cm-stepper__step-circle--done' : (index == currentStepIndex ? 'cm-stepper__step-circle--current' : 'cm-stepper__step-circle--future')) }}">
                    {{ index in skipped ? '–' : (index < currentStepIndex ? '✓' : index) }}
                </span>
                <span class="cm-stepper__step-name">{{ label }}</span>
            </div>
        {% endfor %}
    </div>
    <div class="cm-stepper__progress">
        <div class="cm-stepper__progress-fill" style="width: {{ (currentStepIndex / stepLabels|length * 100)|round }}%"></div>
    </div>
    <div class="cm-stepper__caption">{{ (stepCaptionKey|default('wizardStepCaptionLabel'))|trans({'%step%': currentStepIndex, '%total%': stepLabels|length, '%name%': stepLabels[currentStepIndex - 1]}) }}</div>
</div>
