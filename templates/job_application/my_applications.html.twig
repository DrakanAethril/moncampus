{# Screen 2b - "My job search", the student's view (design_handoff_stage_alternance).

   Deliberately free of a banner, a "to do" block, goals and a right-hand column: the README rules
   them out by name for this screen. Guidance lives on the teacher side (2a). #}
{% extends 'layout/app.html.twig' %}

{% block page_title %}{{ 'myJobApplicationsPageHeading'|trans }}{% endblock %}

{% block page_breadcrumb %}
    {% include '_breadcrumb.html.twig' with {segments: [
        {label: 'homeNavLabel'|trans, url: path('app_home')},
        {label: 'myJobApplicationsPageHeading'|trans, url: app.request.requestUri},
    ]} %}
{% endblock %}

{% block main %}
    {% if searchClosed %}
        {# "Mark as finished" on the teacher side: the mailbox stays readable, sending is off. We
           say so rather than let the student discover a missing button. #}
        <div class="alert alert-info" role="alert">{{ 'myJobApplicationsSearchClosedNotice'|trans }}</div>
    {% endif %}

    <div class="card">
        <div class="cm-jobapp-head">
            <span class="cm-jobapp-head__title">{{ 'myJobApplicationsCardTitle'|trans }}</span>
            <span class="cm-jobapp-head__count">{{ total }}</span>
            <span class="cm-jobapp-head__filters">
                {% for value in filters %}
                    <a href="{{ path('app_my_job_applications', {filter: value}) }}"
                       class="cm-jobapp-filter{{ filter == value ? ' is-active' }}">
                        {{ ('myJobApplicationsFilter' ~ value|capitalize ~ 'Label')|trans }}
                    </a>
                {% endfor %}
            </span>
        </div>

        {% if rows is empty %}
            <div class="card-body text-secondary">{{ 'myJobApplicationsEmptyLabel'|trans }}</div>
        {% else %}
            {% for row in rows %}
                {% set application = row.application %}
                {% set summary = row.summary %}
                <div class="cm-jobapp-row{{ row.latestReply ? ' is-latest-reply' }}">
                    <span class="cm-jobapp-row__dot cm-jobapp-row__dot--{{ row.accent }}"></span>
                    <div class="cm-jobapp-row__main">
                        <span class="cm-jobapp-row__name">
                            {{ application.enterprise.name }}{% if application.position %} — {{ application.position }}{% endif %}
                        </span>
                        {# A factual line: a date and a verifiable fact, never a reading of what the
                           company answered (handoff principle #1). #}
                        <span class="cm-jobapp-row__summary">
                            {{ summary.labelKey|trans({
                                '%sentAt%': summary.sentAt ? summary.sentAt|date('d/m') : '',
                                '%replyAt%': summary.replyAt ? summary.replyAt|date('d/m') : '',
                            }) }}
                            {%- if summary.replyAttachmentCount > 0 %} — {{ 'jobApplicationAttachmentCountLabel'|trans({'%count%': summary.replyAttachmentCount}) }}{% endif %}
                        </span>
                    </div>

                    <span class="cm-jobapp-row__side">
                        <span class="cm-jobapp-row__mails">
                            {{ 'jobApplicationMailCountLabel'|trans({'%count%': summary.mailCount}) }}
                        </span>

                        {% if summary.chip %}
                            <span class="cm-jobapp-chip cm-jobapp-chip--{{ summary.chip.variant }}">
                                {{ summary.chip.labelKey|trans({'%date%': summary.chip.date ? summary.chip.date|date('d/m') : ''}) }}
                            </span>
                        {% endif %}

                        {# The link opens the mailbox on this application, in the folder that has
                           something to read: the inbox when a reply came in, Sent otherwise -
                           without which half the applications would lead to an empty list. #}
                        <a class="cm-jobapp-row__link" href="{{ path(summary.replyAt ? 'app_school_mail' : 'app_school_mail_sent', {application: application.id}) }}">
                            {{ 'myJobApplicationsViewMailsAction'|trans }}
                        </a>
                    </span>
                </div>
            {% endfor %}

            {% if hiddenCount > 0 %}
                {# The mockup only shows a few of them and says how many it holds back: never a
                   silent truncation. #}
                <div class="cm-jobapp-more">
                    {{ 'myJobApplicationsHiddenCountLabel'|trans({'%count%': hiddenCount}) }} ·
                    <a href="{{ path('app_my_job_applications', {filter: filter, all: 1}) }}">{{ 'myJobApplicationsShowAllAction'|trans }}</a>
                </div>
            {% endif %}
        {% endif %}
    </div>
{% endblock %}
