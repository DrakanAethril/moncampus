{% extends 'layout/app.html.twig' %}

{# Shared by App\Controller\DirectoryUserController::new() (App\Form\LdapManageUserType,
   data_class LdapManageUser) and ::edit() (App\Form\UserProfileType, data_class User) -
   `editedUser` is only ever passed by edit(), so it doubles as this template's mode flag.
   design/design_handoff_utilisateurs/README.md is the layout reference (tour 18a/18b). #}

{% import _self as aliases %}

{# One of the student's School mail addresses. Built from the name or taken from the login, an
   address follows its source and is not edited (App\Enum\EmailAliasOrigin::isManageable()): its
   local part then shows as plain text, doubled by a hidden input - CollectionType reads a row
   missing from the submission as a deletion, so a locked row still has to be posted. The matching
   form field being disabled server-side (App\Form\EmailAliasType), the posted value cannot rewrite
   anything anyway.

   The "default" radio is not a field of the collection but the parent form's primaryAliasKey: one
   single answer for the whole list, and an address just added - hence without an id - must be
   designatable right away, which is why the row key is what it carries. #}
{% macro aliasRow(aliasForm, domain, primaryFieldName, selectedKey, primaryAliasId) %}
    {% set alias = aliasForm.vars.data %}
    {% set origin = alias is not null ? alias.origin : null %}
    {% set isLocked = origin is not null and not origin.isManageable() %}
    {% set isLogin = origin is not null and origin.value == 'login' %}
    {# A refused submission is what the screen shows back; failing that - first display - the
       recorded primary address is the one checked. The comparison deliberately avoids the `empty`
       test: the first row's key is "0", which Twig would hold for empty. #}
    {% set isSelected = selectedKey is not null and selectedKey != ''
        ? selectedKey == aliasForm.vars.name
        : (alias is not null and primaryAliasId is not null and alias.id == primaryAliasId) %}
    <div class="cm-alias" data-email-alias-list-target="row">
        <div class="cm-alias__default">
            {% if not isLogin %}
                <label class="cm-alias__radio">
                    <input type="radio" class="form-check-input m-0" name="{{ primaryFieldName }}" value="{{ aliasForm.vars.name }}"{{ isSelected ? ' checked' : '' }}>
                    <span class="visually-hidden">{{ 'emailAliasPrimaryFieldLabel'|trans }}</span>
                </label>
            {% endif %}
        </div>
        <div class="cm-alias__address">
            {% if isLocked %}
                <div class="cm-alias__fixed">{{ alias.localPart }}<span class="cm-alias__domain">@{{ domain }}</span></div>
                <input type="hidden" name="{{ aliasForm.localPart.vars.full_name }}" value="{{ aliasForm.localPart.vars.value }}">
            {% else %}
                {# No .input-group: the form theme wraps the field as soon as it carries an error,
                   which dislocates the flat row Bootstrap expects. The domain is not an input
                   add-on anyway - it is not something one picks. #}
                <div class="cm-alias__input">
                    {{ form_widget(aliasForm.localPart, {attr: {class: 'form-control'}}) }}
                    <span class="cm-alias__domain">@{{ domain }}</span>
                </div>
            {% endif %}
            {{ form_errors(aliasForm.localPart) }}
        </div>
        <div class="cm-alias__origin">
            {% if origin is not null %}
                <span class="badge bg-secondary-lt">{{ origin.labelKey()|trans }}</span>
            {% else %}
                <span class="badge bg-blue-lt">{{ 'emailAliasOriginManualLabel'|trans }}</span>
            {% endif %}
        </div>
        <div class="cm-alias__remove">
            {% if not isLocked %}
                <button type="button" class="btn btn-sm btn-outline-danger" data-action="click->email-alias-list#removeRow" title="{{ 'emailAliasRemoveAction'|trans }}" aria-label="{{ 'emailAliasRemoveAction'|trans }}">✕</button>
            {% endif %}
        </div>
    </div>
{% endmacro %}

{% set isEdit = editedUser is defined and editedUser is not null %}
{% set isActive = isEdit and editedUser.inactiveDate is null %}
{% set pageLabel = isEdit ? (editedUser.displayName ?? editedUser.username) : 'newUserPageHeading'|trans %}

{% block title %}{{ pageLabel }}{% endblock %}

{% block page_breadcrumb %}
    {% include '_breadcrumb.html.twig' with {segments: [
        {label: 'homeNavLabel'|trans, url: path('app_home')},
        {label: 'directoryNavLabel'|trans, url: path('app_directory_groups')},
        {label: 'usersListPageHeading'|trans, url: path('app_directory_users')},
        {label: pageLabel, url: app.request.requestUri},
    ]} %}
{% endblock %}

{% block page_title %}
    {{ pageLabel }}
    {% if isEdit %}
        <span class="badge {{ isActive ? 'bg-green-lt' : 'bg-red-lt' }} align-middle ms-2">
            <span class="status-dot {{ isActive ? 'bg-green' : 'bg-red' }} me-1"></span>
            {{ (isActive ? 'userAccountStatusActiveLabel' : 'userAccountStatusInactiveLabel')|trans }}
        </span>
    {% endif %}
{% endblock %}

{% block page_actions %}
    {# Réinitialiser le mot de passe / Désactiver / Réactiver - admin only (design rule 5), guarded
       here AND in the controller (App\Controller\DirectoryUserController::resetPassword()/
       deactivate()/reactivate()), since a hidden button is not an access control. #}
    {% if isEdit and is_granted('ROLE_ADMIN') %}
        <form method="post" action="{{ path('app_directory_users_reset_password', {id: editedUser.id}) }}" onsubmit="return confirm('{{ 'userResetPasswordConfirmMessage'|trans|e('js') }}')">
            <input type="hidden" name="_token" value="{{ csrf_token('directory_user_reset_password') }}">
            <button type="submit" class="btn btn-outline-secondary">{{ 'userResetPasswordButtonLabel'|trans }}</button>
        </form>
        {% if isActive %}
            <form method="post" action="{{ path('app_directory_users_deactivate', {id: editedUser.id}) }}" onsubmit="return confirm('{{ 'deactivateConfirmMessage'|trans|e('js') }}')">
                <input type="hidden" name="_token" value="{{ csrf_token('directory_user_deactivate') }}">
                <button type="submit" class="btn btn-outline-danger">{{ 'userDeactivateButtonLabel'|trans }}</button>
            </form>
        {% else %}
            <form method="post" action="{{ path('app_directory_users_reactivate', {id: editedUser.id}) }}">
                <input type="hidden" name="_token" value="{{ csrf_token('directory_user_reactivate') }}">
                <button type="submit" class="btn btn-outline-success">{{ 'userReactivateButtonLabel'|trans }}</button>
            </form>
        {% endif %}
    {% endif %}
{% endblock %}

{% block main %}
    <div class="card">
        <div class="card-body">
            {{ form_start(form) }}
                {{ form_errors(form) }}
                <div class="row">
                    <div class="col-md-5 d-flex flex-column gap-3">
                        <div class="cm-subhead">
                            <div class="cm-subhead__title">{{ 'newUserIdentitySectionTitle'|trans }}</div>
                        </div>

                        {% if isEdit %}
                            {# Only remaining editable fields in edit mode - everything else below
                               is plain read display straight off the entity, not form fields at
                               all (see App\Form\UserProfileType's docblock). #}
                            <div class="row g-2">
                                <div class="col-7">{{ form_row(form.contactEmail) }}</div>
                                <div class="col-5">{{ form_row(form.phoneNumber) }}</div>
                            </div>
                            {{ form_row(form.mustChangePassword, {label_attr: {class: 'checkbox-switch'}}) }}
                            {{ form_row(form.testUser, {label_attr: {class: 'checkbox-switch'}}) }}

                            <div class="cm-readonly-panel" aria-readonly="true">
                                <div>
                                    <div class="cm-readonly-panel__label">
                                        {{ 'userFirstnameFieldLabel'|trans }}
                                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="4" y="10.5" width="16" height="10" rx="2"></rect><path d="M8 10.5V7a4 4 0 0 1 8 0v3.5"></path></svg>
                                    </div>
                                    <div class="cm-readonly-panel__value">{{ editedUser.firstname }}</div>
                                </div>
                                <div>
                                    <div class="cm-readonly-panel__label">
                                        {{ 'userLastnameFieldLabel'|trans }}
                                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="4" y="10.5" width="16" height="10" rx="2"></rect><path d="M8 10.5V7a4 4 0 0 1 8 0v3.5"></path></svg>
                                    </div>
                                    <div class="cm-readonly-panel__value">{{ editedUser.lastname }}</div>
                                </div>
                                <div>
                                    <div class="cm-readonly-panel__label">
                                        {{ 'userUsernameColumnLabel'|trans }}
                                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="4" y="10.5" width="16" height="10" rx="2"></rect><path d="M8 10.5V7a4 4 0 0 1 8 0v3.5"></path></svg>
                                    </div>
                                    <div class="cm-readonly-panel__value">{{ editedUser.username }}</div>
                                </div>
                                <div>
                                    <div class="cm-readonly-panel__label">
                                        {{ 'userTypeColumnLabel'|trans }}
                                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="4" y="10.5" width="16" height="10" rx="2"></rect><path d="M8 10.5V7a4 4 0 0 1 8 0v3.5"></path></svg>
                                    </div>
                                    <div class="cm-readonly-panel__value">{{ resolvedType ?? '—' }}</div>
                                </div>
                                {# State of the creation request in the directory (ldap_manage_user
                                   queue) - the dash covers the accounts that never went through that
                                   queue, see DirectoryUserController::edit(). #}
                                <div>
                                    <div class="cm-readonly-panel__label">
                                        {{ 'userLdapAddStatusLabel'|trans }}
                                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="4" y="10.5" width="16" height="10" rx="2"></rect><path d="M8 10.5V7a4 4 0 0 1 8 0v3.5"></path></svg>
                                    </div>
                                    <div class="cm-readonly-panel__value">
                                        {% if ldapAddStatus %}
                                            <span class="badge {{ ldapAddStatus.class }}">{{ ldapAddStatus.label }}</span>
                                        {% else %}
                                            —
                                        {% endif %}
                                    </div>
                                </div>
                                {% if ldapAddStatus and ldapAddStatus.error %}
                                    <div class="cm-readonly-panel__row--wide">
                                        <div class="cm-readonly-panel__label">{{ 'userLdapAddErrorLabel'|trans }}</div>
                                        <div class="cm-readonly-panel__value cm-readonly-panel__value--log">{{ ldapAddStatus.error }}</div>
                                    </div>
                                {% endif %}
                            </div>

                            {% if adGroupBuckets|length > 0 %}
                                <div class="d-flex flex-column gap-2">
                                    <div class="cm-groupchips__heading">{{ 'userDirectoryGroupsSectionTitle'|trans }}</div>
                                    <div class="cm-groupchips__list">
                                        {% for bucket in adGroupBuckets %}
                                            {% for group in bucket.groups %}
                                                <span class="cm-groupchip cm-groupchip--locked" aria-readonly="true">
                                                    <svg class="cm-groupchip__lock" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="4" y="10.5" width="16" height="10" rx="2"></rect><path d="M8 10.5V7a4 4 0 0 1 8 0v3.5"></path></svg>
                                                    {{ group.name }}
                                                </span>
                                            {% endfor %}
                                        {% endfor %}
                                    </div>
                                </div>
                            {% endif %}

                            <p class="text-secondary small mb-0">{{ 'userProfileLdapOwnedNotice'|trans }}</p>
                        {% else %}
                            <div class="row">
                                <div class="col-md-6">{{ form_row(form.firstname) }}</div>
                                <div class="col-md-6">{{ form_row(form.lastname) }}</div>
                            </div>
                            {{ form_row(form.userType) }}
                            <div class="row g-2">
                                <div class="col-7">{{ form_row(form.contactEmail) }}</div>
                                <div class="col-5">{{ form_row(form.phoneNumber) }}</div>
                            </div>
                            {{ form_row(form.mustChangePassword, {label_attr: {class: 'checkbox-switch'}}) }}
                            {{ form_row(form.testUser, {label_attr: {class: 'checkbox-switch'}}) }}
                        {% endif %}
                    </div>
                    <div class="col-md-7 d-flex flex-column gap-3">
                        <div class="cm-subhead">
                            <div class="cm-subhead__title">{{ isEdit ? 'editUserSecondaryGroupsSectionTitle'|trans : 'newUserSecondaryGroupsSectionTitle'|trans }}</div>
                        </div>
                        <div>
                            {# create: form.userGroups (LdapManageUserType) against every active group;
                               edit: form.manualGroups (UserProfileType) against manually-assignable
                               groups only, already excluding whatever this user's annuaire membership
                               already grants - see App\Controller\DirectoryUserController::edit(). #}
                            {% set chipField = isEdit ? form.manualGroups : form.userGroups %}
                            {% for bucket in (isEdit ? manualGroupBuckets : groupBuckets) %}
                                <div class="cm-groupchips__section">
                                    <div class="cm-groupchips__heading">{{ bucket.label ?? 'groupTypeOthersLabel'|trans }}</div>
                                    <div class="cm-groupchips__list">
                                        {% for group in bucket.groups %}
                                            {# Twig's |first returns false (not null) on no match - defensive only, this
                                               should never actually happen since the buckets and the field's own choices
                                               are built from the exact same query, see DirectoryUserController. #}
                                            {% set child = chipField.children|filter(c => c.vars.value == group.name)|first %}
                                            {% if child is not null and child is not same as(false) %}
                                                <label class="cm-groupchip">
                                                    {{ form_widget(child, {attr: {class: 'cm-groupchip__input'}}) }}
                                                    <span class="cm-groupchip__box"></span>
                                                    {{ group.name }}
                                                </label>
                                            {% endif %}
                                        {% endfor %}
                                    </div>
                                </div>
                            {% endfor %}
                            {# form_rest() below would otherwise re-render this field from scratch:
                               a compound field with zero available choices (e.g. no manually-
                               assignable group left to offer, or none defined at all) has zero
                               children, and FormView::isRendered() only auto-derives "rendered"
                               from its children when there's at least one - so it stays false and
                               leaks the field's own default label/widget markup below the card. #}
                            {% do chipField.setRendered %}
                        </div>
                    </div>
                </div>

                {# School mail addresses - students only (App\Controller\DirectoryUserController::edit()).
                   The domain is not a choice: it comes from MAIL_STUDENT_DOMAIN, the same database
                   serving both development and production (App\Entity\EmailAlias). #}
                {% if showEmailAliases|default(false) %}
                    {% set selectedKey = form.primaryAliasKey.vars.data %}
                    {% set primaryAliasId = editedUser.primaryAlias is not null ? editedUser.primaryAlias.id : null %}

                    <div class="mt-4" data-controller="email-alias-list">
                        <div class="cm-subhead mb-3">
                            <div class="cm-subhead__title">{{ 'userEmailAliasesSectionTitle'|trans }}</div>
                            <div class="cm-subhead__hint">{{ 'userEmailAliasesSectionHint'|trans }}</div>
                        </div>

                        <div class="cm-alias-list{{ form.emailAliases|length == 0 ? ' d-none' : '' }}" data-email-alias-list-target="list">
                            <div class="cm-alias cm-alias--head">
                                <div class="cm-alias__default">{{ 'emailAliasPrimaryColumnLabel'|trans }}</div>
                                <div class="cm-alias__address">{{ 'emailAliasAddressColumnLabel'|trans }}</div>
                                <div class="cm-alias__origin">{{ 'emailAliasOriginColumnLabel'|trans }}</div>
                                <div class="cm-alias__remove"></div>
                            </div>
                            <div data-email-alias-list-target="rows"
                                 data-prototype="{{ aliases.aliasRow(form.emailAliases.vars.prototype, studentMailDomain, form.primaryAliasKey.vars.full_name, null, null)|e('html_attr') }}"
                                 data-prototype-name="__name__">
                                {% for aliasForm in form.emailAliases %}
                                    {{ aliases.aliasRow(aliasForm, studentMailDomain, form.primaryAliasKey.vars.full_name, selectedKey, primaryAliasId) }}
                                {% endfor %}
                            </div>
                        </div>

                        <p class="text-secondary small mb-0{{ form.emailAliases|length > 0 ? ' d-none' : '' }}" data-email-alias-list-target="empty">{{ 'userEmailAliasesEmptyLabel'|trans }}</p>

                        <button type="button" class="btn btn-outline-primary btn-sm mt-2" data-action="click->email-alias-list#addRow">+ {{ 'emailAliasAddAction'|trans }}</button>

                        {# form_rest() would otherwise render the collection and the designation
                           field a second time, in their default markup, below the card. #}
                        {% do form.emailAliases.setRendered %}
                        {% do form.primaryAliasKey.setRendered %}
                    </div>
                {% endif %}

                {# Bibliothèque de fichiers - the *whole* of what an admin may do to somebody else's
                   library: a usage total and a number. Not a folder, not a file name, not a preview.

                   A section of this form and not a card of its own: the quota is a field of the
                   account like the others, and its former standalone <form> put a second
                   « Enregistrer » at the foot of the screen - the one that saved the account then
                   read as missing. The field is administrators-only (App\Form\UserProfileType's
                   fileLibraryQuotaEditable), staff seeing the usage without being offered the box. #}
                {% if isEdit and fileLibraryQuota is defined and fileLibraryQuota %}
                    <div class="mt-4">
                        <div class="cm-subhead mb-3">
                            <div class="cm-subhead__title">{{ 'fileLibraryQuotaCardTitle'|trans }}</div>
                        </div>

                        <p class="cm-flib__quota-usage">{{ 'fileLibraryQuotaUsageLabel'|trans({'%used%': fileLibraryQuota.usedLabel, '%limit%': fileLibraryQuota.limitLabel}) }}</p>
                        <div class="cm-flib__quota cm-flib__quota--{{ fileLibraryQuota.level }}">
                            <div class="cm-flib__quota-line">
                                <span></span>
                                <span class="cm-flib__quota-percent">{{ fileLibraryQuota.percent }} %</span>
                            </div>
                            <div class="cm-flib__quota-track">
                                <div class="cm-flib__quota-fill" style="width: {{ min(fileLibraryQuota.percent, 100) }}%"></div>
                            </div>
                        </div>

                        {% if form.fileLibraryQuota is defined %}
                            <div class="row mt-3">
                                <div class="col-md-3">
                                    {{ form_row(form.fileLibraryQuota, {
                                        attr: {placeholder: fileLibraryQuota.defaultLabel},
                                        help: 'fileLibraryQuotaFieldHelpText'|trans({'%default%': fileLibraryQuota.defaultLabel}),
                                    }) }}
                                </div>
                            </div>
                        {% endif %}
                    </div>
                {% endif %}

                <div class="cm-actionbar">
                    <div class="cm-actionbar__buttons">
                        <a href="{{ path('app_directory_users') }}" class="btn btn-link">{{ 'cancelAction'|trans }}</a>
                        {{ form_widget(form.submit) }}
                    </div>
                </div>
                {{ form_rest(form) }}
            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}
