{% extends 'layout/app.html.twig' %}

{# Shared by App\Controller\DirectoryUserController::new() (App\Form\LdapManageUserType,
   data_class LdapManageUser) and ::edit() (App\Form\UserProfileType, data_class User) -
   `editedUser` is only ever passed by edit(), so it doubles as this template's mode flag.
   design/design_handoff_utilisateurs/README.md is the layout reference (tour 18a/18b). #}

{% set isEdit = editedUser is defined and editedUser is not null %}
{% set isActive = isEdit and editedUser.inactiveDate is null %}
{% set pageLabel = isEdit ? (editedUser.displayName ?? editedUser.username) : 'newUserPageHeading'|trans %}

{% block title %}{{ pageLabel }}{% endblock %}

{% block page_breadcrumb %}
    {% include '_breadcrumb.html.twig' with {segments: [
        {label: 'homeNavLabel'|trans, url: path('app_home')},
        {label: 'directoryNavLabel'|trans, url: path('app_directory_groups')},
        {label: 'usersListPageHeading'|trans, url: path('app_directory_users')},
        {label: pageLabel, url: app.request.requestUri},
    ]} %}
{% endblock %}

{% block page_title %}
    {{ pageLabel }}
    {% if isEdit %}
        <span class="badge {{ isActive ? 'bg-green-lt' : 'bg-red-lt' }} align-middle ms-2">
            <span class="status-dot {{ isActive ? 'bg-green' : 'bg-red' }} me-1"></span>
            {{ (isActive ? 'userAccountStatusActiveLabel' : 'userAccountStatusInactiveLabel')|trans }}
        </span>
    {% endif %}
{% endblock %}

{% block page_actions %}
    {# Réinitialiser le mot de passe / Désactiver / Réactiver - admin only (design rule 5), guarded
       here AND in the controller (App\Controller\DirectoryUserController::resetPassword()/
       deactivate()/reactivate()), since a hidden button is not an access control. #}
    {% if isEdit and is_granted('ROLE_ADMIN') %}
        <form method="post" action="{{ path('app_directory_users_reset_password', {id: editedUser.id}) }}" onsubmit="return confirm('{{ 'userResetPasswordConfirmMessage'|trans|e('js') }}')">
            <input type="hidden" name="_token" value="{{ csrf_token('directory_user_reset_password') }}">
            <button type="submit" class="btn btn-outline-secondary">{{ 'userResetPasswordButtonLabel'|trans }}</button>
        </form>
        {% if isActive %}
            <form method="post" action="{{ path('app_directory_users_deactivate', {id: editedUser.id}) }}" onsubmit="return confirm('{{ 'deactivateConfirmMessage'|trans|e('js') }}')">
                <input type="hidden" name="_token" value="{{ csrf_token('directory_user_deactivate') }}">
                <button type="submit" class="btn btn-outline-danger">{{ 'userDeactivateButtonLabel'|trans }}</button>
            </form>
        {% else %}
            <form method="post" action="{{ path('app_directory_users_reactivate', {id: editedUser.id}) }}">
                <input type="hidden" name="_token" value="{{ csrf_token('directory_user_reactivate') }}">
                <button type="submit" class="btn btn-outline-success">{{ 'userReactivateButtonLabel'|trans }}</button>
            </form>
        {% endif %}
    {% endif %}
{% endblock %}

{% block main %}
    <div class="card">
        <div class="card-body">
            {{ form_start(form) }}
                {{ form_errors(form) }}
                <div class="row">
                    <div class="col-md-5 d-flex flex-column gap-3">
                        <div class="cm-subhead">
                            <div class="cm-subhead__title">{{ 'newUserIdentitySectionTitle'|trans }}</div>
                        </div>

                        {% if isEdit %}
                            {# Only remaining editable fields in edit mode - everything else below
                               is plain read display straight off the entity, not form fields at
                               all (see App\Form\UserProfileType's docblock). #}
                            <div class="row g-2">
                                <div class="col-7">{{ form_row(form.contactEmail) }}</div>
                                <div class="col-5">{{ form_row(form.phoneNumber) }}</div>
                            </div>
                            {{ form_row(form.mustChangePassword, {label_attr: {class: 'checkbox-switch'}}) }}
                            {{ form_row(form.testUser, {label_attr: {class: 'checkbox-switch'}}) }}

                            <div class="cm-readonly-panel" aria-readonly="true">
                                <div>
                                    <div class="cm-readonly-panel__label">
                                        {{ 'userFirstnameFieldLabel'|trans }}
                                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="4" y="10.5" width="16" height="10" rx="2"></rect><path d="M8 10.5V7a4 4 0 0 1 8 0v3.5"></path></svg>
                                    </div>
                                    <div class="cm-readonly-panel__value">{{ editedUser.firstname }}</div>
                                </div>
                                <div>
                                    <div class="cm-readonly-panel__label">
                                        {{ 'userLastnameFieldLabel'|trans }}
                                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="4" y="10.5" width="16" height="10" rx="2"></rect><path d="M8 10.5V7a4 4 0 0 1 8 0v3.5"></path></svg>
                                    </div>
                                    <div class="cm-readonly-panel__value">{{ editedUser.lastname }}</div>
                                </div>
                                <div>
                                    <div class="cm-readonly-panel__label">
                                        {{ 'userUsernameColumnLabel'|trans }}
                                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="4" y="10.5" width="16" height="10" rx="2"></rect><path d="M8 10.5V7a4 4 0 0 1 8 0v3.5"></path></svg>
                                    </div>
                                    <div class="cm-readonly-panel__value">{{ editedUser.username }}</div>
                                </div>
                                <div>
                                    <div class="cm-readonly-panel__label">
                                        {{ 'userTypeColumnLabel'|trans }}
                                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="4" y="10.5" width="16" height="10" rx="2"></rect><path d="M8 10.5V7a4 4 0 0 1 8 0v3.5"></path></svg>
                                    </div>
                                    <div class="cm-readonly-panel__value">{{ resolvedType ?? '—' }}</div>
                                </div>
                                {# État de la demande de création dans l'annuaire (file
                                   ldap_manage_user) - le tiret couvre les comptes qui ne sont
                                   jamais passés par cette file, voir DirectoryUserController::edit(). #}
                                <div>
                                    <div class="cm-readonly-panel__label">
                                        {{ 'userLdapAddStatusLabel'|trans }}
                                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="4" y="10.5" width="16" height="10" rx="2"></rect><path d="M8 10.5V7a4 4 0 0 1 8 0v3.5"></path></svg>
                                    </div>
                                    <div class="cm-readonly-panel__value">
                                        {% if ldapAddStatus %}
                                            <span class="badge {{ ldapAddStatus.class }}">{{ ldapAddStatus.label }}</span>
                                        {% else %}
                                            —
                                        {% endif %}
                                    </div>
                                </div>
                                {% if ldapAddStatus and ldapAddStatus.error %}
                                    <div class="cm-readonly-panel__row--wide">
                                        <div class="cm-readonly-panel__label">{{ 'userLdapAddErrorLabel'|trans }}</div>
                                        <div class="cm-readonly-panel__value cm-readonly-panel__value--log">{{ ldapAddStatus.error }}</div>
                                    </div>
                                {% endif %}
                            </div>

                            {% if adGroupBuckets|length > 0 %}
                                <div class="d-flex flex-column gap-2">
                                    <div class="cm-groupchips__heading">{{ 'userDirectoryGroupsSectionTitle'|trans }}</div>
                                    <div class="cm-groupchips__list">
                                        {% for bucket in adGroupBuckets %}
                                            {% for group in bucket.groups %}
                                                <span class="cm-groupchip cm-groupchip--locked" aria-readonly="true">
                                                    <svg class="cm-groupchip__lock" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="4" y="10.5" width="16" height="10" rx="2"></rect><path d="M8 10.5V7a4 4 0 0 1 8 0v3.5"></path></svg>
                                                    {{ group.name }}
                                                </span>
                                            {% endfor %}
                                        {% endfor %}
                                    </div>
                                </div>
                            {% endif %}

                            <p class="text-secondary small mb-0">{{ 'userProfileLdapOwnedNotice'|trans }}</p>
                        {% else %}
                            <div class="row">
                                <div class="col-md-6">{{ form_row(form.firstname) }}</div>
                                <div class="col-md-6">{{ form_row(form.lastname) }}</div>
                            </div>
                            {{ form_row(form.userType) }}
                            <div class="row g-2">
                                <div class="col-7">{{ form_row(form.contactEmail) }}</div>
                                <div class="col-5">{{ form_row(form.phoneNumber) }}</div>
                            </div>
                            {{ form_row(form.mustChangePassword, {label_attr: {class: 'checkbox-switch'}}) }}
                            {{ form_row(form.testUser, {label_attr: {class: 'checkbox-switch'}}) }}
                        {% endif %}
                    </div>
                    <div class="col-md-7 d-flex flex-column gap-3">
                        <div class="cm-subhead">
                            <div class="cm-subhead__title">{{ isEdit ? 'editUserSecondaryGroupsSectionTitle'|trans : 'newUserSecondaryGroupsSectionTitle'|trans }}</div>
                        </div>
                        <div>
                            {# create: form.userGroups (LdapManageUserType) against every active group;
                               edit: form.manualGroups (UserProfileType) against manually-assignable
                               groups only, already excluding whatever this user's annuaire membership
                               already grants - see App\Controller\DirectoryUserController::edit(). #}
                            {% set chipField = isEdit ? form.manualGroups : form.userGroups %}
                            {% for bucket in (isEdit ? manualGroupBuckets : groupBuckets) %}
                                <div class="cm-groupchips__section">
                                    <div class="cm-groupchips__heading">{{ bucket.label ?? 'groupTypeOthersLabel'|trans }}</div>
                                    <div class="cm-groupchips__list">
                                        {% for group in bucket.groups %}
                                            {# Twig's |first returns false (not null) on no match - defensive only, this
                                               should never actually happen since the buckets and the field's own choices
                                               are built from the exact same query, see DirectoryUserController. #}
                                            {% set child = chipField.children|filter(c => c.vars.value == group.name)|first %}
                                            {% if child is not null and child is not same as(false) %}
                                                <label class="cm-groupchip">
                                                    {{ form_widget(child, {attr: {class: 'cm-groupchip__input'}}) }}
                                                    <span class="cm-groupchip__box"></span>
                                                    {{ group.name }}
                                                </label>
                                            {% endif %}
                                        {% endfor %}
                                    </div>
                                </div>
                            {% endfor %}
                            {# form_rest() below would otherwise re-render this field from scratch:
                               a compound field with zero available choices (e.g. no manually-
                               assignable group left to offer, or none defined at all) has zero
                               children, and FormView::isRendered() only auto-derives "rendered"
                               from its children when there's at least one - so it stays false and
                               leaks the field's own default label/widget markup below the card. #}
                            {% do chipField.setRendered %}
                        </div>
                    </div>
                </div>
                <div class="cm-actionbar">
                    <div class="cm-actionbar__buttons">
                        <a href="{{ path('app_directory_users') }}" class="btn btn-link">{{ 'cancelAction'|trans }}</a>
                        {{ form_widget(form.submit) }}
                    </div>
                </div>
                {{ form_rest(form) }}
            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}
