{# The tool's breadcrumb, in both its entry points (handoff, "Accès par le menu"):
   "Accueil > Outils > Enregistrements audio" from the top bar, and
   "Accueil > SIO-1 > Outils > Enregistrements audio" from a class.

   `program` carries the class when it is known - always, from step 2 on, which gets it from the
   recording. `leaf` adds the last segment ("Nouvel enregistrement", "Statistiques d'écoute"…),
   absent on the list itself. #}
{% set list_url = program ? path('app_program_tools_audio_recordings', {id: program.id}) : path('app_audio_recordings') %}
{% set segments = [{label: 'homeNavLabel'|trans, url: path('app_home')}] %}
{% if program %}
    {% set segments = segments|merge([{label: program.displayShortName, url: path('app_program_students', {id: program.id})}]) %}
{% endif %}
{% set segments = segments|merge([
    {label: 'toolsNavLabel'|trans, url: list_url},
    {label: 'audioRecordingsPageHeading'|trans, url: list_url},
]) %}
{% if leaf is defined and leaf %}
    {% set segments = segments|merge([{label: leaf, url: app.request.requestUri}]) %}
{% endif %}
{% include '_breadcrumb.html.twig' with {segments: segments} %}
