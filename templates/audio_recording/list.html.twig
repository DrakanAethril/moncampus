{% extends 'layout/app.html.twig' %}

{# Handoff screen 1: the list of recordings. Multi-class when reached from the top bar's "Outils"
   menu (with the "Toutes les classes" filter at the top), filtered on one class when reached from
   its submenu - `scopedProgram` makes the whole difference. #}

{% block title %}{{ 'audioRecordingsPageHeading'|trans }}{{ scopedProgram ? ' - ' ~ scopedProgram.displayShortName }}{% endblock %}

{% block page_breadcrumb %}
    {% include 'audio_recording/_breadcrumb.html.twig' with {program: scopedProgram} %}
{% endblock %}
{% block page_title %}{{ 'audioRecordingsPageHeading'|trans }}{% endblock %}

{% block page_actions %}
    {% if not scopedProgram %}
        <form method="get" class="cm-audio-filter">
            <select name="class" class="form-select" onchange="this.form.requestSubmit()" aria-label="{{ 'audioRecordingClassFilterLabel'|trans }}">
                <option value="0">{{ 'audioRecordingAllClassesLabel'|trans }}</option>
                {% for program in programs %}
                    <option value="{{ program.id }}" {{ filterId == program.id ? 'selected' }}>{{ program.displayShortName }}</option>
                {% endfor %}
            </select>
        </form>
    {% endif %}
    <a class="btn btn-primary" href="{{ scopedProgram
        ? path('app_program_tools_audio_recording_new', {id: scopedProgram.id})
        : path('app_audio_recording_new') }}">+ {{ 'audioRecordingNewAction'|trans }}</a>
{% endblock %}

{% block main %}
    <div class="card">
        {% if rows is empty %}
            <div class="card-body text-secondary">{{ 'audioRecordingsEmptyMessage'|trans }}</div>
        {% else %}
            <div class="table-responsive">
                <table class="table card-table cm-audio-table">
                    <thead>
                        <tr>
                            <th>{{ 'audioRecordingColumnLabel'|trans }}</th>
                            <th class="cm-audio-table__target">{{ 'audioRecordingTargetColumnLabel'|trans }}</th>
                            <th class="cm-audio-table__type">{{ 'audioRecordingTypeColumnLabel'|trans }}</th>
                            <th class="cm-audio-table__files">{{ 'audioRecordingFilesColumnLabel'|trans }}</th>
                            <th class="cm-audio-table__status">{{ 'audioRecordingStatusColumnLabel'|trans }}</th>
                            <th class="cm-audio-table__action"><span class="visually-hidden">{{ 'audioRecordingActionsColumnLabel'|trans }}</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for row in rows %}
                            {% set recording = row.recording %}
                            <tr>
                                <td class="cm-audio-table__name" title="{{ recording.name }}">{{ recording.name }}</td>
                                <td class="cm-audio-table__target">
                                    {{- recording.program.displayShortName }} ·
                                    {{ recording.options is empty
                                        ? 'audioRecordingWholeClassLabel'|trans
                                        : recording.options|map(option => option.shortName)|join(' · ') -}}
                                </td>
                                <td class="cm-audio-table__type">{{ recording.mode.labelKey|trans }}</td>
                                {# "3 fichiers" in common mode, "5 individuels + 1 commun" in individualised
                                   mode: the mockup counts the two kinds apart as soon as both exist. #}
                                <td class="cm-audio-table__files">
                                    {%- if recording.individual -%}
                                        {{ 'audioRecordingIndividualCountLabel'|trans({'%count%': row.individualCount}) }}
                                        {%- if row.commonCount > 0 %} + {{ 'audioRecordingCommonCountLabel'|trans({'%count%': row.commonCount}) }}{% endif -%}
                                    {%- else -%}
                                        {{ 'audioRecordingFilesCountLabel'|trans({'%count%': row.commonCount}) }}
                                    {%- endif -%}
                                </td>
                                <td class="cm-audio-table__status">
                                    <span class="cm-audio-pill {{ row.status.badgeClass }}">{{ row.status.labelKey|trans }}</span>
                                </td>
                                {# One action per row, the one its state calls for: complete a draft, give
                                   the assignment of a ready recording, follow the listening of one
                                   already given. #}
                                <td class="cm-audio-table__action">
                                    {% if row.status.value == 'draft' %}
                                        <a class="cm-audio-ghost" href="{{ path('app_audio_recording_files', {recordingId: recording.id}) }}">{{ 'audioRecordingCompleteAction'|trans }}</a>
                                    {% elseif row.status.value == 'complete' %}
                                        <a class="cm-audio-ghost" href="{{ path('app_assignment_new', {recording: recording.id}) }}">{{ 'audioRecordingCreateWorkAction'|trans }}</a>
                                    {% else %}
                                        <a class="cm-audio-ghost" href="{{ path('app_audio_recording_statistics', {recordingId: recording.id}) }}">{{ 'audioRecordingStatisticsAction'|trans }}</a>
                                    {% endif %}
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}
    </div>
{% endblock %}
