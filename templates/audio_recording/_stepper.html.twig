{# The two-step stepper of mockups 2 and 3: "Paramètres" then "Fichiers audio". The step already
   cleared carries a green ticked dot, the current one a filled dot, the one still ahead a hollow
   dot. #}
{% set labels = ['audioRecordingStepSettingsLabel'|trans, 'audioRecordingStepFilesLabel'|trans] %}
<ol class="cm-audio-stepper">
    {% for index in 1..2 %}
        <li class="cm-audio-stepper__step {{ index < step ? 'is-done' : (index == step ? 'is-current' : '') }}">
            <span class="cm-audio-stepper__dot" aria-hidden="true">
                {%- if index < step -%}
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="m5 13 5 5L20 7"></path></svg>
                {%- else -%}
                    {{ index }}
                {%- endif -%}
            </span>
            <span class="cm-audio-stepper__label">{{ labels[index - 1] }}</span>
        </li>
    {% endfor %}
</ol>
