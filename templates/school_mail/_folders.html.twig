{# Left pane of the School mail box (screen 3b): folders, then the applications context. #}
<div class="cm-mail-folders">
    <nav class="cm-mail-folders__card" aria-label="{{ 'schoolMailPageHeading'|trans }}">
        <a href="{{ path('app_school_mail', application ? {application: application.id} : {}) }}"
           class="cm-mail-folders__item{{ folder == 'inbox' ? ' is-active' }}"{{ folder == 'inbox' ? ' aria-current="page"' }}>
            <twig:ux:icon name="inbox" width="16" height="16"/>
            <span>{{ 'schoolMailInboxFolderLabel'|trans }}</span>
            {% if counts.unread > 0 %}
                <span class="cm-mail-folders__badge">{{ counts.unread > 99 ? '99+' : counts.unread }}</span>
            {% else %}
                <span class="cm-mail-folders__count">{{ counts.inbox }}</span>
            {% endif %}
        </a>
        <a href="{{ path('app_school_mail_sent', application ? {application: application.id} : {}) }}"
           class="cm-mail-folders__item{{ folder == 'sent' ? ' is-active' }}"{{ folder == 'sent' ? ' aria-current="page"' }}>
            <twig:ux:icon name="send" width="16" height="16"/>
            <span>{{ 'schoolMailSentFolderLabel'|trans }}</span>
            <span class="cm-mail-folders__count">{{ counts.sent }}</span>
        </a>
        <a href="{{ path('app_school_mail_drafts') }}"
           class="cm-mail-folders__item{{ folder == 'drafts' ? ' is-active' }}"{{ folder == 'drafts' ? ' aria-current="page"' }}>
            <twig:ux:icon name="pen" width="16" height="16"/>
            <span>{{ 'schoolMailDraftsFolderLabel'|trans }}</span>
            {% if counts.drafts > 0 %}<span class="cm-mail-folders__count">{{ counts.drafts }}</span>{% endif %}
        </a>
        <a href="{{ path('app_school_mail_trash') }}"
           class="cm-mail-folders__item{{ folder == 'trash' ? ' is-active' }}"{{ folder == 'trash' ? ' aria-current="page"' }}>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M4.5 6.5h15"></path><path d="M9.5 6.5V4.8h5v1.7"></path><path d="M6.5 6.5 7.4 19a1.5 1.5 0 0 0 1.5 1.4h6.2A1.5 1.5 0 0 0 16.6 19l.9-12.5"></path></svg>
            <span>{{ 'schoolMailTrashFolderLabel'|trans }}</span>
            {% if counts.trash > 0 %}<span class="cm-mail-folders__count">{{ counts.trash }}</span>{% endif %}
        </a>
    </nav>

    {# The signature travels with every mail (screen 3f), so it belongs where mails are, not in the
       account settings. #}
    <a class="cm-schoolmail-context__all" href="{{ path('app_school_mail_signature') }}">{{ 'schoolMailSignatureNavLabel'|trans }}</a>

    {% if contexts is not empty %}
        <div class="cm-schoolmail-context">
            <b class="cm-schoolmail-context__label">{{ 'schoolMailContextLabel'|trans }}</b>
            {% for context in contexts %}
                <a class="cm-schoolmail-context__item{{ application and application.id == context.application.id ? ' is-active' }}"
                   href="{{ path(folder == 'sent' ? 'app_school_mail_sent' : 'app_school_mail', {application: context.application.id}) }}">
                    <span class="cm-jobapp-row__dot cm-jobapp-row__dot--{{ context.accent }}"></span>
                    <span class="cm-schoolmail-context__name">{{ context.application.name }}</span>
                    <span class="cm-schoolmail-context__count">{{ context.mailCount }}</span>
                </a>
            {% endfor %}
            <a class="cm-schoolmail-context__all" href="{{ path('app_my_job_applications') }}">{{ 'schoolMailAllApplicationsAction'|trans }}</a>
        </div>
    {% endif %}
</div>
