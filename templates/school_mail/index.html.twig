{# Screen 3b - "School mail", the student's external mailbox (design_handoff_stage_alternance).

   The same three-pane styling as internal Messaging, yet two mailboxes that never cross
   (principle #8): hence the identity banner, which always says which address you write from
   here. #}
{% extends 'layout/app.html.twig' %}

{% block page_title %}{{ 'schoolMailPageHeading'|trans }}{% endblock %}

{% block page_breadcrumb %}
    {% include '_breadcrumb.html.twig' with {segments: [
        {label: 'homeNavLabel'|trans, url: path('app_home')},
        {label: 'schoolMailPageHeading'|trans, url: path('app_school_mail')},
    ]} %}
{% endblock %}

{% block main %}
    {% if mailbox %}
        {# Permanent identity banner (principle #8): here you write from your etu address, not
           from internal Messaging - the two mailboxes never talk to each other. #}
        <p class="cm-schoolmail-identity">{{ 'schoolMailIdentityBannerLabel'|trans }} <b>{{ mailbox }}</b></p>
    {% endif %}

    {% if not searchClosed %}
        <div class="cm-schoolmail-actions">
            <a class="cm-btn cm-btn--primary" href="{{ path('app_school_mail_compose') }}">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M12 20h9"></path><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z"></path></svg>
                {{ 'schoolMailComposeAction'|trans }}
            </a>
        </div>
    {% endif %}

    <div class="cm-mail-app{{ selected ? ' is-reading' }}">
        {% include 'school_mail/_folders.html.twig' %}
        {% include 'school_mail/_list.html.twig' %}

        {% if selected %}
            {% include 'school_mail/_message.html.twig' with {message: selected} %}
        {% else %}
            <div class="cm-mail-thread cm-mail-empty">
                <div class="cm-mail-empty__body">
                    <div class="cm-mail-empty__content">
                        <span class="cm-mail-empty__icon">
                            <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2.5" y="5" width="19" height="14" rx="3"></rect><path d="M3.5 7.5 10.4 12.6a2.7 2.7 0 0 0 3.2 0L20.5 7.5"></path></svg>
                        </span>
                        <div class="cm-mail-empty__title">{{ 'schoolMailSelectMailTitle'|trans }}</div>
                        <p class="cm-mail-empty__text">{{ 'schoolMailSelectMailText'|trans }}</p>
                    </div>
                </div>
            </div>
        {% endif %}
    </div>
{% endblock %}
