{% extends 'layout/app.html.twig' %}

{% block title %}{{ dossier.title }}{% endblock %}

{% block page_breadcrumb %}
    {% include '_breadcrumb.html.twig' with {segments: [
        {label: 'homeNavLabel'|trans, url: path('app_home')},
        {label: 'toolsNavLabel'|trans, url: path('app_tools_random_draw')},
        {label: 'dossierNavLabel'|trans, url: path('app_dossiers')},
        {label: dossier.title, url: path('app_dossier_show', {id: dossier.id})},
    ]} %}
{% endblock %}

{# The state pill sits inside the title, as the handoff draws it - .page-title is a flex container,
   and the app already puts a badge there (see .page-title .cm-training-badge). #}
{% block page_title %}{{ dossier.title }}<span class="cm-dd-tag cm-dd-titletag cm-dd--{{ dossier.state.tagModifier }}">{{ dossier.state.labelKey|trans }}</span>{% endblock %}

{% block page_actions %}
    {% if canEdit %}
        <form method="post" action="{{ path('app_dossier_duplicate', {id: dossier.id}) }}">
            <input type="hidden" name="_token" value="{{ csrf_token('dossier_duplicate') }}">
            <button type="submit" class="cm-dd-ghost">{{ 'dossierDuplicateAction'|trans }}</button>
        </form>
    {% endif %}
    <a class="cm-dd-ghost" href="{{ path('app_dossier_archive', {id: dossier.id}) }}" data-turbo="false">{{ 'dossierArchiveAction'|trans }}</a>
    <a class="cm-dd-btn cm-dd-btn--sm" href="{{ path('app_dossier_tracking', {id: dossier.id}) }}">{{ 'dossierTrackingAction'|trans }}</a>
{% endblock %}

{% block main %}
    <div class="cm-dd-page">
        <div class="cm-dd-manage">
            <div class="cm-dd-card">
                <div class="cm-dd-cardhead">
                    <span class="cm-dd-cardtitle">{{ 'dossierDocumentsColumnLabel'|trans }}</span>
                    {% if queueSize > 0 %}
                        <a class="cm-dd-link" href="{{ path('app_dossier_review', {id: dossier.id}) }}">{{ 'dossierQueueLinkText'|trans({'%count%': queueSize}) }}</a>
                    {% endif %}
                    {% if canEdit %}
                        <a class="cm-dd-btn cm-dd-btn--sm" style="margin-left: auto;" href="{{ path('app_dossier_documents', {id: dossier.id, document: 'new'}) }}">{{ 'dossierAddDocumentAction'|trans }}</a>
                    {% endif %}
                </div>
                {% for entry in groups %}
                    <div class="cm-dd-grouphead">
                        <span class="cm-dd-grouphead__title">{{ entry.group ? entry.group.title : 'dossierUngroupedLabel'|trans }}</span>
                        <span class="cm-dd-meta">{{ 'dossierDocumentCountText'|trans({'%count%': entry.documents|length}) }}</span>
                    </div>
                    {% for document in entry.documents %}
                        {% set progress = board.documentProgress(document) %}
                        <div class="cm-dd-manrow">
                            {% include 'dossier/_doc_badges.html.twig' with {document: document} only %}
                            <span class="cm-dd-docrow__text">
                                <span class="cm-dd-docrow__name">{{ document.name }}</span>
                                <span class="cm-dd-docrow__rules">{% include 'dossier/_rules.html.twig' with {document: document} only %}</span>
                                {# The two tags sit under the règles rather than beside them: they
                                   are properties of the document, read once when it is set up,
                                   where the line above is the calendar somebody comes back to. It
                                   also empties the right-hand end of the row, which is what lets
                                   the jauge, the fraction and the crayon line up from one document
                                   to the next. #}
                                <span class="cm-dd-manrow__tags">
                                    {% include 'dossier/_required.html.twig' with {document: document} only %}
                                    {% include 'dossier/_profile.html.twig' with {document: document} only %}
                                </span>
                            </span>
                            <span class="cm-dd-manrow__end">
                                <span class="cm-dd-manrow__progress">
                                    <span class="cm-dd-bar{{ progress.percent == 100 ? ' cm-dd-bar--done' }}"><span class="cm-dd-bar__fill" style="width: {{ progress.percent }}%"></span></span>
                                    <span class="cm-dd-manrow__value">{{ progress.done }}/{{ progress.total }}</span>
                                </span>
                                {% if canEdit %}
                                    <a class="cm-dd-docrow__pencil" href="{{ path('app_dossier_documents', {id: dossier.id, document: document.id}) }}"
                                       aria-label="{{ 'dossierEditDocumentAction'|trans }}" title="{{ 'dossierEditDocumentAction'|trans }}"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 20h4l9.5-9.5a2.1 2.1 0 0 0-3-3L5 17v3"></path><path d="M13.5 6.5l3 3"></path></svg></a>
                                {% endif %}
                            </span>
                        </div>
                    {% endfor %}
                {% endfor %}
            </div>

            <div class="cm-dd-side">
                <div class="cm-dd-card cm-dd-card--pad">
                    <span class="cm-dd-cardtitle">{{ 'dossierValidatorsFieldLabel'|trans }}</span>
                    {% for validator in dossier.validators %}
                        <div class="cm-dd-person">
                            {% include 'dossier/_avatar.html.twig' with {user: validator, size: 26} only %}
                            <span class="cm-dd-person__text">
                                <span class="cm-dd-person__name">{{ validator.displayName ?? validator.username }}</span>
                                {# The same number on every row, and deliberately so: nothing routes a
                                   dépôt to one validateur, so « à traiter » is the dossier's queue
                                   and each of them may answer any of it. #}
                                <span class="cm-dd-meta">{{ 'dossierPendingDepositsText'|trans({'%count%': queueSize}) }}</span>
                            </span>
                            {% set isCreator = dossier.createdBy and dossier.createdBy.id == validator.id %}
                            <span class="cm-dd-chip__role cm-dd-person__role{{ isCreator ? ' cm-dd-chip__role--creator' }}">{{ (isCreator ? 'dossierRoleCreatorLabel' : 'dossierRoleValidatorLabel')|trans }}</span>
                        </div>
                    {% endfor %}
                    {% if canEdit %}
                        <span class="cm-dd-cardfoot"><a class="cm-dd-link" href="{{ path('app_dossier_settings', {id: dossier.id}) }}">{{ 'dossierAddValidatorAction'|trans }}</a></span>
                    {% endif %}
                </div>

                <div class="cm-dd-card cm-dd-card--pad">
                    <div style="display: flex; align-items: baseline; gap: 10px;">
                        <span class="cm-dd-cardtitle">{{ 'dossierTargetsFieldLabel'|trans }}</span>
                        <span class="cm-dd-count">{{ programLabels|join(', ') }}</span>
                    </div>
                    <div class="cm-dd-ciblechips">
                        {% for row in board.rows %}
                            {# The pastille says where the cible stands in one colour: green when
                               every obligatoire is settled, red when something is late or to be
                               corrected, gold otherwise. #}
                            {% set alerts = row.alerts %}
                            {% set ring = row.complete ? 'valide' : (alerts is not empty and alerts|first.value in ['retard', 'corriger'] ? 'corriger' : 'attente') %}
                            <span class="cm-dd-ciblechip">
                                <span class="cm-dd-ring cm-dd--{{ ring }}" aria-hidden="true"></span>
                                <span class="cm-dd-ciblechip__name">{{ row.student.displayName ?? row.student.username }}</span>
                            </span>
                        {% else %}
                            <p class="cm-dd-meta">{{ 'dossierNoCibleText'|trans }}</p>
                        {% endfor %}
                    </div>
                    {% if canEdit %}
                        <span class="cm-dd-cardfoot"><a class="cm-dd-link" href="{{ path('app_dossier_settings', {id: dossier.id}) }}">{{ 'dossierEditTargetsAction'|trans }}</a></span>
                    {% endif %}
                </div>

                {% if canDelete %}
                    <form method="post" action="{{ path('app_dossier_delete', {id: dossier.id}) }}"
>
                        <input type="hidden" name="_token" value="{{ csrf_token('dossier_delete') }}">
                        <button type="submit" class="cm-dd-link cm-dd-link--danger"
                                data-controller="confirm-submit"
                                data-confirm-submit-message-value="{{ 'dossierDeleteConfirmText'|trans }}"
                                data-action="click->confirm-submit#confirm">{{ 'dossierDeleteAction'|trans }}</button>
                    </form>
                {% endif %}
            </div>
        </div>
    </div>
{% endblock %}
