{% extends 'layout/app.html.twig' %}

{% block title %}{{ 'equipmentSearchPageHeading'|trans }}{% endblock %}

{% block page_breadcrumb %}
    {% include 'equipment/_breadcrumb.html.twig' with {extra: [
        {label: 'equipmentSearchPageHeading'|trans, url: app.request.requestUri},
    ]} %}
{% endblock %}
{% block page_title %}{{ 'equipmentSearchPageHeading'|trans }} « {{ query }} »{% endblock %}

{% block main %}
    {# A wrong check digit is said, never corrected: the piece it nearly names is only offered as a
       suggestion (StockController::search()). #}
    {% if hasWrongCheckDigit %}
        <div class="alert alert-warning">{{ 'equipmentWrongCheckDigitText'|trans }}</div>
    {% endif %}

    {% if matches is empty and mistyped is empty %}
        <div class="card"><div class="card-body text-center text-secondary">{{ 'equipmentCodeNotFoundText'|trans }}</div></div>
    {% else %}
        <div class="card">
            <div class="table-responsive">
                <table class="table table-vcenter card-table table-striped">
                    <thead>
                        <tr>
                            <th>{{ 'equipmentItemCodeColumnLabel'|trans }}</th>
                            <th>{{ 'equipmentTypeNameFieldLabel'|trans }}</th>
                            <th>{{ 'equipmentItemStatusColumnLabel'|trans }}</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for item in matches %}
                            <tr>
                                <td><a href="{{ path('app_equipment_item_show', {id: item.id}) }}" class="font-monospace fw-bold">{{ item.code }}</a></td>
                                <td>{{ item.type.name }}</td>
                                <td>{% include 'equipment/_status_badge.html.twig' with {status: item.status} only %}</td>
                                <td></td>
                            </tr>
                        {% endfor %}
                        {% for item in mistyped %}
                            <tr>
                                <td><a href="{{ path('app_equipment_item_show', {id: item.id}) }}" class="font-monospace fw-bold">{{ item.code }}</a></td>
                                <td>{{ item.type.name }}</td>
                                <td>{% include 'equipment/_status_badge.html.twig' with {status: item.status} only %}</td>
                                <td><span class="cm-badge cm-badge--gold">{{ 'equipmentSuggestionBadge'|trans }}</span></td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    {% endif %}
{% endblock %}
