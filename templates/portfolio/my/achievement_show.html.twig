{% extends 'layout/app.html.twig' %}

{% block title %}{{ achievement.title }}{% endblock %}
{% block page_breadcrumb %}
    {{ component('Cm:Breadcrumb', {segments: [
        {label: 'myPortfolioNavLabel'|trans, url: path('app_my_portfolio')},
        {label: achievement.title, url: app.request.requestUri},
    ]}) }}
{% endblock %}
{% block page_title %}{{ achievement.title }}{% endblock %}

{% block main %}
    <div class="cm-pf-page">
        <div class="cm-pf-inline">
            <twig:Cm:Badge :of="achievement.state"/>
            {% if achievement.revision > 0 %}<span class="cm-pf-meta">{{ 'portfolioRevisionText'|trans({'%revision%': achievement.revision}) }}</span>{% endif %}
            {% if achievement.requestedReviewer %}<span class="cm-pf-meta">· {{ 'portfolioRequestedReviewerText'|trans({'%name%': achievement.requestedReviewer.displayName ?? achievement.requestedReviewer.username}) }}</span>{% endif %}
        </div>
        {% set last = achievement.lastReview %}
        {% if achievement.state.value == 'to_rework' and last and last.comment %}
            <div class="cm-pf-banner cm-pf-banner--danger"><strong>{{ 'portfolioSentBackText'|trans({'%name%': last.reviewer.displayName ?? last.reviewer.username}) }}</strong><br>{{ last.comment|nl2br }}</div>
        {% endif %}

        {% include 'portfolio/_achievement_body.html.twig' %}

        <div class="cm-pf-card cm-pf-card--pad">
            <twig:Cm:Subhead :title="'portfolioEvidenceHeading'|trans" :hint="'portfolioEvidenceHint'|trans"/>
            {% include 'portfolio/_evidence_list.html.twig' with {evidences: achievement.evidences, removeRoute: 'app_my_portfolio_achievement_evidence_remove', removeParams: {id: achievement.id}, warnReopen: achievement.validated} %}
            {% if achievement.validated %}<p class="cm-pf-hint mb-0">{{ 'portfolioEvidenceReopenHint'|trans }}</p>{% endif %}
            {{ form_start(evidenceForm) }}
                <div class="cm-pf-form">
                    <div class="cm-pf-field cm-pf-field--wide">{{ form_row(evidenceForm.file) }}</div>
                    <div class="cm-pf-field">{{ form_row(evidenceForm.label) }}</div>
                </div>
                {{ form_row(evidenceForm.submit, {attr: {class: 'cm-btn cm-btn--outline'}}) }}
            {{ form_end(evidenceForm) }}
        </div>

        <div class="cm-pf-card cm-pf-card--pad">
            <twig:Cm:Subhead :title="'portfolioJournalHeading'|trans"/>
            {% include 'portfolio/_journal.html.twig' with {reviews: achievement.reviews} %}
        </div>

        <twig:Cm:ActionBar>
            {% if achievement.revision == 0 %}
                <form method="post" action="{{ path('app_my_portfolio_achievement_delete', {id: achievement.id}) }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('my_portfolio') }}">
                    <button type="submit" class="cm-btn cm-btn--danger" data-controller="confirm-submit" data-action="confirm-submit#confirm"
                            data-confirm-submit-message-value="{{ 'portfolioAchievementDeleteConfirm'|trans }}">{{ 'portfolioAchievementDeleteAction'|trans }}</button>
                </form>
            {% endif %}
            <twig:Cm:Button variant="outline" href="{{ path('app_my_portfolio_achievement_edit', {id: achievement.id}) }}">{{ 'editActionLabel'|trans }}</twig:Cm:Button>
            {% if achievement.state.value in ['draft', 'to_rework'] %}
                <form method="post" action="{{ path('app_my_portfolio_achievement_submit', {id: achievement.id}) }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('my_portfolio') }}">
                    <button type="submit" class="cm-btn cm-btn--primary"{{ submissionErrors is not empty ? ' disabled' }}>{{ 'portfolioSubmitAction'|trans }}</button>
                </form>
            {% endif %}
        </twig:Cm:ActionBar>
        {% if achievement.state.value in ['draft', 'to_rework'] and submissionErrors is not empty %}
            <p class="cm-pf-hint">{{ 'portfolioSubmitBlockedHint'|trans }} {{ submissionErrors|map(e => e|trans)|join(' · ') }}</p>
        {% endif %}
    </div>
{% endblock %}
