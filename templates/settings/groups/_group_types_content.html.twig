<div data-frankenphp-hot-reload-preserve
     data-controller="group-type-list"
     data-group-type-list-deactivate-url-template-value="{{ path('app_settings_group_types_deactivate', {id: '__ID__'}) }}"
     data-group-type-list-token-value="{{ csrf_token('settings_group_types_deactivate') }}"
     data-group-type-list-deactivate-confirm-message-value="{{ 'deactivateConfirmMessage'|trans }}"
     data-group-type-list-error-message-value="{{ 'deactivateErrorMessage'|trans }}">
    <div class="form-check form-switch mb-2 mt-2">
        <input class="form-check-input" type="checkbox" id="group-types-include-inactive" data-group-type-list-target="includeInactive" data-action="change->group-type-list#toggleInactive">
        <label class="form-check-label" for="group-types-include-inactive">{{ 'showInactiveFilterLabel'|trans }}</label>
    </div>
    <div class="table-responsive">
        <table class="table table-vcenter card-table table-striped">
            <thead>
                <tr>
                    <th>{{ 'groupTypeNameFieldLabel'|trans }}</th>
                    <th></th>
                </tr>
            </thead>
            <tbody data-controller="sortable-reorder" data-sortable-reorder-url-value="{{ path('app_settings_group_types_reorder') }}" data-sortable-reorder-token-value="{{ csrf_token('settings_group_types_reorder') }}">
                {% for groupType in groupTypes %}
                    {% set isInactive = groupType.inactiveDate is not null %}
                    <tr data-group-type-list-target="row" data-inactive="{{ isInactive ? 'true' : 'false' }}"{{ isInactive ? ' hidden' : '' }} data-sortable-reorder-id-param="{{ groupType.id }}">
                        <td><span class="sortable-reorder-handle" style="cursor: grab; color: var(--cm-faint, #8a99a6); margin-right: 6px;">⠿</span>{{ groupType.name }}</td>
                        <td class="cm-actions">
                            <a href="{{ path('app_settings_group_types_edit', {id: groupType.id}) }}" class="cm-action--warning">{{ 'editActionLabel'|trans }}</a>
                            {% if not isInactive %}
                                <button type="button" class="cm-action--danger" data-id="{{ groupType.id }}" data-action="click->group-type-list#deactivate">{{ 'deactivateActionLabel'|trans }}</button>
                            {% endif %}
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="2" class="text-center text-secondary">{{ 'datatableZeroRecordsLabel'|trans }}</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
