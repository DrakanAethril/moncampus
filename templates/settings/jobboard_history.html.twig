{% extends 'layout/app.html.twig' %}

{% block title %}{{ 'jobboardHistoryHeading'|trans }}{% endblock %}

{% block page_breadcrumb %}
    {% include '_breadcrumb.html.twig' with {segments: [
        {label: 'homeNavLabel'|trans, url: path('app_home')},
        {label: 'settingsConfigurationNavLabel'|trans, url: path('app_settings_configuration')},
        {label: 'jobboardSettingsHeading'|trans, url: path('app_settings_jobboard_history')},
    ]} %}
{% endblock %}

{% block page_title %}{{ 'jobboardSettingsHeading'|trans }}{% endblock %}

{% block main %}
    {% include 'settings/_jobboard_tabs.html.twig' with {activeTab: 'history'} only %}

    <div class="card cm-card--tabbed" style="padding: 18px">
        <div class="cm-subhead" style="margin-bottom: 14px">
            <div class="cm-subhead__title">{{ 'jobboardHistoryHeading'|trans }}</div>
            {# Said on screen because the two grains are not an accident: a veille running three
               times a morning is one day of veille, an import is a gesture somebody made. #}
            <div class="cm-subhead__hint">{{ 'jobboardHistoryHintText'|trans }}</div>
        </div>

        <table class="card-table">
            <thead>
                <tr>
                    <th>{{ 'jobboardHistoryDateColumn'|trans }}</th>
                    <th>{{ 'jobboardHistoryOriginColumn'|trans }}</th>
                    <th>{{ 'jobboardTokenTrackColumn'|trans }}</th>
                    <th class="text-end">{{ 'jobboardHistoryAddedColumn'|trans }}</th>
                    <th class="text-end">{{ 'jobboardHistoryDuplicateColumn'|trans }}</th>
                    <th class="text-end">{{ 'jobboardHistoryRemovedColumn'|trans }}</th>
                    <th class="text-end">{{ 'jobboardHistoryRejectedColumn'|trans }}</th>
                    {# Beside « Refusées » and never merged with it: a refusal is a defect of the offer,
                       a block is a decision taken on the sources screen. #}
                    <th class="text-end">{{ 'jobboardHistoryBlockedColumn'|trans }}</th>
                </tr>
            </thead>
            <tbody>
                {% for row in rows %}
                    <tr>
                        <td class="text-ink">
                            {{ row.at|localized_date(row.dayOnly ? 'd MMM y' : 'd MMM y HH:mm') }}
                            {% if row.dayOnly and row.passes > 1 %}
                                <span class="text-secondary">· {{ 'jobboardHistoryPassesText'|trans({'%count%': row.passes}) }}</span>
                            {% endif %}
                        </td>
                        <td>
                            {% if row.kind == 'api' %}
                                <span class="cm-badge cm-badge--blue">{{ 'jobboardHistoryOriginApiLabel'|trans }}</span>
                                <span class="text-ink">{{ row.token.label }}</span>
                                {% if row.token.revoked %}
                                    <span class="text-secondary">· {{ 'jobboardHistoryTokenRevokedText'|trans }}</span>
                                {% endif %}
                            {% else %}
                                <span class="cm-badge cm-badge--gold">{{ 'jobboardHistoryOriginImportLabel'|trans }}</span>
                                <span class="text-ink">
                                    {% if row.batch.importedBy %}
                                        {{ row.batch.importedBy.displayName ?? row.batch.importedBy.username }}
                                    {% else %}
                                        {{ 'jobboardHistoryImporterUnknownText'|trans }}
                                    {% endif %}
                                </span>
                            {% endif %}
                        </td>
                        <td>{{ row.track.name }}</td>
                        <td class="text-end text-ink">{{ row.created }}</td>
                        <td class="text-end">{{ row.reviewed }}</td>
                        <td class="text-end">{{ row.closed }}</td>
                        <td class="text-end{{ row.rejected > 0 ? ' cm-jb-history__rejected' }}">{{ row.rejected }}</td>
                        <td class="text-end">{{ row.blocked }}</td>
                    </tr>
                {% else %}
                    <tr><td colspan="8" class="text-secondary">{{ 'jobboardHistoryEmptyText'|trans }}</td></tr>
                {% endfor %}
            </tbody>
        </table>

        {% if rows|length >= limit %}
            <div class="cm-actionbar">
                <div class="cm-actionbar__meta">{{ 'jobboardHistoryTruncatedText'|trans({'%count%': limit}) }}</div>
            </div>
        {% endif %}

        {# The second list, and the reason it exists: the resolution never refuses an offer whose
           site it does not know, so the only way to see what it decided is to read it here. Nothing
           on this block is a warning - the offers concerned were filed like the others. #}
        <div class="cm-subhead" style="margin-top: 26px; margin-bottom: 14px">
            <div class="cm-subhead__title">{{ 'jobboardHistoryLearningHeading'|trans }}</div>
            <div class="cm-subhead__hint">{{ 'jobboardHistoryLearningHintText'|trans }}</div>
        </div>

        <table class="card-table">
            <thead>
                <tr>
                    <th>{{ 'jobboardHistoryDateColumn'|trans }}</th>
                    <th>{{ 'jobboardHistoryLearningKindColumn'|trans }}</th>
                    <th>{{ 'jobboardHistoryLearningSourceColumn'|trans }}</th>
                    <th>{{ 'jobboardHistoryLearningDomainColumn'|trans }}</th>
                    <th>{{ 'jobboardHistoryLearningDeclaredColumn'|trans }}</th>
                    <th>{{ 'jobboardHistoryOriginColumn'|trans }}</th>
                </tr>
            </thead>
            <tbody>
                {% for learning in learnings %}
                    <tr>
                        <td class="text-ink">{{ learning.learnedAt|localized_date('d MMM y HH:mm') }}</td>
                        <td>
                            <span class="cm-badge cm-badge--{{ learning.kind.value == 'source_created' ? 'purple' : 'teal' }}">
                                {{ learning.kind.labelKey|trans }}
                            </span>
                        </td>
                        <td class="text-ink">{{ learning.source.label }}</td>
                        <td><code>{{ learning.domain }}</code></td>
                        {# The declared name is printed even when it was ignored: « déclaré hellowork,
                           domaine bit.ly » is what makes a wrong attachment readable at a glance. #}
                        <td class="text-secondary">{{ learning.declared }}</td>
                        <td>
                            {% if learning.batch.token %}
                                <span class="cm-badge cm-badge--blue">{{ 'jobboardHistoryOriginApiLabel'|trans }}</span>
                                <span class="text-ink">{{ learning.batch.token.label }}</span>
                            {% else %}
                                <span class="cm-badge cm-badge--gold">{{ 'jobboardHistoryOriginImportLabel'|trans }}</span>
                                <span class="text-ink">
                                    {% if learning.batch.importedBy %}
                                        {{ learning.batch.importedBy.displayName ?? learning.batch.importedBy.username }}
                                    {% else %}
                                        {{ 'jobboardHistoryImporterUnknownText'|trans }}
                                    {% endif %}
                                </span>
                            {% endif %}
                        </td>
                    </tr>
                {% else %}
                    <tr><td colspan="6" class="text-secondary">{{ 'jobboardHistoryLearningEmptyText'|trans }}</td></tr>
                {% endfor %}
            </tbody>
        </table>

        <div class="cm-actionbar">
            <div class="cm-actionbar__meta">{{ 'jobboardHistoryLearningFooterText'|trans }}</div>
            <div class="cm-actionbar__buttons">
                <a class="cm-btn" href="{{ path('app_settings_jobboard_sources') }}">{{ 'jobboardHistoryLearningSourcesAction'|trans }}</a>
            </div>
        </div>
    </div>
{% endblock %}
