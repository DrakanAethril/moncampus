{% extends 'layout/app.html.twig' %}

{% set pageLabel = (isEdit ? 'editGroupPageHeading' : 'newGroupPageHeading')|trans %}
{% set entityName = isEdit ? form.vars.data.name : null %}

{% block title %}{{ pageLabel }}{{ entityName ? ' - ' ~ entityName }}{% endblock %}

{% block page_breadcrumb %}
    {% include '_breadcrumb.html.twig' with {segments: [
        {label: 'homeNavLabel'|trans, url: path('app_home')},
        {label: 'groupsListPageHeading'|trans, url: path('app_settings_groups')},
        {label: entityName ?? pageLabel, url: app.request.requestUri},
    ]} %}
{% endblock %}
{% block page_title %}{{ pageLabel }}{{ entityName ? ' - ' ~ entityName }}{% endblock %}

{% block main %}
    <div class="card">
        <div class="card-body">
            {{ form_start(form) }}
                {{ form_errors(form) }}
                <div class="row" data-controller="group-parent-filter">
                    <div class="col-md-6">{{ form_row(form.name) }}</div>
                    <div class="col-md-6">{{ form_row(form.role) }}</div>
                    {# Type and parent sit side by side because they are read together: the parent
                       has to be of another type, and the filter controller greys out the rest. #}
                    <div class="col-md-6">{{ form_row(form.groupType) }}</div>
                    <div class="col-md-6">{{ form_row(form.parent) }}</div>
                    <div class="col-md-6">{{ form_row(form.manuallyAssignable) }}</div>
                </div>
                <div class="d-flex justify-content-between">
                    <a href="{{ path('app_settings_groups') }}" class="btn btn-link">{{ 'cancelAction'|trans }}</a>
                    {{ form_widget(form.submit, {'label': isEdit ? 'submitEditAction' : 'submitCreateAction'}) }}
                </div>
                {{ form_rest(form) }}
            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}
