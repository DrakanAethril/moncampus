{% extends 'layout/app.html.twig' %}

{# A SchoolYear has no name column - it identifies itself by its span. Written tight ("2026-2027")
   rather than the spaced "2026 - 2027" the DataTables columns use, so the heading doesn't read as
   "Modifier l'année scolaire - 2026 - 2027". #}
{% set pageLabel = (isEdit ? 'editSchoolYearPageHeading' : 'newSchoolYearPageHeading')|trans %}
{% set entityName = isEdit ? form.vars.data.startDate|date('Y') ~ '-' ~ form.vars.data.endDate|date('Y') : null %}

{% block title %}{{ pageLabel }}{{ entityName ? ' - ' ~ entityName }}{% endblock %}

{% block page_breadcrumb %}
    {% include '_breadcrumb.html.twig' with {segments: [
        {label: 'homeNavLabel'|trans, url: path('app_home')},
        {label: 'pedagogiquePageHeading'|trans, url: path('app_settings_structure_school_years')},
        {label: entityName ?? pageLabel, url: app.request.requestUri},
    ]} %}
{% endblock %}
{% block page_title %}{{ pageLabel }}{{ entityName ? ' - ' ~ entityName }}{% endblock %}

{% block main %}
    <div class="card">
        <div class="card-body">
            {{ form_start(form) }}
                {{ form_errors(form) }}
                <div class="row">
                    <div class="col-md-6">{{ form_row(form.startDate) }}</div>
                    <div class="col-md-6">{{ form_row(form.endDate) }}</div>
                </div>
                <div class="d-flex justify-content-between">
                    <a href="{{ path('app_settings_structure_school_years') }}" class="btn btn-link">{{ 'cancelAction'|trans }}</a>
                    {{ form_widget(form.submit, {'label': isEdit ? 'submitEditAction' : 'submitCreateAction'}) }}
                </div>
                {{ form_rest(form) }}
            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}
