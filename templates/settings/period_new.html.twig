{% extends 'layout/app.html.twig' %}

{% set pageLabel = (isEdit ? 'editPeriodPageHeading' : 'newPeriodPageHeading')|trans %}
{% set entityName = isEdit ? form.vars.data.name : null %}

{% block title %}{{ pageLabel }}{{ entityName ? ' - ' ~ entityName }} - {{ periodGroup.name }}{% endblock %}

{% block page_breadcrumb %}
    {% include '_breadcrumb.html.twig' with {segments: [
        {label: 'homeNavLabel'|trans, url: path('app_home')},
        {label: 'pedagogiquePageHeading'|trans, url: path('app_settings_structure_period_groups')},
        {label: periodGroup.name, url: path('app_settings_structure_period_groups_periods', {groupId: periodGroup.id})},
        {label: entityName ?? pageLabel, url: app.request.requestUri},
    ]} %}
{% endblock %}
{# The owning period group stays out of the h1 (it's already the breadcrumb's 3rd segment) -
   stacking it after the period name gave a three-dash heading nobody could parse. The browser
   tab title keeps it, having no breadcrumb to lean on. #}
{% block page_title %}{{ pageLabel }}{{ entityName ? ' - ' ~ entityName }}{% endblock %}

{% block main %}
    <div class="card">
        <div class="card-body">
            {{ form_start(form) }}
                {{ form_errors(form) }}
                <div class="row">
                    <div class="col-md-6">{{ form_row(form.name) }}</div>
                    <div class="col-md-6">{{ form_row(form.type) }}</div>
                    <div class="col-md-6">{{ form_row(form.startDate) }}</div>
                    <div class="col-md-6">{{ form_row(form.endDate) }}</div>
                    <div class="col-md-12">{{ form_row(form.modalities) }}</div>
                </div>
                <div class="d-flex justify-content-between">
                    <a href="{{ path('app_settings_structure_period_groups_periods', {groupId: periodGroup.id}) }}" class="btn btn-link">{{ 'cancelAction'|trans }}</a>
                    {{ form_widget(form.submit, {'label': isEdit ? 'submitEditAction' : 'submitCreateAction'}) }}
                </div>
                {{ form_rest(form) }}
            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}
