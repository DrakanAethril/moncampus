{% extends 'layout/app.html.twig' %}

{% block title %}{{ 'jobboardImportAnalysisHeading'|trans }}{% endblock %}

{% block page_breadcrumb %}
    {% include '_breadcrumb.html.twig' with {segments: [
        {label: 'homeNavLabel'|trans, url: path('app_home')},
        {label: 'settingsConfigurationNavLabel'|trans, url: path('app_settings_configuration')},
        {label: 'jobboardSettingsHeading'|trans, url: path('app_settings_jobboard_import')},
        {label: 'jobboardImportAnalysisHeading'|trans, url: path('app_settings_jobboard_import_analysis')},
    ]} %}
{% endblock %}

{% block page_title %}{{ 'jobboardImportAnalysisHeading'|trans }}{% endblock %}

{% block main %}
    <div class="card" style="padding: 18px">
        <div class="cm-subhead" style="margin-bottom: 14px">
            <div class="cm-subhead__title">{{ fileName }}</div>
            <div class="cm-subhead__hint">{{ 'jobboardImportAnalysisHintText'|trans({'%track%': track.name}) }}</div>
        </div>

        {# Nothing is written while this is on screen. The three numbers are what the confirmation
           actually commits to, counted by the same parser the real pass will use. #}
        <div class="cm-loan-summary" style="grid-template-columns: repeat(3, 1fr); margin-bottom: 18px">
            <div>
                <span class="cm-loan-summary__label">{{ 'jobboardOutcomeCreatedLabel'|trans }}</span>
                <span class="cm-loan-summary__value">{{ report.created }}</span>
            </div>
            <div>
                <span class="cm-loan-summary__label">{{ 'jobboardOutcomeReviewedLabel'|trans }}</span>
                <span class="cm-loan-summary__value">{{ report.reviewed }}</span>
            </div>
            <div>
                <span class="cm-loan-summary__label">{{ 'jobboardOutcomeRejectedLabel'|trans }}</span>
                <span class="cm-loan-summary__value{{ report.rejected > 0 ? ' cm-loan-summary__value--late' }}">{{ report.rejected }}</span>
            </div>
        </div>

        {# What confirming will teach the platform about the sites themselves. Announced before the
           confirmation and not after, because it is the one thing on this screen that outlives the
           file: an offer is a row, a domain attached to a site changes where every later offer from
           that host goes. #}
        {% if report.learned is not empty %}
            <div class="cm-subhead" style="margin-bottom: 10px">
                <div class="cm-subhead__title">{{ 'jobboardImportLearningHeading'|trans }}</div>
                <div class="cm-subhead__hint">{{ 'jobboardImportLearningHintText'|trans }}</div>
            </div>
            <table class="card-table" style="margin-bottom: 18px">
                <thead>
                    <tr>
                        <th>{{ 'jobboardHistoryLearningKindColumn'|trans }}</th>
                        <th>{{ 'jobboardHistoryLearningSourceColumn'|trans }}</th>
                        <th>{{ 'jobboardHistoryLearningDomainColumn'|trans }}</th>
                        <th>{{ 'jobboardHistoryLearningDeclaredColumn'|trans }}</th>
                    </tr>
                </thead>
                <tbody>
                    {% for learning in report.learned %}
                        <tr>
                            <td>
                                <span class="cm-badge cm-badge--{{ learning.kind.value == 'source_created' ? 'purple' : 'teal' }}">
                                    {{ learning.kind.labelKey|trans }}
                                </span>
                            </td>
                            <td class="text-ink">{{ learning.source.label }}</td>
                            <td><code>{{ learning.domain }}</code></td>
                            <td class="text-secondary">{{ learning.declared }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% endif %}

        {# A refused line never takes the others with it - the rule of the API, kept here so the two
           doors behave identically. Each one is named with its reason before anything is written. #}
        {% if report.rejectedLines is not empty %}
            <div class="cm-subhead" style="margin-bottom: 10px">
                <div class="cm-subhead__title">{{ 'jobboardImportRejectedHeading'|trans }}</div>
                <div class="cm-subhead__hint">{{ 'jobboardImportRejectedHintText'|trans }}</div>
            </div>
            <table class="card-table" style="margin-bottom: 18px">
                <thead>
                    <tr>
                        <th>{{ 'jobboardImportLineColumn'|trans }}</th>
                        <th>{{ 'jobboardImportOfferColumn'|trans }}</th>
                        <th>{{ 'jobboardImportReasonColumn'|trans }}</th>
                    </tr>
                </thead>
                <tbody>
                    {% for line in report.rejectedLines %}
                        <tr>
                            <td>{{ line.index + 1 }}</td>
                            <td class="text-ink">{{ line.position ?? line.sourceRef ?? '—' }}</td>
                            <td>{{ line.reason.labelKey|trans }}{% if line.field %} <span class="text-secondary">({{ line.field }})</span>{% endif %}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% endif %}

        <form method="post" action="{{ path('app_settings_jobboard_import_confirm') }}">
            <input type="hidden" name="_token" value="{{ csrf_token('jobboard_import_confirm') }}">
            <div class="cm-actionbar">
                <div class="cm-actionbar__meta">{{ 'jobboardImportConfirmMetaText'|trans({'%track%': track.name}) }}</div>
                <div class="cm-actionbar__buttons">
                    <a class="cm-btn" href="{{ path('app_settings_jobboard_import') }}">{{ 'jobboardImportBackAction'|trans }}</a>
                    <button type="submit" class="cm-btn cm-btn--primary">{{ 'jobboardImportConfirmAction'|trans }}</button>
                </div>
            </div>
        </form>
    </div>
{% endblock %}
