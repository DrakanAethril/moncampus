{% extends 'layout/app.html.twig' %}

{# SkillLevel's display string is `label`, not `name` like the other structure entities. #}
{% set pageLabel = (isEdit ? 'editSkillLevelPageHeading' : 'newSkillLevelPageHeading')|trans %}
{% set entityName = isEdit ? form.vars.data.label : null %}

{% block title %}{{ pageLabel }}{{ entityName ? ' - ' ~ entityName }}{% endblock %}

{% block page_breadcrumb %}
    {% include '_breadcrumb.html.twig' with {segments: [
        {label: 'homeNavLabel'|trans, url: path('app_home')},
        {label: 'configurationPageHeading'|trans, url: path('app_settings_structure_skill_levels')},
        {label: entityName ?? pageLabel, url: app.request.requestUri},
    ]} %}
{% endblock %}
{% block page_title %}{{ pageLabel }}{{ entityName ? ' - ' ~ entityName }}{% endblock %}

{% block main %}
    <div class="card">
        <div class="card-body">
            {{ form_start(form) }}
                {{ form_errors(form) }}
                <div class="row">
                    <div class="col-md-6">{{ form_row(form.label) }}</div>
                    <div class="col-md-6">{{ form_row(form.color) }}</div>
                </div>
                <div class="d-flex justify-content-between">
                    <a href="{{ path('app_settings_structure_skill_levels') }}" class="btn btn-link">{{ 'cancelAction'|trans }}</a>
                    {{ form_widget(form.submit, {'label': isEdit ? 'submitEditAction' : 'submitCreateAction'}) }}
                </div>
                {{ form_rest(form) }}
            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}
