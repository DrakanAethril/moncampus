{# « Qui joue (étudiants) » of a serious game (design/validated/quiz-tournament.md §14): the targeting
   that opens it to students, and whom that reaches today. App\Controller\Settings\SeriousGameTargetingController. #}
{% extends 'layout/app.html.twig' %}

{% set heading = 'seriousGameTargetingPageHeading'|trans({'%game%': game.title}) %}
{% block title %}{{ heading }}{% endblock %}

{% block page_breadcrumb %}{% include 'settings/serious_game/_breadcrumb.html.twig' with {extra: [
    {label: game.title, url: path('app_settings_serious_games_game', {slug: game.slug})},
    {label: 'seriousGameTargetingNavLabel'|trans, url: path('app_settings_serious_games_students', {slug: game.slug})},
]} %}{% endblock %}

{% block page_title %}{{ heading }}{% endblock %}

{% block main %}
    {{ form_start(form, {attr: {class: 'cm-pf-page', novalidate: 'novalidate'}}) }}
        {% if not game.published %}
            <div class="cm-pf-banner cm-pf-banner--warn">{{ 'seriousGameTargetingUnpublishedBanner'|trans }}</div>
        {% endif %}
        {% if not moduleLitForStudents %}
            <div class="cm-pf-banner cm-pf-banner--warn">{{ 'seriousGameTargetingModuleOffBanner'|trans({'%module%': 'featureSeriousGamesLabel'|trans, '%matrix%': 'featureMatrixPageHeading'|trans}) }}</div>
        {% endif %}
        {{ form_errors(form) }}

        <div class="cm-pf-card cm-pf-card--pad">
            <twig:Cm:Subhead :title="'seriousGameTargetingReachSubhead'|trans" :hint="'seriousGameTargetingReachHint'|trans"/>
            {% if reach.programs is empty %}
                <p class="mb-0">{{ 'seriousGameTargetingEmpty'|trans }}</p>
            {% else %}
                <p><strong>{{ 'seriousGameTargetingReachTotal'|trans({'%count%': reach.total}) }}</strong></p>
                <div class="table-responsive">
                    <table class="table table-vcenter card-table">
                        <thead>
                            <tr>
                                <th>{{ 'seriousGameTargetingProgramColumn'|trans }}</th>
                                <th>{{ 'seriousGameTargetingTrackColumn'|trans }}</th>
                                <th class="text-end">{{ 'seriousGameTargetingStudentsColumn'|trans }}</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for row in reach.programs %}
                                <tr>
                                    <td>
                                        <strong>{{ row.program.shortName }}</strong>
                                        {% if row.program.testProgram %}<twig:Cm:Badge tone="gold">{{ 'seriousGameTargetingTestProgram'|trans }}</twig:Cm:Badge>{% endif %}
                                        <div class="text-secondary small">{{ row.program.name }}</div>
                                    </td>
                                    <td>{{ row.program.cohort.track.name|default('') }}</td>
                                    <td class="text-end">{{ row.students }}</td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% endif %}
        </div>

        <div class="cm-pf-card cm-pf-card--pad">
            <twig:Cm:Subhead :title="'seriousGameTargetingFieldSubhead'|trans" :hint="'seriousGameTargetingFieldHint'|trans"/>
            {{ form_errors(form.targets) }}
            {{ form_widget(form.targets) }}
        </div>

        <twig:Cm:ActionBar>
            <twig:Cm:Button variant="primary" type="submit">{{ 'submitSaveAction'|trans }}</twig:Cm:Button>
        </twig:Cm:ActionBar>
    {{ form_end(form) }}
{% endblock %}
