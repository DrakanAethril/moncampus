{% extends 'layout/app.html.twig' %}

{% block title %}{{ 'gameRevealHeading'|trans }}{% endblock %}

{% block page_breadcrumb %}
    {% include '_breadcrumb.html.twig' with {segments: [
        {label: 'homeNavLabel'|trans, url: path('app_home')},
        {label: 'gameProgressHeading'|trans, url: path('app_game')},
        {label: 'gameRevealHeading'|trans, url: path('app_game_ranking_reveal')},
    ]} %}
{% endblock %}

{% block page_title %}{{ 'gameRevealHeading'|trans }}{% endblock %}

{% block main %}
    <p class="cm-gm-context">{{ program.displayShortName }} · {{ period.name }}</p>

    {# A ceremony screen, projected in class: that moment is what pays for the ten weeks of
       anonymity before it. #}
    <div class="card">
        <div class="card-body">
            <span class="cm-gm-label">{{ 'gameRevealPodiumHeading'|trans }}</span>
            <div class="cm-gm-plate" style="grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); margin-top: 14px">
                {% for score in podium %}
                    {% set alias = aliases[score.student.id]|default(null) %}
                    {% set profile = profiles[score.student.id]|default(null) %}
                    {% set level = profile ? profile.level : 1 %}
                    <div class="cm-gm-plate__cell">
                        <span class="cm-gm-av">
                            <span class="cm-gm-av__ring" style="{{ game_level_style(level) }}">
                                <span class="cm-gm-av__face">{{ score.student.initials|default((score.student.displayName ?? score.student.username)|slice(0, 1)|upper) }}</span>
                            </span>
                            <span class="cm-gm-av__band" style="{{ game_band_style(level) }}">{{ 'gameLevelBandLabel'|trans({'%level%': level}) }}</span>
                        </span>
                        <span class="cm-gm-plate__title">{{ score.student.displayName ?? score.student.username }}</span>
                        <span class="cm-gm-plate__xp">
                            {{ score.rank == 1 ? 'gameRevealTopLabel'|trans : 'gameRevealRankLabel'|trans({'%rank%': score.rank}) }} · {{ 'gameRevealIndexLabel'|trans({'%index%': score.indexValue}) }}
                        </span>
                        {% if alias and alias.figure %}
                            <span class="cm-gm-fam__sub">{{ 'gameRevealWasLabel'|trans({'%name%': alias.figure.surname}) }}</span>
                        {% endif %}
                    </div>
                {% endfor %}
            </div>
        </div>
    </div>

    <div class="card" style="margin-top: 16px">
        <div class="card-body">
            <span class="cm-gm-label">{{ 'gameRevealTiersHeading'|trans }}</span>
            {# The part that counts, because it is not a ranking: everybody can be in it. #}
            <div class="cm-gm-shelf" style="margin-top: 10px">
                {% set medals = {'gold': '🥇', 'silver': '🥈', 'bronze': '🥉'} %}
                {% for tier, threshold in {'gold': settings.thresholdGold, 'silver': settings.thresholdSilver, 'bronze': settings.thresholdBronze} %}
                    {% set reached = scores|filter(s => s.indexValue >= threshold and (tier != 'gold' ? s.indexValue < (tier == 'silver' ? settings.thresholdGold : settings.thresholdSilver) : true)) %}
                    {% if reached|length %}
                        <div class="cm-gm-shelf__row">
                            <span class="cm-gm-shelf__icon">{{ medals[tier] }}</span>
                            <span class="cm-gm-shelf__label">
                                {% for score in reached %}<b>{{ score.student.displayName ?? score.student.username }}</b>{{ not loop.last ? ' · ' }}{% endfor %}
                            </span>
                        </div>
                    {% endif %}
                {% endfor %}
            </div>
        </div>
    </div>

    <div class="card" style="margin-top: 16px">
        <div class="card-body">
            <span class="cm-gm-label">{{ 'gameRevealWallHeading'|trans }}</span>
            {# Where the pseudonym stops being a disguise and becomes a culture of the filière. #}
            <div class="cm-gm-log" style="margin-top: 10px">
                {% for score in scores %}
                    {% set alias = aliases[score.student.id]|default(null) %}
                    {% if alias and alias.figure %}
                        <div class="cm-gm-log__row" style="grid-template-columns: 120px minmax(0, 1fr)">
                            <span class="cm-gm-log__rule">{{ alias.figure.surname }}</span>
                            <span class="cm-gm-log__rule" style="font-weight: 400">
                                {{ alias.figure.fullName }}{% if alias.figure.dates %} · {{ alias.figure.dates }}{% endif %}
                                <span class="cm-gm-log__src">{{ alias.figure.notice }}</span>
                            </span>
                        </div>
                    {% endif %}
                {% endfor %}
            </div>

            <div class="cm-card-note">{{ 'gameRevealBottomNoteText'|trans }}</div>
        </div>
    </div>
{% endblock %}
