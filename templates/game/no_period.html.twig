{% extends 'layout/app.html.twig' %}

{% block title %}{{ 'gameProgressHeading'|trans }}{% endblock %}

{% block page_breadcrumb %}
    {% include '_breadcrumb.html.twig' with {segments: [
        {label: 'homeNavLabel'|trans, url: path('app_home')},
        {label: 'gameProgressHeading'|trans, url: path('app_game')},
    ]} %}
{% endblock %}

{% block page_title %}{{ 'gameProgressHeading'|trans }}{% endblock %}

{% block main %}
    {# The game borrows the school's calendar rather than inventing one. Without a period group on
       the formation there is nothing to score, and saying so plainly beats drawing an index of 0 -
       which would read as a bad period rather than as no period at all. #}
    <div class="cm-note">
        <span class="cm-note__icon">i</span>
        <span>{{ 'gameNoPeriodText'|trans({'%program%': program.name}) }}</span>
    </div>

    <div class="card" style="margin-top: 16px">
        <div class="card-body">
            <a href="{{ path('app_game_levels') }}" class="cm-btn cm-btn--outline">{{ 'gameLevelsHeading'|trans }}</a>
        </div>
    </div>
{% endblock %}
