{% set config = widget.config %}
<label class="cm-cb-field">{{ 'classBoardDrawSavedField'|trans }}
    <select class="cm-cb-input" name="drawId" data-kind="id" data-rerender>
        <option value="">{{ 'classBoardDrawNoSavedOption'|trans }}</option>
        {% for draw in data.draws ?? [] %}
            <option value="{{ draw.id }}" {{ config.drawId == draw.id ? 'selected' }}>{{ draw.name }}</option>
        {% endfor %}
    </select>
</label>
<div class="cm-cb-hint">{{ 'classBoardDrawSavedHint'|trans }}</div>
