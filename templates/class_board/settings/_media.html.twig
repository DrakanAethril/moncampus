{% set config = widget.config %}
<label class="cm-cb-field">{{ 'classBoardMediaFileField'|trans }}
    <select class="cm-cb-input" name="fileId" data-kind="id" data-rerender>
        <option value="">{{ 'classBoardChooseOption'|trans }}</option>
        {% for file in data.files ?? [] %}
            <option value="{{ file.id }}" {{ config.fileId == file.id ? 'selected' }}>{{ file.label }}</option>
        {% endfor %}
    </select>
</label>
<div class="cm-cb-hint">{{ 'classBoardMediaHint'|trans }}</div>
