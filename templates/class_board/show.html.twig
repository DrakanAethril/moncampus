{% extends 'base.html.twig' %}

{# The virtual board (design/validated/tableau-virtuel.md; mockup
   design/validated/tableau-virtuel-screens.html). It extends base.html.twig rather than the app
   shell, like the word cloud's projection: no navbar and no breadcrumb on a screen meant for the
   projector - its own top bar carries the class, the name and the way back to the list.

   One window, projected and handled in the same place (§1.2). The surface is 16:9 and everything on
   it is sized from its width (container units), so the laptop and the projector show the same
   board; a 4:3 screen gets bands of the board's own background, never a stretched one. The
   background is the board's, whatever the viewer's light/dark theme. #}

{% block title %}{{ board.name }}{% endblock %}

{% block body %}
{# « Photo » is the photograph of the day (App\Service\ClassBoard\ClassBoardPhotoOfTheDay), stored
   with the uploads; without one yet, app.css falls back to the photograph shipped with the app. #}
<div class="cm-cb" data-background="{{ board.background.value }}"
     {% if photo and photo.storageKey %}style="--cb-nature-photo: url('{{ file_url(photo.storageKey)|e('css') }}')"{% endif %}
     data-controller="class-board"
     data-class-board-revision-value="{{ board.revision }}"
     data-class-board-csrf-value="{{ csrf_token('class_board') }}"
     data-class-board-save-url-value="{{ path('app_class_board_save', {id: board.id}) }}"
     data-class-board-name-url-value="{{ path('app_class_board_name', {id: board.id}) }}"
     data-class-board-new-widget-url-value="{{ path('app_class_board_widget_new', {id: board.id}) }}"
     data-class-board-render-url-value="{{ path('app_class_board_widget_render', {id: board.id}) }}"
     data-class-board-quit-url-value="{{ path('app_class_board_index') }}"
     data-class-board-labels-value="{{ {
         saved: 'classBoardSavedAtStatus'|trans({'%time%': '__TIME__'}),
         saving: 'classBoardSavingStatus'|trans,
         dirty: 'classBoardDirtyStatus'|trans,
         failed: 'classBoardNotSavedStatus'|trans,
         duplicateName: 'classBoardDuplicateNameStatus'|trans,
         emptyName: 'classBoardEmptyNameStatus'|trans,
     }|json_encode }}">
    <div class="cm-cb__surface" data-class-board-target="surface">
        <div class="cm-cb__inner" data-class-board-target="inner">
            {% for view in widgets %}
                {% include 'class_board/_widget.html.twig' %}
            {% endfor %}

            {# The credit the licence asks for, under every widget. Shown on « Photo » only. #}
            {% if photo and photo.storageKey %}
                <p class="cm-cb__credit">
                    {{ 'classBoardPhotoCreditLabel'|trans }}
                    <a href="{{ photo.sourceUrl }}" target="_blank" rel="noopener noreferrer">{{ photo.author|length > 60 ? photo.author|slice(0, 59) ~ '…' : photo.author }}</a>
                    · {% if photo.licenseUrl %}<a href="{{ photo.licenseUrl }}" target="_blank" rel="noopener noreferrer">{{ photo.licenseName }}</a>{% else %}{{ photo.licenseName }}{% endif %}
                    · Wikimedia Commons
                </p>
            {% endif %}

            <div class="cm-cb__bar" data-class-board-target="chrome">
                {% if board.program %}
                    <span class="cm-cb__chip">{{ board.program.displayShortName }}</span>
                {% else %}
                    <span class="cm-cb__chip cm-cb__chip--free">{{ 'classBoardWithoutClassLabel'|trans }}</span>
                {% endif %}
                <span class="cm-cb__name" contenteditable="plaintext-only" spellcheck="false" role="textbox"
                      aria-label="{{ 'classBoardNameFieldLabel'|trans }}"
                      data-class-board-target="name"
                      data-action="blur->class-board#rename keydown->class-board#nameKey">{{ board.name }}</span>
                <span class="cm-cb__status" data-class-board-target="status" aria-live="polite">{{ 'classBoardSavedAtStatus'|trans({'%time%': board.updatedAt|date('H:i')}) }}</span>
                <span class="cm-cb__spacer"></span>
                <button type="button" class="cm-cb__chrome-btn" aria-expanded="false" data-class-board-target="backgroundButton" data-action="class-board#toggleBackgrounds">
                    <twig:ux:icon name="palette"/>{{ 'classBoardBackgroundAction'|trans }}
                </button>
                <button type="button" class="cm-cb__chrome-btn" data-action="class-board#toggleBlackout" title="B">
                    <twig:ux:icon name="screen-off"/>{{ 'classBoardBlackoutAction'|trans }}
                </button>
                <button type="button" class="cm-cb__chrome-btn" data-action="class-board#toggleFullscreen" title="F">
                    <twig:ux:icon name="maximize"/>{{ 'classBoardFullscreenAction'|trans }}
                </button>
                <button type="button" class="cm-cb__chrome-btn cm-cb__chrome-btn--primary" data-action="class-board#saveNow">
                    <twig:ux:icon name="device-floppy"/>{{ 'classBoardSaveAction'|trans }}
                </button>
                <button type="button" class="cm-cb__chrome-btn" data-action="class-board#quit">
                    <twig:ux:icon name="logout"/>{{ 'classBoardQuitAction'|trans }}
                </button>
            </div>

            <div class="cm-cb__backgrounds" data-class-board-target="backgrounds" hidden>
                {% for background in backgrounds %}
                    <div>
                        {# background-color, not the shorthand: app.css draws the photograph's
                           swatch as an image over it. #}
                        <button type="button" style="background-color: {{ background.swatch }}"
                                aria-pressed="{{ background == board.background ? 'true' : 'false' }}"
                                aria-label="{{ background.labelKey|trans }}"
                                data-background="{{ background.value }}"
                                data-action="class-board#chooseBackground"></button>
                        <span>{{ background.labelKey|trans }}</span>
                    </div>
                {% endfor %}
            </div>

            <div class="cm-cb__dock" data-class-board-target="chrome dock">
                {% for group in dock %}
                    <div class="cm-cb__dock-group" role="group" aria-label="{{ group.labelKey|trans }}">
                        <span class="cm-cb__dock-label">{{ group.labelKey|trans }}</span>
                        <div class="cm-cb__dock-buttons">
                            {% for item in group.items %}
                                {% set label = item.type.labelKey|trans %}
                                <button type="button" class="cm-cb__dock-btn" data-type="{{ item.type.value }}"
                                        aria-label="{{ 'classBoardAddWidgetAction'|trans({'%widget%': label}) }}"
                                        {{ item.enabled ? '' : 'disabled' }}
                                        data-action="class-board#addWidget">
                                    {{ ux_icon(item.type.icon) }}
                                    <span class="cm-cb__tip">{{ item.enabled ? label : 'classBoardNeedsClassTip'|trans({'%widget%': label}) }}</span>
                                </button>
                            {% endfor %}
                        </div>
                    </div>
                {% endfor %}
            </div>

            <div class="cm-cb__notice" data-class-board-target="notice" hidden>
                <strong>{{ 'classBoardStaleHeading'|trans }}</strong>
                <span>{{ 'classBoardStaleMessage'|trans }}</span>
                <button type="button" class="cm-cb-btn cm-cb-btn--primary" data-action="class-board#reload">{{ 'classBoardReloadAction'|trans }}</button>
            </div>

            <div class="cm-cb__blackout" data-class-board-target="blackout" data-action="click->class-board#toggleBlackout" hidden>
                <span>{{ 'classBoardBlackoutHint'|trans }}</span>
            </div>
        </div>
    </div>
</div>
{% endblock %}
