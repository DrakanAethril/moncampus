{% extends 'layout/app.html.twig' %}

{# Full-page mounting of the wizard (2a). The wizard itself is in _wizard.html.twig, mounted
   identically as a modal or a panel from another screen - here it only receives its wrapper:
   breadcrumb, title, and nothing else. #}

{% set heading_key = isEdit ? 'assignmentWizardEditPageHeading' : 'assignmentWizardPageHeading' %}
{% set page_heading = context.program
    ? (heading_key ~ 'WithClass')|trans({'%class%': context.program.displayShortName})
    : heading_key|trans %}

{% block title %}{{ page_heading }}{% endblock %}

{% block page_breadcrumb %}
    {% set segments = [
        {label: 'homeNavLabel'|trans, url: path('app_home')},
        {label: 'assignmentsListPageHeading'|trans, url: path('app_assignments')},
    ] %}
    {% if context.program %}
        {% set segments = segments|merge([{label: context.program.displayShortName, url: path('app_assignments', {classe: context.program.id})}]) %}
    {% endif %}
    {% include '_breadcrumb.html.twig' with {segments: segments|merge([
        {label: heading_key|trans, url: app.request.requestUri},
    ])} %}
{% endblock %}

{# The title names the class as soon as it is chosen - on opening when the entry point knows it,
   otherwise at step 1. The wizard rewrites that element alone, spotted by its attribute: it is the
   page that declares itself, the wizard does not go looking for any screen's title. #}
{% block page_title %}<span data-assignment-wizard-heading
                            data-plain="{{ heading_key|trans }}"
                            data-with-class="{{ (heading_key ~ 'WithClass')|trans({'%class%': '%class%'}) }}">{{ page_heading }}</span>{% endblock %}

{% block main %}
    {{ include('assignment/_wizard.html.twig') }}
{% endblock %}
