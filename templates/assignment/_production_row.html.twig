{# One row of « Productions attendues » (2a, Consigne step). The same template serves the rows already
   present and the prototype of the rows added on the fly - hence the deadline toggle being a form
   field rather than free HTML in the parent template.

   The row turns amber as soon as it carries a deadline of its own: that is what makes it visible, at
   a glance, that an assignment announces several dates. #}
<div class="cm-prod-row" data-assignment-wizard-target="productionRow">
    {{ form_widget(production.name, {attr: {class: 'cm-input cm-prod-row__name'}}) }}
    {{ form_widget(production.format, {attr: {class: 'cm-select cm-prod-row__format'}}) }}
    {{ form_widget(production.dueMode, {attr: {class: 'cm-select cm-prod-row__mode', 'data-assignment-wizard-target': 'productionDueMode', 'data-action': 'change->assignment-wizard#productionDueModeChanged'}}) }}
    {{ form_widget(production.dueDate, {attr: {class: 'cm-input cm-input--date cm-prod-row__date', 'data-action': 'change->assignment-wizard#refreshMultiDueBanner'}}) }}
    {{ form_widget(production.position, {attr: {'data-assignment-wizard-target': 'productionPosition'}}) }}
    <button type="button" class="cm-prod-row__remove" data-action="assignment-wizard#removeProduction" aria-label="{{ 'assignmentWizardRemoveProductionAction'|trans }}">&times;</button>
</div>
