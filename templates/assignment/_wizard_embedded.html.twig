{# Modal or panel mounting of the wizard (2a): the same card, laid over the screen it was opened from.
   Rendered as a fragment - with no layout - so it can be loaded into a Turbo frame by the calling
   screen, which thus keeps its own content behind it.

   The content itself is rigorously the same as in full page: that is what « reusable component »
   means. #}
<turbo-frame id="assignment-wizard">
    <a href="{{ context.returnUrl }}" class="cm-panel-backdrop" aria-label="{{ 'cancelAction'|trans }}" data-turbo-frame="_top"></a>
    <div class="cm-wizard-shell cm-wizard-shell--{{ context.mode }}" role="dialog" aria-modal="true" aria-label="{{ (isEdit ? 'assignmentWizardEditPageHeading' : 'assignmentWizardPageHeading')|trans }}">
        <div class="cm-wizard-shell__header">
            {% set heading_key = isEdit ? 'assignmentWizardEditPageHeading' : 'assignmentWizardPageHeading' %}
            <span class="cm-wizard-shell__title">
                {{- context.program
                    ? (heading_key ~ 'WithClass')|trans({'%class%': context.program.displayShortName})
                    : heading_key|trans -}}
            </span>
            <a href="{{ context.returnUrl }}" class="cm-panel__close" aria-label="{{ 'cancelAction'|trans }}" data-turbo-frame="_top">&times;</a>
        </div>
        {{ include('assignment/_wizard.html.twig') }}
    </div>
</turbo-frame>
