{% extends 'layout/app.html.twig' %}

{# « Consulter » from the list (2b): where every student stands, one by one. The full follow-up
   screen - reminders, corrections, grading - is outside the handoff's scope; what is laid down here
   is where the link leads and how the class's state reads.

   The rows come from App\Service\AssignmentFollowUpBoard, which reads the proof each nature
   actually produces. This template must never go back to reading `row.submission` alone: six
   natures out of eleven never produce a deposit. #}

{% block title %}{{ assignment.title }}{% endblock %}

{% block page_breadcrumb %}
    {% include '_breadcrumb.html.twig' with {segments: [
        {label: 'homeNavLabel'|trans, url: path('app_home')},
        {label: 'assignmentsListPageHeading'|trans, url: path('app_assignments')},
        {label: assignment.program.displayShortName, url: path('app_assignments', {classe: assignment.program.id})},
        {label: assignment.title, url: app.request.requestUri},
    ]} %}
{% endblock %}

{% block page_title %}{{ assignment.title }}{% endblock %}

{% block main %}
    <div class="card mb-3">
        <div class="card-body cm-worksummary">
            <div>
                <span class="cm-worksummary__label">{{ 'assignmentTypeColumnLabel'|trans }}</span>
                <span class="cm-worksummary__value">{{ assignment.nature.labelKey|trans }}</span>
            </div>
            <div>
                <span class="cm-worksummary__label">{{ 'assignmentDueColumnLabel'|trans }}</span>
                <span class="cm-worksummary__value">{{ assignment.dueDate|localized_date }} · {{ assignment.dueDate|date('H:i') }}</span>
            </div>
            <div>
                <span class="cm-worksummary__label">{{ 'assignmentWizardAudienceFieldLabel'|trans }}</span>
                <span class="cm-worksummary__value">{{ details.audience }}</span>
            </div>
            <div>
                <span class="cm-worksummary__label">{{ 'assignmentProgressColumnLabel'|trans }}</span>
                <span class="cm-worksummary__value">{{ progress ? progress.key|trans(progress.params) : '—' }}</span>
            </div>
        </div>
    </div>

    {% if assignment.expectedProductions|length > 0 %}
        <div class="card mb-3">
            <div class="card-header">{{ 'assignmentWizardProductionsFieldLabel'|trans }}</div>
            <div class="table-responsive">
                <table class="table table-vcenter card-table">
                    <tbody>
                        {% for production in assignment.expectedProductions %}
                            <tr>
                                <td>{{ production.name }}</td>
                                <td>{{ production.format.labelKey|trans }}</td>
                                <td class="{{ production.hasOwnDueDate ? 'cm-worksummary__own-due' }}">
                                    {{- production.effectiveDueDate|localized_date }} · {{ production.effectiveDueDate|date('H:i') -}}
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    {% endif %}

    {# One line per student, read from whatever this nature accepts as proof - a deposit, a quiz
       attempt, a response, a listening, a watching, a validated estimate, a declaration. The
       vocabulary follows the nature too: « Non rendu » under a quiz was the screen's own bug. #}
    <div class="card">
        <div class="table-responsive">
            <table class="table table-vcenter card-table">
                <thead>
                    <tr>
                        <th>{{ 'assignmentStudentColumnLabel'|trans }}</th>
                        <th>{{ 'assignmentSubmissionStatusColumnLabel'|trans }}</th>
                        <th>{{ assignment.nature.followUpDateColumnLabelKey|trans }}</th>
                        {% if assignment.quizInstance %}
                            <th>{{ 'assignmentFollowUpScoreColumnLabel'|trans }}</th>
                            <th class="cm-actions"></th>
                        {% endif %}
                    </tr>
                </thead>
                <tbody>
                    {% for row in rows %}
                        <tr>
                            <td>{{ row.student.displayName ?? row.student.username }}</td>
                            <td><span class="badge {{ row.status.badgeClass }}">{{ row.statusLabelKey|trans }}</span></td>
                            <td>{{ row.doneAt ? row.doneAt|date('d/m/Y H:i') : '—' }}</td>
                            {% if assignment.quizInstance %}
                                <td>{{ row.scorePercent is not null ? row.scorePercent|round ~ ' %' : '—' }}</td>
                                <td class="cm-actions">
                                    {# The copy itself lives on the quiz's own follow-up, which is where
                                       every attempt of that student is listed - this is a door onto it,
                                       not a second reading of it. #}
                                    {% if row.attempt %}
                                        <a class="cm-action--neutral" href="{{ path('app_program_quiz_student_attempts', {id: assignment.program.id, instanceId: assignment.quizInstance.id, studentId: row.student.id}) }}">{{ 'assignmentFollowUpViewCopyAction'|trans }}</a>
                                    {% endif %}
                                </td>
                            {% endif %}
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="{{ assignment.quizInstance ? 5 : 3 }}" class="text-secondary">{{ 'assignmentShowNoAudienceMessage'|trans }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endblock %}
