{% extends 'layout/app.html.twig' %}

{% block title %}{{ 'quizLiveCreatedPageHeading'|trans }}{% endblock %}

{% block page_breadcrumb %}
    {{ component('Cm:Breadcrumb', {segments: [
        {label: 'quizLiveNavLabel'|trans, url: path('app_quiz_live_index')},
        {label: session.quizInstance.name, url: app.request.requestUri},
    ]}) }}
{% endblock %}
{% block page_title %}{{ 'quizLiveCreatedPageHeading'|trans }}{% endblock %}

{% block main %}
    <div class="card" style="max-width: 720px;">
        <div class="card-body d-flex flex-column gap-3">
            <div class="d-flex align-items-center gap-3 flex-wrap">
                <div class="flex-fill">
                    <div class="fw-bold" style="font-size: 20px;">{{ session.quizInstance.name }}</div>
                    <div class="text-secondary" style="font-size: 12.5px;">
                        {{ session.program ? session.program.displayShortName : 'quizLiveIndexNoClassLabel'|trans }} · {{ session.quizInstance.questions|length }} {{ 'quizQuestionsCountLabel'|trans }} ·
                        {%- if session.quizInstance.secondsPerQuestion %} {{ 'quizLiveCreatedDefaultSecondsTemplate'|trans({'%seconds%': session.quizInstance.secondsPerQuestion}) }}{% else %} {{ 'quizLiveCreatedNoDefaultSecondsLabel'|trans }}{% endif %}
                    </div>
                </div>
                {% if session.public %}<twig:Cm:Badge tone="gold">{{ 'quizLivePublicBadge'|trans }}</twig:Cm:Badge>{% else %}<twig:Cm:Badge tone="blue">{{ 'quizLiveClassOnlyBadge'|trans }}</twig:Cm:Badge>{% endif %}
                <span class="d-inline-flex align-items-center gap-2 text-secondary">{{ 'quizLiveCreatedThemeLabel'|trans }} {{ include('quiz_live/_swatch.html.twig', {theme: theme}) }} <span class="fw-bold">{{ theme.name }}</span></span>
            </div>
            {% if session.public %}
                <div class="alert alert-info mb-0">{{ 'quizLiveCreatedPublicMessage'|trans({'%url%': joinUrl}) }}</div>
            {% endif %}
            {% if session.program %}
                <div class="alert alert-info mb-0">{{ 'quizLiveCreatedInfoMessageTemplate'|trans({'%program%': session.program.displayShortName}) }}</div>
            {% else %}
                <div class="alert alert-info mb-0">{{ 'quizLiveCreatedNoClassMessage'|trans }}</div>
            {% endif %}
            <ol class="d-flex flex-column gap-2 mb-0 text-secondary" style="font-size: 13.5px;">
                <li>{{ 'quizLiveCreatedStep1'|trans }}</li>
                <li>{{ 'quizLiveCreatedStep2'|trans }}</li>
                <li>{{ 'quizLiveCreatedStep3'|trans }}</li>
            </ol>
        </div>
        <div class="card-footer d-flex gap-2">
            {% if not session.isOver %}
                <form method="post" action="{{ path('app_quiz_live_cancel', {id: session.id}) }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('quiz_live_control') }}">
                    <twig:Cm:Button variant="outline" type="submit">{{ 'quizLiveCancelAction'|trans }}</twig:Cm:Button>
                </form>
                {# data-turbo="false": the projector is a full-bleed page of its own, outside the app shell. #}
                <twig:Cm:Button variant="primary" :href="path('app_quiz_live_projector', {id: session.id})" class="ms-auto" data-turbo="false">{{ 'quizLiveOpenProjectorAction'|trans }}</twig:Cm:Button>
            {% else %}
                <twig:Cm:Button variant="primary" :href="path('app_quiz_live_results', {id: session.id})" class="ms-auto">{{ 'quizLiveResultsAction'|trans }}</twig:Cm:Button>
            {% endif %}
        </div>
    </div>
{% endblock %}
