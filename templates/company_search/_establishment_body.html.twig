{# What the register says about one establishment and its company, and how to get there.
   Parameters: company (CompanyRow), establishment (EstablishmentRow), schoolPlace (?GeocodedPlace). #}
{% if not establishment.open %}
    <div class="alert alert-warning" role="alert">
        {{ establishment.closedOn ? 'companySearchClosedOnNotice'|trans({'%date%': establishment.closedOn|date('d/m/Y')}) : 'companySearchClosedNotice'|trans }}
    </div>
{% endif %}

<div class="cm-cs-fiche">
    <div class="cm-cs-fiche__main">
        {% include 'company_search/_registry_cards.html.twig' with {company: company, establishment: establishment} %}
    </div>

    <aside class="cm-cs-fiche__side">
        {% include 'company_search/_go_there.html.twig' with {establishment: establishment, schoolPlace: schoolPlace, name: company.name} %}

        {% include 'company_search/_how_to_reach.html.twig' with {establishment: establishment, name: company.name} %}
    </aside>
</div>
