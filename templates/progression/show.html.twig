{% extends 'layout/app.html.twig' %}

{% block title %}{{ progression.displayName }}{% endblock %}

{% block page_breadcrumb %}
    {% include '_breadcrumb.html.twig' with {segments: [
        {label: 'homeNavLabel'|trans, url: path('app_home')},
        {label: 'progressionNavLabel'|trans, url: path('app_progression')},
        {label: 'progressionManagePageHeading'|trans, url: path('app_progression_manage')},
        {label: progression.displayName, url: app.request.requestUri},
    ]} %}
{% endblock %}
{% block page_title %}
    {{ progression.displayName }}
    {% set schoolYear = progression.program.schoolYear %}
    {% if schoolYear %}<span class="text-secondary fs-4 fw-normal ms-2">— {{ schoolYear.startDate|date('Y') }}-{{ schoolYear.endDate|date('Y') }}</span>{% endif %}
{% endblock %}

{% block page_actions %}
    {# « Partager la trame », and the label is deliberately not « Partager »: what travels is the
       order and the durations, never the créneaux - a date is a property of a timetable, and a
       colleague's timetable is not yours (design/validated/content-sharing-between-teachers.md). #}
    {% if canShare %}
        <button type="button" class="btn btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#content-share-modal">{{ 'contentShareTrameAction'|trans }}</button>
    {% endif %}
{% endblock %}

{% block main %}
    <div class="cm-prog-layout">
        <div class="card">
            <div class="card-header cm-prog-cardhead">
                <span class="card-title">{{ 'progressionSequencesCardTitle'|trans }}</span>
                <span class="cm-prog-cardhead__hint">{{ 'progressionSequencesCardHint'|trans }}</span>
                <span class="cm-prog-cardhead__actions">
                    <button type="button" class="cm-btn cm-btn--outline cm-btn--sm" data-bs-toggle="collapse" data-bs-target="#progression-evaluation-form">+ {{ 'progressionAddEvaluationAction'|trans }}</button>
                    <button type="button" class="cm-btn cm-btn--outline cm-btn--sm" data-bs-toggle="collapse" data-bs-target="#progression-sequence-form">+ {{ 'progressionAddSequenceAction'|trans }}</button>
                </span>
            </div>

            {% include 'progression/_add_evaluation_form.html.twig' %}
            {% include 'progression/_add_sequence_form.html.twig' %}

            <div class="card-body">
                {# Reordering replans everything downstream (§4.8), so the drop POSTs the whole new
                   order in one request. Only the séquence rows live inside the sortable container -
                   the out-of-séquence evaluations below carry a date, not a rank, and must not be
                   draggable into the ordering. #}
                <div class="cm-prog-rows"
                     data-controller="sortable-reorder"
                     data-sortable-reorder-url-value="{{ path('app_progression_sequences_reorder', {id: progression.id}) }}"
                     data-sortable-reorder-token-value="{{ csrf_token('progression_sequences_reorder') }}">
                    {% for sequence in sequences %}
                        {% set status = sequence.status %}
                        <div class="cm-prog-row cm-prog-row--{{ status.tone }}" data-sortable-reorder-id-param="{{ sequence.id }}">
                            <span class="cm-prog-row__handle sortable-reorder-handle" aria-hidden="true">⠿</span>
                            <span class="cm-prog-row__index">{{ loop.index }}</span>
                            <span class="cm-prog-row__body">
                                <span class="cm-prog-row__title">{{ sequence.title }}</span>
                                <span class="cm-prog-row__meta">
                                    {% if sequence.firstPlacedDay %}
                                        {{ sequence.firstPlacedDay|date('d') }} {{ ('monthShort' ~ sequence.firstPlacedDay|date('n') ~ 'Label')|trans }}
                                        → {% if sequence.lastPlacedDay %}{{ sequence.lastPlacedDay|date('d') }} {{ ('monthShort' ~ sequence.lastPlacedDay|date('n') ~ 'Label')|trans }}{% else %}…{% endif %}
                                    {% elseif sequence.forcedStartDate %}
                                        {{ 'progressionFromDateLabel'|trans({'%date%': sequence.forcedStartDate|date('d/m/Y')}) }}
                                    {% else %}
                                        {{ 'progressionNotScheduledLabel'|trans }}
                                    {% endif %}
                                    · {{ 'progressionPlacedDurationLabel'|trans({'%placed%': sequence.placedMinutes|duration_minutes, '%planned%': sequence.plannedMinutes|duration_minutes}) }}
                                    {% if sequence.countSeancesToPlace > 0 %}
                                        — {{ 'progressionSeancesToPlaceLabel'|trans({'%count%': sequence.countSeancesToPlace}) }}
                                    {% endif %}
                                    {% if not sequence.placeInTimetable %}· {{ 'progressionNotPlacedInTimetableLabel'|trans }}{% endif %}
                                    {% if sequence.truncatedByNext %}· {{ 'progressionTruncatedByNextLabel'|trans }}{% endif %}
                                    {# The séquence's "Créneaux utilisés", shown only when it departs
                                       from the defaults - every séquence carries the fields, and
                                       spelling out "toutes matières, tous créneaux" on each row
                                       would say nothing on all of them at once. #}
                                    {% if sequence.slotTopicScope.value == 'all' %}· {{ 'progressionSlotTopicAllTag'|trans }}{% endif %}
                                    {% if sequence.slotTopicScope.value == 'specific' and sequence.slotTopic %}· {{ sequence.slotTopic.name }}{% endif %}
                                    {% if sequence.slotComposition.value != 'all' %}· {{ sequence.slotComposition.labelKey|trans }}{% endif %}
                                    {% if sequence.oneSeancePerWeek %}· {{ 'progressionSlotOnePerWeekTag'|trans }}{% endif %}
                                </span>
                            </span>
                            <span class="cm-prog-chip-status cm-prog-chip-status--{{ status.tone }}">{{ status.labelKey|trans }}</span>
                            <a href="{{ path('app_progression_placement', {id: progression.id, sequenceId: sequence.id}) }}"
                               class="cm-btn cm-btn--sm {{ status.value == 'placed' ? 'cm-btn--outline' : 'cm-btn--primary' }}">{{ 'progressionPlaceSeancesAction'|trans }}</a>
                            {# Not inside the reorder container's own <form> - there isn't one; each
                               row action is its own POST form, which is what keeps this page free
                               of the nested-<form> bug class. #}
                            <form method="post" action="{{ path('app_progression_sequence_remove', {id: progression.id, sequenceId: sequence.id}) }}"
                                  onsubmit="return confirm('{{ 'progressionSequenceRemoveConfirm'|trans|e('js') }}')">
                                <input type="hidden" name="_token" value="{{ csrf_token('progression_sequence_remove') }}">
                                <button type="submit" class="cm-prog-row__remove" aria-label="{{ 'removeActionLabel'|trans }}">✕</button>
                            </form>
                        </div>
                    {% endfor %}
                </div>

                {% if sequences is empty %}
                    <p class="text-secondary">{{ 'progressionNoSequenceLabel'|trans }}</p>
                {% endif %}

                {# Evaluations posed on the progression rather than on one of its séquences (the
                   design's BTS blanc). One attached to a séquence is listed on that séquence's
                   placement screen instead - never nowhere, which is what it used to be. #}
                <div class="cm-prog-rows">
                    {% for evaluation in outOfSequenceEvaluations %}
                        {% include 'progression/_evaluation_row.html.twig' with {
                            progression: progression,
                            evaluation: evaluation,
                            sequences: sequences,
                            showSequence: true,
                        } only %}
                    {% endfor %}
                </div>
                <p class="cm-prog-hint">{{ 'progressionSequencesFootnote'|trans }}</p>
            </div>
        </div>

        <aside class="cm-prog-rail">
            {# First card of the rail: who delivers this matière. It leads because on a co-animated
               progression it is the answer to "why is somebody else's séquence in my plan", and on
               a solo one it is a single row that costs nothing to read. #}
            {% include 'progression/_co_animation.html.twig' %}
            <div class="card">
                {# The design's rail card also carried a completeness gauge; it was dropped as not
                   pulling its weight, leaving the D/F/S counters as the card's whole content. #}
                <div class="card-body">
                    <h3 class="card-title">{{ 'progressionRailEvaluationsTitle'|trans }}</h3>
                    <p class="cm-prog-rail__counts">
                        {{ 'progressionRailEvaluationsLabel'|trans({
                            '%diagnostic%': counts.diagnostic,
                            '%formative%': counts.formative,
                            '%summative%': counts.summative,
                        }) }}
                    </p>
                </div>
            </div>
            <div class="card">
                <div class="card-body">
                    <h3 class="card-title">{{ 'progressionRailCalendarTitle'|trans }}</h3>
                    <a href="{{ path('app_progression') }}" class="cm-prog-rail__link">{{ 'progressionRailAnnualLink'|trans }}</a>
                    <a href="{{ path('app_progression_month', {month: currentMonthKey}) }}" class="cm-prog-rail__link">{{ 'progressionRailMonthLink'|trans }}</a>
                </div>
            </div>
            {# The other side of "+ Ajouter une séquence": the same availableSequenceInstances, listed
               so a séquence instantiated for the class and never planned is visible instead of only
               existing inside a <select>. The ✕ deletes the instantiation itself, not a progression
               row - hence its own confirm, spelling out that the frozen copy goes for good. #}
            <div class="card">
                <div class="card-body">
                    <h3 class="card-title">{{ 'progressionRailUnusedTitle'|trans }}</h3>
                    <p class="cm-prog-rail__hint">{{ (progression.coAnimated ? 'progressionRailUnusedCoAnimatedHint' : 'progressionRailUnusedHint')|trans }}</p>
                    {% for instance in availableSequenceInstances %}
                        {# Own <form> per row; the rail carries no outer form, so nothing is nested. #}
                        <div class="cm-prog-rail__item">
                            <span class="cm-prog-rail__item-body">
                                <span class="cm-prog-rail__item-title">{{ instance.titre }}</span>
                                {# "Créée par" is back, but only on a co-animated progression: the
                                   pool is then the two teachers' instantiations, so the name is
                                   what tells them apart. On a solo plan it would be the same name
                                   on every row, which is why it was dropped in the first place. #}
                                <span class="cm-prog-rail__item-meta">
                                    {{ 'progressionRailUnusedSeanceCountLabel'|trans({'%count%': instance.seanceInstances|length}) }}
                                    {% if progression.coAnimated and instance.createdBy %}
                                        · {{ 'progressionRailUnusedCreatedByLabel'|trans({'%name%': instance.createdBy.displayName ?? instance.createdBy.username}) }}
                                    {% endif %}
                                </span>
                            </span>
                            {# The ✕ destroys the class's frozen copy, which is not a co-animator's
                               gesture on a colleague's séquence - the route refuses it, so the
                               screen must not offer it either. #}
                            {% if instance.createdBy is same as(app.user) or is_staff() %}
                                <form method="post" action="{{ path('app_progression_sequence_instance_remove', {id: progression.id, sequenceInstanceId: instance.id}) }}"
                                      onsubmit="return confirm('{{ 'progressionRailUnusedRemoveConfirm'|trans({'%title%': instance.titre})|e('js') }}')">
                                    <input type="hidden" name="_token" value="{{ csrf_token('progression_sequence_instance_remove') }}">
                                    <button type="submit" class="cm-prog-row__remove"
                                            aria-label="{{ 'progressionRailUnusedRemoveAction'|trans }}" title="{{ 'progressionRailUnusedRemoveAction'|trans }}">✕</button>
                                </form>
                            {% endif %}
                        </div>
                    {% else %}
                        <p class="cm-prog-rail__empty">{{ 'progressionRailUnusedEmptyLabel'|trans }}</p>
                    {% endfor %}
                </div>
            </div>
        </aside>
    </div>

    {% if canAddCoTeacher %}
        {% include 'progression/_co_animation_modal.html.twig' %}
    {% endif %}

    {% if canShare %}
        {% include 'content_share/_modal.html.twig' with {
            subjectType: 'progression',
            subjectId: progression.id,
            subjectTitle: progression.displayName,
            subjectDetail: 'contentShareTrameDetailLabel'|trans({'%count%': progression.sequences|length}),
            groups: shareGroups,
            shares: shares,
            memberCounts: shareMemberCounts,
        } only %}
    {% endif %}
{% endblock %}
