{% extends 'layout/app.html.twig' %}

{% block title %}{{ 'progressionManagePageHeading'|trans }}{% endblock %}

{% block page_breadcrumb %}
    {% include '_breadcrumb.html.twig' with {segments: [
        {label: 'homeNavLabel'|trans, url: path('app_home')},
        {label: 'progressionNavLabel'|trans, url: path('app_progression')},
        {label: 'progressionManagePageHeading'|trans, url: path('app_progression_manage')},
    ]} %}
{% endblock %}
{% block page_title %}{{ 'progressionManagePageHeading'|trans }}{% endblock %}

{% block page_actions %}
    <a href="{{ path('app_progression_new') }}" class="cm-btn cm-btn--primary">+ {{ 'progressionNewAction'|trans }}</a>
{% endblock %}

{% block main %}
    {# Chips per class, alphabetical, "Toutes" first with the overall count - the design's own
       ordering rule ("tri alphabétique classes puis matières"), applied server-side in
       ProgressionController::manageList(). #}
    <div class="cm-prog-chips">
        <span class="cm-prog-chips__label">{{ 'progressionFilterClassesLabel'|trans }} :</span>
        <a href="{{ path('app_progression_manage') }}" class="cm-prog-chip{{ selectedCohort is null or selectedCohort == '' ? ' is-active' }}">{{ 'progressionFilterAllLabel'|trans }} · {{ total }}</a>
        {% if coAnimatedTotal > 0 %}
            <span class="cm-prog-chips__label">{{ 'progressionCoAnimatedCountLabel'|trans({'%count%': coAnimatedTotal}) }}</span>
        {% endif %}
        {% for chip in chips %}
            <a href="{{ path('app_progression_manage', {cohort: chip.id}) }}" class="cm-prog-chip{{ selectedCohort == chip.id ? ' is-active' }}">{{ chip.label }} · {{ chip.count }}</a>
        {% endfor %}
    </div>

    <div class="card">
        <div class="table-responsive">
            <table class="table card-table table-vcenter cm-prog-table">
                <thead>
                    <tr>
                        <th>{{ 'progressionTableClassHeader'|trans }}</th>
                        <th>{{ 'progressionTableTopicHeader'|trans }}</th>
                        <th>{{ 'progressionTableEvaluationsHeader'|trans }}</th>
                        <th class="text-end">{{ 'progressionTableActionsHeader'|trans }}</th>
                    </tr>
                </thead>
                <tbody>
                    {% for row in rows %}
                        {% set counts = row.counts %}
                        {% set hasEvaluation = counts.diagnostic + counts.formative + counts.summative > 0 %}
                        <tr>
                            <td class="fw-bold">{{ row.cohort ? row.cohort.name : '—' }}</td>
                            <td>
                                {{ row.topic ? row.topic.name : '—' }}
                                {# The row is in this list because the viewer owns it OR is named on
                                   it as a co-animator, and those two look identical without a mark:
                                   the chip names the colleague, and the group the viewer holds. #}
                                {% if row.coAnimated %}
                                    <span class="cm-prog-chip-status cm-prog-chip-status--info">{{ 'progressionCoAnimatedChipLabel'|trans }}</span>
                                    <span class="d-block text-secondary small">
                                        {% if row.otherTeachers is not empty %}{{ 'progressionCoAnimatedWithLabel'|trans({'%names%': row.otherTeachers|join(', ')}) }}{% endif %}
                                        {% if row.ownGroups is not empty %} · {{ 'progressionCoAnimatedOwnGroupLabel'|trans({'%groups%': row.ownGroups|join(', ')}) }}{% endif %}
                                    </span>
                                {% endif %}
                            </td>
                            <td>
                                {% if hasEvaluation %}
                                    <span class="cm-prog-dfs">{{ counts.diagnostic }} · {{ counts.formative }} · {{ counts.summative }}</span>
                                {% else %}
                                    <span class="text-secondary">—</span>
                                {% endif %}
                            </td>
                            <td class="text-end">
                                {# One verb per row action, per the design's constraint. The export
                                   is a GET that returns a file, so each entry is a plain link - no
                                   form and nothing for Turbo to intercept; `pdf-download` takes the
                                   click over only to show a spinner while Gotenberg renders, and
                                   falls back to following the link when anything but a PDF comes
                                   back.

                                   The controller sits on the wrapper rather than on the entries: the
                                   menu closes on click, and the spinner has to stay on the button
                                   instead of leaving with the entry that was clicked.

                                   The table sits in a `.table-responsive`, whose `overflow` is a
                                   clipping context - on the last row of a short list the menu was cut
                                   at the bottom edge of the card. A `fixed` Popper strategy
                                   positions it against the viewport instead, which no ancestor's
                                   overflow can trim; same fix as the bibliothèque's row menu. #}
                                <div class="d-flex justify-content-end gap-2">
                                    <div class="dropdown"
                                         data-controller="pdf-download"
                                         data-pdf-download-loading-label-value="{{ 'pdfExportLoadingLabel'|trans }}"
                                         data-pdf-download-fallback-filename-value="progression.pdf">
                                        <button type="button" class="cm-btn cm-btn--outline cm-btn--sm dropdown-toggle"
                                                data-bs-toggle="dropdown" aria-expanded="false"
                                                data-bs-boundary="viewport"
                                                data-bs-popper-config='{"strategy":"fixed"}'
                                                data-pdf-download-target="trigger">
                                            <span class="spinner-border spinner-border-sm d-none me-1" role="status" aria-hidden="true" data-pdf-download-target="spinner"></span>
                                            <span data-pdf-download-target="label">{{ 'progressionExportPdfAction'|trans }}</span>
                                        </button>
                                        <div class="dropdown-menu dropdown-menu-end">
                                            {# The dated one first: it is the document of record, and
                                               it is what this button produced before there was a
                                               choice. #}
                                            <a class="dropdown-item" data-action="pdf-download#download"
                                               href="{{ path('app_progression_export_pdf', {id: row.progression.id}) }}">{{ 'progressionExportPdfWithDatesAction'|trans }}</a>
                                            <a class="dropdown-item" data-action="pdf-download#download"
                                               href="{{ path('app_progression_export_pdf', {id: row.progression.id, mode: 'undated'}) }}">{{ 'progressionExportPdfWithoutDatesAction'|trans }}</a>
                                        </div>
                                    </div>
                                    <a href="{{ path('app_progression_show', {id: row.progression.id}) }}" class="cm-btn cm-btn--primary cm-btn--sm">{{ 'progressionManageRowAction'|trans }}</a>
                                </div>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="4" class="text-secondary">{{ 'progressionListEmptyLabel'|trans }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endblock %}
