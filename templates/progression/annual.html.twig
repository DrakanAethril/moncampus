{% extends 'layout/app.html.twig' %}

{% block title %}{{ 'progressionAnnualPageHeading'|trans }}{% endblock %}

{% block page_breadcrumb %}
    {% include '_breadcrumb.html.twig' with {segments: [
        {label: 'homeNavLabel'|trans, url: path('app_home')},
        {label: 'progressionNavLabel'|trans, url: path('app_progression')},
    ]} %}
{% endblock %}
{% block page_title %}{{ 'progressionAnnualPageHeading'|trans }}{% endblock %}

{% block main %}
    {% include 'progression/_filters.html.twig' with {action_template: 'progression/_manage_button.html.twig'} %}

    {# Ten fixed 316 px columns with a horizontal scrollbar, scrolled to the current month on load
       (design_handoff_progression README §3) - the scroll itself is the month-scroll Stimulus
       controller, since a server-rendered page cannot position a scrollbar. #}
    <div class="cm-prog-months" data-controller="progression-month-scroll">
        {% for month in months %}
            <section class="cm-prog-month{{ month.isCurrent ? ' is-current' }}"{{ month.isCurrent ? ' data-progression-month-scroll-target="current"'|raw }}>
                <header class="cm-prog-month__head">
                    <span class="cm-prog-month__name">{{ ('monthFull' ~ month.month ~ 'Label')|trans|capitalize }}</span>
                    {% if month.isCurrent %}
                        <span class="cm-prog-month__now">{{ 'progressionCurrentMonthBadge'|trans }}</span>
                    {% endif %}
                    <a href="{{ path('app_progression_month', app.request.query.all|merge({month: month.key})) }}" class="cm-btn cm-btn--outline cm-btn--sm">{{ 'progressionMonthDetailAction'|trans }}</a>
                </header>
                <div class="cm-prog-month__body">
                    {% for class in month.classes %}
                        <div class="cm-prog-classblock">
                            <div class="cm-prog-classblock__head">
                                <span class="cm-prog-classblock__label">{{ class.label }}</span>
                                <span class="cm-prog-classblock__rule"></span>
                            </div>
                            {% for card in class.cards %}
                                {% include 'progression/_card.html.twig' with {card: card} only %}
                            {% endfor %}
                        </div>
                    {% else %}
                        <p class="cm-prog-month__empty">{{ 'progressionMonthEmptyLabel'|trans }}</p>
                    {% endfor %}
                </div>
            </section>
        {% endfor %}
    </div>
{% endblock %}
