{# One course on its author's public page (design/validated/cours-en-ligne.md, §5): what it is
   about, its tags, and which materials it comes with - the interactive course named first and in
   bold when there is one, since it is the one a reader is most likely looking for. Its picture, when
   it has one, sits above the band.

   The whole card leads to the course, through its title's link stretched over it (`::after`): a
   card that was itself an <a> could not carry the second link, « Test », which opens the quiz the
   author linked - and an <a> inside an <a> is no HTML at all. #}
{% set kinds = [] %}
{% for material in course.materials %}
    {% if material.kind not in kinds %}{% set kinds = kinds|merge([material.kind]) %}{% endif %}
{% endfor %}
<article class="cm-pub-card cm-pub-card--stretched">
    {% if course.imageKey %}
        {# Decorative: the title right below says what the course is. #}
        <img class="cm-pub-card__image" src="{{ file_url(course.imageKey) }}" alt="" loading="lazy">
    {% endif %}
    <span class="cm-pub-card__band cm-pub-card__band--{{ (course.id % 4) + 1 }}">
        {% for tag in course.tags|slice(0, 1) %}{{ tag.label }}{% else %}{{ 'onlineCourseNavLabel'|trans }}{% endfor %}
    </span>
    <span class="cm-pub-card__body">
        <a class="cm-pub-card__title cm-pub-card__link" href="{{ path('app_public_courses_course', {handle: page.handle, slug: course.slug}) }}">{{ course.title }}</a>
        <span class="cm-pub-card__summary">{{ course.summary }}</span>
        {% if course.tags is not empty %}
            <span class="cm-pub-tags">
                {% for tag in course.tags %}<span class="cm-pub-tag">{{ tag.label }}</span>{% endfor %}
            </span>
        {% endif %}
        <span class="cm-pub-card__kinds">
            {% for kind in kinds %}
                <span class="{{ kind.isBundle ? 'is-main' }}">{{ kind.shortLabelKey|trans }}</span>
            {% endfor %}
            {% if course.estimatedMinutes %}
                <span class="cm-pub-card__duration">{{ include('online_course/_duration.html.twig', {minutes: course.estimatedMinutes}) }}</span>
            {% endif %}
            {% if course.hasTest %}
                <a class="cm-pub-card__test {{ not course.estimatedMinutes ? 'is-pushed' }}" href="{{ path('app_public_courses_test', {handle: page.handle, slug: course.slug}) }}"
                   title="{{ 'onlineCourseTestCardTitle'|trans }}">
                    <twig:ux:icon name="clipboard-check" width="13" height="13"/>{{ 'onlineCourseTestLabel'|trans }}
                </a>
            {% endif %}
        </span>
    </span>
</article>
