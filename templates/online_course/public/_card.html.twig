{# One course on its author's public page (design/validated/cours-en-ligne.md, §5 and §20): a large
   cover - the course's picture, or a tint when it has none - carrying one pictogram per nature of
   material, the interactive course's set apart; then the title, the duration and « Test ».

   The summary is drawn over the cover and shows when the card is hovered or holds the focus. It
   stays in the markup, so a screen reader reads it with the card. The tags are not on the card:
   the rows already sort the courses by tag, and the course's own page lists them.

   The whole card leads to the course, through its title's link stretched over it (`::after`): a
   card that was itself an <a> could not carry the second link, « Test », which opens the quiz the
   author linked - and an <a> inside an <a> is no HTML at all. #}
{% set kinds = [] %}
{% for material in course.materials %}
    {% if material.kind not in kinds %}{% set kinds = kinds|merge([material.kind]) %}{% endif %}
{% endfor %}
<article class="cm-pub-card cm-pub-card--stretched">
    <div class="cm-pub-card__cover cm-pub-card__band--{{ (course.id % 4) + 1 }}">
        {% if course.imageKey %}
            {# Decorative: the title right below says what the course is. #}
            <img class="cm-pub-card__image" src="{{ file_url(course.imageKey) }}" alt="" loading="lazy">
        {% endif %}
        {% if kinds is not empty %}
            <ul class="cm-pub-card__kinds" aria-label="{{ 'onlineCourseMaterialsHeading'|trans }}">
                {% for kind in kinds %}
                    <li class="cm-pub-card__kind {{ kind.isBundle ? 'is-main' }}">
                        <twig:ux:icon name="{{ kind.icon }}" width="16" height="16"/>
                        <span class="visually-hidden">{{ kind.labelKey|trans }}</span>
                    </li>
                {% endfor %}
            </ul>
        {% endif %}
        {% if course.summary %}
            <p class="cm-pub-card__summary">{{ course.summary }}</p>
        {% endif %}
    </div>
    <div class="cm-pub-card__body">
        <a class="cm-pub-card__title cm-pub-card__link" href="{{ path('app_public_courses_course', {handle: page.handle, slug: course.slug}) }}">{{ course.title }}</a>
        {% if course.estimatedMinutes or course.hasTest %}
            <span class="cm-pub-card__meta">
                {% if course.estimatedMinutes %}
                    <span class="cm-pub-card__duration">{{ include('online_course/_duration.html.twig', {minutes: course.estimatedMinutes}) }}</span>
                {% endif %}
                {% if course.hasTest %}
                    <a class="cm-pub-card__test" href="{{ path('app_public_courses_test', {handle: page.handle, slug: course.slug}) }}"
                       title="{{ 'onlineCourseTestCardTitle'|trans }}">
                        <twig:ux:icon name="clipboard-check" width="13" height="13"/>{{ 'onlineCourseTestLabel'|trans }}
                    </a>
                {% endif %}
            </span>
        {% endif %}
    </div>
</article>
