{% extends 'layout/public.html.twig' %}

{# A teacher's public page (design/validated/cours-en-ligne.md, §5): their published courses, and
   nothing else - no parcours for a visitor, no other teacher.

   It is the teacher's page more than the establishment's: their banner replaces the shell's bar,
   the emblem is not drawn and there is no footer. The teacher's name is not printed either - it is
   theirs to put in the banner's title.

   Two shapes, each with its own address: the rows (« récemment mis à jour », then one per tag in
   alphabetical order, each cut to what one line holds - online_course_row_controller.js), and a
   full list, for a row's « Voir tout » (`?tag=…`, `?view=recent`) or a search (`?q=`). #}

{% block public_title %}{{ page.title }}{% endblock %}

{% block public_meta %}
    {# A plain slice rather than |u.truncate: twig/string-extra is not installed. #}
    <meta name="description" content="{{ (page.introduction ? page.introduction|plain_text : 'onlineCoursePublicPageDescription'|trans({'%title%': page.title}))|slice(0, 180) }}">
    <meta property="og:title" content="{{ page.title }}">
    <meta property="og:type" content="website">
    {% if page.bannerImageKey %}
        <meta property="og:image" content="{{ file_url(page.bannerImageKey) }}">
    {% endif %}
{% endblock %}

{% block public_modifier %}cm-pub--page{% endblock %}

{% block public_header %}
    {% embed 'online_course/_page_banner.html.twig' with {
        banner_title: page.title,
        title_color: page.titleColor,
        banner_color: page.bannerColor,
        banner_height: page.bannerHeight,
        image_key: page.bannerImageKey,
    } %}
        {% block bar %}
            <div class="cm-pub-banner__bar">
                {% if app.user %}
                    <twig:Cm:Button variant="outline" size="sm" href="{{ path('app_home') }}">{{ 'publicShellBackAction'|trans }}</twig:Cm:Button>
                    {# The app shell's own menu, avatar alone: theme, profile and sign-out live in it. #}
                    <div class="cm-pub-banner__user">{{ include('layout/_user_menu.html.twig', {compact: true}) }}</div>
                {% else %}
                    {% set visitor_theme = app.request.cookies.get('theme') %}
                    <span class="cm-theme" data-controller="theme" data-theme-authenticated-value="false">
                        <button type="button" class="{{ visitor_theme != 'dark' ? 'is-on' }}" data-action="theme#setLight" aria-label="{{ 'themeLightLabel'|trans }}">☀</button>
                        <button type="button" class="{{ visitor_theme == 'dark' ? 'is-on' }}" data-action="theme#setDark" aria-label="{{ 'themeDarkLabel'|trans }}">☾</button>
                    </span>
                    <twig:Cm:Button variant="outline" size="sm" href="{{ path('app_login') }}">{{ 'publicShellSignInAction'|trans }}</twig:Cm:Button>
                {% endif %}
            </div>
        {% endblock %}
    {% endembed %}
{% endblock %}

{# No footer on a teacher's page - the user's decision of 2026-10-03: neither the establishment's
   name nor the licence line. The source-code link (AGPL §13) stays on the course pages this page
   leads to, and in « À propos ». #}
{% block public_footer %}{% endblock %}

{% block public_main %}
    {% set page_url = path('app_public_courses_page', {handle: page.handle}) %}

    {% if isOwner and total == 0 %}
        <div class="cm-pub__notice">{{ 'onlineCoursePublicPageEmptyOwnerNotice'|trans }}</div>
    {% endif %}

    {% if page.introduction and not listed and not showPaths %}
        <div class="cm-pub-intro cm-pub-prose">{{ page.introduction|raw }}</div>
    {% endif %}

    <div class="cm-pub-toolbar">
        {% if learningPaths is not empty %}
            <span class="cm-filterbar__segmented">
                <a class="cm-filterbar__seg {{ not showPaths ? 'is-active' }}" href="{{ page_url }}">{{ 'onlineCoursePublicCoursesTab'|trans({'%count%': total}) }}</a>
                <a class="cm-filterbar__seg {{ showPaths ? 'is-active' }}" href="{{ path('app_public_courses_page', {handle: page.handle, tab: 'paths'}) }}">{{ 'onlineCoursePublicPathsTab'|trans({'%count%': learningPaths|length}) }}</a>
            </span>
        {% endif %}
        {% if not showPaths and total > 0 %}
            <form class="cm-pub-search" method="get" action="{{ page_url }}" role="search">
                <label class="visually-hidden" for="public-course-search">{{ 'onlineCoursePublicSearchLabel'|trans }}</label>
                <input type="search" id="public-course-search" name="q" value="{{ search }}" placeholder="{{ 'onlineCoursePublicSearchPlaceholder'|trans }}" autocomplete="off">
                <twig:Cm:Button variant="outline" size="sm" type="submit">{{ 'onlineCoursePublicSearchAction'|trans }}</twig:Cm:Button>
            </form>
        {% endif %}
    </div>

    {% if showPaths %}
        <div class="cm-pub-cards">
            {% for learningPath in learningPaths %}
                <a class="cm-pub-card" href="{{ path('app_learning_path_show', {id: learningPath.id}) }}">
                    <span class="cm-pub-card__band cm-pub-card__band--4">{{ 'learningPathCardBandLabel'|trans({'%count%': learningPath.steps|length}) }}</span>
                    <span class="cm-pub-card__body">
                        <span class="cm-pub-card__title">{{ learningPath.title }}</span>
                        <span class="cm-pub-card__summary">{{ learningPath.summary }}</span>
                    </span>
                </a>
            {% endfor %}
        </div>
    {% elseif total == 0 %}
        <p class="cm-pub-empty">{{ 'onlineCoursePublicNoCourseYetLabel'|trans }}</p>
    {% elseif listed %}
        {# A row's « Voir tout », or a search: every course that answers, on as many lines as it takes. #}
        <div class="cm-pub-section-head">
            <h2 class="cm-pub-section-head__title">
                {% if search != '' %}
                    {{ 'onlineCoursePublicSearchResultsHeading'|trans({'%search%': search}) }}
                {% elseif tagKeys is not empty %}
                    {{ listedTags is not empty ? listedTags|map(row => row.label)|join(' + ') : tagKeys|join(' + ') }}
                {% else %}
                    {{ 'onlineCoursePublicRecentRowTitle'|trans }}
                {% endif %}
                <span class="cm-pub-row__count">{{ courses|length }}</span>
            </h2>
            <a class="cm-pub-section-head__back" href="{{ page_url }}">
                <twig:ux:icon name="arrow-left" width="14" height="14"/>{{ 'onlineCoursePublicBackToRowsAction'|trans }}
            </a>
        </div>
        {% if courses is empty %}
            <p class="cm-pub-empty">{{ 'onlineCoursePublicNoMatchLabel'|trans }}</p>
        {% else %}
            <div class="cm-pub-cards">
                {% for course in courses %}
                    {{ include('online_course/public/_card.html.twig') }}
                {% endfor %}
            </div>
        {% endif %}
    {% else %}
        {{ include('online_course/public/_row.html.twig', {
            title: 'onlineCoursePublicRecentRowTitle'|trans,
            row_courses: all,
            more_url: path('app_public_courses_page', {handle: page.handle, view: 'recent'}),
        }) }}
        {% for row in rows %}
            {{ include('online_course/public/_row.html.twig', {
                title: row.label,
                row_courses: row.courses,
                more_url: path('app_public_courses_page', {handle: page.handle, tag: row.key}),
            }) }}
        {% endfor %}
    {% endif %}
{% endblock %}
