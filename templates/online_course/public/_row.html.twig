{# One row of a teacher's public page (design/validated/cours-en-ligne.md, §5): its name and how
   many courses it holds, « Voir tout » on the right, and the courses on **one** line - as many as
   that line holds. online_course_row_controller.js counts the columns, hides the cards that do not
   fit (out of the tab order too) and hands the last one shown the arrow to the row's own page,
   which appears when that card is hovered.

   Without JavaScript the line is cut by the grid itself (`grid-auto-rows: 0`), and « Voir tout »
   still leads to every course.

   Variables: title, row_courses, more_url. #}
<section class="cm-pub-row" data-controller="online-course-row">
    <div class="cm-pub-row__head">
        <h2 class="cm-pub-row__title">{{ title }} <span class="cm-pub-row__count">{{ row_courses|length }}</span></h2>
        <a class="cm-pub-row__all" href="{{ more_url }}">{{ 'onlineCoursePublicSeeAllAction'|trans }}</a>
    </div>
    <div class="cm-pub-cards cm-pub-row__track" data-online-course-row-target="track">
        {% for course in row_courses %}
            {{ include('online_course/public/_card.html.twig') }}
        {% endfor %}
    </div>
    <a class="cm-pub-row__next" href="{{ more_url }}" data-online-course-row-target="next" hidden
       aria-label="{{ 'onlineCoursePublicSeeAllInRowLabel'|trans({'%row%': title}) }}" title="{{ 'onlineCoursePublicSeeAllAction'|trans }}">
        <twig:ux:icon name="chevron-right" width="22" height="22"/>
    </a>
</section>
