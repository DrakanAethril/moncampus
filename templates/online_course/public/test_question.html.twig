{% extends 'layout/public.html.twig' %}

{# One question of a course's test, drawn by the very partials the passation uses
   (quiz/_question_take_body.html.twig) - twelve types, written once, as on a path's quiz. No verdict
   here: the correction comes at the end. #}

{% block public_title %}{{ 'onlineCourseTestLabel'|trans }} · {{ course.title }}{% endblock %}

{% block public_meta %}<meta name="robots" content="noindex">{% endblock %}

{% block public_home_url %}{{ path('app_public_courses_page', {handle: page.handle}) }}{% endblock %}
{% block public_home_label %}{{ page.title }}{% endblock %}

{% block public_main %}
    {{ include('online_course/public/_test_head.html.twig') }}

    <div class="cm-lp-question">
        <div class="cm-lp-question__head">
            <twig:Cm:Badge tone="blue">{{ question.type.shortLabelKey|trans }}</twig:Cm:Badge>
            <span>{{ 'learningPathQuestionOfLabel'|trans({'%number%': index + 1, '%total%': run.questionCount}) }}</span>
            <span class="cm-lp-bar"><span style="width: {{ (100 * index / run.questionCount)|round }}%"></span></span>
        </div>
        <form method="post" class="cm-lp-question__body"
              action="{{ path('app_public_courses_test_answer', {handle: page.handle, slug: course.slug}) }}"
              {{ include('quiz/_question_take_attributes.html.twig') }}>
            <input type="hidden" name="_token" value="{{ csrf_token('online_course_test') }}">
            <input type="hidden" name="index" value="{{ index }}">

            {{ include('quiz/_question_take_body.html.twig') }}

            <div class="cm-lp-question__foot">
                <twig:Cm:Button variant="primary" type="submit">
                    {{ (index + 1 == run.questionCount ? 'learningPathQuestionFinishAction' : 'learningPathQuestionNextAction')|trans }}
                </twig:Cm:Button>
            </div>
        </form>
    </div>
{% endblock %}
