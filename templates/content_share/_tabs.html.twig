{# The three tabs of Outils > Partages (design/validated/content-sharing-between-teachers.md,
   "Screens and routes"). « Reçus » carries its count; the others do not - a badge on « Mes
   partages » would only tell its author what they already know.

   `currentTab` is 'received', 'catalog' or 'mine'; `receivedCount` is optional. #}
{% set share_tabs = [
    {
        url: path('app_shares'),
        label: 'contentShareReceivedTabLabel'|trans ~ (receivedCount is defined and receivedCount > 0 ? ' (' ~ receivedCount ~ ')' : ''),
        active: currentTab == 'received',
    },
    {
        url: path('app_shares_catalog'),
        label: 'contentShareCatalogTabLabel'|trans,
        active: currentTab == 'catalog',
    },
    {
        url: path('app_shares_mine'),
        label: 'contentShareMineTabLabel'|trans,
        active: currentTab == 'mine',
    },
] %}
{% include '_tabs.html.twig' with {tabs: share_tabs} %}
