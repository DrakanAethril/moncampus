<!DOCTYPE html>
{# Authenticated users' choice (App\Entity\User::$themePreference) is the source of truth once
   logged in; anonymous visitors (e.g. the login page, or a visitor whose contact-email
   confirmation link redirected them there because the token was already expired/consumed - see
   App\Controller\PublicContactEmailController - possibly while genuinely logged out in that
   browser) only have the cookie theme_controller.js sets. Deliberately no hardcoded fallback
   theme when neither exists: an unset data-bs-theme falls through to Tabler's own light baseline
   ([data-bs-theme="dark"] is what triggers its dark overrides), rather than presuming a
   preference we don't actually have - a previously-chosen theme must never be silently
   overridden just because this one request happens to be unauthenticated. #}
<html lang="{{ app.request.locale }}" data-bs-theme="{{ app.user ? app.user.themePreference : app.request.cookies.get('theme') }}">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
        <title>{% block title %}Institution Beaupeyrat{% endblock %}</title>
        {# assetBaseUrl (unset for every normal page request) is set to the internal-network vhost
           "http://php" only by the Livret Alternant PDF-export flow (App\Service\InternshipBookletPdfExporter),
           since Gotenberg renders a standalone HTML string with no browser origin and these
           asset() URLs are otherwise root-relative. #}
        <link rel="icon" href="{{ assetBaseUrl|default('') }}{{ asset('images/favicon-32x32.png') }}" sizes="32x32">
        <link rel="apple-touch-icon" href="{{ assetBaseUrl|default('') }}{{ asset('images/apple-touch-icon.png') }}">

        {% block stylesheets %}
            {# Source Sans 3 / Spectral are self-hosted (assets/styles/fonts.css, imported by
               assets/app.js) rather than pulled from fonts.googleapis.com, which used to need two
               preconnects and a render-blocking third-party stylesheet here before the first paint.
               These two preloads replace what the removed <link> gave for free: @font-face lives in
               a stylesheet the browser only parses after fetching it, so without them the two fonts
               actually used above the fold are discovered one round-trip late and every heading and
               label flashes in the fallback face first (font-display: swap). Deliberately only two
               of the six vendored files - the `latin` subsets, which cover French and English; a
               preload the page never uses costs bandwidth and earns a console warning, so latin-ext
               and Spectral 700 stay lazily discovered. crossorigin is required even same-origin:
               fonts are always fetched in CORS mode, and a preload whose mode doesn't match the
               real request is silently downloaded twice. #}
            <link rel="preload" as="font" type="font/woff2" crossorigin href="{{ assetBaseUrl|default('') }}{{ asset('fonts/source-sans-3-latin.woff2') }}">
            <link rel="preload" as="font" type="font/woff2" crossorigin href="{{ assetBaseUrl|default('') }}{{ asset('fonts/spectral-600-latin.woff2') }}">
            <link rel="stylesheet" href="{{ assetBaseUrl|default('') }}{{ asset('tabler/css/tabler.min.css') }}">
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
            <script src="{{ assetBaseUrl|default('') }}{{ asset('tabler/js/tabler.min.js') }}" defer></script>
        {% endblock %}

        {% if matomo_url and matomo_site_id %}
            {# requireConsent blocks every request the tracker would otherwise send until a visitor
               accepts the banner below (see assets/controllers/matomo_consent_controller.js), which
               calls _paq.push(['setConsentGiven']) - true opt-in, not just cookie-less tracking. #}
            <script>
                var _paq = window._paq = window._paq || [];
                _paq.push(['requireConsent']);
                _paq.push(['trackPageView']);
                _paq.push(['enableLinkTracking']);
                (function() {
                    var u = "{{ matomo_url }}/";
                    _paq.push(['setTrackerUrl', u + 'matomo.php']);
                    _paq.push(['setSiteId', '{{ matomo_site_id }}']);
                    var d = document, g = d.createElement('script'), s = d.getElementsByTagName('script')[0];
                    g.async = true; g.src = u + 'matomo.js'; s.parentNode.insertBefore(g, s);
                })();
            </script>
        {% endif %}

        {% set frankenphpHotReload = app.request.server.get('FRANKENPHP_HOT_RELOAD') %}
        {% if frankenphpHotReload %}
        <meta name="frankenphp-hot-reload:url" content="{{ frankenphpHotReload }}">
        <script src="https://cdn.jsdelivr.net/npm/idiomorph"></script>
        <script src="https://cdn.jsdelivr.net/npm/frankenphp-hot-reload/+esm" type="module"></script>
        {% endif %}
    </head>
    <body>
        {# The deployment banner sits above everything, on every page, logged in or not: somebody on
           the login screen while a deploy runs is exactly the person about to type a password into
           a platform that is going to stop answering. It lives here rather than in the app shell so
           there is one copy of it and the login screen is not a special case.

           The controller sits on the wrapper and not on the banner, because it has to go on
           watching a page that currently has no banner at all - which is every page, most of the
           time. The wrapper is what it fills and empties. #}
        <div data-controller="deployment-notice"
             data-deployment-notice-url-value="{{ path('app_deployment_notice_status') }}">{{ deployment_notice_html()|raw }}</div>

        {% block body %}{% endblock %}

        {% if matomo_url and matomo_site_id %}
            <div class="alert alert-important position-fixed bottom-0 start-50 translate-middle-x mb-3" style="z-index: 1050; max-width: 640px;" role="alert" data-controller="matomo-consent" hidden>
                <div class="d-flex align-items-center flex-wrap gap-2">
                    <div class="flex-fill">{{ 'matomoConsentMessage'|trans }}</div>
                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-sm btn-outline-secondary" data-action="matomo-consent#decline">{{ 'matomoConsentDeclineAction'|trans }}</button>
                        <button type="button" class="btn btn-sm btn-primary" data-action="matomo-consent#accept">{{ 'matomoConsentAcceptAction'|trans }}</button>
                    </div>
                </div>
            </div>
        {% endif %}
    </body>
</html>
