{# Standalone print document (no base.html.twig): the A4 poster of a course, rendered by
   App\Controller\EcoCourseController::joinPdf() and converted by Gotenberg. Same page shape as a
   flag's page (eco/_checkpoint_pdf_page.html.twig), so the two read as one set. #}
<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="utf-8">
<title>{{ course.name }}</title>
<style>
    @page { size: A4; margin: 0; }
    body { margin: 0; font-family: 'Source Sans 3', Arial, sans-serif; color: #12344d; }
    * { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
    .eco-pdf-page {
        box-sizing: border-box;
        width: 210mm;
        height: 297mm;
        padding: 20mm 20mm 16mm;
        display: flex;
        flex-direction: column;
        align-items: center;
    }
    .eco-pdf-eyebrow { font-weight: 700; font-size: 12pt; color: #8a99a6; letter-spacing: 3pt; text-transform: uppercase; text-align: center; }
    .eco-pdf-name { font-weight: 700; font-size: 32pt; margin: 6mm 0 2mm; text-align: center; }
    .eco-pdf-lead { font-size: 15pt; color: #5b6c79; text-align: center; }
    .eco-pdf-qr { flex: 1; display: flex; align-items: center; justify-content: center; width: 100%; }
    .eco-pdf-qr svg { width: 120mm; height: 120mm; }
    .eco-pdf-code-label { font-size: 11pt; font-weight: 700; color: #8a99a6; letter-spacing: 2pt; text-transform: uppercase; }
    .eco-pdf-code { font-family: ui-monospace, monospace; font-weight: 700; font-size: 40pt; letter-spacing: 10pt; background: #f2f5f8; border-radius: 4mm; margin: 2mm 0 6mm; padding: 2mm 8mm 2mm calc(8mm + 10pt); }
    .eco-pdf-steps { margin: 0 0 6mm; padding: 0; list-style: none; font-size: 12.5pt; color: #3d5263; text-align: center; line-height: 1.6; }
    .eco-pdf-url { font-family: ui-monospace, monospace; font-size: 9.5pt; color: #8a99a6; word-break: break-all; text-align: center; }
</style>
</head>
<body>
<div class="eco-pdf-page">
    <div class="eco-pdf-eyebrow">E-CO · {{ course.parcours.name|upper }}</div>
    <div class="eco-pdf-name">{{ course.name }}</div>
    <div class="eco-pdf-lead">{{ 'ecoCourseJoinPdfLeadText'|trans }}</div>
    <div class="eco-pdf-qr">{{ qrSvg|raw }}</div>
    <div class="eco-pdf-code-label">{{ 'ecoCourseJoinPdfCodeLabel'|trans }}</div>
    <div class="eco-pdf-code">{{ course.code }}</div>
    <ol class="eco-pdf-steps">
        <li>{{ 'ecoCourseJoinPdfStepScanText'|trans }}</li>
        <li>{{ 'ecoCourseJoinPdfStepPseudoText'|trans }}</li>
        <li>{{ 'ecoCourseJoinPdfStepJoinText'|trans }}</li>
    </ol>
    <div class="eco-pdf-url">{{ joinUrl }}</div>
</div>
</body>
</html>
