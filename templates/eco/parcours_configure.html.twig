{% extends 'layout/app.html.twig' %}

{% block title %}{{ parcours.name }}{% endblock %}

{% block page_breadcrumb %}
    {{ component('Cm:Breadcrumb', {segments: [
        {label: 'ecoParcoursListPageHeading'|trans, url: path('app_eco_parcours')},
        {label: parcours.name, url: app.request.requestUri},
    ]}) }}
{% endblock %}
{% block page_title %}
    {{ parcours.name }}
    <span class="badge {{ parcours.status.badgeClass }} ms-2">{{ parcours.status.labelKey|trans }} — {{ parcours.locatedCheckpointCount }}/{{ parcours.checkpoints|length }}</span>
{% endblock %}
{% block page_actions %}
    {% if parcours.checkpoints|length > 0 %}
        <a href="{{ path('app_eco_parcours_pdf', {id: parcours.id}) }}" class="btn btn-outline-primary">{{ 'ecoParcoursExportPdfButtonLabel'|trans({'%count%': parcours.checkpoints|length}) }}</a>
    {% endif %}
    {% if parcours.ready %}
        <a href="{{ path('app_eco_course_index', {parcoursId: parcours.id}) }}" class="btn btn-primary ms-2">{{ 'ecoParcoursCoursesButtonLabel'|trans }}</a>
    {% endif %}
{% endblock %}

{% block main %}
    <div class="row g-4 align-items-start">
        <div class="col-12 col-lg-7">
            <div class="card">
                <div class="table-responsive">
                    <table class="table table-vcenter card-table">
                        <thead>
                            <tr>
                                <th>{{ 'ecoCheckpointNumberColumnLabel'|trans }}</th>
                                <th>{{ 'ecoCheckpointNameColumnLabel'|trans }}</th>
                                <th>{{ 'ecoCheckpointShortCodeColumnLabel'|trans }}</th>
                                <th>{{ 'ecoCheckpointToleranceColumnLabel'|trans }}</th>
                                <th>{{ 'ecoCheckpointLocationColumnLabel'|trans }}</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for checkpoint in parcours.checkpoints %}
                                <tr>
                                    <td><span class="font-monospace fw-bold">{{ checkpoint.type.shortLetter ?? checkpoint.position }}</span></td>
                                    <td>
                                        {{ checkpoint.name }}
                                        {% if checkpoint.note %}<span class="text-secondary">({{ checkpoint.note }})</span>{% endif %}
                                    </td>
                                    <td><span class="font-monospace">{{ checkpoint.shortCode }}</span></td>
                                    <td>
                                        {% set isOverridden = checkpoint.toleranceMeters != constant('App\\Entity\\EcoCheckpoint::DEFAULT_TOLERANCE_METERS') %}
                                        <div class="input-group input-group-flat" style="max-width: 110px;">
                                            <input type="number" min="1" id="eco-tolerance-{{ checkpoint.id }}" name="tolerance[{{ checkpoint.id }}]" form="eco-parcours-configure-form" value="{{ checkpoint.toleranceMeters }}" class="form-control"{% if isOverridden %} style="border-color: var(--tblr-yellow); background: var(--tblr-yellow-lt);"{% endif %}>
                                            <span class="input-group-text">m</span>
                                        </div>
                                        {# The canopy over this flag calls for a wider radius than it has (EcoToleranceAdvisor):
                                           one click fills the field, the teacher still saves. #}
                                        {% if toleranceAdvice[checkpoint.id] is defined %}
                                            <button type="button" class="eco-tolerance-advice"
                                                    data-controller="eco-tolerance-advice"
                                                    data-action="eco-tolerance-advice#apply"
                                                    data-eco-tolerance-advice-input-param="eco-tolerance-{{ checkpoint.id }}"
                                                    data-eco-tolerance-advice-meters-param="{{ toleranceAdvice[checkpoint.id] }}"
                                                    title="{{ 'ecoToleranceAdviceHintText'|trans({'%height%': checkpoint.canopyHeight|round}) }}">
                                                {{- 'ecoToleranceAdviceLabel'|trans({'%meters%': toleranceAdvice[checkpoint.id]}) -}}
                                            </button>
                                        {% endif %}
                                    </td>
                                    <td>
                                        {% if checkpoint.located %}
                                            <span class="text-success">● {{ checkpoint.latitude }}, {{ checkpoint.longitude }} · {{ checkpoint.locatedAt|date('d/m') }}</span>
                                        {% else %}
                                            <span class="text-warning">● {{ 'ecoCheckpointNotLocatedLabel'|trans }}</span>
                                        {% endif %}
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
                <div class="card-footer text-secondary" style="font-size: 12.5px;">
                    {{ 'ecoCheckpointDefaultToleranceNoteText'|trans({'%default%': constant('App\\Entity\\EcoCheckpoint::DEFAULT_TOLERANCE_METERS')}) }}
                </div>
            </div>
        </div>
        <div class="col-12 col-lg-5 d-flex flex-column gap-3">
            {# The parcours map (screen 1e): only checkpoints already scanned on the ground have
               coordinates, hence a marker; the others are counted in the legend. #}
            <div class="card">
                {% if mapCheckpoints is not empty %}
                    <div class="eco-map"
                         data-controller="eco-checkpoint-map"
                         data-eco-checkpoint-map-checkpoints-value="{{ mapCheckpoints|json_encode }}"
                         data-eco-checkpoint-map-expand-label-value="{{ 'ecoResultsMapExpandLabel'|trans }}"
                         data-eco-checkpoint-map-collapse-label-value="{{ 'ecoResultsMapCollapseLabel'|trans }}"
                         {{ include('eco/_map_layers_attribute.html.twig') }}></div>
                {% else %}
                    <div class="card-body text-secondary">{{ 'ecoCheckpointMapEmptyText'|trans }}</div>
                {% endif %}
                <div class="card-footer eco-map__legend">
                    <span class="eco-map__legend-item"><span class="eco-map__legend-swatch eco-map__legend-swatch--located"></span>{{ 'ecoCheckpointMapLocatedLegendLabel'|trans }}</span>
                    {% set toLocate = parcours.checkpoints|length - parcours.locatedCheckpointCount %}
                    {% if toLocate > 0 %}
                        <span class="eco-map__legend-item"><span class="eco-map__legend-swatch eco-map__legend-swatch--tolocate"></span>{{ 'ecoCheckpointMapToLocateLegendLabel'|trans({'%count%': toLocate}) }}</span>
                    {% endif %}
                    <span class="ms-auto">{{ 'ecoMapAttributionText'|trans }}</span>
                </div>
            </div>
            <div class="cm-note">
                <span class="cm-note__icon">📍</span>
                <div>{{ 'ecoCheckpointLocationNoteText'|trans }}</div>
            </div>
            {# Its own form, outside the save bar's: sharing is saved on its own button. #}
            <div class="card" id="eco-share">
                <div class="card-body d-flex flex-column gap-2">
                    <twig:Cm:Subhead :title="'ecoParcoursShareTitle'|trans" :hint="'ecoParcoursShareHintText'|trans"/>
                    <div class="text-secondary" style="font-size: 12.5px;">
                        {{ 'ecoParcoursCreatedByLabel'|trans({'%name%': parcours.teacher.displayName ?? parcours.teacher.username}) }}
                    </div>
                    <form method="post" action="{{ path('app_eco_parcours_share', {id: parcours.id}) }}" class="d-flex flex-column gap-2">
                        <input type="hidden" name="_token" value="{{ csrf_token('eco_parcours_share') }}">
                        <label class="form-label mb-0" for="eco-share-users">{{ 'ecoParcoursShareFieldLabel'|trans }}</label>
                        {# Picking Users always goes through tomselect + ajax; the endpoint offers only
                           teachers who run e-CO, and the save re-checks every id. #}
                        <select id="eco-share-users" name="sharedWith[]" multiple
                                data-controller="tom-select"
                                data-tom-select-url-value="{{ path('app_eco_parcours_share_candidates', {parcours: parcours.id}) }}"
                                data-tom-select-placeholder-value="{{ 'ecoParcoursSharePlaceholder'|trans }}">
                            {% for user in parcours.sharedWith %}
                                <option value="{{ user.id }}" selected>{{ user.displayName ?? user.username }}</option>
                            {% endfor %}
                        </select>
                        <div class="text-end">
                            <twig:Cm:Button type="submit" variant="outline">{{ 'ecoParcoursShareSubmitLabel'|trans }}</twig:Cm:Button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
    <form id="eco-parcours-configure-form" method="post">
        <input type="hidden" name="_token" value="{{ csrf_token('eco_parcours_configure') }}">
        <twig:Cm:ActionBar :lastModified="parcours" class="mt-3">
            <a href="{{ path('app_eco_parcours') }}" class="btn btn-link">{{ 'cancelAction'|trans }}</a>
            <button type="submit" class="btn btn-primary">{{ 'submitSaveAction'|trans }}</button>
        </twig:Cm:ActionBar>
    </form>

    {# After the save bar, not inside its form: the analysis has a form of its own. #}
    {{ include('eco/_parcours_terrain.html.twig') }}
{% endblock %}
