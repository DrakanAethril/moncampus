{% extends 'layout/app.html.twig' %}

{% block title %}{{ 'ecoCourseResultsPageHeadingTemplate'|trans({'%name%': course.name}) }}{% endblock %}

{% block page_breadcrumb %}
    {% include '_breadcrumb.html.twig' with {segments: [
        {label: 'ecoParcoursListPageHeading'|trans, url: path('app_eco_parcours')},
        {label: course.parcours.name, url: path('app_eco_parcours_configure', {id: course.parcours.id})},
        {label: 'ecoCourseIndexBreadcrumbLabel'|trans, url: path('app_eco_course_index', {parcoursId: course.parcours.id})},
        {label: 'ecoCourseResultsBreadcrumbLabel'|trans, url: app.request.requestUri},
    ]} %}
{% endblock %}
{% block page_title %}{{ 'ecoCourseResultsPageHeadingTemplate'|trans({'%name%': course.name}) }}{% endblock %}
{% block page_actions %}
    {% if selectedRunner %}
        <a href="{{ path('app_eco_course_results_csv', {courseId: course.id, runnerId: selectedRunner.id}) }}" class="btn btn-outline-primary">{{ 'ecoResultsExportCsvButtonLabel'|trans }}</a>
    {% endif %}
{% endblock %}

{% block main %}
    <form method="get" class="mb-3" style="max-width: 320px;">
        <select name="runner" class="form-select" onchange="this.form.submit()">
            {% for runner in runners %}
                <option value="{{ runner.id }}" {{ selectedRunner and selectedRunner.id == runner.id ? 'selected' }}>{{ runner.pseudo }}</option>
            {% else %}
                <option>{{ 'ecoCourseNoneYetText'|trans }}</option>
            {% endfor %}
        </select>
    </form>

    {% if selectedRunner and stats %}
        <div class="row row-cards mb-3">
            <div class="col-6 col-lg">
                <div class="card card-body">
                    <div class="text-secondary text-uppercase" style="font-size: 11.5px;">{{ 'ecoResultsDurationLabel'|trans }}</div>
                    <div class="h2 mb-0">{{ stats.durationSeconds is not null ? (stats.durationSeconds // 60) ~ ':' ~ ('%02d'|format(stats.durationSeconds % 60)) : '—' }}</div>
                </div>
            </div>
            <div class="col-6 col-lg">
                <div class="card card-body">
                    <div class="text-secondary text-uppercase" style="font-size: 11.5px;">{{ 'ecoResultsDistanceLabel'|trans }}</div>
                    <div class="h2 mb-0">{{ (stats.distanceMeters / 1000)|number_format(1, ',') }} km</div>
                </div>
            </div>
            <div class="col-6 col-lg">
                <div class="card card-body">
                    <div class="text-secondary text-uppercase" style="font-size: 11.5px;">{{ 'ecoResultsAverageSpeedLabel'|trans }}</div>
                    <div class="h2 mb-0">{{ stats.averageSpeedKmh is not null ? stats.averageSpeedKmh|number_format(1, ',') ~ ' km/h' : '—' }}</div>
                </div>
            </div>
            <div class="col-6 col-lg">
                <div class="card card-body">
                    <div class="text-secondary text-uppercase" style="font-size: 11.5px;">{{ 'ecoResultsCheckpointsLabel'|trans }}</div>
                    <div class="h2 mb-0 text-success">{{ stats.checkpointsValidated }}/{{ stats.checkpointsTotal }} <span class="fs-4 text-secondary">· {{ 'ecoResultsFailuresSuffixLabel'|trans({'%count%': stats.scanFailureCount}) }}</span></div>
                </div>
            </div>
            <div class="col-6 col-lg">
                <div class="card card-body">
                    <div class="text-secondary text-uppercase" style="font-size: 11.5px;">{{ 'ecoResultsElevationLabel'|trans }}</div>
                    <div class="h2 mb-0">
                        {%- if stats.elevation %}+{{ stats.elevation.gain|round }} m <span class="fs-4 text-secondary">/ −{{ stats.elevation.loss|round }} m</span>{% else %}—{% endif -%}
                    </div>
                </div>
            </div>
            <div class="col-6 col-lg">
                <div class="card card-body">
                    <div class="text-secondary text-uppercase" style="font-size: 11.5px;">{{ 'ecoResultsStopsLabel'|trans }}</div>
                    <div class="h2 mb-0">{{ analysis.stops|length }} <span class="fs-4 text-secondary">· {{ (analysis.stopSecondsTotal // 60) }} min</span></div>
                </div>
            </div>
            <div class="col-6 col-lg">
                <div class="card card-body">
                    <div class="text-secondary text-uppercase" style="font-size: 11.5px;">{{ 'ecoResultsAppExitsLabel'|trans }}</div>
                    <div class="h2 mb-0 {{ stats.appEvents|length > 0 ? 'text-warning' }}">{{ stats.appEvents|length }}</div>
                </div>
            </div>
        </div>

        {% if map %}
            <div class="card mb-3">
                <div class="card-header">
                    <h3 class="card-title">{{ 'ecoResultsMapHeading'|trans }}</h3>
                    <form method="get" class="ms-auto d-flex align-items-center gap-2">
                        <input type="hidden" name="runner" value="{{ selectedRunner.id }}">
                        <label class="text-secondary" style="font-size: 12px;" for="eco-compare">{{ 'ecoResultsCompareLabel'|trans }}</label>
                        <select id="eco-compare" name="compare" class="form-select form-select-sm" style="width: auto;" onchange="this.form.submit()">
                            <option value="">{{ 'ecoResultsCompareNoneLabel'|trans }}</option>
                            {% for runner in runners|filter(candidate => candidate.id != selectedRunner.id) %}
                                <option value="{{ runner.id }}" {{ comparedRunner and comparedRunner.id == runner.id ? 'selected' }}>{{ runner.pseudo }}</option>
                            {% endfor %}
                        </select>
                    </form>
                </div>
                <div class="eco-map"
                     data-controller="eco-result-map"
                     data-eco-result-map-trace-value="{{ map.trace|json_encode }}"
                     data-eco-result-map-checkpoints-value="{{ map.checkpoints|json_encode }}"
                     data-eco-result-map-stops-value="{{ map.stops|json_encode }}"
                     data-eco-result-map-refused-scans-value="{{ map.refusedScans|json_encode }}"
                     data-eco-result-map-legs-value="{{ map.legs|json_encode }}"
                     {# Twig's own empty hash encodes to "[]", which a Stimulus Object value rejects
                        outright - and a rejected value aborts connect(), leaving a blank map. #}
                     data-eco-result-map-compared-value="{{ map.compared ? map.compared|json_encode : '{}' }}"
                     data-eco-result-map-expand-label-value="{{ 'ecoResultsMapExpandLabel'|trans }}"
                     data-eco-result-map-collapse-label-value="{{ 'ecoResultsMapCollapseLabel'|trans }}"></div>
                <div class="card-footer eco-map__legend">
                    <span class="eco-map__legend-item"><span class="eco-map__legend-swatch eco-map__legend-swatch--trace"></span>{{ 'ecoResultsMapLegendTraceLabel'|trans }}</span>
                    {% if map.compared %}
                        <span class="eco-map__legend-item"><span class="eco-map__legend-swatch eco-map__legend-swatch--compared"></span>{{ map.compared.pseudo }}</span>
                    {% endif %}
                    {% if map.legs|filter(leg => leg.kind is not null)|length > 0 %}
                        <span class="eco-map__legend-item"><span class="eco-map__legend-swatch eco-map__legend-swatch--worst"></span>{{ 'ecoResultsMapWorstDetourLabel'|trans }}</span>
                        <span class="eco-map__legend-item"><span class="eco-map__legend-swatch eco-map__legend-swatch--best"></span>{{ 'ecoResultsMapBestDetourLabel'|trans }}</span>
                    {% endif %}
                    <span class="eco-map__legend-item"><span class="eco-map__legend-swatch eco-map__legend-swatch--stop"></span>{{ 'ecoResultsMapLegendStopLabel'|trans }}</span>
                    {% if map.refusedScans is not empty %}
                        <span class="eco-map__legend-item"><span class="eco-map__legend-swatch eco-map__legend-swatch--refused"></span>{{ 'ecoResultsMapLegendRefusedLabel'|trans }}</span>
                    {% endif %}
                    <span class="ms-auto">{{ 'ecoResultsMapNoteText'|trans }}</span>
                </div>
            </div>
        {% endif %}

        {% if analysis.legs is not empty %}
            <div class="card mb-3">
                <div class="card-header">
                    <h3 class="card-title">{{ 'ecoResultsLegsHeading'|trans }}</h3>
                    <span class="ms-auto text-secondary" style="font-size: 12px;">{{ 'ecoResultsLegsNoteText'|trans }}</span>
                </div>
                <div class="table-responsive">
                    <table class="table table-vcenter card-table">
                        <thead>
                            <tr>
                                <th>{{ 'ecoResultsLegColumnLabel'|trans }}</th>
                                <th>{{ 'ecoResultsLegTimeColumnLabel'|trans }}</th>
                                <th>{{ 'ecoResultsLegGapColumnLabel'|trans }}</th>
                                <th>{{ 'ecoResultsLegDistanceColumnLabel'|trans }}</th>
                                <th>{{ 'ecoResultsLegDetourColumnLabel'|trans }}</th>
                                <th>{{ 'ecoResultsLegSearchColumnLabel'|trans }}</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for leg in analysis.legs %}
                                <tr>
                                    <td class="fw-bold">{{ leg.fromName }} → {{ leg.toName }}</td>
                                    <td>{{ (leg.seconds // 60) }}:{{ '%02d'|format(leg.seconds % 60) }}</td>
                                    <td>
                                        {%- if leg.isBest %}
                                            <span class="text-success fw-bold">{{ 'ecoResultsLegBestLabel'|trans }}</span>
                                        {%- elseif leg.gapSeconds is not null %}
                                            <span class="{{ leg.gapSeconds > 60 ? 'text-danger' : 'text-secondary' }}">+{{ (leg.gapSeconds // 60) }}:{{ '%02d'|format(leg.gapSeconds % 60) }}</span>
                                        {%- else %}
                                            <span class="text-secondary">—</span>
                                        {%- endif -%}
                                    </td>
                                    <td class="text-secondary">{{ leg.travelledMeters|round }} m</td>
                                    <td>
                                        {%- if leg.detourRatio is not null -%}
                                            {# Above 1,5 the runner covered half as much ground again as the straight line: a real navigation error, not a bend in the path. #}
                                            <span class="{{ leg.detourRatio >= 1.5 ? 'text-danger fw-bold' : (leg.detourRatio >= 1.25 ? 'text-warning' : 'text-secondary') }}">×{{ leg.detourRatio|number_format(2, ',') }}</span>
                                        {%- else %}<span class="text-secondary">—</span>{% endif -%}
                                    </td>
                                    <td>
                                        {%- if leg.searchSeconds %}
                                            <span class="{{ leg.searchSeconds >= 60 ? 'text-warning' : 'text-secondary' }}">{{ leg.searchSeconds }} s</span>
                                        {%- else %}<span class="text-secondary">—</span>{% endif -%}
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        {% endif %}

        <div class="card">
            <div class="table-responsive">
                <table class="table table-vcenter card-table">
                    <thead>
                        <tr>
                            <th>{{ 'ecoResultsCheckpointColumnLabel'|trans }}</th>
                            <th>{{ 'ecoResultsTimeColumnLabel'|trans }}</th>
                            <th>{{ 'ecoResultsGapColumnLabel'|trans }}</th>
                            <th>{{ 'ecoResultsOutcomeColumnLabel'|trans }}</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for scan in selectedRunner.scans %}
                            <tr>
                                <td class="fw-bold">{{ scan.checkpoint.name }}</td>
                                <td class="text-secondary">{{ scan.scannedAt ? scan.scannedAt|date('H:i:s') : '—' }}</td>
                                <td class="{{ scan.result.value == 'out_of_range' ? 'text-danger fw-bold' }}">{{ scan.distanceMeters is not null ? scan.distanceMeters|round ~ ' m' : '—' }}</td>
                                <td>
                                    {% if scan.result.value == 'success' %}
                                        <span class="text-success fw-bold">✓ {{ (scan.method.value == 'manual_code' ? 'ecoResultsOutcomeManualCodeLabel' : (scan.attemptSequence > 1 ? 'ecoResultsOutcomeSuccessRetryLabel' : 'ecoResultsOutcomeSuccessLabel'))|trans({'%attempt%': scan.attemptSequence}) }}</span>
                                    {% elseif scan.result.value == 'out_of_order' %}
                                        <span class="text-danger fw-bold">✕ {{ 'ecoScanResultOutOfOrderLabel'|trans }}</span>
                                    {% else %}
                                        <span class="text-danger fw-bold">✕ {{ 'ecoResultsOutcomeOutOfRangeLabel'|trans }}</span>
                                    {% endif %}
                                </td>
                            </tr>
                        {% else %}
                            <tr><td colspan="4" class="text-secondary">{{ 'ecoResultsNoScansText'|trans }}</td></tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
            <div class="card-footer text-secondary" style="font-size: 12.5px;">{{ 'ecoResultsNoteText'|trans }}</div>
        </div>
    {% else %}
        <div class="text-secondary">{{ 'ecoCourseNoneYetText'|trans }}</div>
    {% endif %}
{% endblock %}
