{% extends 'layout/app.html.twig' %}

{# Outils > École Directe (App\Controller\EcoleDirecte\EcoleDirecteController and
   EcoleDirecteSendController), administrators only for now. Sign in to one's own École Directe
   account, read it, send one's cahier de texte and an evaluation's grades there. Every call to École
   Directe is a button: nothing reads or writes on its own, and every send is previewed first.
   Nothing typed on this page is kept by the platform - the sealed connection lives in the Stimulus
   controller's memory, and closing the tab forgets it. #}

{% block title %}{{ 'ecoleDirecteHeading'|trans }}{% endblock %}

{% block page_breadcrumb %}
    {{ component('Cm:Breadcrumb', {segments: [
        {label: 'toolsNavLabel'|trans, url: path('app_ecole_directe')},
        {label: 'ecoleDirecteHeading'|trans, url: path('app_ecole_directe')},
    ]}) }}
{% endblock %}
{% block page_title %}{{ 'ecoleDirecteHeading'|trans }}{% endblock %}

{% block main %}
    {% set monday = 'monday this week'|date('Y-m-d') %}
    <div data-controller="ecole-directe"
         data-ecole-directe-token-value="{{ csrf_token(csrfId) }}"
         data-ecole-directe-login-url-value="{{ path('app_ecole_directe_login') }}"
         data-ecole-directe-challenge-url-value="{{ path('app_ecole_directe_challenge') }}"
         data-ecole-directe-lesson-log-url-value="{{ path('app_ecole_directe_lesson_log') }}"
         data-ecole-directe-explore-url-value="{{ path('app_ecole_directe_explore') }}"
         data-ecole-directe-lesson-log-preview-url-value="{{ path('app_ecole_directe_lesson_log_preview') }}"
         data-ecole-directe-lesson-log-send-url-value="{{ path('app_ecole_directe_lesson_log_send') }}"
         data-ecole-directe-gradebook-targets-url-value="{{ path('app_ecole_directe_gradebook_targets') }}"
         data-ecole-directe-gradebook-preview-url-value="{{ path('app_ecole_directe_gradebook_preview') }}"
         data-ecole-directe-gradebook-send-url-value="{{ path('app_ecole_directe_gradebook_send') }}"
         data-ecole-directe-gradebook-link-url-value="{{ path('app_ecole_directe_gradebook_link') }}"
         data-ecole-directe-gradebook-unlink-url-value="{{ path('app_ecole_directe_gradebook_unlink') }}"
         data-ecole-directe-unreachable-message-value="{{ 'ecoleDirecteUnreachableMessage'|trans }}">

        <div class="alert alert-info">{{ 'ecoleDirectePrototypeNotice'|trans }}</div>
        <div class="alert alert-danger" role="alert" data-ecole-directe-target="error" hidden></div>

        {# Sign-in. The autocomplete hints let the teacher's own browser remember the password -
           on their device, which is not the platform keeping it. #}
        <div class="card mb-3" data-ecole-directe-target="loginPanel">
            <div class="card-body">
                <twig:Cm:Subhead :title="'ecoleDirecteLoginTitle'|trans" :hint="'ecoleDirecteLoginHint'|trans" class="mb-3"/>
                <form data-action="submit->ecole-directe#login" autocomplete="on" style="max-width: 26rem">
                    <div class="mb-3">
                        <label class="form-label" for="ecole-directe-identifiant">{{ 'ecoleDirecteIdentifiantLabel'|trans }}</label>
                        <input type="text" class="form-control" id="ecole-directe-identifiant" name="username" autocomplete="username" required data-ecole-directe-target="identifiant">
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="ecole-directe-password">{{ 'ecoleDirectePasswordLabel'|trans }}</label>
                        <input type="password" class="form-control" id="ecole-directe-password" name="password" autocomplete="current-password" required data-ecole-directe-target="password">
                    </div>
                    <twig:Cm:Button variant="primary" type="submit" data-ecole-directe-target="loginButton">{{ 'ecoleDirecteLoginAction'|trans }}</twig:Cm:Button>
                </form>
            </div>
        </div>

        {# École Directe's identity question, asked of a device it does not know. #}
        <div class="card mb-3" data-ecole-directe-target="challengePanel" hidden>
            <div class="card-body">
                <twig:Cm:Subhead :title="'ecoleDirecteChallengeTitle'|trans" :hint="'ecoleDirecteChallengeHint'|trans" class="mb-3"/>
                <form data-action="submit->ecole-directe#answer">
                    <p class="fw-medium" data-ecole-directe-target="question"></p>
                    <div class="mb-3" data-ecole-directe-target="choices"></div>
                    <twig:Cm:Button variant="primary" type="submit" data-ecole-directe-target="answerButton">{{ 'ecoleDirecteChallengeAction'|trans }}</twig:Cm:Button>
                </form>
            </div>
        </div>

        <div data-ecole-directe-target="connectedPanel" hidden>
            <div class="card mb-3">
                <div class="card-body">
                    <twig:Cm:Subhead :title="'ecoleDirecteAccountTitle'|trans" class="mb-3">
                        <twig:block name="action">
                            <twig:Cm:Button variant="outline" size="sm" data-action="ecole-directe#forget">{{ 'ecoleDirecteForgetAction'|trans }}</twig:Cm:Button>
                        </twig:block>
                    </twig:Cm:Subhead>
                    <div data-ecole-directe-target="account"></div>
                </div>
            </div>

            <div data-ecole-directe-target="teacherPanels">
            <div class="card mb-3">
                <div class="card-body">
                    <twig:Cm:Subhead :title="'ecoleDirecteLessonLogTitle'|trans" :hint="'ecoleDirecteLessonLogHint'|trans" class="mb-3"/>
                    <form class="d-flex flex-wrap align-items-end gap-2 mb-3" data-action="submit->ecole-directe#readLessonLog">
                        <div>
                            <label class="form-label" for="ecole-directe-from">{{ 'ecoleDirecteFromLabel'|trans }}</label>
                            <input type="date" class="form-control" id="ecole-directe-from" value="{{ monday }}" required data-ecole-directe-target="from">
                        </div>
                        <div>
                            <label class="form-label" for="ecole-directe-to">{{ 'ecoleDirecteToLabel'|trans }}</label>
                            <input type="date" class="form-control" id="ecole-directe-to" value="{{ monday|date_modify('+6 days')|date('Y-m-d') }}" required data-ecole-directe-target="to">
                        </div>
                        <twig:Cm:Button variant="primary" type="submit" data-ecole-directe-target="lessonLogButton">{{ 'ecoleDirecteReadAction'|trans }}</twig:Cm:Button>
                    </form>
                    <div data-ecole-directe-target="slots"></div>
                </div>
            </div>

            {# Sending the cahier de texte: « Préparer » reads École Directe and shows what would
               change; only « Envoyer vers École Directe » writes, and only the ticked slots. #}
            <div class="card mb-3">
                <div class="card-body">
                    <twig:Cm:Subhead :title="'ecoleDirecteSendLessonLogTitle'|trans" :hint="'ecoleDirecteSendLessonLogHint'|trans" class="mb-3"/>
                    <form class="d-flex flex-wrap align-items-end gap-2 mb-3" data-action="submit->ecole-directe#previewLessonLog">
                        <div>
                            <label class="form-label" for="ecole-directe-send-from">{{ 'ecoleDirecteFromLabel'|trans }}</label>
                            <input type="date" class="form-control" id="ecole-directe-send-from" value="{{ monday }}" required data-ecole-directe-target="sendFrom">
                        </div>
                        <div>
                            <label class="form-label" for="ecole-directe-send-to">{{ 'ecoleDirecteToLabel'|trans }}</label>
                            <input type="date" class="form-control" id="ecole-directe-send-to" value="{{ monday|date_modify('+6 days')|date('Y-m-d') }}" required data-ecole-directe-target="sendTo">
                        </div>
                        <twig:Cm:Button variant="outline" type="submit" data-ecole-directe-target="lessonLogPreviewButton">{{ 'ecoleDirectePreviewAction'|trans }}</twig:Cm:Button>
                    </form>
                    <div data-ecole-directe-target="lessonLogPreview"></div>
                    <div class="mt-3" data-ecole-directe-target="lessonLogSendBar" hidden>
                        <twig:Cm:Button variant="primary" data-action="ecole-directe#sendLessonLog" data-ecole-directe-target="lessonLogSendButton">{{ 'ecoleDirecteSendSelectionAction'|trans }}</twig:Cm:Button>
                    </div>
                    <div class="mt-3" data-ecole-directe-target="lessonLogResult"></div>
                </div>
            </div>

            {# Sending an evaluation: the École Directe classes are read on a button, never on their
               own; then which evaluation, where, a preview, and the send. #}
            <div class="card mb-3">
                <div class="card-body">
                    <twig:Cm:Subhead :title="'ecoleDirecteSendGradebookTitle'|trans" :hint="'ecoleDirecteSendGradebookHint'|trans" class="mb-3"/>
                    {% if evaluations is empty %}
                        <p class="text-secondary mb-0">{{ 'ecoleDirecteNoEvaluationLabel'|trans }}</p>
                    {% else %}
                        <div class="mb-3">
                            <twig:Cm:Button variant="outline" size="sm" data-action="ecole-directe#loadGradebookTargets" data-ecole-directe-target="gradebookTargetsButton">{{ 'ecoleDirecteLoadTargetsAction'|trans }}</twig:Cm:Button>
                        </div>
                        {# The two options travel with every preview and send; changing either, or
                           the evaluation, drops a preview that no longer says what would be sent. #}
                        <form class="row g-2 align-items-end mb-3" data-action="submit->ecole-directe#previewGradebook change->ecole-directe#gradebookChanged input->ecole-directe#gradebookChanged">
                            <div class="col-md-6">
                                <label class="form-label" for="ecole-directe-evaluation">{{ 'ecoleDirecteEvaluationLabel'|trans }}</label>
                                <select class="form-select" id="ecole-directe-evaluation" required data-ecole-directe-target="evaluation" data-action="ecole-directe#evaluationPicked">
                                    <option value="">{{ 'ecoleDirecteEvaluationPlaceholder'|trans }}</option>
                                    {% for evaluation in evaluations %}
                                        <option value="{{ evaluation.id }}" data-scale="{{ evaluation.scale }}" data-coefficient="{{ evaluation.coefficient }}" data-counts-out-of20="{{ evaluation.countsOutOf20 ? 1 : 0 }}">{{ evaluation.date ? evaluation.date|date('d/m/Y') ~ ' · ' }}{{ evaluation.topic.program.displayShortName }} · {{ evaluation.topic.name }} · {{ evaluation.name }} ({{ 'ecoleDirecteEvaluationScaleLabel'|trans({'%scale%': evaluation.scale}) }})</option>
                                    {% endfor %}
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label" for="ecole-directe-gradebook-target">{{ 'ecoleDirecteGradebookTargetLabel'|trans }}</label>
                                <select class="form-select" id="ecole-directe-gradebook-target" required data-ecole-directe-target="gradebookTarget">
                                    <option value="">{{ 'ecoleDirecteGradebookTargetPlaceholder'|trans }}</option>
                                </select>
                            </div>
                            <div class="col-auto">
                                <label class="form-label" for="ecole-directe-coefficient">{{ 'ecoleDirecteCoefficientLabel'|trans }}</label>
                                <input type="number" class="form-control" id="ecole-directe-coefficient" style="width: 8rem" min="0.01" max="100" step="0.01" value="1" required data-ecole-directe-target="coefficient">
                            </div>
                            <div class="col-auto" data-ecole-directe-target="outOf20Field" hidden>
                                <label class="form-check mb-2">
                                    <input type="checkbox" class="form-check-input" data-ecole-directe-target="outOf20">
                                    <span class="form-check-label">{{ 'ecoleDirecteOutOf20Label'|trans }}</span>
                                </label>
                            </div>
                            <div class="col-auto">
                                <twig:Cm:Button variant="outline" type="submit" data-ecole-directe-target="gradebookPreviewButton">{{ 'ecoleDirectePreviewAction'|trans }}</twig:Cm:Button>
                            </div>
                        </form>
                        <div data-ecole-directe-target="gradebookPreview"></div>
                        <div class="mt-3" data-ecole-directe-target="gradebookSendBar" hidden>
                            <twig:Cm:Button variant="primary" data-action="ecole-directe#sendGradebook" data-ecole-directe-target="gradebookSendButton">{{ 'ecoleDirecteSendGradebookAction'|trans }}</twig:Cm:Button>
                        </div>
                        <div class="mt-3" data-ecole-directe-target="gradebookResult"></div>
                    {% endif %}
                </div>
            </div>
            </div>

            {% if is_granted('ROLE_ADMIN') %}
                <div class="card mb-3">
                    <div class="card-body">
                        <twig:Cm:Subhead :title="'ecoleDirecteExplorerTitle'|trans" :hint="'ecoleDirecteExplorerHint'|trans" class="mb-3"/>
                        <form class="d-flex gap-2 mb-3" data-action="submit->ecole-directe#explore">
                            <input type="text" class="form-control font-monospace" placeholder="cahierdetexte/loadslots/2026-09-21/2026-09-27.awp" aria-label="{{ 'ecoleDirecteExplorerPathLabel'|trans }}" required data-ecole-directe-target="path">
                            <twig:Cm:Button variant="outline" type="submit" data-ecole-directe-target="exploreButton">{{ 'ecoleDirecteReadAction'|trans }}</twig:Cm:Button>
                        </form>
                        <pre class="cm-mono small mb-0" style="max-height: 32rem; overflow: auto" data-ecole-directe-target="raw" hidden></pre>
                    </div>
                </div>
            {% endif %}
        </div>
    </div>
{% endblock %}
