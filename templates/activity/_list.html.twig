{# Activity feed - taken from Tabler's Activity page (design/tabler/shared/includes/parts/
   activity.html): a divide-y list, an initials chip on the left, sentence and timestamp on the
   right. Shared by the two dashboards and the two histories, for both logs.

   Expects: `activities` (list<UfaActivity|PlatformActivity>), `emptyMessage` (translated). #}
{% if activities is empty %}
    <p class="text-secondary mb-0">{{ emptyMessage }}</p>
{% else %}
    <div class="divide-y">
        {% for activity in activities %}
            {% set actorLabel = activity.actor ? (activity.actor.displayName ?? activity.actor.username) : '' %}
            <div>
                <div class="row py-2">
                    <div class="col-auto">
                        <span class="cm-user__avatar" title="{{ actorLabel }}">
                            {{- activity.actor ? (activity.actor.initials|default(actorLabel|slice(0, 1)|upper)) : '·' -}}
                        </span>
                    </div>
                    <div class="col">
                        <div style="color: var(--cm-ink); font-size: 13.5px;">{{ activity_message(activity) }}</div>
                        <div class="text-secondary" style="font-size: 12px;">
                            {{ activity.occurredAt|date('d/m/Y H:i') }}
                            {%- if activity.ipAddress is defined and activity.ipAddress %} · {{ activity.ipAddress }}{% endif %}
                        </div>
                    </div>
                </div>
            </div>
        {% endfor %}
    </div>
{% endif %}
