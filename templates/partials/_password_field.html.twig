{# A password row for the Tabler-shaped forms of the authenticated shell, carrying the reveal
   control (the eye) that every "type your own password" field on this platform has. The public
   auth card draws its own (.cm-authcard__eye in templates/security/*.html.twig) because its
   tokens are scoped to .cm-authcard; both are driven by the same
   assets/controllers/password_visibility_controller.js.

   Expects `field` (a PasswordType form view). The row is written out by hand rather than through
   form_row() because the button has to sit next to the widget, inside the positioned wrapper. #}
<div class="mb-3">
    {{ form_label(field) }}
    <div class="cm-password-field" data-controller="password-visibility">
        {{ form_widget(field, {attr: {'data-password-visibility-target': 'input'}}) }}
        <button type="button" class="cm-password-field__eye" aria-pressed="false"
                title="{{ 'togglePasswordVisibilityHint'|trans }}"
                aria-label="{{ 'togglePasswordVisibilityHint'|trans }}"
                data-action="password-visibility#toggle">
            <svg class="icon" data-password-visibility-target="shownIcon"><use href="{{ asset('icons/tabler-sprite.svg') }}#tabler-icon-eye"></use></svg>
            <svg class="icon d-none" data-password-visibility-target="hiddenIcon"><use href="{{ asset('icons/tabler-sprite.svg') }}#tabler-icon-eye-off"></use></svg>
        </button>
    </div>
    {{ form_help(field) }}
    {{ form_errors(field) }}
</div>
