{# Folders pane, shared by index.html.twig and show.html.twig (design/design_handoff_messagerie
   #1) - `folder` is the currently open one ('inbox'/'sent'/'archived'), `counts` from
   App\Controller\MessageController::folderCounts(). No Brouillons/Corbeille entries: neither
   drafts nor an in-app trash view exist in design/validated/internal-messaging.md (soft-deleted
   messages are explicitly "no in-app audit view in v1"), so this only covers the three folders
   the backend actually has. #}
<div class="cm-mail-folders">
    <a href="{{ path('app_messages_new') }}" class="cm-mail-folders__new">
        <twig:ux:icon name="plus" width="15" height="15"/>
        <span>{{ 'messageComposeAction'|trans }}</span>
    </a>
    <nav class="cm-mail-folders__card" aria-label="{{ 'messagesPageHeading'|trans }}">
        <a href="{{ path('app_messages') }}" class="cm-mail-folders__item{{ folder == 'inbox' ? ' is-active' }}"{{ folder == 'inbox' ? ' aria-current="page"' }}>
            <twig:ux:icon name="inbox" width="16" height="16"/>
            <span>{{ 'messagesInboxTabLabel'|trans }}</span>
            {% if counts.unread > 0 %}
                <span class="cm-mail-folders__badge">{{ counts.unread > 99 ? '99+' : counts.unread }}</span>
            {% endif %}
        </a>
        <a href="{{ path('app_messages_sent') }}" class="cm-mail-folders__item{{ folder == 'sent' ? ' is-active' }}"{{ folder == 'sent' ? ' aria-current="page"' }}>
            <twig:ux:icon name="send" width="16" height="16"/>
            <span>{{ 'messagesSentTabLabel'|trans }}</span>
            <span class="cm-mail-folders__count">{{ counts.sent }}</span>
        </a>
        <a href="{{ path('app_messages_archived') }}" class="cm-mail-folders__item{{ folder == 'archived' ? ' is-active' }}"{{ folder == 'archived' ? ' aria-current="page"' }}>
            <twig:ux:icon name="archive" width="16" height="16"/>
            <span>{{ 'messagesArchivedTabLabel'|trans }}</span>
            <span class="cm-mail-folders__count">{{ counts.archived }}</span>
        </a>
    </nav>
</div>
