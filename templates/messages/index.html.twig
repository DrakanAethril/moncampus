{% extends 'layout/app.html.twig' %}

{% block title %}{{ 'messagesPageHeading'|trans }}{% endblock %}

{% block page_breadcrumb %}
    {{ component('Cm:Breadcrumb', {segments: [
        {label: 'messagesPageHeading'|trans, url: app.request.requestUri},
    ]}) }}
{% endblock %}
{% block page_title %}{{ 'messagesPageHeading'|trans }}{% endblock %}
{% block page_actions %}{% endblock %}

{% block main %}
    <div class="cm-mail-app" data-controller="message-drawer" data-action="click->message-drawer#backdropClick">
        {% include 'messages/_folders.html.twig' %}

        {% if total == 0 %}
            <div class="cm-mail-empty cm-mail-empty--span">
                <div class="cm-mail-empty__head">
                    <span class="cm-mail-empty__pill">{{ ('messages' ~ folder|capitalize ~ 'TabLabel')|trans }}</span>
                    <span class="cm-mail-empty__hint">{{ 'messagesEmptyFolderHintLabel'|trans }}</span>
                </div>
                <div class="cm-mail-empty__body">
                    <div class="cm-mail-empty__content">
                        <span class="cm-mail-empty__icon">
                            <twig:ux:icon name="inbox" width="30" height="30" stroke-width="1.5"/>
                        </span>
                        <div class="cm-mail-empty__title">{{ 'messagesEmptyFolderTitle'|trans }}</div>
                        <p class="cm-mail-empty__text">{{ (folder == 'sent' ? 'messagesEmptySentText' : folder == 'archived' ? 'messagesEmptyArchivedText' : 'messagesEmptyInboxText')|trans }}</p>
                        <div class="cm-mail-empty__actions">
                            <a href="{{ path('app_messages_new') }}" class="cm-mail-btn-primary">{{ 'messageComposeAction'|trans }}</a>
                            {% if folder != 'inbox' %}
                                <a href="{{ path('app_messages') }}" class="cm-mail-btn-link">{{ 'messagesGoToInboxAction'|trans }}</a>
                            {% endif %}
                        </div>
                    </div>
                </div>
            </div>
        {% else %}
            {% include 'messages/_list.html.twig' %}

            <div class="cm-mail-thread cm-mail-empty">
                <div class="cm-mail-empty__body">
                    <div class="cm-mail-empty__content">
                        <span class="cm-mail-empty__icon">
                            <twig:ux:icon name="mail" width="30" height="30"/>
                        </span>
                        <div class="cm-mail-empty__title">{{ 'messagesSelectThreadTitle'|trans }}</div>
                        <p class="cm-mail-empty__text">{{ 'messagesSelectThreadText'|trans }}</p>
                    </div>
                </div>
            </div>
        {% endif %}
    </div>
{% endblock %}
