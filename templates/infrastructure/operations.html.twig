{% extends 'layout/app.html.twig' %}

{% block title %}{{ 'infrastructureOperationsNavLabel'|trans }}{% endblock %}

{% block page_breadcrumb %}
    {% include '_breadcrumb.html.twig' with {segments: [
        {label: 'homeNavLabel'|trans, url: path('app_home')},
        {label: 'infrastructureNavLabel'|trans, url: path('app_infrastructure')},
        {label: 'infrastructureOperationsNavLabel'|trans, url: path('app_infrastructure_operations')},
    ]} %}
{% endblock %}

{% block page_title %}{{ 'infrastructureOperationsNavLabel'|trans }}{% endblock %}

{% block page_actions %}
    <a href="{{ path('app_infrastructure_operations_export', filters|filter(v => v is not null and v != '')) }}" class="cm-btn cm-btn--outline">{{ 'proxmoxOperationExportAction'|trans }}</a>
{% endblock %}

{% block main %}
    {% include 'infrastructure/_tabs.html.twig' %}

    <div class="card cm-card--tabbed">
        <form method="get" class="cm-actionbar" style="margin: 0; padding: 12px 18px; border-top: 0; border-bottom: 1px solid var(--cm-border-soft); background: var(--cm-surface-soft);">
            <input type="search" name="q" value="{{ filters.q }}" class="cm-input cm-field--md" placeholder="{{ 'proxmoxOperationSearchPlaceholder'|trans }}">

            <label class="cm-field-label" for="filter-host">{{ 'proxmoxOperationHostLabel'|trans }}</label>
            <select id="filter-host" name="host" class="cm-select cm-field--sm">
                <option value="">{{ 'proxmoxFilterAllLabel'|trans }}</option>
                {% for h in hosts %}
                    <option value="{{ h.id }}"{{ filters.host == h.id ? ' selected' }}>{{ h.label }}</option>
                {% endfor %}
            </select>

            <label class="cm-field-label" for="filter-action">{{ 'proxmoxOperationActionLabel'|trans }}</label>
            <select id="filter-action" name="action" class="cm-select cm-field--sm">
                <option value="">{{ 'proxmoxFilterAllLabel'|trans }}</option>
                {% for case in actions %}
                    <option value="{{ case.value }}"{{ filters.action == case.value ? ' selected' }}>{{ case.labelKey|trans }}</option>
                {% endfor %}
            </select>

            <label class="cm-field-label" for="filter-status">{{ 'proxmoxOperationResultLabel'|trans }}</label>
            <select id="filter-status" name="status" class="cm-select cm-field--sm">
                <option value="">{{ 'proxmoxFilterAllLabel'|trans }}</option>
                {% for case in statuses %}
                    <option value="{{ case.value }}"{{ filters.status == case.value ? ' selected' }}>{{ case.labelKey|trans }}</option>
                {% endfor %}
            </select>

            <span class="cm-actionbar__meta" style="margin-left:auto">{{ 'proxmoxOperationCountMeta'|trans({'%count%': total}) }}</span>
            <button type="submit" class="cm-btn cm-btn--outline cm-btn--sm">{{ 'proxmoxGuestRefreshAction'|trans }}</button>
        </form>

        <div class="table-responsive">
            <table class="table table-vcenter card-table">
                <thead>
                    <tr>
                        <th>{{ 'proxmoxOperationWhenLabel'|trans }}</th>
                        <th>{{ 'proxmoxOperationActionLabel'|trans }}</th>
                        <th>{{ 'proxmoxGuestMachineLabel'|trans }}</th>
                        <th>{{ 'proxmoxOperationHostLabel'|trans }}</th>
                        <th>{{ 'proxmoxOperationAuthorLabel'|trans }}</th>
                        <th>{{ 'proxmoxOperationResultLabel'|trans }}</th>
                        <th>{{ 'proxmoxOperationDetailLabel'|trans }}</th>
                    </tr>
                </thead>
                <tbody>
                    {% for operation in operations %}
                        <tr>
                            <td class="cm-guest__sub cm-mono">{{ operation.requestedAt|date('d/m · H:i:s') }}</td>
                            <td><span class="cm-badge cm-badge--{{ operation.action.badgeModifier }}">{{ operation.action.labelKey|trans }}</span></td>
                            <td>
                                {% if operation.guestName %}
                                    <span class="cm-guest__name">{{ operation.guestName }}</span>
                                    <span class="cm-mono cm-guest__sub">· {{ operation.vmid }}</span>
                                {% else %}
                                    <span class="cm-guest__sub">—</span>
                                {% endif %}
                            </td>
                            <td class="cm-guest__sub">{{ operation.hostLabel }}</td>
                            <td class="cm-guest__sub">{{ operation.requestedByLabel }}</td>
                            <td><span class="cm-badge cm-badge--{{ operation.status.badgeModifier }}">{{ operation.status.labelKey|trans }}</span></td>
                            <td class="cm-guest__sub">
                                {# Proxmox's own wording, untranslated: a glossary would be one more thing to
                                   keep in step, and the raw string is what is searchable as-is. #}
                                {{ operation.message ?? '' }}
                                {% if operation.status.isSettled and operation.settledAt %}
                                    <span class="cm-guest__sub">· {{ 'proxmoxOperationTookText'|trans({'%seconds%': operation.durationSeconds}) }}</span>
                                {% endif %}
                                {% if operation.upid and operation.status.value == 'unknown' %}
                                    <div class="cm-mono" style="font-size:11px">{{ operation.upid }}</div>
                                {% endif %}
                            </td>
                        </tr>
                    {% else %}
                        <tr><td colspan="7" class="text-center py-4 cm-guest__sub">{{ 'proxmoxOperationNoneText'|trans }}</td></tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

        {% if pageCount > 1 %}
            <div class="cm-actionbar" style="margin:0; padding: 12px 18px; border-top: 1px solid var(--cm-border-soft);">
                <span class="cm-actionbar__meta">{{ 'proxmoxOperationPageMeta'|trans({'%page%': page, '%pages%': pageCount}) }}</span>
                <div class="cm-actionbar__buttons">
                    {% if page > 1 %}
                        <a class="cm-btn cm-btn--outline cm-btn--sm" href="{{ path('app_infrastructure_operations', filters|merge({page: page - 1})) }}">{{ 'proxmoxOperationPreviousAction'|trans }}</a>
                    {% endif %}
                    {% if page < pageCount %}
                        <a class="cm-btn cm-btn--outline cm-btn--sm" href="{{ path('app_infrastructure_operations', filters|merge({page: page + 1})) }}">{{ 'proxmoxOperationNextAction'|trans }}</a>
                    {% endif %}
                </div>
            </div>
        {% endif %}
    </div>
{% endblock %}
