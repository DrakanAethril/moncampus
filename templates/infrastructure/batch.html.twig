{% extends 'layout/app.html.twig' %}

{% block title %}{{ batch.label }}{% endblock %}

{% block page_breadcrumb %}
    {% include '_breadcrumb.html.twig' with {segments: [
        {label: 'homeNavLabel'|trans, url: path('app_home')},
        {label: 'infrastructureNavLabel'|trans, url: path('app_infrastructure')},
        {label: 'infrastructureBatchesNavLabel'|trans, url: path('app_infrastructure_batches')},
        {label: batch.label, url: app.request.requestUri},
    ]} %}
{% endblock %}

{% block page_title %}{{ batch.label }}{% endblock %}

{% block main %}
    <p class="cm-host__meta mb-3">
        {{ batch.program ? batch.program.displayShortName : '—' }} ·
        {{ batch.host ? batch.host.label : '—' }} ·
        {{ batch.ipRange ? batch.ipRange.label : '—' }} ·
        {{ 'proxmoxTemplateNameLabel'|trans }} {{ batch.templateVmid }} ·
        {{ batch.cores }} {{ 'proxmoxGuestCoresLabel'|trans }} / {{ batch.memoryMib }} Mio / {{ batch.diskGib }} Gio
        {% if batch.expiresAt %} · {{ 'vmBatchExpiresFieldLabel'|trans }} {{ batch.expiresAt|date('d/m/Y') }}{% endif %}
    </p>
    {% include 'infrastructure/_tabs.html.twig' %}

    {% if batch.isExpired %}
        {# Expired says nothing about the machines: the application destroys nothing, ever. It is a
           note to a person, not a countdown. #}
        <div class="cm-note cm-note--gold mb-3">
            <span class="cm-note__icon">!</span>
            <span>{{ 'vmBatchExpiredNote'|trans }}</span>
        </div>
    {% endif %}

    <div class="card cm-card--tabbed"
         data-controller="vm-batch"
         data-vm-batch-token-value="{{ csrf_token('infrastructure_action') }}"
         data-vm-batch-deploy-url-value="{{ path('app_infrastructure_batch_deploy', {id: batch.id}) }}"
         {# The page reloads itself while machines are being built, so somebody watching a class
            deploy sees it advance without pressing anything. #}
         data-vm-batch-auto-refresh-value="{{ batch.isDeploymentUnderWay ? 'true' : 'false' }}"
         data-vm-batch-labels-value="{{ {
             progress: 'vmBatchDeployProgressLabel'|trans,
             waiting: 'vmBatchDeployWaitingLabel'|trans,
             stalled: 'vmBatchDeployStalledLabel'|trans,
         }|json_encode }}">

        <div class="cm-actionbar" style="margin:0; padding: 12px 18px; border-bottom: 1px solid var(--cm-border-soft); background: var(--cm-surface-soft);">
            {% for status, count in counts %}
                <span class="cm-badge cm-badge--{{ status == 'created' or status == 'provisioned' ? 'green' : (status == 'failed' ? 'red' : 'gray') }}">{{ count }} {{ status }}</span>
            {% endfor %}
            <span class="cm-actionbar__meta ms-auto" data-vm-batch-target="progress">
                {{ 'vmBatchRemainingMeta'|trans({'%count%': remaining}) }}
            </span>
            {% if remaining > 0 %}
                {# Deployed in passes: twenty-four clones do not fit in one request, a batch is not
                   atomic, and only the outstanding items are ever attempted - so pressing this
                   twice is safe by construction. #}
                <button type="button" class="cm-btn cm-btn--primary cm-btn--sm" data-action="vm-batch#deploy" data-vm-batch-target="button">
                    {{ 'vmBatchDeployAction'|trans }}
                </button>
            {% endif %}
        </div>

        <div class="table-responsive">
            <table class="table table-vcenter card-table">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>{{ 'vmBatchStudentLabel'|trans }}</th>
                        <th>{{ 'proxmoxGuestMachineLabel'|trans }}</th>
                        <th>VMID</th>
                        <th>{{ 'proxmoxWizardIpFieldLabel'|trans }}</th>
                        <th>{{ 'guestAccountLoginLabel'|trans }}</th>
                        <th>{{ 'proxmoxGuestStatusLabel'|trans }}</th>
                        <th class="cm-actions"></th>
                    </tr>
                </thead>
                <tbody>
                    {% for item in batch.items %}
                        <tr>
                            <td class="cm-guest__sub">{{ item.position }}</td>
                            <td>{{ item.studentLabel }}</td>
                            <td class="cm-mono">{{ item.guestName }}</td>
                            <td class="cm-mono">{{ item.vmid ?? '—' }}</td>
                            <td class="cm-mono">{{ item.ipAllocation ? item.ipAllocation.ip : '—' }}</td>
                            <td class="cm-mono">{{ item.login }}</td>
                            <td>
                                <span class="cm-badge cm-badge--{{ item.status.badgeModifier }}">{{ item.status.labelKey|trans }}</span>
                                {% if item.message %}<div class="cm-guest__sub">{{ item.message }}</div>{% endif %}
                            </td>
                            <td class="cm-actions">
                                    {% if item.vmid and item.node and batch.host %}
                                        <a href="{{ path('app_infrastructure_guest_accounts', {id: batch.host.id, node: item.node, vmid: item.vmid}) }}">{{ 'guestAccountsShortAction'|trans }}</a>
                                    {% endif %}
                                    {# Only while it is still a plan: once a clone has been asked for, this
                                       row is the only thing pointing at a machine that exists. #}
                                    {% if item.status.value == 'planned' %}
                                        <form method="post" action="{{ path('app_infrastructure_batch_item_remove', {id: batch.id, itemId: item.id}) }}">
                                            <input type="hidden" name="_token" value="{{ csrf_token('infrastructure_action') }}">
                                            <button type="submit" class="cm-action--danger">{{ 'vmBatchItemRemoveAction'|trans }}</button>
                                        </form>
                                    {% endif %}
                                </td>
                        </tr>
                        {# A row of its own rather than a column: the log is a narrative, it is read
                           in full or not at all, and folded away it costs the table nothing. #}
                        {% if item.installLogEntries is not empty %}
                            <tr class="cm-installlog__row">
                                <td colspan="8">
                                    {# Unfolded on the machine being worked on: arriving on a batch
                                       mid-deployment should show what is happening rather than a
                                       column of closed triangles. #}
                                    <details class="cm-installlog"{{ batch.firstUnfinishedItem is same as(item) ? ' open' : '' }}>
                                        <summary>{{ 'vmInstallLogToggleAction'|trans({'%count%': item.installLogEntries|length}) }}</summary>
                                        <ol class="cm-installlog__list">
                                            {% for entry in item.installLogEntries %}
                                                <li class="cm-installlog__entry{{ entry.ok ? '' : ' cm-installlog__entry--ko' }}">
                                                    <span class="cm-installlog__at cm-mono">{{ entry.at|date('d/m H:i:s') }}</span>
                                                    <span class="cm-installlog__step">{{ entry.step.labelKey|trans }}</span>
                                                    {% if entry.detail %}
                                                        <span class="cm-installlog__detail cm-mono">{{ entry.detail }}</span>
                                                    {% endif %}
                                                </li>
                                            {% endfor %}
                                        </ol>
                                    </details>
                                </td>
                            </tr>
                        {% endif %}
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endblock %}
