{% extends 'layout/app.html.twig' %}

{% block title %}{{ host.label }}{% endblock %}

{% block page_breadcrumb %}
    {% include '_breadcrumb.html.twig' with {segments: [
        {label: 'homeNavLabel'|trans, url: path('app_home')},
        {label: 'infrastructureNavLabel'|trans, url: path('app_infrastructure')},
        {label: 'infrastructureHostsNavLabel'|trans, url: path('app_infrastructure_hosts')},
        {label: host.label, url: path('app_infrastructure_guests', {id: host.id})},
        {label: 'infrastructureGuestsNavLabel'|trans, url: app.request.requestUri},
    ]} %}
{% endblock %}

{% block page_title %}{{ host.label }}{% endblock %}

{% block main %}
    {% include 'infrastructure/_localnav.html.twig' %}

    <p class="cm-host__meta mb-3">
        <span class="cm-statusdot cm-statusdot--{{ host.lastCheckOk is null ? 'unknown' : (host.lastCheckOk ? 'ok' : 'down') }}"></span>
        {{ host.displayAddress }}
        {% if host.pveVersion %} · PVE {{ host.pveVersion }}{% endif %}
        {% if host.managedPool %} · pool <b>{{ host.managedPool }}</b>{% endif %}
        {% if host.vmidMin and host.vmidMax %} · VMID {{ host.vmidMin }}–{{ host.vmidMax }}{% endif %}
    </p>

    {% if failure %}
        {# The machine list is the one screen that reads the hypervisor as it renders - somebody is
           about to press "stop" on one of these rows, and a stale list would be worse than an
           error. So a host that has gone away says so here rather than showing an empty table. #}
        <div class="cm-note" style="border-left-color: var(--cm-red-tx); background: var(--cm-red-bg); color: var(--cm-red-tx);">
            <span class="cm-note__icon" style="background: var(--cm-red-tx);">!</span>
            <span><strong>{{ 'proxmoxGuestsUnreachableTitle'|trans }}</strong> {{ failure }}</span>
        </div>
    {% else %}
        <div class="card"
             data-controller="proxmox-guests"
             data-proxmox-guests-token-value="{{ csrf_token('infrastructure_action') }}"
             data-proxmox-guests-confirm-stop-value="{{ 'proxmoxGuestForceConfirmText'|trans }}">
            <form method="get" class="cm-actionbar" style="margin: 0; padding: 12px 18px; border-top: 0; border-bottom: 1px solid var(--cm-border-soft); background: var(--cm-surface-soft);">
                {# GET, because this form asks to be shown a result rather than to change anything -
                   a POST handled by Turbo would have to redirect to be legal. #}
                <input type="search" name="q" value="{{ filters.q }}" class="cm-input cm-field--md" placeholder="{{ 'proxmoxGuestSearchPlaceholder'|trans }}">

                <label class="cm-field-label" for="filter-node">{{ 'proxmoxGuestNodeLabel'|trans }}</label>
                <select id="filter-node" name="node" class="cm-select cm-field--sm">
                    <option value="">{{ 'proxmoxFilterAllLabel'|trans }}</option>
                    {% for node in nodes %}
                        <option value="{{ node.name }}"{{ filters.node == node.name ? ' selected' }}>{{ node.name }}</option>
                    {% endfor %}
                </select>

                <label class="cm-field-label" for="filter-status">{{ 'proxmoxGuestStatusLabel'|trans }}</label>
                <select id="filter-status" name="status" class="cm-select cm-field--sm">
                    <option value="">{{ 'proxmoxFilterAllLabel'|trans }}</option>
                    <option value="running"{{ filters.status == 'running' ? ' selected' }}>{{ 'proxmoxGuestRunningLabel'|trans }}</option>
                    <option value="stopped"{{ filters.status == 'stopped' ? ' selected' }}>{{ 'proxmoxGuestStoppedLabel'|trans }}</option>
                    <option value="template"{{ filters.status == 'template' ? ' selected' }}>{{ 'proxmoxGuestTemplateLabel'|trans }}</option>
                </select>

                <label class="cm-field-label" for="filter-type">{{ 'proxmoxGuestTypeLabel'|trans }}</label>
                <select id="filter-type" name="type" class="cm-select cm-field--sm">
                    <option value="">{{ 'proxmoxFilterAllLabel'|trans }}</option>
                    <option value="qemu"{{ filters.type == 'qemu' ? ' selected' }}>QEMU</option>
                    <option value="lxc"{{ filters.type == 'lxc' ? ' selected' }}>LXC</option>
                </select>

                <label class="cm-field-label"><input type="checkbox" name="scoped" value="1"{{ filters.scoped ? ' checked' }}> {{ 'proxmoxGuestScopedOnlyLabel'|trans }}</label>

                <span class="cm-actionbar__meta" style="margin-left:auto">{{ 'proxmoxGuestCountMeta'|trans({'%shown%': rows|length, '%total%': totalCount}) }}</span>
                <button type="submit" class="cm-btn cm-btn--outline cm-btn--sm">{{ 'proxmoxGuestRefreshAction'|trans }}</button>
            </form>

            <div class="table-responsive">
                <table class="table cm-table">
                    <thead>
                        <tr>
                            <th style="width:70px">VMID</th>
                            <th>{{ 'proxmoxGuestMachineLabel'|trans }}</th>
                            <th style="width:90px">{{ 'proxmoxGuestNodeLabel'|trans }}</th>
                            <th style="width:120px">{{ 'proxmoxGuestStatusLabel'|trans }}</th>
                            <th style="width:110px">{{ 'proxmoxGuestCpuLabel'|trans }}</th>
                            <th style="width:130px">{{ 'proxmoxGuestMemoryLabel'|trans }}</th>
                            <th style="width:90px">{{ 'proxmoxGuestDiskLabel'|trans }}</th>
                            <th style="width:100px">{{ 'proxmoxGuestUptimeLabel'|trans }}</th>
                            <th style="width:250px"></th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for row in rows %}
                            {% set guest = row.guest %}
                            {% set live = liveOperations[guest.vmid] is defined ? liveOperations[guest.vmid] : null %}
                            <tr data-proxmox-guests-target="row"
                                class="{{ row.inScope ? '' : 'cm-row--out' }}"
                                data-vmid="{{ guest.vmid }}">
                                <td class="cm-mono">{{ guest.vmid }}</td>
                                <td>
                                    <div class="cm-guest__name">{{ guest.name }}</div>
                                    <div class="cm-guest__sub">
                                        {{ guest.isContainer ? 'LXC' : 'QEMU' }}
                                        {%- if guest.template %} · <span style="color: var(--cm-teal-tx)">{{ 'proxmoxGuestTemplateLabel'|trans }}</span>{% endif %}
                                        {%- if guest.pool %} · pool <i>{{ guest.pool }}</i>{% endif %}
                                    </div>
                                </td>
                                <td class="cm-guest__sub">{{ guest.node }}</td>
                                <td>
                                    {% if guest.template %}
                                        <span class="cm-badge cm-badge--teal">{{ 'proxmoxGuestTemplateLabel'|trans }}</span>
                                    {% elseif guest.isRunning %}
                                        <span class="cm-badge cm-badge--green">{{ 'proxmoxGuestRunningLabel'|trans }}</span>
                                    {% else %}
                                        <span class="cm-badge cm-badge--gray">{{ 'proxmoxGuestStoppedLabel'|trans }}</span>
                                    {% endif %}
                                    {% if guest.isLocked %}
                                        <span class="cm-badge cm-badge--gold">{{ guest.lock }}</span>
                                    {% endif %}
                                </td>
                                <td>
                                    {% if guest.isRunning %}
                                        {% set cpuPercent = (guest.cpuUsage * 100)|round %}
                                        <div class="cm-meter"><span class="cm-meter__fill{{ cpuPercent > 80 ? ' cm-meter__fill--high' }}" style="width: {{ cpuPercent }}%"></span></div>
                                        <div class="cm-meter__text">{{ cpuPercent }} % · {{ guest.maxCpu }} {{ 'proxmoxGuestCoresLabel'|trans }}</div>
                                    {% else %}
                                        <span class="cm-guest__sub">— · {{ guest.maxCpu }} {{ 'proxmoxGuestCoresLabel'|trans }}</span>
                                    {% endif %}
                                </td>
                                <td>
                                    {% if guest.isRunning %}
                                        {% set memPercent = guest.memoryPercent|round %}
                                        <div class="cm-meter"><span class="cm-meter__fill{{ memPercent > 80 ? ' cm-meter__fill--high' }}" style="width: {{ memPercent }}%"></span></div>
                                        <div class="cm-meter__text">{{ (guest.usedMemoryBytes / 1073741824)|number_format(1, ',', ' ') }} / {{ (guest.maxMemoryBytes / 1073741824)|number_format(1, ',', ' ') }} Gio</div>
                                    {% else %}
                                        <span class="cm-guest__sub">— / {{ (guest.maxMemoryBytes / 1073741824)|number_format(1, ',', ' ') }} Gio</span>
                                    {% endif %}
                                </td>
                                <td class="cm-guest__sub">{{ (guest.maxDiskBytes / 1073741824)|number_format(0, ',', ' ') }} Gio</td>
                                <td class="cm-guest__sub">{{ guest.uptimeSeconds ? (guest.uptimeSeconds // 86400) ~ ' j ' ~ ((guest.uptimeSeconds % 86400) // 3600) ~ ' h' : '—' }}</td>
                                <td>
                                    <div class="cm-guest__actions" data-proxmox-guests-target="actions">
                                        {% if not row.inScope %}
                                            {# Visible, counted, and untouchable. Hiding it would make an
                                               administrator think the machine had vanished from Proxmox. #}
                                            <span class="cm-badge cm-badge--gray">{{ 'proxmoxGuestOutOfScopeBadge'|trans }}</span>
                                        {% elseif live %}
                                            <span class="cm-guest__sub" data-proxmox-guests-target="pending"
                                                  data-status-url="{{ path('app_infrastructure_operation_status', {id: live.id}) }}">
                                                {{ 'proxmoxGuestOperationPendingText'|trans({
                                                    '%action%': live.action.labelKey|trans,
                                                    '%who%': live.requestedByLabel,
                                                }) }}
                                            </span>
                                        {% elseif guest.template %}
                                            <span class="cm-guest__sub">{{ 'proxmoxGuestTemplateNoActionText'|trans }}</span>
                                        {% elseif not canOperate %}
                                            <span class="cm-guest__sub">—</span>
                                        {% else %}
                                            {# « Arrêter » and « Forcer » are two buttons and never a menu: an
                                               ACPI request and a power cut must not be choosable by accident. #}
                                            {% if guest.isRunning %}
                                                {% if row.canStop %}
                                                    <button type="button" class="cm-linkaction" data-action="proxmox-guests#run"
                                                            data-url="{{ path('app_infrastructure_guests_power', {id: host.id, node: guest.node, vmid: guest.vmid, action: 'shutdown'}) }}">{{ 'proxmoxGuestShutdownAction'|trans }}</button>
                                                    <button type="button" class="cm-linkaction cm-linkaction--danger" data-action="proxmox-guests#run"
                                                            data-confirm="1"
                                                            data-url="{{ path('app_infrastructure_guests_power', {id: host.id, node: guest.node, vmid: guest.vmid, action: 'stop'}) }}">{{ 'proxmoxGuestForceAction'|trans }}</button>
                                                {% endif %}
                                                {% if row.canStart %}
                                                    <button type="button" class="cm-linkaction" data-action="proxmox-guests#run"
                                                            data-url="{{ path('app_infrastructure_guests_power', {id: host.id, node: guest.node, vmid: guest.vmid, action: 'reboot'}) }}">{{ 'proxmoxGuestRebootAction'|trans }}</button>
                                                {% endif %}
                                            {% elseif row.canStart %}
                                                <button type="button" class="cm-linkaction cm-linkaction--positive" data-action="proxmox-guests#run"
                                                        data-url="{{ path('app_infrastructure_guests_power', {id: host.id, node: guest.node, vmid: guest.vmid, action: 'start'}) }}">{{ 'proxmoxGuestStartAction'|trans }}</button>
                                            {% endif %}
                                        {% endif %}
                                    </div>
                                </td>
                            </tr>
                        {% else %}
                            <tr><td colspan="9" class="text-center py-4 cm-guest__sub">{{ 'proxmoxGuestNoneText'|trans }}</td></tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    {% endif %}
{% endblock %}
