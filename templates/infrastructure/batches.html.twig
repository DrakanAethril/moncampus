{% extends 'layout/app.html.twig' %}

{% block title %}{{ 'infrastructureBatchesNavLabel'|trans }}{% endblock %}

{% block page_breadcrumb %}
    {% include '_breadcrumb.html.twig' with {segments: [
        {label: 'homeNavLabel'|trans, url: path('app_home')},
        {label: 'infrastructureNavLabel'|trans, url: path('app_infrastructure')},
        {label: 'infrastructureBatchesNavLabel'|trans, url: path('app_infrastructure_batches')},
    ]} %}
{% endblock %}

{% block page_title %}{{ 'infrastructureBatchesNavLabel'|trans }}{% endblock %}

{% block page_actions %}
    <a href="{{ path('app_infrastructure_batches_new') }}" class="cm-btn cm-btn--primary">{{ 'vmBatchAddAction'|trans }}</a>
{% endblock %}

{% block main %}
    {% include 'infrastructure/_tabs.html.twig' %}

    {% if rows is empty %}
        <div class="card cm-card--tabbed">
            <div class="card-body text-center py-5">
                <p class="mb-3">{{ 'vmBatchNoneText'|trans }}</p>
                <a href="{{ path('app_infrastructure_batches_new') }}" class="cm-btn cm-btn--primary">{{ 'vmBatchAddAction'|trans }}</a>
            </div>
        </div>
    {% else %}
        <div class="card cm-card--tabbed">
            <div class="table-responsive">
                <table class="table table-vcenter card-table">
                    <thead>
                        <tr>
                            <th>{{ 'vmBatchLabelFieldLabel'|trans }}</th>
                            <th>{{ 'vmBatchProgramFieldLabel'|trans }}</th>
                            <th>{{ 'proxmoxOperationHostLabel'|trans }}</th>
                            <th>{{ 'vmBatchProgressLabel'|trans }}</th>
                            <th>{{ 'vmBatchCreatedLabel'|trans }}</th>
                            <th>{{ 'vmBatchExpiresFieldLabel'|trans }}</th>
                            <th class="cm-actions"></th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for row in rows %}
                            {% set batch = row.batch %}
                            <tr class="{{ batch.isActive ? '' : 'cm-row--out' }}">
                                <td>
                                    <a class="cm-guest__name" href="{{ path('app_infrastructure_batch', {id: batch.id}) }}">{{ batch.label }}</a>
                                    <div class="cm-guest__sub">{{ batch.shape.labelKey|trans }}</div>
                                </td>
                                <td class="cm-guest__sub">{{ batch.program ? batch.program.displayShortName : '—' }}</td>
                                <td class="cm-guest__sub">{{ batch.host ? batch.host.label : '—' }}</td>
                                <td>
                                    {% for status, count in row.counts %}
                                        <span class="cm-badge cm-badge--{{ status == 'created' or status == 'provisioned' ? 'green' : (status == 'failed' ? 'red' : 'gray') }}">{{ count }} {{ status }}</span>
                                    {% else %}
                                        <span class="cm-guest__sub">—</span>
                                    {% endfor %}
                                </td>
                                {# Quand le lot a été planifié. Deux lots portant le nom d'une même
                                   classe ne se distinguent que par là, une fois l'année entamée. #}
                                <td class="cm-guest__sub">{{ batch.creationDate|date('d/m/Y') }}</td>
                                <td class="cm-guest__sub">
                                    {% if batch.expiresAt %}
                                        {{ batch.expiresAt|date('d/m/Y') }}
                                        {% if batch.isExpired %}<span class="cm-badge cm-badge--gold">{{ 'vmBatchExpiredBadge'|trans }}</span>{% endif %}
                                    {% else %}—{% endif %}
                                </td>
                                <td class="cm-actions">
                                        <a href="{{ path('app_infrastructure_batch', {id: batch.id}) }}">{{ 'vmBatchOpenAction'|trans }}</a>
                                        {# The plan goes; the machines it created stay on the hypervisor.
                                           This application does not destroy machines at all. #}
                                        <form method="post" action="{{ path('app_infrastructure_batch_remove', {id: batch.id}) }}"
                                              onsubmit="return confirm('{{ 'vmBatchRemoveConfirmText'|trans|e('js') }}')">
                                            <input type="hidden" name="_token" value="{{ csrf_token('infrastructure_action') }}">
                                            <button type="submit" class="cm-action--danger">{{ 'vmBatchRemoveAction'|trans }}</button>
                                        </form>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    {% endif %}
{% endblock %}
