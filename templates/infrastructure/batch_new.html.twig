{% extends 'layout/app.html.twig' %}

{% block title %}{{ 'vmBatchNewHeading'|trans }}{% endblock %}

{% block page_breadcrumb %}
    {% include '_breadcrumb.html.twig' with {segments: [
        {label: 'homeNavLabel'|trans, url: path('app_home')},
        {label: 'infrastructureNavLabel'|trans, url: path('app_infrastructure')},
        {label: 'infrastructureBatchesNavLabel'|trans, url: path('app_infrastructure_batches')},
        {label: 'vmBatchNewHeading'|trans, url: app.request.requestUri},
    ]} %}
{% endblock %}

{% block page_title %}{{ 'vmBatchNewHeading'|trans }}{% endblock %}

{% block main %}
    {% include 'infrastructure/_tabs.html.twig' %}

    <div class="cm-tabbed-content">

    {# The choices are a GET - "show me who this would deploy to" changes nothing, and the preview
       below has to move as the filters move. Only the last form creates anything. #}
    <form method="get" class="card mb-3">
        <fieldset class="cm-fieldset">
            <legend class="cm-fieldset__legend">{{ 'vmBatchWhoLegend'|trans }}</legend>
            <div class="row g-3">
                <div class="col-md-5">
                    <label class="cm-field-label" for="programId">{{ 'vmBatchProgramFieldLabel'|trans }}</label>
                    <select id="programId" name="programId" class="cm-select w-100"
                            data-controller="auto-submit" data-action="change->auto-submit#submit">
                        <option value="">{{ 'vmBatchProgramPlaceholder'|trans }}</option>
                        {% for p in programs %}
                            <option value="{{ p.id }}"{{ program and program.id == p.id ? ' selected' }}>{{ p.displayShortName }}</option>
                        {% endfor %}
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="cm-field-label" for="hostId">{{ 'proxmoxOperationHostLabel'|trans }}</label>
                    <select id="hostId" name="hostId" class="cm-select w-100">
                        {% for h in hosts %}
                            <option value="{{ h.id }}"{{ host and host.id == h.id ? ' selected' }}>{{ h.label }}</option>
                        {% endfor %}
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="cm-field-label" for="namePattern">{{ 'vmBatchNamePatternFieldLabel'|trans }}</label>
                    <input id="namePattern" name="namePattern" class="cm-input w-100 cm-mono" value="{{ namePattern }}">
                    <div class="cm-guest__sub mt-1">{{ 'vmBatchNamePatternHelp'|trans }}</div>
                </div>
            </div>

            {# The shape is part of "who", not of "what machine": it decides whether a machine is a
               student's or a group's, which is the same question as who gets an account on it. #}
            <div class="row g-3 mt-0">
                <div class="col-md-5">
                    <label class="cm-field-label" for="shape">{{ 'vmBatchShapeFieldLabel'|trans }}</label>
                    {# Submitting on change is what makes the fields below *exist*: which of them
                       are shown is decided server-side by the shape, so before this the only way
                       to reveal them was to press « Prévisualiser » first. #}
                    <select id="shape" name="shape" class="cm-select w-100"
                            data-controller="auto-submit" data-action="change->auto-submit#submit">
                        {% for case in shapes %}
                            <option value="{{ case.value }}"{{ shape.value == case.value ? ' selected' }}>{{ case.labelKey|trans }}</option>
                        {% endfor %}
                    </select>
                    <div class="cm-guest__sub mt-1">{{ shape.descriptionKey|trans }}</div>
                </div>
                {% if program and shape.value == 'per_group' %}
                    <div class="col-md-7">
                        <label class="cm-field-label" for="groupBatchId">{{ 'vmBatchGroupBatchFieldLabel'|trans }}</label>
                        <select id="groupBatchId" name="groupBatchId" class="cm-select w-100"{{ targetableGroupBatches is empty ? ' disabled' }}>
                            <option value="">{{ 'vmBatchGroupBatchPlaceholder'|trans }}</option>
                            {% for candidate in targetableGroupBatches %}
                                <option value="{{ candidate.id }}"{{ groupBatch and groupBatch.id == candidate.id ? ' selected' }}>{{ candidate.name }}</option>
                            {% endfor %}
                        </select>
                        <div class="cm-guest__sub mt-1">
                            {{ (targetableGroupBatches is empty ? 'vmBatchNoGroupBatchHelp' : 'vmBatchGroupBatchHelp')|trans }}
                        </div>
                    </div>
                {% endif %}
            </div>

            {% if program and shape.value != 'for_accounts' %}
                <div class="row g-3 mt-1">
                    <div class="col-12">
                        <label class="cm-field-label d-block mb-1">{{ 'vmBatchTeachersFieldLabel'|trans }}</label>
                        {# Checkbox group rather than a multi-select, per this app's form rule. The
                           list itself is not the same on the two shapes: a class's teachers here,
                           only those who own or were given the saved set on a per-group batch. #}
                        {% for teacher in candidateTeachers %}
                            <label class="cm-field-label d-block">
                                <input type="checkbox" name="teachers[]" value="{{ teacher.id }}"{{ teacher.id in chosenTeacherIds ? ' checked' }}>
                                {{ teacher.displayName ?? teacher.username }}
                            </label>
                        {% else %}
                            <p class="cm-guest__sub">{{ (shape.value == 'per_group' ? 'vmBatchNoGroupTeacherText' : 'vmBatchNoTeacherText')|trans }}</p>
                        {% endfor %}
                        <div class="cm-guest__sub mt-1">{{ 'vmBatchTeachersHelpText'|trans }}</div>
                    </div>
                </div>
            {% endif %}

            {% if program and shape.value == 'for_accounts' %}
                <div class="row g-3 mt-1">
                    <div class="col-md-8">
                        <label class="cm-field-label" for="batch-users">{{ 'vmBatchAccountsFieldLabel'|trans }}</label>
                        {# Server-rendered <option selected> for what is already chosen: the search
                           is an ajax one, so nothing else would survive the reload a preview is. #}
                        <select id="batch-users" name="users[]" multiple
                                data-controller="tom-select"
                                data-tom-select-url-value="{{ path('app_infrastructure_batches_user_search') }}"
                                data-tom-select-placeholder-value="{{ 'vmBatchAccountsPlaceholder'|trans }}">
                            {% for user in chosenUsers %}
                                <option value="{{ user.id }}" selected>{{ user.displayName ?? user.username }} ({{ user.username }})</option>
                            {% endfor %}
                        </select>
                        <div class="cm-guest__sub mt-1">{{ 'vmBatchAccountsHelpText'|trans }}</div>
                    </div>
                </div>
            {% endif %}

            {% if program and shape.value == 'per_student' %}
                {# Checkbox groups rather than a multi-select, and the filters apply to the STUDENT:
                   a program offers SISR, and which students take it is a per-student fact. Ticking
                   nothing means the whole class. #}
                <div class="row g-3 mt-1">
                    <div class="col-md-6">
                        <label class="cm-field-label d-block mb-1">{{ 'vmBatchOptionsFieldLabel'|trans }}</label>
                        {% for option in program.options %}
                            <label class="cm-field-label d-block">
                                <input type="checkbox" name="options[]" value="{{ option.id }}"{{ option.id in filters.options ? ' checked' }}>
                                {{ option.name }}
                            </label>
                        {% else %}
                            <p class="cm-guest__sub">{{ 'vmBatchNoOptionText'|trans }}</p>
                        {% endfor %}
                    </div>
                    <div class="col-md-6">
                        <label class="cm-field-label d-block mb-1">{{ 'vmBatchModalitiesFieldLabel'|trans }}</label>
                        {% for modality in program.modalities %}
                            <label class="cm-field-label d-block">
                                <input type="checkbox" name="modalities[]" value="{{ modality.id }}"{{ modality.id in filters.modalities ? ' checked' }}>
                                {{ modality.name }}
                            </label>
                        {% else %}
                            <p class="cm-guest__sub">{{ 'vmBatchNoModalityText'|trans }}</p>
                        {% endfor %}
                    </div>
                </div>
                <div class="cm-note mt-3">
                    <span class="cm-note__icon">i</span>
                    <span>{{ 'vmBatchFilterNote'|trans }}</span>
                </div>
            {% endif %}
        </fieldset>

        <div class="cm-fieldset">
            <div class="cm-actionbar" style="margin-top:0; border-top:0; padding-top:0;">
                <span class="cm-actionbar__meta">
                    {% if program %}{{ 'vmBatchSelectionMeta'|trans({'%selected%': selected|length, '%total%': members|length}) }}{% endif %}
                </span>
                <div class="cm-actionbar__buttons">
                    <button type="submit" class="cm-btn cm-btn--outline">{{ 'vmBatchPreviewAction'|trans }}</button>
                </div>
            </div>
        </div>
    </form>

    {% if failure %}
        <div class="cm-note cm-note--danger mb-3">
            <span class="cm-note__icon">!</span>
            <span>{{ failure }}</span>
        </div>
    {% endif %}

    {# A machine carrying several accounts, whichever shape produced it: the preview table below
       reads the same rows for a group of a set and for a handful of people picked by hand. #}
    {% set perGroup = shape.isMultiAccount %}
    {% set rows = perGroup ? groupPlan : plan %}

    {% if program and host and rows is not empty %}
        <form method="post" action="{{ path('app_infrastructure_batches_create') }}" class="card">
            <input type="hidden" name="_token" value="{{ csrf_token('infrastructure_action') }}">
            <input type="hidden" name="programId" value="{{ program.id }}">
            <input type="hidden" name="hostId" value="{{ host.id }}">
            <input type="hidden" name="shape" value="{{ shape.value }}">
            {% if shape.value == 'per_group' %}<input type="hidden" name="groupBatchId" value="{{ groupBatch.id }}">{% endif %}
            <input type="hidden" name="namePattern" value="{{ namePattern }}">
            {% for id in filters.options %}<input type="hidden" name="options[]" value="{{ id }}">{% endfor %}
            {% for id in filters.modalities %}<input type="hidden" name="modalities[]" value="{{ id }}">{% endfor %}
            {% for user in chosenUsers %}<input type="hidden" name="users[]" value="{{ user.id }}">{% endfor %}
            {% for id in chosenTeacherIds %}<input type="hidden" name="teachers[]" value="{{ id }}">{% endfor %}

            <fieldset class="cm-fieldset">
                <legend class="cm-fieldset__legend">{{ 'vmBatchMachineLegend'|trans }}</legend>
                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="cm-field-label" for="label">{{ 'vmBatchLabelFieldLabel'|trans }}</label>
                        <input id="label" name="label" class="cm-input w-100" required value="{{ program.displayShortName }} — {{ 'vmBatchDefaultLabelSuffix'|trans }}">
                    </div>
                    <div class="col-md-4">
                        <label class="cm-field-label" for="templateVmid">{{ 'proxmoxTemplateNameLabel'|trans }}</label>
                        <select id="templateVmid" name="templateVmid" class="cm-select w-100" required>
                            {% for template in templates %}
                                <option value="{{ template.vmid }}">{{ template.name }} ({{ template.vmid }})</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="cm-field-label" for="node">{{ 'proxmoxGuestNodeLabel'|trans }}</label>
                        <select id="node" name="node" class="cm-select w-100" required>
                            {% for n in nodes %}<option value="{{ n.name }}">{{ n.name }}</option>{% endfor %}
                        </select>
                    </div>
                </div>
                <div class="row g-3 mt-1">
                    <div class="col-md-2">
                        <label class="cm-field-label" for="cores">{{ 'proxmoxWizardCoresFieldLabel'|trans }}</label>
                        <input id="cores" name="cores" type="number" min="1" class="cm-input w-100" value="2">
                    </div>
                    <div class="col-md-3">
                        <label class="cm-field-label" for="memoryMib">{{ 'proxmoxWizardMemoryFieldLabel'|trans }}</label>
                        <input id="memoryMib" name="memoryMib" type="number" min="128" step="128" class="cm-input w-100" value="2048">
                    </div>
                    <div class="col-md-2">
                        <label class="cm-field-label" for="diskGib">{{ 'proxmoxWizardDiskFieldLabel'|trans }}</label>
                        <input id="diskGib" name="diskGib" type="number" min="1" class="cm-input w-100" value="16">
                    </div>
                    <div class="col-md-3">
                        <label class="cm-field-label" for="rangeId">{{ 'proxmoxWizardRangeFieldLabel'|trans }}</label>
                        <select id="rangeId" name="rangeId" class="cm-select w-100" required>
                            {% for r in ranges %}<option value="{{ r.id }}">{{ r.label }}</option>{% endfor %}
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="cm-field-label" for="expiresAt">{{ 'vmBatchExpiresFieldLabel'|trans }}</label>
                        <input id="expiresAt" name="expiresAt" type="date" class="cm-input w-100">
                    </div>
                </div>
                <div class="row g-3 mt-1">
                    <div class="col-md-6">
                        <label class="cm-field-label d-block"><input type="checkbox" name="linkedClone" value="1"> {{ 'proxmoxLinkedCloneLabel'|trans }}</label>
                    </div>
                </div>
            </fieldset>

            <fieldset class="cm-fieldset">
                <legend class="cm-fieldset__legend">
                    {{ 'vmBatchPostInstallLegend'|trans }} <span>{{ 'proxmoxHostOptionalLabel'|trans }}</span>
                </legend>
                <textarea name="postInstallScript" class="cm-input w-100 cm-mono" rows="6" placeholder="#!/bin/bash&#10;apt-get update -qq"></textarea>
                {# The two things that make a script fail are said where it is written, not in a
                   documentation somebody reads after the failure. #}
                <div class="cm-guest__sub mt-1">{{ 'vmBatchPostInstallHelp'|trans }}</div>
                <div class="cm-note cm-note--gold mt-2">
                    <span class="cm-note__icon">!</span>
                    <span>{{ 'vmBatchPostInstallWarning'|trans }}</span>
                </div>
            </fieldset>

            <fieldset class="cm-fieldset">
                <legend class="cm-fieldset__legend">{{ 'vmBatchPlanLegend'|trans }}</legend>

                {% if shortBy > 0 %}
                    {# Said before the button: it means some students would silently get nothing. #}
                    <div class="cm-note cm-note--gold mb-3">
                        <span class="cm-note__icon">!</span>
                        <span>{{ 'vmBatchShortByText'|trans({'%count%': shortBy}) }}</span>
                    </div>
                {% endif %}

                <div class="table-responsive">
                    <table class="table table-vcenter card-table">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>{{ (perGroup ? 'vmBatchGroupColumnLabel' : 'vmBatchStudentLabel')|trans }}</th>
                                <th>{{ 'proxmoxGuestMachineLabel'|trans }}</th>
                                <th>VMID</th>
                                <th>{{ (perGroup ? 'vmBatchGroupAccountsColumnLabel' : 'guestAccountLoginLabel')|trans }}</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for row in rows %}
                                <tr>
                                    <td class="cm-guest__sub">{{ row.position }}</td>
                                    <td>{{ perGroup ? row.groupLabel : row.studentLabel }}</td>
                                    <td class="cm-mono">{{ row.guestName }}</td>
                                    <td class="cm-mono">{{ row.vmid }}</td>
                                    <td class="cm-mono">
                                        {#- Every account of that one machine, spelled out before
                                            anything is created rather than discovered: the members of
                                            a group, and the teachers the batch names on top of them.
                                            A per-student machine carries members only once there is
                                            somebody beyond the student. -#}
                                        {%- if row.members is not empty -%}
                                            {% for member in row.members %}{{ member.login }}{{ not loop.last ? ', ' }}{% endfor %}
                                        {%- else -%}
                                            {{ perGroup ? '—' : row.login }}
                                        {%- endif -%}
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </fieldset>

            <div class="cm-fieldset">
                <div class="cm-actionbar" style="margin-top:0; border-top:0; padding-top:0;">
                    <span class="cm-actionbar__meta">{{ (perGroup ? 'vmBatchCreateGroupMeta' : 'vmBatchCreateMeta')|trans({'%count%': rows|length}) }}</span>
                    <div class="cm-actionbar__buttons">
                        <a href="{{ path('app_infrastructure_batches') }}" class="cm-btn cm-btn--outline">{{ 'cancelAction'|trans }}</a>
                        <button type="submit" class="cm-btn cm-btn--primary">{{ 'vmBatchCreateAction'|trans }}</button>
                    </div>
                </div>
            </div>
        </form>
    {% elseif program %}
        <div class="card"><div class="card-body text-center py-4 cm-guest__sub">{{ 'vmBatchNobodySelectedText'|trans }}</div></div>
    {% endif %}
    </div>
{% endblock %}
