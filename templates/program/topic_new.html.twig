{% extends 'layout/app.html.twig' %}

{% block title %}{{ (isEdit ? 'editTopicPageHeading' : 'newTopicPageHeading')|trans }} - {{ program.displayShortName }}{% endblock %}
{% block page_title %}{{ (isEdit ? 'editTopicPageHeading' : 'newTopicPageHeading')|trans }} - {{ program.displayShortName }}{% endblock %}

{% block main %}
    <div class="card">
        <div class="card-body">
            {{ form_start(form) }}
                {{ form_errors(form) }}
                <div class="row">
                    <div class="col-md-6">{{ form_row(form.name) }}</div>
                    <div class="col-md-6">{{ form_row(form.topicGroup) }}</div>
                    {# Several titulaires per matière: each keeps their own evaluations inside the
                       class's carnet de notes, reading the whole of it and writing only their own
                       (App\Security\Voter\EvaluationVoter). #}
                    <div class="col-md-6">
                        <label class="form-label" for="teachers">{{ 'topicTeachersFieldLabel'|trans }}</label>
                        <select id="teachers" name="teachers[]" class="form-select" multiple
                                data-controller="tom-select"
                                data-tom-select-url-value="{{ path('app_program_timetable_settings_teachers_search', {id: program.id}) }}"
                                data-tom-select-placeholder-value="{{ 'topicTeachersFieldPlaceholder'|trans }}">
                            {% for teacher in (form.vars.data ? form.vars.data.orderedTeachers : []) %}
                                <option value="{{ teacher.id }}" selected>{{ teacher.displayName ?? teacher.username }}</option>
                            {% endfor %}
                        </select>
                        <div class="form-hint">{{ 'topicTeachersFieldHelp'|trans }}</div>
                    </div>
                    <div class="col-md-6">{{ form_row(form.coefficient) }}</div>
                    <div class="col-md-4">{{ form_row(form.targetCmHours) }}</div>
                    <div class="col-md-4">{{ form_row(form.targetTdHours) }}</div>
                    <div class="col-md-4">{{ form_row(form.targetTpHours) }}</div>
                    <div class="col-12">{{ form_row(form.description) }}</div>
                </div>
                <div class="d-flex justify-content-between">
                    <a href="{{ path('app_program_timetable_settings_topics', {id: program.id}) }}" class="btn btn-link">{{ 'cancelAction'|trans }}</a>
                    {{ form_widget(form.submit, {'label': isEdit ? 'submitEditAction' : 'submitCreateAction'}) }}
                </div>
                {{ form_rest(form) }}
            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}
