<form method="post" action="{{ path('app_program_internship_contract_modalities', {id: program.id}) }}">
    <input type="hidden" name="_token" value="{{ csrf_token('program_internship_contract_modalities') }}">

    {% for block in blocks %}
        {% set contractType = block.contractType %}
        {% set override = block.override %}
        <div class="d-flex flex-column gap-2{{ not loop.first ? ' mt-4' }}">
            <div class="cm-subhead">
                <div class="cm-subhead__title">{{ contractType.code.labelKey|trans }}</div>
                {% if override %}
                    <span class="badge bg-green-lt">{{ 'internshipContractModalityOverriddenBadge'|trans }}</span>
                    <form method="post" action="{{ path(resetRoute|default('app_program_internship_contract_modalities_reset'), {id: program.id, code: contractType.code.value}) }}" class="d-inline">
                        <input type="hidden" name="_token" value="{{ csrf_token('program_internship_contract_modalities') }}">
                        <button type="submit" class="btn btn-link btn-sm text-danger p-0">{{ 'internshipContractModalityResetAction'|trans }}</button>
                    </form>
                {% else %}
                    <span class="badge bg-secondary-lt">{{ 'internshipContractModalityInheritedBadge'|trans }}</span>
                {% endif %}
            </div>
            <div class="cm-editorblock" data-controller="editorblock" data-editorblock-height-value="200" data-editorblock-seed-value="{{ contractType.defaultModalitiesHtml }}">
                <div class="cm-editorblock__body{{ not override ? ' d-none' }}" data-editorblock-target="body">
                    <textarea class="form-control d-none" rows="8" name="modalities[{{ contractType.code.value }}]"
                              {% if override %}data-controller="hugerte-editor" data-hugerte-editor-height-value="200"{% endif %}
                              data-editorblock-target="textarea"
                    >{{ override ? override.modalitiesHtml : '' }}</textarea>
                </div>
                <div class="cm-editorblock__empty cm-editorblock__empty--preview{{ override ? ' d-none' }}" data-editorblock-target="empty">
                    <div class="cm-editorblock__default-preview">
                        {{ contractType.defaultModalitiesHtml|default('internshipContractModalityDefaultEmptyText'|trans)|raw }}
                    </div>
                    <button type="button" class="cm-editorblock__customize" data-action="editorblock#customize">{{ 'internshipContractModalitySurchargerAction'|trans }}</button>
                </div>
            </div>
        </div>
    {% endfor %}

    <div class="cm-actionbar mt-4">
        <div class="cm-actionbar__buttons">
            <a href="{{ path(backRoute|default('app_program_internship_tutors'), {id: program.id}) }}" class="btn btn-link">{{ 'cancelAction'|trans }}</a>
            <button type="submit" class="btn btn-primary">{{ 'submitSaveAction'|trans }}</button>
        </div>
    </div>
</form>
