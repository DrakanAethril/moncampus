{# Visibility state badge of a part (mockup 2a): green when it is readable, amber when it is
   scheduled, grey when it is hidden. The date only appears when it means something. #}
{% if visibility.value == 'hidden' %}
    <span class="cm-badge cm-badge--gray">{{ 'lessonLogVisibilityHiddenBadge'|trans }}</span>
{% elseif visibility.value == 'now' %}
    <span class="cm-badge cm-badge--green">{{ 'lessonLogVisibilityNowBadge'|trans }}</span>
{% elseif visibleAt is not null and visibleAt <= date() %}
    <span class="cm-badge cm-badge--green">{{ 'lessonLogVisibilitySinceBadge'|trans({'%date%': visibleAt|date('d/m/Y H:i')}) }}</span>
{% else %}
    <span class="cm-badge cm-badge--gold">{{ 'lessonLogVisibilityScheduledBadge'|trans({'%date%': visibleAt ? visibleAt|date('d/m/Y H:i') : '—'}) }}</span>
{% endif %}
