{# Expects `program`. Mirrors LessonSessionEventFormatter::optionColor()/optionLegendKey(): one
   swatch per Option assigned to the Program, plus a default swatch for sessions with no Option or
   more than one. Each swatch is a button (not a static div) - clicking it toggles that legend's
   sessions on/off via the shared lesson-timetable Stimulus controller's toggleLegend action (see
   assets/controllers/lesson_timetable_controller.js), which this legend must be a descendant of. #}
<div class="mt-3 d-flex flex-wrap gap-3">
    {% for option in program.options %}
        <button type="button" class="cm-legend-item" data-legend-key="{{ option.id }}" data-action="lesson-timetable#toggleLegend">
            <span class="badge" style="background-color: {{ option.color }};">&nbsp;</span>
            {{ option.shortName }}
        </button>
    {% endfor %}
    <button type="button" class="cm-legend-item" data-legend-key="default" data-action="lesson-timetable#toggleLegend">
        <span class="badge" style="background-color: var(--tblr-primary);">&nbsp;</span>
        {{ 'timetableLegendDefaultLabel'|trans }}
    </button>
</div>
