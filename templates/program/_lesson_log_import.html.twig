{# « Importer depuis une séance » (mockup 2a): take back the cahier de texte of the same lesson given
   elsewhere. The library séance first, when the slot comes from one, then the suggestions, then the
   full list. Each entry saves: that is what allows taking the documents and the assignments over too,
   and what the confirmation announces. #}
<div class="dropdown">
    <button type="button" class="btn btn-outline-primary dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">{{ 'lessonLogImportAction'|trans }}</button>
    <div class="dropdown-menu dropdown-menu-end cm-import-menu">
        <div class="cm-visibility-menu__title">{{ 'lessonLogImportMenuTitle'|trans }}</div>

        {% if seanceInstance %}
            {% include 'program/_lesson_log_import_row.html.twig' with {
                label: 'lessonLogImportLibraryLabel'|trans,
                meta: seanceInstance.titre ~ (seanceInstance.sequenceInstance ? ' · ' ~ seanceInstance.sequenceInstance.titre : ''),
                url: path('app_program_timetable_session_log_import_library', {id: program.id, sessionId: session.id}),
                confirmMessage: hasContent ? 'lessonLogImportLibraryConfirmMessage'|trans : null
            } %}
        {% endif %}

        {% for suggestion in suggestions %}
            {% include 'program/_lesson_log_import_row.html.twig' with {
                label: {'otherGroup': 'lessonLogImportOtherGroupLabel', 'previousYear': 'lessonLogImportPreviousYearLabel'}[suggestion.kind]|trans,
                meta: suggestion.session.program.displayShortName ~ ' — ' ~ suggestion.session.displayName ~ ' · ' ~ suggestion.session.day|date('d/m/Y'),
                url: path('app_program_timetable_session_log_import', {id: program.id, sessionId: session.id, sourceId: suggestion.session.id}),
                confirmMessage: hasContent ? 'lessonLogImportSessionConfirmMessage'|trans : null
            } %}
        {% endfor %}

        {% set suggestedIds = suggestions|map(x => x.session.id) %}
        {% set others = browsable|filter(s => s.id not in suggestedIds) %}
        {% if others is not empty %}
            <div class="cm-visibility-menu__title mt-3">{{ 'lessonLogImportBrowseTitle'|trans }}</div>
            {% for source in others|slice(0, 8) %}
                {% include 'program/_lesson_log_import_row.html.twig' with {
                    label: null,
                    meta: source.program.displayShortName ~ ' — ' ~ source.displayName ~ ' · ' ~ source.day|date('d/m/Y'),
                    url: path('app_program_timetable_session_log_import', {id: program.id, sessionId: session.id, sourceId: source.id}),
                    confirmMessage: hasContent ? 'lessonLogImportSessionConfirmMessage'|trans : null
                } %}
            {% endfor %}
        {% endif %}

        {% if suggestions is empty and others is empty and not seanceInstance %}
            <p class="cm-visibility-menu__note mb-0">{{ 'lessonLogImportEmptyMessage'|trans }}</p>
        {% else %}
            <p class="cm-visibility-menu__note">{{ 'lessonLogImportNote'|trans }}</p>
        {% endif %}
    </div>
</div>
