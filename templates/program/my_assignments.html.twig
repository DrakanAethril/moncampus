{% extends 'layout/app.html.twig' %}

{% block title %}{{ 'myAssignmentsPageHeading'|trans }} - {{ program.displayShortName }}{% endblock %}

{# Depth follows navigation: the entry lives in the formation's own submenu, so the formation is the
   level above - reached, for a student, through its class list (App\Controller\ProgramController
   lets an enrolled student in). Same trail as « Quiz », its neighbour in that submenu. #}
{% block page_breadcrumb %}
    {% include '_breadcrumb.html.twig' with {segments: [
        {label: 'homeNavLabel'|trans, url: path('app_home')},
        {label: program.displayShortName, url: path('app_program_students', {id: program.id})},
        {label: 'programMyAssignmentsNavLabel'|trans, url: app.request.requestUri},
    ]} %}
{% endblock %}
{% block page_title %}{{ 'myAssignmentsPageHeading'|trans }} - {{ program.displayShortName }}{% endblock %}

{% block main %}
    <div class="card">
        <div class="table-responsive">
            <table class="table table-vcenter card-table">
                <thead>
                    <tr>
                        <th>{{ 'assignmentTitleFieldLabel'|trans }}</th>
                        <th>{{ 'assignmentNatureFieldLabel'|trans }}</th>
                        <th>{{ 'assignmentDueDateFieldLabel'|trans }}</th>
                        <th>{{ 'assignmentSubmissionStatusColumnLabel'|trans }}</th>
                        <th class="cm-actions"></th>
                    </tr>
                </thead>
                <tbody>
                    {% for row in rows %}
                        <tr>
                            <td>{{ row.assignment.title }}</td>
                            <td><span class="cm-badge {{ row.assignment.nature.badgeClass }}">{{ row.assignment.nature.labelKey|trans }}</span></td>
                            <td>{{ row.assignment.dueDate|date('d/m/Y') }}</td>
                            <td>
                                {% if row.assignment.expectsSubmission %}
                                    <span class="badge {{ row.status.badgeClass }}">{{ row.status.labelKey|trans }}</span>
                                {% else %}
                                    —
                                {% endif %}
                            </td>
                            <td class="cm-actions">
                                <a href="{{ path('app_program_my_assignment', {id: program.id, assignmentId: row.assignment.id}) }}" class="{{ row.assignment.expectsSubmission and row.status.value == 'missing' ? 'cm-action--positive' : 'cm-action--neutral' }}">
                                    {{ (row.assignment.expectsSubmission and row.status.value == 'missing' ? 'assignmentSubmitButtonLabel' : 'assignmentViewButtonLabel')|trans }}
                                </a>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="5" class="text-secondary">{{ 'myAssignmentsEmptyMessage'|trans }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endblock %}
