{% extends 'layout/app.html.twig' %}

{% block title %}{{ (isEdit ? 'editTopicGroupPageHeading' : 'newTopicGroupPageHeading')|trans }} - {{ program.displayShortName }}{% endblock %}
{% block page_title %}{{ (isEdit ? 'editTopicGroupPageHeading' : 'newTopicGroupPageHeading')|trans }} - {{ program.displayShortName }}{% endblock %}

{% block main %}
    <div class="card">
        <div class="card-body">
            {{ form_start(form) }}
                {{ form_errors(form) }}
                <div class="row">
                    <div class="col-md-6">{{ form_row(form.name) }}</div>
                    {# Same convention as the Enseignant field of topic_new.html.twig: not a form
                       field, an ajax tom-select resolved on the server side from a top-level POST
                       field. Clearable ("no teacher") through the tom-select's own remove button. #}
                    <div class="col-md-6">
                        <label class="form-label" for="teacher">{{ 'topicGroupTeacherFieldLabel'|trans }}</label>
                        <select id="teacher" name="teacher" class="form-select"
                                data-controller="tom-select"
                                data-tom-select-url-value="{{ path('app_program_timetable_settings_teachers_search', {id: program.id}) }}"
                                data-tom-select-placeholder-value="{{ 'topicGroupTeacherFieldPlaceholder'|trans }}">
                            {% if form.vars.data and form.vars.data.teacher %}
                                <option value="{{ form.vars.data.teacher.id }}" selected>{{ form.vars.data.teacher.displayName ?? form.vars.data.teacher.username }}</option>
                            {% endif %}
                        </select>
                    </div>
                    {% if form.options is defined %}
                        <div class="col-12">{{ form_row(form.options) }}</div>
                    {% endif %}
                </div>
                <div class="d-flex justify-content-between">
                    <a href="{{ path('app_program_timetable_settings_topic_groups', {id: program.id}) }}" class="btn btn-link">{{ 'cancelAction'|trans }}</a>
                    {{ form_widget(form.submit, {'label': isEdit ? 'submitEditAction' : 'submitCreateAction'}) }}
                </div>
                {{ form_rest(form) }}
            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}
