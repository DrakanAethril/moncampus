{% extends 'layout/app.html.twig' %}

{% block title %}{{ (isEdit ? 'editEvaluationPageHeading' : 'newEvaluationPageHeading')|trans }} - {{ topic.name }}{% endblock %}

{% block page_breadcrumb %}
    {% include '_breadcrumb.html.twig' with {segments: [
        {label: 'homeNavLabel'|trans, url: path('app_home')},
        {label: program.displayShortName, url: path('app_program_students', {id: program.id})},
        {label: 'gradebookNavLabel'|trans, url: path('app_program_gradebook', {id: program.id, topic: topic.id})},
        {label: (isEdit ? 'editEvaluationPageHeading' : 'newEvaluationPageHeading')|trans, url: app.request.requestUri},
    ]} %}
{% endblock %}
{% block page_title %}{{ (isEdit ? 'editEvaluationPageHeading' : 'newEvaluationPageHeading')|trans }} - {{ topic.name }}{% endblock %}

{% block main %}
    {{ form_start(form, {attr: {class: 'cm-gb-page', 'data-controller': 'evaluation-form'}}) }}
        <a class="cm-gb-back" href="{{ path('app_program_gradebook', {id: program.id, topic: topic.id}) }}">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M12 19l-7-7 7-7"></path></svg>
            {{ 'gradebookEntryBackLabel'|trans }}
        </a>

        <div class="cm-gb-recap">
            <span class="cm-gb-recap__label">{{ 'gradebookFormRecapLabel'|trans }}</span>
            <span class="cm-gb-recap__chip">{{ topic.name }}</span>
            <span class="cm-gb-recap__chip">{{ program.displayShortName }}</span>
        </div>

        {{ form_errors(form) }}

        {# Two columns separated by a rule: what the evaluation IS on the left, how it is graded and
           when it appears on the right. #}
        <div class="cm-gb-panel cm-gb-panel--split">
            <div class="cm-gb-panel__col">
                <div class="cm-gb-fieldset">
                    <label class="cm-gb-label" for="{{ form.name.vars.id }}">{{ 'evaluationNameFieldLabel'|trans }}</label>
                    {{ form_widget(form.name, {attr: {class: 'form-control', autofocus: true, placeholder: 'evaluationNameFieldPlaceholder'|trans}}) }}
                    {{ form_errors(form.name) }}
                </div>

                {# Support: three clickable cards. The radios stay in the DOM (the <label> wraps them)
                   - it is :has(input:checked) that paints the card, with no JavaScript. #}
                <div class="cm-gb-fieldset">
                    <span class="cm-gb-label">{{ 'evaluationTypeFieldLabel'|trans }}</span>
                    <div class="cm-gb-pickcards">
                        {% for choice in form.type %}
                            <label class="cm-gb-pickcard cm-gb-pickcard--{{ choice.vars.value }}">
                                {{ form_widget(choice) }}
                                <b>{{ choice.vars.label|trans }}</b>
                                <span>{{ ('evaluationType' ~ choice.vars.value|capitalize ~ 'HintText')|trans }}</span>
                            </label>
                        {% endfor %}
                    </div>
                    {{ form_errors(form.type) }}
                </div>

                <div class="cm-gb-fieldrow">
                    <div class="cm-gb-fieldset">
                        <span class="cm-gb-label">{{ 'evaluationModalityFieldLabel'|trans }}</span>
                        <div class="cm-gb-seg">
                            {% for choice in form.modality %}
                                <label class="cm-gb-seg__opt">{{ form_widget(choice) }}{{ choice.vars.label|trans }}</label>
                            {% endfor %}
                        </div>
                    </div>
                    <div class="cm-gb-fieldset">
                        <span class="cm-gb-label">{{ 'evaluationStatusFieldLabel'|trans }}</span>
                        <div class="cm-gb-seg">
                            {% for choice in form.status %}
                                <label class="cm-gb-seg__opt">{{ form_widget(choice) }}{{ choice.vars.label|trans }}</label>
                            {% endfor %}
                        </div>
                    </div>
                </div>

                {# « Autre » is the field's empty choice (the evaluation then belongs to no
                   progression). Symfony always renders that choice first: it is pushed to the end of
                   the segment to keep the Diagnostique/Formative/Sommative/Autre order. #}
                <div class="cm-gb-fieldset">
                    <span class="cm-gb-label">{{ 'evaluationNatureFieldLabel'|trans }}</span>
                    <div class="cm-gb-seg">
                        {% for choice in form.nature.children|filter(c => c.vars.value is not empty)|merge(form.nature.children|filter(c => c.vars.value is empty)) %}
                            <label class="cm-gb-seg__opt">{{ form_widget(choice) }}{{ choice.vars.label|trans }}</label>
                        {% endfor %}
                    </div>
                    <span class="cm-gb-hint">{{ 'evaluationNatureFieldHelpText'|trans }}</span>
                </div>
            </div>

            <div class="cm-gb-panel__rule"></div>

            <div class="cm-gb-panel__col">
                <div class="cm-gb-fieldrow">
                    <div class="cm-gb-fieldset">
                        <label class="cm-gb-label" for="{{ form.date.vars.id }}">{{ 'evaluationDateFieldLabel'|trans }}</label>
                        {{ form_widget(form.date, {attr: {class: 'form-control'}}) }}
                    </div>
                    <div class="cm-gb-fieldset cm-gb-fieldset--narrow">
                        <label class="cm-gb-label" for="{{ form.scale.vars.id }}">{{ 'evaluationScaleFieldLabel'|trans }}</label>
                        {{ form_widget(form.scale, {attr: {class: 'form-control'}}) }}
                    </div>
                    <div class="cm-gb-fieldset cm-gb-fieldset--narrow">
                        <label class="cm-gb-label" for="{{ form.coefficient.vars.id }}">{{ 'evaluationCoefficientFieldLabel'|trans }}</label>
                        {{ form_widget(form.coefficient, {attr: {class: 'form-control'}}) }}
                    </div>
                </div>

                <div class="cm-gb-fieldset gap-1">
                    <label class="cm-gb-check">
                        {{ form_widget(form.countsOutOf20) }}
                        {{ 'evaluationCountsOutOf20FieldLabel'|trans }}
                    </label>
                    <span class="cm-gb-hint cm-gb-hint--indent">{{ 'evaluationCountsOutOf20FieldHelpText'|trans }}</span>
                </div>

                <div class="cm-gb-fieldset gap-1">
                    <label class="cm-gb-check">
                        {{ form_widget(form.hasRubric) }}
                        {{ 'evaluationHasRubricFieldLabel'|trans }}
                    </label>
                    <span class="cm-gb-hint cm-gb-hint--indent">{{ 'evaluationHasRubricFieldHelpText'|trans }}</span>
                </div>

                {# Visibility: an Immédiate/Programmée segment that shows or hides the date+time pair.
                   The hasScheduledVisibility checkbox stays the field actually submitted (see
                   ProgramGradebookController::evaluationForm()), the segment only drives it.
                   On creation, it arrives ticked on now + 24 h. #}
                <div class="cm-gb-fieldset" data-evaluation-form-target="visibility">
                    <span class="cm-gb-label">{{ 'evaluationVisibilityFieldLabel'|trans }}</span>
                    <div class="d-flex align-items-center gap-3 flex-wrap">
                        <div class="cm-gb-seg cm-gb-seg--pad">
                            <label class="cm-gb-seg__opt">
                                <input type="radio" name="visibility_mode" value="now" {{ form.hasScheduledVisibility.vars.checked ? '' : 'checked' }} data-action="change->evaluation-form#setVisibility">
                                {{ 'evaluationVisibilityImmediateLabel'|trans }}
                            </label>
                            <label class="cm-gb-seg__opt">
                                <input type="radio" name="visibility_mode" value="scheduled" {{ form.hasScheduledVisibility.vars.checked ? 'checked' : '' }} data-action="change->evaluation-form#setVisibility">
                                {{ 'evaluationVisibilityScheduledLabel'|trans }}
                            </label>
                        </div>
                        {# A dedicated class and not .d-flex: the latter carries an !important that
                           would beat the hidden attribute, leaving the field visible. #}
                        <div class="cm-gb-visfields" data-evaluation-form-target="scheduledFields" {{ form.hasScheduledVisibility.vars.checked ? '' : 'hidden' }}>
                            <span class="cm-gb-recap__label">{{ 'evaluationVisibilityFromLabel'|trans }}</span>
                            {{ form_widget(form.visibleAt, {attr: {class: 'form-control'}}) }}
                        </div>
                    </div>
                    <span class="cm-gb-hint" data-evaluation-form-target="scheduledHint" {{ form.hasScheduledVisibility.vars.checked ? '' : 'hidden' }}>
                        {{ 'evaluationVisibleAtFieldHelpText'|trans }}
                    </span>
                    <div class="d-none">{{ form_widget(form.hasScheduledVisibility, {attr: {'data-evaluation-form-target': 'scheduledCheckbox'}}) }}</div>
                </div>
            </div>
        </div>

        <div class="cm-gb-actions">
            <a href="{{ path('app_program_gradebook', {id: program.id, topic: topic.id}) }}" class="btn btn-outline-secondary">{{ 'cancelAction'|trans }}</a>
            <button type="submit" name="save" value="1" class="btn btn-outline-primary">
                {{ (isEdit ? 'submitEditAction' : 'submitCreateAction')|trans }}
            </button>
            <button type="submit" name="saveAndEnter" value="1" class="btn btn-primary">
                {{ (isEdit ? 'gradebookFormSaveAndEnterLabel' : 'gradebookFormCreateAndEnterLabel')|trans }}
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="ms-1"><path d="M5 12h14M12 5l7 7-7 7"></path></svg>
            </button>
        </div>

        {{ form_rest(form) }}
    {{ form_end(form) }}
{% endblock %}
