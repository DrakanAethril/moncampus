{# Shared per-question breakdown, reused by the student's own correction screen (1m,
   quiz_correction.html.twig - entraînement only) and the teacher's "Voir la copie" screen
   (quiz_attempt_show.html.twig - any mode). `attempt` is the only expected variable. #}
<div class="d-flex flex-column gap-2">
    {% for attemptAnswer in attempt.attemptAnswers %}
        {% set question = attemptAnswer.instanceQuestion %}
        {% set selectedIds = attemptAnswer.selectedAnswers|map(sa => sa.instanceAnswer.id) %}
        <div class="card">
            <div class="card-body py-3">
                <div class="d-flex align-items-center gap-2">
                    <span class="d-flex align-items-center justify-content-center" style="width:22px;height:22px;border-radius:50%;flex:none;color:#fff;font-size:12px;background:{{ attemptAnswer.isCorrect ? 'var(--cm-positive-tx)' : 'var(--cm-red-tx)' }};">{{ attemptAnswer.isCorrect ? '✓' : '✕' }}</span>
                    <span class="text-secondary" style="font:600 12px ui-monospace, monospace;">Q{{ loop.index }}</span>
                    {# A texte à trous *is* its statement: it gets replayed just below with the
                       student's words in place, so repeating it here with raw "..." markers would
                       print the same sentence twice. #}
                    <span style="font:600 14.5px var(--cm-font-ui); color: var(--cm-ink);">
                        {{- question.type.value == 'texte_a_trous' ? question.type.labelKey|trans : question.label -}}
                    </span>
                    {# Only the partial-credit types (texte à trous, légende) can land between 0 and
                       their full worth - showing the fraction on the others would just repeat the
                       ✓/✕ badge. A weighted Zone question still shows its barème. #}
                    {% if (question.type.value in ['texte_a_trous', 'legende', 'apparier'] or (question.type.value == 'zone' and question.points != 1)) and attemptAnswer.score is not null %}
                        <span class="cm-badge cm-badge--gold">{{ attemptAnswer.score }} / {{ question.points }}</span>
                    {% endif %}
                    {% if attemptAnswer.isCorrect %}
                        <a class="ms-auto small" data-bs-toggle="collapse" href="#correction-{{ attemptAnswer.id }}" role="button">{{ 'programQuizSeeDetailAction'|trans }} ▾</a>
                    {% endif %}
                </div>
                <div class="{{ attemptAnswer.isCorrect ? 'collapse' : '' }}" id="correction-{{ attemptAnswer.id }}">
                    <div class="d-flex gap-2 flex-wrap" style="padding-left:32px; margin-top:10px;">
                        {% if question.type.value == 'texte_a_trous' %}
                            {# The statement replayed with what the student put in each blank, green
                               or red, followed by what would have been accepted for the wrong ones. #}
                            {% set responses = attemptAnswer.blankResponses %}
                            {% set results = blank_results(question, responses) %}
                            {% set expected = question.blankAnswers %}
                            <div class="d-flex flex-column gap-2">
                                <div class="cm-blanks-text">
                                    {%- for segment in question.blankSegments -%}
                                        {%- if segment.type == 'text' -%}
                                            {{- segment.value -}}
                                        {%- else -%}
                                            <span class="cm-blank-slot {{ results[segment.index] ? 'cm-blank-slot--correct' : 'cm-blank-slot--wrong' }}">
                                                {{- responses[segment.index]|default('') ?: '—' -}}
                                            </span>
                                        {%- endif -%}
                                    {%- endfor -%}
                                </div>
                                {% for index, isRight in results %}
                                    {% if not isRight and expected[index] is not empty %}
                                        <div class="cm-blank-expected">
                                            {{ 'quizBlankIndexLabel'|trans({'%number%': index + 1}) }} — {{ 'quizBlankExpectedAnswersTemplate'|trans({'%answers%': expected[index]|join(', ')}) }}
                                        </div>
                                    {% endif %}
                                {% endfor %}
                            </div>
                        {% elseif question.type.value == 'zone' %}
                            {# The support replayed read-only: the expected zone(s) in green, a
                               wrongly clicked one in red, its feedback text underneath. #}
                            {% set clicked = attemptAnswer.zoneResponses %}
                            {% set states = {} %}
                            {% for zoneId in question.zoneCorrectIds %}
                                {% set states = states|merge({(zoneId): 'good'}) %}
                            {% endfor %}
                            {% for zoneId in clicked %}
                                {% if zoneId not in question.zoneCorrectIds %}
                                    {% set states = states|merge({(zoneId): 'bad'}) %}
                                {% endif %}
                            {% endfor %}
                            <div class="d-flex flex-column gap-2" style="min-width: 0;">
                                {% include 'quiz/_zone_support.html.twig' with {
                                    question: question,
                                    states: states,
                                    image_url: question.imageStorageKey ? file_url(question.imageStorageKey) : null,
                                } only %}
                                {% for zoneId in clicked %}
                                    {% set feedback = question.zoneFeedbackFor(zoneId) %}
                                    {% if feedback %}
                                        <div class="cm-blank-expected" style="color: var(--cm-red-tx);">{{ feedback }}</div>
                                    {% endif %}
                                {% endfor %}
                            </div>
                        {% elseif question.type.value == 'legende' %}
                            {% set placements = attemptAnswer.zoneResponses %}
                            {% set results = zone_results(question, placements) %}
                            {% set choiceTexts = {} %}
                            {% for choice in question.legendeChoices %}
                                {% set choiceTexts = choiceTexts|merge({(choice.key): choice.text}) %}
                            {% endfor %}
                            {% set states = {} %}
                            {% set placed = {} %}
                            {% for zoneId, isRight in results %}
                                {% set states = states|merge({(zoneId): isRight ? 'good' : 'bad'}) %}
                                {% if placements[zoneId]|default('') is not empty %}
                                    {% set placed = placed|merge({(zoneId): choiceTexts[placements[zoneId]]|default('—')}) %}
                                {% endif %}
                            {% endfor %}
                            <div class="d-flex flex-column gap-2" style="min-width: 0;">
                                {% include 'quiz/_zone_support.html.twig' with {
                                    question: question,
                                    states: states,
                                    placed: placed,
                                    image_url: question.imageStorageKey ? file_url(question.imageStorageKey) : null,
                                } only %}
                                {% set labelTexts = question.zoneLabelTexts %}
                                {% for zoneId, isRight in results %}
                                    {% if not isRight %}
                                        <div class="cm-blank-expected">{{ 'quizLegendeExpectedTemplate'|trans({'%zone%': loop.index, '%label%': labelTexts[zoneId]|default(zoneId)}) }}</div>
                                    {% endif %}
                                {% endfor %}
                            </div>
                        {% elseif question.type.value == 'apparier' %}
                            {# Every pair replayed with what the student put in its slot, green or
                               red, the expected item beside it, and the pair's own feedback under
                               the board for the ones they got wrong. #}
                            {% set associations = attemptAnswer.matchingResponses %}
                            {% set results = matching_results(question, associations) %}
                            {% set choiceTexts = {} %}
                            {% for choice in question.matchingChoices %}
                                {% set choiceTexts = choiceTexts|merge({(choice.key): choice.text}) %}
                            {% endfor %}
                            {% set placed = {} %}
                            {% for pairId, key in associations %}
                                {% set placed = placed|merge({(pairId): choiceTexts[key]|default('—')}) %}
                            {% endfor %}
                            <div class="d-flex flex-column gap-2" style="min-width: 0;">
                                {% include 'quiz/_matching_board.html.twig' with {
                                    question: question,
                                    results: results,
                                    placed: placed,
                                    reveal: true,
                                } only %}
                                {% for pairId, isRight in results %}
                                    {% if not isRight %}
                                        {% set feedback = question.matchingFeedbackFor(pairId) %}
                                        {% if feedback %}
                                            <div class="cm-blank-expected" style="color: var(--cm-red-tx);">{{ feedback }}</div>
                                        {% endif %}
                                    {% endif %}
                                {% endfor %}
                            </div>
                        {% elseif question.type.value == 'ordre' %}
                            <div class="d-flex flex-column gap-1">
                                <div class="small text-secondary">{{ 'programQuizYourOrderLabel'|trans }}</div>
                                {% for sa in attemptAnswer.selectedAnswers %}
                                    <div>{{ loop.index }}. {{ sa.instanceAnswer.label }}</div>
                                {% endfor %}
                                {% if not attemptAnswer.isCorrect %}
                                    <div class="small text-secondary mt-2">{{ 'programQuizCorrectOrderLabel'|trans }}</div>
                                    {% for a in question.answers|sort((a, b) => a.orderIndex <=> b.orderIndex) %}
                                        <div>{{ loop.index }}. {{ a.label }}</div>
                                    {% endfor %}
                                {% endif %}
                            </div>
                        {% else %}
                            {% for a in question.answers %}
                                {% set isSelected = a.id in selectedIds %}
                                {% if a.correct %}
                                    <span class="badge" style="border:1px solid color-mix(in srgb, var(--cm-positive-tx) 45%, var(--cm-border)); background:var(--cm-green-bg); color:var(--cm-positive-tx); font-weight:600; padding:7px 13px;">✓ {{ a.label }}{% if isSelected %} <span class="fw-normal">— {{ 'programQuizYourAnswerSuffix'|trans }}</span>{% else %} <span class="fw-normal">— {{ 'programQuizCorrectAnswerSuffix'|trans }}</span>{% endif %}</span>
                                {% elseif isSelected %}
                                    <span class="badge" style="border:1px solid color-mix(in srgb, var(--cm-red-tx) 45%, var(--cm-border)); background:var(--cm-red-bg); color:var(--cm-red-tx); font-weight:600; padding:7px 13px; text-decoration:line-through;">{{ a.label }} <span class="fw-normal" style="text-decoration:none;">— {{ 'programQuizYourAnswerSuffix'|trans }}</span></span>
                                {% else %}
                                    <span class="badge" style="border:1px solid var(--cm-border); color:var(--cm-faint); padding:7px 13px;">{{ a.label }}</span>
                                {% endif %}
                            {% endfor %}
                        {% endif %}
                    </div>
                    {# 1m's "Correction : …" callout - only where it earns its place, under a
                       question the student actually got wrong. #}
                    {% if question.explanation and not attemptAnswer.isCorrect %}
                        <div class="cm-note" style="margin: 10px 0 0 32px;">
                            <span class="cm-note__icon">i</span>
                            <div><b>{{ 'programQuizExplanationLabel'|trans }}</b> {{ question.explanation }}</div>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    {% endfor %}
</div>
