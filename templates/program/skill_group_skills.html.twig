{% extends 'layout/app.html.twig' %}

{% block title %}{{ 'skillsPageHeading'|trans }} - {{ skillGroup.label }}{% endblock %}

{% block page_breadcrumb %}
    {# Middle segments from the controller - see App\Controller\SkillGroupCrudTrait::skillBreadcrumb(). #}
    {% include '_breadcrumb.html.twig' with {segments: [{label: 'homeNavLabel'|trans, url: path('app_home')}]
        |merge(skillBreadcrumb|map(s => {label: s.labelKey ? s.labelKey|trans : s.label, url: s.url}))
        |merge([{label: skillGroup.label, url: app.request.requestUri}]) } %}
{% endblock %}
{% block page_title %}{{ 'skillsPageHeading'|trans }} - {{ skillGroup.label }}{% endblock %}

{% block main %}
    <div class="mb-3">
        <a href="{{ path(skillRoutes.list, {id: program.id}) }}">&laquo; {{ 'backToInternshipSkillGroupsLinkLabel'|trans }}</a>
    </div>
    <div class="card">
        <div class="card-header d-flex align-items-center">
            <div class="ms-auto">
                <a href="{{ path(skillRoutes.skillNew, {id: program.id, groupId: skillGroup.id}) }}" class="btn btn-primary">
                    <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M12 5l0 14" /><path d="M5 12l14 0" /></svg>
                    {{ 'addSkillButtonLabel'|trans }}
                </a>
            </div>
        </div>
        <div class="card-body">
            {# Server-rendered and drag-reorderable, same reasoning as the skill-group list itself. #}
            <div data-frankenphp-hot-reload-preserve
                 data-controller="deactivable-list"
                 data-deactivable-list-deactivate-url-template-value="{{ path(skillRoutes.skillDeactivate, {id: program.id, groupId: skillGroup.id, skillId: '__ID__'}) }}"
                 data-deactivable-list-token-value="{{ csrf_token('program_settings_deactivate') }}"
                 data-deactivable-list-deactivate-confirm-message-value="{{ 'deactivateConfirmMessage'|trans }}"
                 data-deactivable-list-error-message-value="{{ 'deactivateErrorMessage'|trans }}">
                <div class="form-check form-switch mb-2">
                    <input class="form-check-input" type="checkbox" id="program-skill-group-skills-include-inactive" data-deactivable-list-target="includeInactive" data-action="change->deactivable-list#toggleInactive">
                    <label class="form-check-label" for="program-skill-group-skills-include-inactive">{{ 'showInactiveFilterLabel'|trans }}</label>
                </div>
                <div class="table-responsive">
                    <table class="table table-vcenter card-table table-striped">
                        <thead>
                            <tr>
                                <th></th>
                                <th>{{ 'skillCodeColumnLabel'|trans }}</th>
                                <th>{{ 'skillLabelColumnLabel'|trans }}</th>
                                <th>{{ 'skillVolumeHoursColumnLabel'|trans }}</th>
                                <th>{{ 'skillTeachingPeriodColumnLabel'|trans }}</th>
                                <th>{{ 'skillTeacherColumnLabel'|trans }}</th>
                                <th>{{ 'skillContentColumnLabel'|trans }}</th>
                                <th class="cm-actions"></th>
                            </tr>
                        </thead>
                        <tbody data-controller="sortable-reorder"
                               data-sortable-reorder-url-value="{{ path(skillRoutes.skillsReorder, {id: program.id, groupId: skillGroup.id}) }}"
                               data-sortable-reorder-token-value="{{ csrf_token('program_settings_skills_reorder') }}">
                            {% for skill in skills %}
                                {% set isInactive = skill.inactiveDate is not null %}
                                {% set isDocumented = skill.occupationDescription and skill.knowledgeHtml and skill.activitiesHtml and skill.performanceCriteriaHtml %}
                                <tr data-deactivable-list-target="row" data-inactive="{{ isInactive ? 'true' : 'false' }}"{{ isInactive ? ' hidden' : '' }} data-sortable-reorder-id-param="{{ skill.id }}">
                                    <td><span class="sortable-reorder-handle" style="cursor: grab; color: var(--cm-faint, #8a99a6);">&#10287;</span></td>
                                    <td>
                                        {% if skill.code %}
                                            <span class="badge bg-blue-lt">{{ skill.code }}</span>
                                        {% else %}
                                            <span class="text-secondary">&mdash;</span>
                                        {% endif %}
                                    </td>
                                    <td>
                                        {{ skill.label }}
                                        {% if isInactive %}<span class="badge bg-secondary-lt ms-2">{{ 'deactivatedStatusLabel'|trans }}</span>{% endif %}
                                    </td>
                                    <td class="text-secondary">{{ skill.volumeHours ? 'skillVolumeHoursValue'|trans({'%hours%': skill.volumeHours|number_format(0, ',', ' ')}) : '—' }}</td>
                                    <td class="text-secondary">{{ skill.teachingPeriodLabel ?: '—' }}</td>
                                    <td class="text-secondary">{{ skill.teacher ? (skill.teacher.displayName ?? skill.teacher.username) : '—' }}</td>
                                    <td>
                                        {% if isDocumented %}
                                            <span class="badge bg-green-lt">{{ 'skillDocumentedBadge'|trans }}</span>
                                        {% else %}
                                            <span class="badge bg-yellow-lt">{{ 'skillIncompleteBadge'|trans }}</span>
                                        {% endif %}
                                    </td>
                                    <td class="cm-actions">
                                        <a href="{{ path(skillRoutes.skillEdit, {id: program.id, groupId: skillGroup.id, skillId: skill.id}) }}" class="cm-action--warning">{{ 'editActionLabel'|trans }}</a>
                                        {% if not isInactive %}
                                            <button type="button" class="cm-action--danger" data-id="{{ skill.id }}" data-action="click->deactivable-list#deactivate">{{ 'deactivateActionLabel'|trans }}</button>
                                        {% endif %}
                                    </td>
                                </tr>
                            {% else %}
                                <tr>
                                    <td colspan="8" class="text-center text-secondary">{{ 'datatableZeroRecordsLabel'|trans }}</td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
