{# Les quatre choix de la maquette, en radios du formulaire principal : changer la visibilité ne
   sauvegarde plus rien de soi-même, c'est le bouton Enregistrer qui la porte avec le reste. #}
<div class="cm-visibility-menu__title">{{ 'lessonLogVisibilityMenuTitle'|trans }}</div>
{% for choice in visibilityField %}
    <label class="cm-visibility-option {{ choice.vars.checked ? 'is-selected' }}">
        {{ form_widget(choice) }}
        <span>{{ choice.vars.label|trans }}</span>
    </label>
{% endfor %}
{% do visibilityField.setRendered %}

{# La date ne concerne que « choisir date et heure » ; elle reste soumise dans tous les cas, le
   modèle l'effaçant lui-même dès qu'un autre choix est retenu. #}
<div class="mt-2">{{ form_widget(visibleAtField) }}</div>
{% do visibleAtField.setRendered %}

<p class="cm-visibility-menu__note">{{ 'lessonLogVisibilityMenuNote'|trans }}</p>
