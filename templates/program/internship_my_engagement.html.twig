{% extends 'layout/app.html.twig' %}

{% block title %}{{ 'ufaAlternanceEngagementPageHeading'|trans }}{% endblock %}

{% block page_breadcrumb %}
    {% include '_breadcrumb.html.twig' with {segments: [
        {label: 'homeNavLabel'|trans, url: path('app_home')},
        {label: program.displayShortName, url: path('app_program_internship_my_evaluations', {id: program.id})},
        {label: 'ufaAlternanceEngagementPageHeading'|trans, url: app.request.requestUri},
    ]} %}
{% endblock %}
{% block page_title %}{{ 'ufaAlternanceEngagementPageHeading'|trans }}{% endblock %}

{% block main %}
    <div class="card">
        <div class="card-header"><h3 class="card-title">{{ 'ufaAlternanceEngagementClausesTitle'|trans }}</h3></div>
        <div class="card-body">
            <ol class="mb-0">
                <li class="mb-2">{{ 'ufaAlternanceEngagementClause1'|trans }}</li>
                <li class="mb-2">{{ 'ufaAlternanceEngagementClause2'|trans }}</li>
                <li class="mb-2">{{ 'ufaAlternanceEngagementClause3'|trans }}</li>
                <li>{{ 'ufaAlternanceEngagementClause4'|trans }}</li>
            </ol>
        </div>
        <div class="card-footer d-flex justify-content-between align-items-center">
            {% if engagement.signedStudentAt %}
                <span class="badge bg-green-lt">{{ 'ufaAlternanceEngagementSignedOnLabel'|trans({'%date%': engagement.signedStudentAt|date('d/m/Y')}) }}</span>
            {% else %}
                <span class="text-secondary small">{{ 'ufaAlternanceEngagementStudentPromptLabel'|trans }}</span>
                <form method="post" action="{{ path('app_program_internship_my_engagement_sign', {id: program.id}) }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('program_internship_my_engagement_sign') }}">
                    <button type="submit" class="btn btn-primary btn-sm">{{ 'ufaAlternanceEngagementSignButtonLabel'|trans }}</button>
                </form>
            {% endif %}
        </div>
    </div>
{% endblock %}
