{% extends 'layout/app.html.twig' %}

{% block title %}{{ 'gradebookStudentPageHeading'|trans }} - {{ program.displayShortName }}{% endblock %}

{% block page_breadcrumb %}
    {% include '_breadcrumb.html.twig' with {segments: [
        {label: 'homeNavLabel'|trans, url: path('app_home')},
        {label: program.displayShortName, url: path('app_program_students', {id: program.id})},
        {label: 'gradebookStudentPageHeading'|trans, url: app.request.requestUri},
    ]} %}
{% endblock %}
{% block page_title %}{{ 'gradebookStudentPageHeading'|trans }}{% endblock %}

{% block main %}
    <div class="d-flex flex-column gap-3">
        {% if periods|length > 0 %}
            <div class="d-flex align-items-center gap-2 flex-wrap">
                <span class="cm-gb-label">{{ 'gradebookPeriodFieldLabel'|trans }}</span>
                <div class="cm-gb-seg">
                    {% for period in periods %}
                        <a class="cm-gb-seg__link {{ selectedPeriod and selectedPeriod.id == period.id ? 'is-active' }}"
                           href="{{ path('app_program_gradebook', {id: program.id, period: period.id}) }}">{{ period.name }}</a>
                    {% endfor %}
                    <a class="cm-gb-seg__link {{ selectedPeriod is null ? 'is-active' }}"
                       href="{{ path('app_program_gradebook', {id: program.id}) }}">{{ 'gradebookPeriodFullYearLabel'|trans }}</a>
                </div>
            </div>
        {% endif %}

        <div class="cm-gb-shero">
            <div class="d-flex flex-column gap-1">
                <div class="cm-gb-shero__title">{{ 'gradebookStudentHeroTitle'|trans }}</div>
                <div class="cm-gb-shero__meta">
                    {{ selectedPeriod ? selectedPeriod.name : 'gradebookPeriodFullYearLabel'|trans }}
                    · {{ 'gradebookStudentSubjectsCountLabel'|trans({'%count%': subjects|length}) }}
                    · {{ 'gradebookStudentGradedCountLabel'|trans({'%count%': gradedCount}) }}
                </div>
            </div>
            <div class="d-flex align-items-center gap-3">
                <div class="text-end">
                    <div class="cm-gb-shero__cap">{{ 'gradebookStudentGeneralAverageLabel'|trans }}</div>
                    <div class="cm-gb-shero__sub">{{ 'gradebookStudentAllSubjectsLabel'|trans }}</div>
                </div>
                <div class="cm-gb-shero__avg {{ calculator.gradeColorClass(overallAverage) }}">
                    {{ overallAverage is null ? '—' : overallAverage|number_format(2) }}
                </div>
            </div>
        </div>

        {% if recent|length > 0 %}
            <div class="cm-gb-card">
                <span class="cm-gb-label">{{ 'gradebookStudentRecentLabel'|trans }}</span>
                <div class="cm-gb-recent">
                    {% for row in recent %}
                        <div class="cm-gb-recent__item">
                            <div class="cm-gb-recent__text">
                                <span class="cm-gb-recent__name" title="{{ row.evaluation.name }}">{{ row.evaluation.name }}</span>
                                <span class="cm-gb-recent__meta">{{ row.topic.name }} · {{ row.evaluation.date ? row.evaluation.date|date('d/m') : '—' }}</span>
                            </div>
                            <span class="cm-gb-note {{ calculator.gradeColorClass(row.normalized) }}">{{ row.grade.value }}/{{ row.evaluation.scale }}</span>
                        </div>
                    {% endfor %}
                </div>
            </div>
        {% endif %}

        {% if subjects is empty %}
            <div class="cm-gb-card text-secondary">{{ 'gradebookStudentNoGradeLabel'|trans }}</div>
        {% else %}
            <div class="cm-gb-subjects">
                {% for subject in subjects %}
                    {% set panelId = 'gb-subject-' ~ subject.topic.id %}
                    <button class="cm-gb-subject" type="button" data-bs-toggle="collapse"
                            data-bs-target="#{{ panelId }}" aria-expanded="{{ loop.first ? 'true' : 'false' }}" aria-controls="{{ panelId }}">
                        <span class="d-flex align-items-center gap-3" style="min-width: 0">
                            <span class="cm-gb-subject__chevron">›</span>
                            <span class="d-flex flex-column gap-1 text-start">
                                <span class="cm-gb-subject__name">{{ subject.topic.name }}</span>
                                <span class="cm-gb-subject__sub">
                                    {% if subject.topic.teacher %}{{ subject.topic.teacher.displayName ?? subject.topic.teacher.username }} · {% endif %}
                                    {{ 'gradebookStudentEvaluationsCountLabel'|trans({'%count%': subject.rows|length}) }}
                                    · {{ 'gradebookCoefficientShortLabel'|trans }} {{ subject.topic.coefficient }}
                                </span>
                            </span>
                        </span>
                        <span class="d-flex align-items-center gap-2">
                            <span class="cm-gb-shero__cap">{{ 'gradebookStudentSubjectAverageLabel'|trans }}</span>
                            <span class="cm-gb-subject__avg {{ calculator.gradeColorClass(subject.average) }}">
                                {{ subject.average is null ? '—' : subject.average|number_format(2) }}
                            </span>
                        </span>
                    </button>

                    <div id="{{ panelId }}" class="collapse {{ loop.first ? 'show' }}">
                        {% for row in subject.rows %}
                            <div class="cm-gb-evrow">
                                <div class="d-flex flex-column gap-1 flex-fill" style="min-width: 0">
                                    <span class="cm-gb-evrow__name">{{ row.evaluation.name }}</span>
                                    <div class="cm-gb-evrow__badges">
                                        <span class="cm-gb-badge cm-gb-badge--sm cm-gb-badge--{{ row.evaluation.type.value }}">{{ row.evaluation.type.labelKey|trans }}</span>
                                        <span class="cm-gb-badge cm-gb-badge--sm cm-gb-badge--{{ row.evaluation.modality.value }}">{{ row.evaluation.modality.labelKey|trans }}</span>
                                        <span class="cm-gb-badge cm-gb-badge--sm cm-gb-badge--{{ row.evaluation.status.value }}">{{ row.evaluation.status.labelKey|trans }}</span>
                                        <span class="cm-gb-evrow__meta">
                                            {{ row.evaluation.date ? row.evaluation.date|date('d/m') : '—' }}
                                            · {{ 'gradebookCoefficientShortLabel'|trans }} {{ row.evaluation.coefficient }}
                                        </span>
                                    </div>
                                </div>

                                {% if row.grade is null %}
                                    <span class="cm-gb-val cm-gb-val--empty">—</span>
                                {% elseif row.grade.status.value == 'normal' %}
                                    <span class="cm-gb-note {{ calculator.gradeColorClass(row.normalized) }}">{{ row.grade.value }}/{{ row.evaluation.scale }}</span>
                                {% elseif row.grade.status.value == 'excluded' %}
                                    <span class="cm-gb-val cm-gb-val--paren {{ calculator.gradeColorClass(row.normalized) }}">({{ row.grade.value }})</span>
                                {% else %}
                                    <span class="cm-gb-val cm-gb-val--ne">{{ row.grade.status.shortLabelKey|trans }}</span>
                                {% endif %}
                            </div>
                        {% endfor %}
                    </div>
                {% endfor %}
            </div>
        {% endif %}
    </div>
{% endblock %}
