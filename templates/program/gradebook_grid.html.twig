{% extends 'layout/app.html.twig' %}

{% block title %}{{ 'gradebookPageHeading'|trans }} - {{ program.displayShortName }}{% endblock %}

{% block page_breadcrumb %}
    {% include '_breadcrumb.html.twig' with {segments: [
        {label: 'homeNavLabel'|trans, url: path('app_home')},
        {label: program.displayShortName, url: path('app_program_students', {id: program.id})},
        {label: 'gradebookNavLabel'|trans, url: app.request.requestUri},
    ]} %}
{% endblock %}
{% block page_title %}{{ 'gradebookPageHeading'|trans }} - {{ program.displayShortName }}{% endblock %}

{% block main %}
    <div data-controller="evaluation-grid"
         data-evaluation-grid-editable-value="{{ canEdit ? 'true' : 'false' }}"
         data-evaluation-grid-evaluations-value="{{ evaluationsJson|json_encode }}"
         data-evaluation-grid-roster-value="{{ rosterJson|json_encode }}"
         data-evaluation-grid-grades-value="{{ gradesJson|json_encode(constant('JSON_FORCE_OBJECT')) }}"
         data-evaluation-grid-periods-value="{{ periodsJson|json_encode }}"
         data-evaluation-grid-save-url-template-value="{{ path('app_program_gradebook_save_grade', {id: program.id, evaluationId: '__EVAL_ID__', studentId: '__STUDENT_ID__'}) }}"
         data-evaluation-grid-edit-url-template-value="{{ path('app_program_gradebook_evaluation_edit', {id: program.id, evaluationId: '__EVAL_ID__'}) }}"
         data-evaluation-grid-deactivate-url-template-value="{{ path('app_program_gradebook_evaluation_deactivate', {id: program.id, evaluationId: '__EVAL_ID__'}) }}"
         data-evaluation-grid-entry-url-template-value="{{ path('app_program_gradebook_evaluation_entry', {id: program.id, evaluationId: '__EVAL_ID__'}) }}"
         data-evaluation-grid-csrf-token-value="{{ csrf_token('gradebook_save') }}"
         data-evaluation-grid-labels-value="{{ {
             studentsColumnLabel: 'gradebookStudentsColumnLabel'|trans,
             averageColumnLabel: 'gradebookAverageColumnLabel'|trans,
             sortByAverageTitle: 'gradebookSortByAverageTitle'|trans,
             sortByEvaluationTitle: 'gradebookSortByEvaluationTitle'|trans,
             enterGradesTitle: 'gradebookEnterGradesTitle'|trans,
             editEvaluationTitle: 'gradebookEditEvaluationTitle'|trans,
             deleteEvaluationTitle: 'gradebookDeleteEvaluationTitle'|trans,
             deleteEvaluationConfirmMessage: 'gradebookDeleteEvaluationConfirmMessage'|trans({'%name%': '%name%'}),
             cellPlaceholder: 'gradebookCellPlaceholder'|trans,
             cellInputTitle: 'gradebookCellInputTitle'|trans,
             absentShortLabel: 'gradebookAbsentShortLabel'|trans,
             notEvaluatedShortLabel: 'gradebookNotEvaluatedShortLabel'|trans,
             notTestedShortLabel: 'gradebookNotTestedShortLabel'|trans,
             networkErrorMessage: 'gradebookNetworkErrorMessage'|trans,
             classAverageRowLabel: 'gradebookClassAverageRowLabel'|trans,
             coefficientShortLabel: 'gradebookCoefficientShortLabel'|trans,
             nature_diagnostic: 'evaluationNatureDiagnosticLabel'|trans,
             nature_formative: 'evaluationNatureFormativeLabel'|trans,
             nature_summative: 'evaluationNatureSummativeLabel'|trans,
         }|json_encode }}">

        <div class="cm-gb-toolbar">
            <div class="cm-gb-toolbar__row">
                {% if topicsJson|length > 1 %}
                    <div class="cm-gb-field">
                        <span class="cm-gb-label">{{ 'gradebookSubjectFieldLabel'|trans }}</span>
                        <select class="cm-gb-select" data-action="change->evaluation-grid#navigateTopic" aria-label="{{ 'gradebookSubjectFieldLabel'|trans }}">
                            {% for t in topicsJson %}
                                <option value="{{ path('app_program_gradebook', {id: program.id, topic: t.id}) }}" {{ t.id == topic.id ? 'selected' }}>{{ t.name }}</option>
                            {% endfor %}
                        </select>
                    </div>
                {% endif %}

                {% if periodsJson|length > 0 %}
                    <div class="cm-gb-field">
                        <span class="cm-gb-label">{{ 'gradebookPeriodFieldLabel'|trans }}</span>
                        <select class="cm-gb-select" data-evaluation-grid-target="periodSelect" data-action="change->evaluation-grid#onFilterChange" aria-label="{{ 'gradebookPeriodFieldLabel'|trans }}">
                            <option value="annee">{{ 'gradebookPeriodFullYearLabel'|trans }}</option>
                            {% for p in periodsJson %}
                                <option value="{{ p.id }}">{{ p.name }}</option>
                            {% endfor %}
                        </select>
                    </div>
                {% endif %}

                {# A referent consulting a colleague's matière creates nothing: instead, the screen says
                   who the matière belongs to (see ProgramGradebookController::grid()). #}
                {% if canEdit %}
                    <a href="{{ path('app_program_gradebook_evaluation_new', {id: program.id, topic: topic.id}) }}" class="btn btn-primary ms-auto">
                        {{ 'gradebookNewEvaluationButtonLabel'|trans }}
                    </a>
                {% else %}
                    <span class="badge bg-secondary-lt ms-auto">
                        {% if topic.teacher %}
                            {{ 'gradebookReadOnlyTopicBadgeLabel'|trans({'%teacher%': topic.teacher.displayName ?? topic.teacher.username}) }}
                        {% else %}
                            {{ 'gradebookReadOnlyBadgeLabel'|trans }}
                        {% endif %}
                    </span>
                {% endif %}
            </div>

            <div class="cm-gb-toolbar__rule"></div>

            <div class="cm-gb-filters">
                <div class="cm-gb-filters__group">
                    {% for value, label in {'all': 'gradebookAllTypesLabel', 'written': 'evaluationTypeWrittenLabel', 'oral': 'evaluationTypeOralLabel', 'practical': 'evaluationTypePracticalLabel'} %}
                        <button type="button" class="cm-gb-chip {{ value == 'all' ? 'is-active' }}" data-filter="type" data-value="{{ value }}" data-action="click->evaluation-grid#setFilter">{{ label|trans }}</button>
                    {% endfor %}
                </div>
                <span class="cm-gb-filters__sep">|</span>
                <div class="cm-gb-filters__group">
                    {% for value, label in {'all': 'gradebookAllModalitiesLabel', 'individual': 'evaluationModalityIndividualLabel', 'group': 'evaluationModalityGroupLabel'} %}
                        <button type="button" class="cm-gb-chip {{ value == 'all' ? 'is-active' }}" data-filter="modality" data-value="{{ value }}" data-action="click->evaluation-grid#setFilter">{{ label|trans }}</button>
                    {% endfor %}
                </div>
                <span class="cm-gb-filters__sep">|</span>
                <div class="cm-gb-filters__group">
                    {% for value, label in {'all': 'gradebookAllStatusesLabel', 'planned': 'evaluationStatusPlannedLabel', 'surprise': 'evaluationStatusSurpriseLabel'} %}
                        <button type="button" class="cm-gb-chip {{ value == 'all' ? 'is-active' }}" data-filter="status" data-value="{{ value }}" data-action="click->evaluation-grid#setFilter">{{ label|trans }}</button>
                    {% endfor %}
                </div>
            </div>
        </div>

        {# The whole grid is painted by the controller: sticky student column, average column, then one
           column per evaluation - see evaluation_grid_controller.js. #}
        <div class="cm-gb-grid">
            <div class="cm-gb-grid__inner" data-evaluation-grid-target="grid"></div>
        </div>

        <div class="cm-gb-legend">
            <span>{{ 'gradebookGridHelpText'|trans }}</span>
            <span class="cm-gb-legend__item"><span class="cm-gb-val--abs">{{ 'gradebookAbsentShortLabel'|trans }}</span> {{ 'gradebookLegendAbsentLabel'|trans }}</span>
            <span class="cm-gb-legend__item"><span class="cm-gb-val--ne">{{ 'gradebookNotEvaluatedShortLabel'|trans }}</span> {{ 'gradebookLegendNotEvaluatedLabel'|trans }}</span>
            <span class="cm-gb-legend__item"><span class="cm-gb-val cm-gb-val--paren cm-grade-band-4">(12)</span> {{ 'gradebookLegendExcludedLabel'|trans }}</span>
        </div>

        {% if canEdit %}
            {# Delete confirmation: the designs' centered modal, not a window.confirm(). #}
            <div class="modal" tabindex="-1" data-evaluation-grid-target="confirmModal">
                <div class="modal-dialog modal-sm modal-dialog-centered">
                    <div class="modal-content">
                        <div class="modal-body text-center py-4">
                            <div class="cm-gb-confirm__icon">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 6h18"></path><path d="M8 6V4a1 1 0 0 1 1-1h6a1 1 0 0 1 1 1v2"></path><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"></path></svg>
                            </div>
                            <h3 class="mb-2">{{ 'gradebookDeleteEvaluationConfirmTitle'|trans }}</h3>
                            <div class="text-secondary" data-evaluation-grid-target="confirmText"></div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-outline-secondary w-50" data-action="click->evaluation-grid#closeConfirm">{{ 'cancelAction'|trans }}</button>
                            <button type="button" class="btn btn-danger w-50" data-action="click->evaluation-grid#confirmDelete">{{ 'gradebookDeleteEvaluationConfirmAction'|trans }}</button>
                        </div>
                    </div>
                </div>
            </div>
        {% endif %}
    </div>
{% endblock %}
