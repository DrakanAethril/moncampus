{# Modal « Ajouter un travail » (maquette 2b). Rendu par-dessus la page plutôt que sur un écran à
   part, et ouvert/fermé par une simple navigation : le paramètre ?travail= décide de sa présence,
   donc rien à synchroniser entre l'URL et l'affichage. #}
<a href="{{ path('app_program_timetable_session_log', {id: program.id, sessionId: session.id}) }}" class="cm-panel-backdrop" aria-label="{{ 'cancelAction'|trans }}"></a>
<div class="cm-modal" role="dialog" aria-modal="true">
    <div class="cm-modal__header">
        <div class="cm-modal__title">{{ 'lessonLogWorkModalTitle'|trans({'%section%': section.labelKey|trans|lower}) }}</div>
        <a href="{{ path('app_program_timetable_session_log', {id: program.id, sessionId: session.id}) }}" class="cm-panel__close" aria-label="{{ 'cancelAction'|trans }}">&times;</a>
    </div>
    {{ form_start(form) }}
        <div class="cm-modal__body">
            {{ form_errors(form) }}
            <div class="cm-field-label">{{ 'lessonLogWorkNatureFieldLabel'|trans }}</div>
            <div class="cm-nature-grid">
                {% for choice in form.nature %}
                    <label class="cm-nature-card">
                        {{ form_widget(choice) }}
                        <span class="cm-nature-card__label">{{ choice.vars.label|trans }}</span>
                        <span class="cm-nature-card__hint">{{ natureHints[choice.vars.value]|trans }}</span>
                    </label>
                {% endfor %}
            </div>
            {% do form.nature.setRendered %}

            {{ form_row(form.title) }}
            {{ form_row(form.description, {attr: {class: 'd-none', 'data-controller': 'hugerte-editor'}}) }}

            <div class="row">
                <div class="col-md-6">{{ form_row(form.dueDate) }}</div>
                <div class="col-md-6">{{ form_row(form.acceptedFormats) }}</div>
            </div>
            {{ form_row(form.publishNow) }}
        </div>
        <div class="cm-modal__footer">
            <a href="{{ path('app_program_timetable_session_log', {id: program.id, sessionId: session.id}) }}" class="btn btn-outline-secondary">{{ 'cancelAction'|trans }}</a>
            {{ form_widget(form.submit) }}
        </div>
        {{ form_rest(form) }}
    {{ form_end(form) }}
</div>
