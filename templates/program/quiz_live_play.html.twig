{% extends 'base.html.twig' %}

{% block title %}{{ session.quizInstance.name }} - {{ 'quizLivePlayPageHeading'|trans }}{% endblock %}

{% block body %}
    <div class="cm-quiz-live cm-quiz-live--mobile"
         data-controller="quiz-live-play"
         data-quiz-live-play-hub-url-value="{{ mercurePublicUrl }}"
         data-quiz-live-play-topic-value="{{ topic }}"
         data-quiz-live-play-answer-url-value="{{ answerUrl }}"
         data-quiz-live-play-state-url-value="{{ stateUrl }}"
         data-quiz-live-play-csrf-token-value="{{ csrf_token('quiz_live_answer') }}"
         data-quiz-live-play-participant-id-value="{{ participant.id }}"
         data-quiz-live-play-initial-state-value="{{ initialState|json_encode }}"
         data-quiz-live-play-home-url="{{ path('app_program_quiz_mine', {id: program.id}) }}"
         data-quiz-live-play-labels-value="{{ {
             correct: 'quizLiveYouWereCorrectLabel'|trans,
             wrong: 'quizLiveYouWereWrongLabel'|trans,
             missed: 'quizLiveYouDidNotAnswerLabel'|trans,
             voted: 'quizLiveYouVotedLabel'|trans,
             points: 'quizLivePointsEarnedTemplate'|trans,
             kinds: {
                 choice: 'quizLivePlayerChoiceHint'|trans,
                 multi: 'quizLivePlayerMultiHint'|trans,
                 order: 'quizLivePlayerOrderHint'|trans,
                 number: 'quizLivePlayerNumberHint'|trans,
                 text: 'quizLivePlayerTextHint'|trans,
                 vote: 'quizLivePlayerVoteHint'|trans,
             },
         }|json_encode }}"
    >
        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="alert alert-{{ label == 'error' ? 'danger' : label }}" role="alert">{{ message|trans }}</div>
            {% endfor %}
        {% endfor %}

        {# ---- Waiting room ---- #}
        <div data-quiz-live-play-target="lobbyPhase" class="d-flex flex-column align-items-center justify-content-center flex-fill gap-3 text-center">
            <span style="width: 14px; height: 14px; border-radius: 50%; background: var(--cm-gold); box-shadow: 0 0 0 7px rgba(201,160,78,.25);"></span>
            <div style="font: 600 20px var(--cm-font-title);">{{ 'quizLiveWaitingRoomMemberLabel'|trans }}</div>
            <div class="cm-quiz-live__meta" style="font-size: 13px;">
                {{ 'quizLiveWaitingRoomCountTemplate'|trans }} <span data-quiz-live-play-target="lobbyParticipantCount">…</span>
                <br>{{ 'quizLiveWaitingRoomHintLabel'|trans }}
            </div>
        </div>

        {# ---- Countdown ---- #}
        <div data-quiz-live-play-target="countdownPhase" hidden class="d-flex flex-column align-items-center justify-content-center flex-fill gap-4 text-center">
            <div class="cm-quiz-live__eyebrow" style="letter-spacing: 3px;">{{ 'quizLiveStartingLabel'|trans }}</div>
            <div class="cm-quiz-live-countdown cm-quiz-live-countdown--mobile"><span class="cm-quiz-live-countdown__number" data-quiz-live-play-target="countdownNumber">5</span></div>
            <div class="cm-quiz-live__meta">{{ session.quizInstance.name }}</div>
        </div>

        {# ---- The statement is on the board ---- #}
        <div data-quiz-live-play-target="readingPhase" hidden class="d-flex flex-column align-items-center justify-content-center flex-fill gap-3 text-center">
            <div class="cm-quiz-live__eyebrow" style="letter-spacing: 3px;">{{ 'quizLiveQuestionCounterPrefix'|trans }} <span data-quiz-live-play-target="readingIndex"></span></div>
            <div style="font: 600 24px var(--cm-font-title); color: #fff;">{{ 'quizLiveLookAtBoardLabel'|trans }}</div>
            <div class="cm-quiz-live__meta" data-quiz-live-play-target="readingKind"></div>
        </div>

        {# ---- Question (shape/color only, no text - confirmed decision) ---- #}
        <div data-quiz-live-play-target="questionPhase" hidden class="d-flex flex-column flex-fill gap-3">
            <div class="d-flex align-items-center gap-2">
                <span class="cm-quiz-live__eyebrow" style="font-size: 11px;">{{ 'quizLiveEyebrowTemplate'|trans({'%program%': program.displayShortName}) }}</span>
                <span class="cm-quiz-live__spacer cm-quiz-live__meta" style="font-size: 13px;">Q <span data-quiz-live-play-target="questionIndex"></span></span>
                <span class="cm-quiz-live__timer cm-quiz-live__timer--sm" data-quiz-live-play-target="questionTimer"></span>
            </div>
            <div class="cm-quiz-live__meta text-center" style="font-size: 13px;" data-quiz-live-play-target="questionHint"></div>
            {# Above the shapes, where the eyes are: the answer the network lost has to be sent again. #}
            <div data-quiz-live-play-target="questionRetryNotice" hidden role="alert" class="text-center cm-quiz-live-verdict is-wrong" style="font-size: 14px;">{{ 'quizLiveAnswerRetryLabel'|trans }}</div>
            <div class="cm-quiz-live-shapes" data-quiz-live-play-target="questionAnswers"></div>
            {# A number: a slider when the question has a range, else a field. #}
            <div data-quiz-live-play-target="numberPanel" hidden class="flex-fill d-flex flex-column justify-content-center gap-3">
                <div class="cm-quiz-live-value" data-quiz-live-play-target="numberValue"></div>
                <input type="range" class="cm-quiz-live-slider" data-quiz-live-play-target="numberSlider" data-action="input->quiz-live-play#slide">
                <input type="number" inputmode="decimal" step="any" class="cm-quiz-live-input" data-quiz-live-play-target="numberInput" aria-label="{{ 'quizLiveNumberFieldLabel'|trans }}">
            </div>
            <div data-quiz-live-play-target="textPanel" hidden class="flex-fill d-flex flex-column justify-content-center">
                <input type="text" class="cm-quiz-live-input" maxlength="200" autocomplete="off" autocapitalize="off" spellcheck="false"
                       data-quiz-live-play-target="textInput" data-action="keydown.enter->quiz-live-play#validate" aria-label="{{ 'quizLiveTextFieldLabel'|trans }}">
            </div>
            <div class="d-flex gap-2" data-quiz-live-play-target="validateBar" hidden>
                <button type="button" class="cm-quiz-live-btn" data-quiz-live-play-target="clearButton" data-action="quiz-live-play#clearOrder" hidden>{{ 'quizLiveClearOrderAction'|trans }}</button>
                <button type="button" class="cm-quiz-live-btn cm-quiz-live-btn--primary flex-fill" data-quiz-live-play-target="validateButton" data-action="quiz-live-play#validate">{{ 'quizLiveValidateAction'|trans }}</button>
            </div>
            <div data-quiz-live-play-target="questionSentNotice" hidden class="text-center cm-quiz-live__meta" style="font-size: 13px;">{{ 'quizLiveAnswerSentLabel'|trans }}</div>
        </div>

        {# ---- Results: this phone's own verdict ---- #}
        <div data-quiz-live-play-target="resultsPhase" hidden class="d-flex flex-column align-items-center justify-content-center flex-fill gap-3 text-center">
            <div class="cm-quiz-live-verdict" data-quiz-live-play-target="resultsBadge"></div>
            <div class="cm-quiz-live__meta" style="font-size: 18px;" data-quiz-live-play-target="resultsPoints"></div>
            <div style="font: 700 46px var(--cm-font-title); color: #fff;" data-quiz-live-play-target="resultsScore">0</div>
            <div class="cm-quiz-live__meta">{{ 'quizLiveYourRankLabel'|trans }} <span data-quiz-live-play-target="resultsRank">—</span></div>
        </div>

        {# ---- Scoreboard ---- #}
        <div data-quiz-live-play-target="scoreboardPhase" hidden class="d-flex flex-column align-items-center justify-content-center flex-fill gap-3 text-center">
            <div class="cm-quiz-live__eyebrow" style="letter-spacing: 3px;">{{ 'quizLiveRevealLabel'|trans }}</div>
            <div style="font: 700 60px var(--cm-font-title); color: var(--cm-gold);" data-quiz-live-play-target="scoreboardRank">—</div>
            <div class="cm-quiz-live__meta" style="font-size: 15px;"><span data-quiz-live-play-target="scoreboardScore">0</span> pts</div>
        </div>

        {# ---- Podium (student's own result) ---- #}
        <div data-quiz-live-play-target="finishedPhase" hidden class="d-flex flex-column align-items-center justify-content-center flex-fill gap-3 text-center">
            <div class="cm-quiz-live__eyebrow" style="letter-spacing: 3px;">{{ 'quizLiveFinalResultsLabel'|trans }}</div>
            <div style="font: 700 60px var(--cm-font-title); color: var(--cm-gold);" data-quiz-live-play-target="podiumMyRank">—</div>
            <div class="cm-quiz-live__meta" style="font-size: 15px;"><span data-quiz-live-play-target="podiumMyScore">0</span> pts</div>
            <a href="{{ path('app_program_quiz_mine', {id: program.id}) }}" class="cm-quiz-live-btn mt-3" data-turbo="false">{{ 'quizLiveBackToHubAction'|trans }}</a>
        </div>
    </div>
{% endblock %}
