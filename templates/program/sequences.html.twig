{% extends 'layout/app.html.twig' %}

{% block title %}{{ 'programSequencesPageHeading'|trans }} - {{ program.displayShortName }}{% endblock %}

{% block page_breadcrumb %}
    {% include '_breadcrumb.html.twig' with {segments: [
        {label: 'homeNavLabel'|trans, url: path('app_home')},
        {label: program.displayShortName, url: path('app_program_timetable', {id: program.id})},
        {label: 'programSequencesPageHeading'|trans, url: app.request.requestUri},
    ]} %}
{% endblock %}
{% block page_title %}{{ 'programSequencesPageHeading'|trans }} - {{ program.displayShortName }}{% endblock %}

{% block main %}
    {# An inventory, not an arrangement: the order of the séquences and the créneaux they sit on
       belong to the Progression pédagogique. This screen only answers "what has been copied for
       this class, by anyone, and how much of it is actually planned". #}
    <p class="text-secondary">{{ 'programSequencesInventoryHintText'|trans }}</p>

    <div class="card">
        <div class="table-responsive">
            <table class="table table-vcenter card-table">
                <thead>
                    <tr>
                        <th>{{ 'sequenceTemplateTitreFieldLabel'|trans }}</th>
                        <th>{{ 'programSequencesSeanceCountColumnLabel'|trans }}</th>
                        <th>{{ 'programSequencesScheduledCountColumnLabel'|trans }}</th>
                        <th class="cm-actions"></th>
                    </tr>
                </thead>
                <tbody>
                    {% for sequenceInstance in sequenceInstances %}
                        <tr>
                            <td><a href="{{ path('app_program_sequences_show', {id: program.id, sequenceInstanceId: sequenceInstance.id}) }}">{{ sequenceInstance.titre }}</a></td>
                            <td>{{ sequenceInstance.seanceInstances|length }}</td>
                            {# "Programmée" = the progression has committed the séance to at least
                               one créneau (see ProgramSequenceInstanceController::list()). Asked of
                               the placements ALONE, deliberately: SeanceInstance::$lessonSession is
                               written at validation and never unwritten by anything that unplans a
                               séance, so reading it - even as a fallback - kept counting séances
                               whose séquence had since been dropped from the progression. The
                               placements are the only thing that always tells the truth. #}
                            {% set scheduled = sequenceInstance.seanceInstances|filter(s => scheduledSeanceInstanceIds[s.id] is defined)|length %}
                            <td>{{ scheduled }} / {{ sequenceInstance.seanceInstances|length }}</td>
                            {# Own form per row - the table carries no outer form, so nothing is
                               nested here. #}
                            <td class="cm-actions">
                                <form method="post" action="{{ path('app_program_sequences_remove', {id: program.id, sequenceInstanceId: sequenceInstance.id}) }}"
                                      onsubmit="return confirm('{{ 'programSequencesRemoveConfirm'|trans({'%title%': sequenceInstance.titre})|e('js') }}')">
                                    <input type="hidden" name="_token" value="{{ csrf_token('program_sequence_instance_remove') }}">
                                    <button type="submit" class="cm-action--danger" style="background: none; border: 0; padding: 0;"
                                            aria-label="{{ 'programSequencesRemoveAction'|trans }}" title="{{ 'programSequencesRemoveAction'|trans }}">
                                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"></path><path d="M8 6V4a1 1 0 0 1 1-1h6a1 1 0 0 1 1 1v2"></path><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"></path><path d="M10 11v6"></path><path d="M14 11v6"></path></svg>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="4" class="text-secondary">{{ 'programSequencesEmptyMessage'|trans }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endblock %}
