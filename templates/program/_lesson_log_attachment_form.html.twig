{# Adding a document, in a modal opened by a part's « + Ajouter un document » (the URL carries
   ?document=<part>). Outside the main form, and not inside the part's card: a file upload has its own
   <form>, and a <form> inside a <form> is invalid HTML the browser drops without saying a word. #}
<a href="{{ path('app_program_timetable_session_log', {id: program.id, sessionId: session.id}) }}" class="cm-panel-backdrop" aria-label="{{ 'cancelAction'|trans }}"></a>
<div class="cm-modal" role="dialog" aria-modal="true">
    <div class="cm-modal__header">
        <div class="cm-modal__title">{{ 'lessonLogAttachmentModalTitle'|trans({'%section%': documentSection.labelKey|trans|lower}) }}</div>
        <a href="{{ path('app_program_timetable_session_log', {id: program.id, sessionId: session.id}) }}" class="cm-panel__close" aria-label="{{ 'cancelAction'|trans }}">&times;</a>
    </div>
    {{ form_start(attachmentForm, {action: path('app_program_timetable_session_log_attachments_new', {id: program.id, sessionId: session.id}), method: 'post', attr: {enctype: 'multipart/form-data'}}) }}
        <div class="cm-modal__body">
            {{ form_errors(attachmentForm) }}
            <input type="hidden" name="section" value="{{ documentSection.value }}">
            {{ form_row(attachmentForm.label) }}
            {{ form_row(attachmentForm.file) }}
            {{ form_row(attachmentForm.url) }}
            <p class="text-secondary small mb-0">{{ 'lessonLogAttachmentHelpText'|trans }}</p>
        </div>
        <div class="cm-modal__footer">
            <a href="{{ path('app_program_timetable_session_log', {id: program.id, sessionId: session.id}) }}" class="btn btn-outline-secondary">{{ 'cancelAction'|trans }}</a>
            {{ form_widget(attachmentForm.submit) }}
        </div>
        {{ form_rest(attachmentForm) }}
    {{ form_end(attachmentForm) }}
</div>
