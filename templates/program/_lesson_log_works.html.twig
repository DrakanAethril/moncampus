{# Travaux donnés sur ce temps. Ce sont des devoirs à part entière : ils alimentent le « Travail à
   réaliser » de l'étudiant et se retrouvent dans la liste des devoirs de la formation. #}
<div class="cm-work-list">
    {% for work in works %}
        <div class="cm-work">
            {% include 'program/_work_icon.html.twig' with {nature: work.nature} %}
            <div class="cm-work__body">
                <div class="cm-work__title">{{ work.title }}</div>
                <div class="cm-work__meta">
                    {{ 'lessonLogWorkDueLabel'|trans({'%date%': work.dueDate|date('d/m/Y H:i')}) }}
                    {%- if work.acceptedFormats is not empty %} · {{ work.acceptedFormats|map(f => f|upper)|join(' / ') }}{% endif %}
                    {%- if work.quizInstance %} · {{ work.quizInstance.name }}{% endif %}
                    {%- if not work.isVisibleFor() %} · {{ 'lessonLogWorkNotPublishedLabel'|trans }}{% endif %}
                    {#- Suivi de lecture : seuls les travaux « À lire » en ont un, et il n'a de sens
                        qu'une fois le travail publié - personne ne peut avoir lu ce qui n'est pas
                        encore visible. -#}
                    {%- if readTracking[work.id] is defined and work.isVisibleFor() %} · {{ 'lessonLogWorkReadCountLabel'|trans({'%read%': readTracking[work.id].read, '%total%': readTracking[work.id].total}) }}{% endif %}
                </div>
            </div>
            <span class="cm-badge {{ work.nature.badgeClass }}">{{ work.nature.labelKey|trans }}</span>
            {% if canEdit %}
                <a class="cm-action--warning ms-3" href="{{ path('app_program_timetable_session_log', {id: program.id, sessionId: session.id, modifier: work.id}) }}">{{ 'editActionLabel'|trans }}</a>
                {# formaction plutôt qu'un <form> imbriqué : la liste des travaux vit à l'intérieur du
                   formulaire qui enveloppe les trois temps, et un <form> dans un <form> est du HTML
                   invalide que le navigateur laisse tomber sans rien dire. #}
                <button type="submit" class="cm-action--danger ms-3"
                        formaction="{{ path('app_program_timetable_session_log_work_remove', {id: program.id, sessionId: session.id, assignmentId: work.id}) }}"
                        formmethod="post" formnovalidate
                        onclick="return confirm('{{ (work.id in worksWithProduction ? 'lessonLogWorkRemoveStartedConfirmMessage' : 'lessonLogWorkRemoveConfirmMessage')|trans|e('js') }}')">{{ 'lessonLogWorkRemoveAction'|trans }}</button>
            {% endif %}
        </div>
    {% endfor %}
    {% if canEdit %}
        <a class="cm-inline-add" href="{{ path('app_program_timetable_session_log', {id: program.id, sessionId: session.id, travail: section.value}) }}">{{ 'lessonLogAddWorkAction'|trans }}</a>
    {% endif %}
</div>
