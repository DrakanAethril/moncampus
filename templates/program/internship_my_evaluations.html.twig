{% extends 'layout/app.html.twig' %}

{% block title %}{{ 'internshipMyEvaluationsPageHeading'|trans }} - {{ program.displayShortName }}{% endblock %}
{% block page_title %}{{ 'internshipMyEvaluationsPageHeading'|trans }} - {{ program.displayShortName }}{% endblock %}

{% block main %}
    <div class="card">
        {% if hasTutorLink %}
            <div class="card-header d-flex justify-content-end">
                <a href="{{ path('app_program_internship_my_engagement', {id: program.id}) }}" class="btn btn-outline-secondary">{{ 'ufaAlternanceEngagementPageHeading'|trans }}</a>
                <a href="{{ path('app_program_internship_my_booklet', {id: program.id}) }}" class="btn btn-outline-primary ms-2">{{ 'internshipBookletViewButtonLabel'|trans }}</a>
                <a href="{{ path('app_program_internship_my_booklet_pdf', {id: program.id}) }}" class="btn btn-primary ms-2"
       data-controller="pdf-download"
       data-action="pdf-download#download"
       data-pdf-download-loading-label-value="{{ 'pdfExportLoadingLabel'|trans }}"
       data-pdf-download-fallback-filename-value="livret-alternant.pdf">
        <span class="spinner-border spinner-border-sm d-none me-1" role="status" aria-hidden="true" data-pdf-download-target="spinner"></span>
        <span data-pdf-download-target="label">{{ 'internshipBookletDownloadPdfButtonLabel'|trans }}</span>
    </a>
            </div>
        {% endif %}
        <div class="table-responsive">
            <table class="table table-vcenter card-table">
                <thead>
                    <tr>
                        <th>{{ 'internshipTutorHomePeriodColumnLabel'|trans }}</th>
                        <th>{{ 'internshipTutorHomeStatusColumnLabel'|trans }}</th>
                        <th class="cm-actions"></th>
                    </tr>
                </thead>
                <tbody>
                    {% for entry in rows %}
                        <tr>
                            <td>{{ entry.period.name }}</td>
                            <td>
                                {% if entry.submitted %}
                                    <span class="badge bg-green-lt">{{ 'internshipEvaluationSubmittedLabel'|trans }}</span>
                                {% elseif not entry.tutorSubmitted %}
                                    <span class="badge bg-secondary-lt">{{ 'internshipStudentEvaluationWaitingForTutorLabel'|trans }}</span>
                                {% else %}
                                    <span class="badge bg-secondary-lt">{{ 'internshipEvaluationNotSubmittedLabel'|trans }}</span>
                                {% endif %}
                            </td>
                            <td class="cm-actions">
                                {% if entry.submitted or entry.tutorSubmitted %}
                                    <a href="{{ path('app_program_internship_my_evaluation_step', {id: program.id, periodId: entry.period.id, step: 'comportement'}) }}" class="{{ entry.submitted ? 'cm-action--warning' : 'cm-action--positive' }}">
                                        {{ (entry.submitted ? 'editActionLabel' : 'internshipEvaluateButtonLabel')|trans }}
                                    </a>
                                {% endif %}
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="3" class="text-secondary">{{ 'internshipTutorHomeNoPeriodsLabel'|trans }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endblock %}
