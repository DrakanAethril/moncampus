{% extends 'layout/app.html.twig' %}

{# The door of a supervised évaluation: what is recorded, who reads it, and for how long, said in
   plain words before anything exists. It is not a formality - an announced surveillance deters,
   a silent one only documents, and it is the prior information that makes the processing lawful. #}

{% block title %}{{ quizInstance.name }}{% endblock %}

{% block page_breadcrumb %}
    {% include '_breadcrumb.html.twig' with {segments: [
        {label: 'homeNavLabel'|trans, url: path('app_home')},
        {label: program.displayShortName, url: path('app_program_quiz_mine', {id: program.id})},
        {label: 'programQuizNavLabel'|trans, url: path('app_program_quiz_mine', {id: program.id})},
        {label: quizInstance.name, url: app.request.requestUri},
    ]} %}
{% endblock %}
{% block page_title %}{{ quizInstance.name }}{% endblock %}

{% block main %}
    <div class="d-flex justify-content-center">
        <div class="card" style="width: 660px; max-width: 100%;" data-controller="quiz-contract">
            <div class="card-body d-flex flex-column gap-3 py-4">
                <div class="d-flex align-items-center gap-2">
                    <span class="cm-badge cm-badge--gold">{{ 'quizSupervisedBadgeLabel'|trans }}</span>
                    <span class="text-secondary small">{{ quizInstance.mode.labelKey|trans }} · {{ program.displayShortName }}</span>
                </div>
                <div style="font: 600 22px var(--cm-font-title); color: var(--cm-ink);">{{ quizInstance.name }}</div>

                <div class="row g-2">
                    <div class="col-6 col-lg-3">
                        <div class="text-secondary text-uppercase small fw-bold" style="letter-spacing:.5px;">{{ 'quizContractQuestionsLabel'|trans }}</div>
                        <div style="font: 600 20px var(--cm-font-title); color: var(--cm-ink);">{{ quizInstance.questionCount }}</div>
                    </div>
                    {% if quizInstance.secondsPerQuestion %}
                        <div class="col-6 col-lg-3">
                            <div class="text-secondary text-uppercase small fw-bold" style="letter-spacing:.5px;">{{ 'quizContractPerQuestionLabel'|trans }}</div>
                            <div style="font: 600 20px var(--cm-font-title); color: var(--cm-ink);">{{ quizInstance.secondsPerQuestion }} s</div>
                        </div>
                    {% endif %}
                    {% if quizInstance.globalTimeMinutes %}
                        <div class="col-6 col-lg-3">
                            <div class="text-secondary text-uppercase small fw-bold" style="letter-spacing:.5px;">{{ 'quizContractTotalTimeLabel'|trans }}</div>
                            <div style="font: 600 20px var(--cm-font-title); color: var(--cm-ink);">{{ quizInstance.globalTimeMinutes }} min</div>
                        </div>
                    {% endif %}
                    <div class="col-6 col-lg-3">
                        <div class="text-secondary text-uppercase small fw-bold" style="letter-spacing:.5px;">{{ 'quizContractAttemptsLabel'|trans }}</div>
                        <div style="font: 600 20px var(--cm-font-title); color: var(--cm-ink);">1</div>
                    </div>
                </div>

                <div class="cm-audio-warn">
                    <div class="fw-medium">{{ 'quizContractHeadingText'|trans }}</div>
                    <ul class="mb-0 mt-1 ps-3">
                        <li>{{ 'quizContractTimeBulletText'|trans }}</li>
                        <li>{{ 'quizContractExitsBulletText'|trans }}</li>
                        {% if quizInstance.supervisionPolicy.value == 'autosubmit' and quizInstance.supervisionSubmitAt %}
                            <li>{{ 'quizContractAutosubmitBulletTemplate'|trans({'%count%': quizInstance.supervisionSubmitAt}) }}</li>
                        {% endif %}
                        <li>{{ 'quizContractTeacherBulletText'|trans }}</li>
                        <li>{{ 'quizContractRetentionBulletText'|trans }}</li>
                        <li>{{ 'quizContractNothingYetBulletText'|trans }}</li>
                    </ul>
                </div>

                <form method="post" action="{{ path('app_program_quiz_start', {id: program.id, instanceId: quizInstance.id}) }}" class="d-flex flex-column gap-3">
                    <input type="hidden" name="_token" value="{{ csrf_token('quiz_supervised_start') }}">
                    <label class="d-flex align-items-start gap-2" style="cursor: pointer;">
                        <input type="checkbox" class="form-check-input mt-1" data-quiz-contract-target="accept" data-action="change->quiz-contract#toggle" required>
                        <span>{{ 'quizContractAcceptLabel'|trans }}</span>
                    </label>
                    <div class="d-flex align-items-center gap-2 justify-content-end">
                        <a href="{{ path('app_program_quiz_mine', {id: program.id}) }}" class="btn btn-link">{{ 'cancelAction'|trans }}</a>
                        <button type="submit" class="btn btn-primary" data-quiz-contract-target="submit" data-action="quiz-contract#begin" disabled>{{ 'quizContractStartAction'|trans }}</button>
                    </div>
                    <div class="text-secondary small text-end">{{ 'quizContractFullscreenHintText'|trans }}</div>
                </form>
            </div>
        </div>
    </div>
{% endblock %}
