{% extends 'layout/app.html.twig' %}

{% block title %}{{ 'programTeachersPageHeading'|trans }} - {{ program.displayShortName }}{% endblock %}

{% block page_breadcrumb %}
    {# Same trail as the student list, which is the neighbouring entry of the same class submenu. #}
    {% include '_breadcrumb.html.twig' with {segments: [
        {label: 'homeNavLabel'|trans, url: path('app_home')},
        {label: program.displayShortName, url: path('app_program_students', {id: program.id})},
        {label: 'programTeachersPageHeading'|trans, url: app.request.requestUri},
    ]} %}
{% endblock %}
{% block page_title %}{{ 'programTeachersPageHeading'|trans }} - {{ program.displayShortName }}{% endblock %}

{% block page_actions %}
    {% include 'program/_export_button.html.twig' with {
        program: program,
        attendancePdfRoute: 'app_program_teachers_attendance_pdf',
        csvRoute: 'app_program_teachers_csv',
    } %}
{% endblock %}

{% block main %}
    {% if teachers|length > 0 %}
        <div class="row row-cards">
            {% for teacher in teachers %}
                {{ include('program/_user_card.html.twig', {user: teacher, options: optionsByTeacherId[teacher.id] ?? [], politeNames: politeNames}) }}
            {% endfor %}
        </div>
    {% else %}
        <div class="card">
            <div class="card-body">
                <p class="text-secondary mb-0">{{ 'programTeachersEmptyLabel'|trans }}</p>
            </div>
        </div>
    {% endif %}
{% endblock %}
