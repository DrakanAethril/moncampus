{% extends 'layout/app.html.twig' %}

{% block title %}{{ assignment.title }} - {{ program.displayShortName }}{% endblock %}

{# One segment per intervening level: the formation, then its « Mes devoirs » list, then this
   travail. The list is the level above whichever screen sent the reader here - the dashboard card
   and « Travail à faire » both link straight to a travail, and a trail that skipped the list would
   leave them no way up. #}
{% block page_breadcrumb %}
    {% include '_breadcrumb.html.twig' with {segments: [
        {label: 'homeNavLabel'|trans, url: path('app_home')},
        {label: program.displayShortName, url: path('app_program_students', {id: program.id})},
        {label: 'programMyAssignmentsNavLabel'|trans, url: path('app_program_my_assignments', {id: program.id})},
        {label: assignment.title, url: app.request.requestUri},
    ]} %}
{% endblock %}
{% block page_title %}{{ assignment.title }}{% endblock %}

{% block main %}
    <div class="mb-3">
        <a href="{{ path('app_program_my_assignments', {id: program.id}) }}" class="btn btn-link ps-0">{{ 'backToAssignmentsAction'|trans }}</a>
    </div>

    <div class="card mb-3">
        <div class="card-body">
            <div class="mb-2">
                <span class="cm-badge {{ assignment.nature.badgeClass }}">{{ assignment.nature.labelKey|trans }}</span>
            </div>
            <div class="mb-2">
                <span class="text-secondary">{{ 'assignmentDueDateFieldLabel'|trans }}:</span>
                {{ assignment.dueDate|date('d/m/Y') }}
            </div>
            {# The consigne is authored in HugeRTE, so it is HTML - printed as such here, the way
               « Travail à faire » prints it (student/_work_brief.html.twig). #}
            {% if assignment.description|trim is not empty %}
                <div>{{ assignment.description|raw }}</div>
            {% endif %}

            {# A « Visionnage » is done on its own screen, and this card is the only thing this page
               shows of it: the way in belongs here rather than in a supports section it does not
               have. #}
            {% if assignment.nature.expectsWatching %}
                <div class="mt-3">
                    {% include 'student/_work_watch_link.html.twig' with {assignment: assignment, link_class: 'cm-btn cm-btn--primary'} only %}
                </div>
            {% endif %}
        </div>
    </div>

    {# The supports the teacher attached - a file to download or a link to follow. An announce-only
       nature (à lire, à réviser) has no submission box at all, so without this section the page
       named a document nothing on it could open.

       Never on a « Visionnage »: there the only file is the video itself, and offering it as a
       download is handing over whole what the work asks to be watched - the player measures the
       watching, a saved file measures nothing. Works published before this rule still carry that
       attachment row, which is why the test is on the nature and not on what is attached. #}
    {% if assignment.attachments|length > 0 and not assignment.nature.expectsWatching %}
        <div class="card mb-3">
            <div class="card-header">
                <h3 class="card-title">{{ 'studentWorkAttachmentsHeading'|trans }}</h3>
            </div>
            <div class="card-body">
                <div class="list-group list-group-flush">
                    {% for attachment in assignment.attachments %}
                        <div class="list-group-item d-flex justify-content-between align-items-center px-0">
                            <span>
                                {{ attachment.label }}
                                {%- if attachment.isLink %} <span class="text-secondary">— {{ attachment.url }}</span>{% endif %}
                            </span>
                            <a href="{{ path('app_student_work_attachment', {assignmentId: assignment.id, attachmentId: attachment.id}) }}" target="_blank" rel="noopener" class="btn btn-sm btn-outline-primary">
                                {{ (attachment.isLink ? 'studentWorkOpenLinkAction' : 'studentWorkDownloadAction')|trans }}
                            </a>
                        </div>
                    {% endfor %}
                </div>
            </div>
        </div>
    {% endif %}

    {% if assignment.expectsSubmission %}
    <div class="card">
        <div class="card-header">
            <h3 class="card-title">{{ 'assignmentSubmissionFilesColumnLabel'|trans }}</h3>
        </div>
        <div class="card-body">
            {# Every deposit, whichever expected production it answers - this page keeps one box for
               the assignment as a whole, where "Travail à faire" splits them per production. #}
            {% if submissions|reduce((total, submission) => total + submission.files|length, 0) > 0 %}
                <div class="list-group list-group-flush mb-3">
                    {% for submission in submissions %}
                        {% for file in submission.files %}
                            <div class="list-group-item d-flex justify-content-between align-items-center px-0">
                                <a href="{{ download_url(file.storageKey, file.originalFilename) }}" target="_blank" rel="noopener">
                                    {{ file.originalFilename }}
                                    {%- if submission.expectedProduction %} <span class="text-secondary">— {{ submission.expectedProduction.name }}</span>{% endif %}
                                </a>
                                <form method="post" action="{{ path('app_program_my_assignment_files_delete', {id: program.id, assignmentId: assignment.id, fileId: file.id}) }}" onsubmit="return confirm('{{ 'assignmentSubmissionFileRemoveConfirmMessage'|trans|e('js') }}')">
                                    <input type="hidden" name="_token" value="{{ csrf_token('assignment_submission_file_delete') }}">
                                    <button type="submit" class="btn btn-sm btn-ghost-danger">{{ 'removeActionLabel'|trans }}</button>
                                </form>
                            </div>
                        {% endfor %}
                    {% endfor %}
                </div>
            {% else %}
                <p class="text-secondary">{{ 'assignmentSubmissionEmptyMessage'|trans }}</p>
            {% endif %}

            {{ form_start(form, {action: path('app_program_my_assignment', {id: program.id, assignmentId: assignment.id}), attr: {enctype: 'multipart/form-data'}}) }}
                {{ form_errors(form) }}
                {{ form_row(form.file) }}
                {{ form_widget(form.submit) }}
                {{ form_rest(form) }}
            {{ form_end(form) }}
        </div>
    </div>
    {% endif %}
{% endblock %}
