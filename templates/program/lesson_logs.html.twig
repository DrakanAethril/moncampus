{% extends 'layout/app.html.twig' %}

{% block title %}{{ 'lessonLogPageHeading'|trans }} - {{ program.displayShortName }}{% endblock %}

{% block page_breadcrumb %}
    {% include '_breadcrumb.html.twig' with {segments: [
        {label: 'homeNavLabel'|trans, url: path('app_home')},
        {label: program.displayShortName, url: path('app_program_timetable', {id: program.id})},
        {label: 'lessonLogPageHeading'|trans, url: app.request.requestUri},
    ]} %}
{% endblock %}
{% block page_title %}{{ 'lessonLogPageHeading'|trans }}{% endblock %}

{% block page_actions %}
    {# The lesson log is a teacher's own: their sessions by default, the whole class's on demand. A
       GET like the week selector - the filtering is the server's job. The week is carried over so
       that flipping the switch answers "and the others, that same week?" rather than starting over. #}
    <form method="get" action="{{ path('app_program_lesson_logs', {id: program.id}) }}"
          class="form-check form-switch mb-0" data-controller="auto-submit">
        <input type="hidden" name="week" value="{{ week|date('Y-m-d') }}">
        <input class="form-check-input" type="checkbox" role="switch" id="lesson-logs-all-teachers"
               name="all" value="1"{{ mineOnly ? '' : ' checked' }}
               data-action="change->auto-submit#submit">
        <label class="form-check-label" for="lesson-logs-all-teachers">{{ 'lessonLogsAllTeachersSwitchLabel'|trans }}</label>
    </form>
{% endblock %}

{% block main %}
    {# Two columns: the list of séances and their state on the left, the read-only preview of the
       selected one on the right (mockup 1b). A screen for spotting, not for editing. #}
    <div class="cm-course-view">
        <div class="card">
            <div class="cm-card-toolbar">
                <h3 class="card-title mb-0">{{ 'lessonLogsSessionsCardTitle'|trans }}</h3>
                {# ‹ week › - same widget as the staff dashboard's day nav. The arrows are plain
                   links because only the server knows which week actually has class next, and the
                   label opens the native calendar to reach a far-off week in one go. #}
                <div class="cm-daynav ms-auto" data-controller="date-jump">
                    {% if previousWeek %}
                        <a class="cm-daynav__arrow" href="{{ path('app_program_lesson_logs', {id: program.id, week: previousWeek, all: mineOnly ? null : 1}) }}"
                           aria-label="{{ 'lessonLogsPreviousWeekLabel'|trans }}" title="{{ 'lessonLogsPreviousWeekLabel'|trans }}">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 6l-6 6 6 6"></path></svg>
                        </a>
                    {% else %}
                        <span class="cm-daynav__arrow is-disabled" aria-hidden="true">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 6l-6 6 6 6"></path></svg>
                        </span>
                    {% endif %}

                    <span class="cm-daynav__date-wrap">
                        {# Dates only, no "Semaine du" prefix: the 330px column has no room for it,
                           and the calendar icon plus the ‹ › on either side already say what it
                           is. The full wording lives in the aria-label. #}
                        <button type="button" class="cm-daynav__date" data-action="date-jump#open"
                                title="{{ 'lessonLogsPickWeekLabel'|trans }}"
                                aria-label="{{ 'lessonLogsWeekRangeLabel'|trans({'%start%': week|date('d/m/Y'), '%end%': weekEnd|date('d/m/Y')}) }}">
                            {{ week|date('d/m') }} – {{ weekEnd|date('d/m/Y') }}
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="5" width="16" height="16" rx="2"></rect><path d="M16 3v4"></path><path d="M8 3v4"></path><path d="M4 11h16"></path></svg>
                        </button>
                        {# Any picked day is snapped to its Monday server-side, so a plain date input
                           is enough - and unlike <input type="week"> it works in every browser. #}
                        <form method="get" action="{{ path('app_program_lesson_logs', {id: program.id}) }}" data-date-jump-target="form">
                            {% if not mineOnly %}<input type="hidden" name="all" value="1">{% endif %}
                            <input type="date" name="week" value="{{ week|date('Y-m-d') }}"
                                   {% if weekPickerMin %}min="{{ weekPickerMin|date('Y-m-d') }}"{% endif %}
                                   {% if weekPickerMax %}max="{{ weekPickerMax|date('Y-m-d') }}"{% endif %}
                                   class="cm-daynav__dateinput" tabindex="-1" aria-hidden="true"
                                   data-date-jump-target="input"
                                   data-action="change->date-jump#submit">
                        </form>
                    </span>

                    {% if nextWeek %}
                        <a class="cm-daynav__arrow" href="{{ path('app_program_lesson_logs', {id: program.id, week: nextWeek, all: mineOnly ? null : 1}) }}"
                           aria-label="{{ 'lessonLogsNextWeekLabel'|trans }}" title="{{ 'lessonLogsNextWeekLabel'|trans }}">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6"></path></svg>
                        </a>
                    {% else %}
                        <span class="cm-daynav__arrow is-disabled" aria-hidden="true">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6"></path></svg>
                        </span>
                    {% endif %}
                </div>
            </div>
            <div class="cm-session-list">
                {% for row in rows %}
                    <a class="cm-session {{ selected and selected.session.id == row.session.id ? 'is-selected' }}"
                       href="{{ path('app_program_lesson_logs', {id: program.id, week: week|date('Y-m-d'), seance: row.session.id, all: mineOnly ? null : 1}) }}">
                        <span class="cm-session__dot cm-session__dot--{{ row.state }}"></span>
                        <span class="cm-session__body">
                            <span class="cm-session__date">{{ row.session.day|date('d/m/Y') }} · {{ row.session.startHour|date('H:i') }}</span>
                            <span class="cm-session__title">{{ row.session.displayName }}</span>
                        </span>
                        <span class="cm-session__state">{{ ('lessonLogsState' ~ row.state|capitalize ~ 'Label')|trans }}</span>
                    </a>
                {% else %}
                    <div class="card-body text-secondary">{{ (mineOnly ? 'lessonLogsNoSessionOfMineThisWeekMessage' : 'lessonLogsNoSessionThisWeekMessage')|trans }}</div>
                {% endfor %}
            </div>
            {# The filled count left the header, where the week selector no longer left room to
               write it on one line. It counts the very dots the legend explains anyway, so it
               reads just as well next to it. #}
            <div class="cm-card-note cm-card-note--split">
                <span>
                    <span class="cm-session__dot cm-session__dot--filled"></span> {{ 'lessonLogsStateFilledLabel'|trans }}
                    <span class="cm-session__dot cm-session__dot--empty ms-3"></span> {{ 'lessonLogsStateEmptyLabel'|trans }}
                </span>
                <span>{{ 'lessonLogsFilledCountLabel'|trans({'%filled%': filled, '%total%': rows|length}) }}</span>
            </div>
        </div>

        {% if selected %}
            <div class="card">
                <div class="cm-log-section__head">
                    <div>
                        <div class="cm-preview__date">{{ selected.session.day|date('d/m/Y') }} · {{ selected.session.startHour|date('H:i') }} – {{ selected.session.endHour|date('H:i') }}{% if selected.session.classRoom %} · {{ selected.session.classRoom.name }}{% endif %}</div>
                        <div class="cm-work__meta">{{ selected.session.displayName }}</div>
                    </div>
                    <a class="btn btn-primary btn-sm ms-auto" href="{{ path('app_program_timetable_session_log', {id: program.id, sessionId: selected.session.id}) }}">{{ 'lessonLogsOpenSessionAction'|trans }}</a>
                </div>
                <div class="card-body">
                    {% for section in sections %}
                        {% set content = selected.log ? selected.log.getContent(section) : null %}
                        <div class="cm-preview-row">
                            <span class="cm-session__dot cm-session__dot--{{ content ? 'filled' : 'empty' }}"></span>
                            <div class="cm-work-card__body">
                                <div class="cm-work__title">{{ section.labelKey|trans }}</div>
                                <div class="cm-work__meta text-truncate">{{ content ? content|striptags : 'lessonLogsSectionEmptyLabel'|trans }}</div>
                                {# Read tracking of this part's assignments: this is where one comes to
                                   see where the class stands, without having to open the séance. #}
                                {% for work in worksBySection[section.value]|default([]) %}
                                    {% set stats = workTracking[work.id]|default(null) %}
                                    <div class="cm-work__meta">
                                        {{ work.title }}
                                        {%- if stats and work.isVisibleFor() %}
                                            {%- if stats.opened is not null %} · {{ 'lessonLogWorkOpenedCountLabel'|trans({'%count%': stats.opened, '%total%': stats.total}) }}{% endif %}
                                            {%- if stats.done is not null %} · {{ 'lessonLogWorkDoneCountLabel'|trans({'%count%': stats.done, '%total%': stats.total}) }}{% endif %}
                                        {%- elseif not work.isVisibleFor() %} · {{ 'lessonLogWorkNotPublishedLabel'|trans }}
                                        {%- endif %}
                                    </div>
                                {% endfor %}
                            </div>
                            {% if selected.log %}
                                {% include 'program/_lesson_log_visibility_badge.html.twig' with {
                                    visibility: selected.log.getVisibility(section), visibleAt: selected.log.getVisibleAt(section)
                                } %}
                            {% else %}
                                <span class="cm-badge cm-badge--gray">{{ 'lessonLogVisibilityHiddenBadge'|trans }}</span>
                            {% endif %}
                        </div>
                    {% endfor %}
                    {% if documentTracking and selected.log and selected.log.attachments|length > 0 %}
                        <p class="cm-work__meta mt-3 mb-0">{{ 'lessonLogDocumentsAllOpenedLabel'|trans({'%count%': documentTracking.all, '%total%': documentTracking.total}) }}</p>
                    {% endif %}
                    <p class="cm-card-note px-0 pb-0">{{ 'lessonLogsReadOnlyNotice'|trans }}</p>
                </div>
            </div>
        {% endif %}
    </div>
{% endblock %}
