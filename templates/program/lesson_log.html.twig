{% extends 'layout/app.html.twig' %}

{% block title %}{{ 'lessonLogPageHeading'|trans }} - {{ session.displayName }} - {{ program.displayShortName }}{% endblock %}

{% block page_breadcrumb %}
    {# The « vue cours » segment only leads to a teacher screen: for a student the trail stops at
       the timetable, which they came from. #}
    {% include '_breadcrumb.html.twig' with {segments: [
        {label: 'homeNavLabel'|trans, url: path('app_home')},
        {label: 'programTimetableNavLabel'|trans, url: path('app_program_timetable', {id: program.id})},
    ]|merge(canViewTeacherTools ? [
        {label: session.displayName ~ ' — ' ~ program.displayShortName, url: path('app_program_lesson_logs', {id: program.id})},
    ] : [])|merge([
        {label: 'lessonLogSessionOfLabel'|trans({'%date%': session.day|date('d/m/Y')}), url: app.request.requestUri},
    ])} %}
{% endblock %}
{% block page_title %}{{ 'lessonLogPageHeading'|trans }}{% endblock %}
{% block page_actions %}
    {% if canEdit %}
        {% include 'program/_lesson_log_import.html.twig' with {suggestions: importSuggestions, browsable: importBrowsable, seanceInstance: seanceInstance, hasContent: importHasContent} %}
    {% endif %}
{% endblock %}

{% block main %}
    {% if not canEdit %}
        <div class="alert alert-info">{{ 'lessonLogViewOnlyNotice'|trans }}</div>
    {% endif %}

    {% if sequenceStrip %}
        {% include 'program/_lesson_log_sequence.html.twig' with {strip: sequenceStrip} %}
    {% endif %}

    {# One part per card, in the order of the séance: what is asked for before, what is done in it,
       what is given afterwards (mockup 2a). Each carries its own visibility on the student side.

       In read-only there is nothing to submit: no <form> at all, without which the closing
       form_rest() would pour out under the cards the visibility fields that only the teacher-only
       menu renders - a dropdown and a date per part, with neither label nor meaning for whoever
       reads them. #}
    {% if canEdit %}
        {{ form_start(form) }}
        {# Token for deleting an assignment: the buttons using it are formactions of this form, so
           they have no hidden field of their own. #}
        <input type="hidden" name="delete_token" value="{{ csrf_token('lesson_log_work_remove') }}">
        <input type="hidden" name="attachment_delete_token" value="{{ csrf_token('lesson_log_attachment_delete') }}">
    {% endif %}
        {% for section in sections %}
            {% set view = sectionViews[section.value] %}
            {% if view.shown %}
            <div class="card mb-3">
                <div class="cm-log-section__head">
                    <span class="cm-step {{ section.badgeClass }}">{{ section.number }}</span>
                    <h3 class="card-title mb-0">{{ section.labelKey|trans }}</h3>
                    <div class="ms-auto d-flex align-items-center gap-2">
                        {# Visibility only concerns whoever sets it: the chip tells the teacher what
                           their class sees, it has nothing to say to the class itself. #}
                        {% if canEdit %}
                            {% include 'program/_lesson_log_visibility_badge.html.twig' with {
                                visibility: log.getVisibility(section), visibleAt: log.getVisibleAt(section)
                            } %}
                            <div class="dropdown">
                                <button type="button" class="btn btn-sm btn-outline-primary dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">{{ 'lessonLogVisibilityAction'|trans }}</button>
                                <div class="dropdown-menu dropdown-menu-end cm-visibility-menu">
                                    {% include 'program/_lesson_log_visibility_menu.html.twig' with {
                                        visibilityField: attribute(form, 'visibility' ~ section.value|capitalize),
                                        visibleAtField: attribute(form, 'visibleAt' ~ section.value|capitalize)
                                    } %}
                                </div>
                            </div>
                        {% endif %}
                    </div>
                </div>
                <div class="card-body">
                    {% set field = {'before': form.travailAvantDescription, 'during': form.contenuRealise, 'after': form.travailApresDescription}[section.value] %}
                    {% if canEdit %}
                        {{ form_row(field, {label: false, attr: {class: 'd-none', 'data-controller': 'hugerte-editor', 'data-lesson-log-field': section.value}}) }}
                        {# What the séance of the progression already says for this part. The button
                           is the only way back to it once the editor holds something, so it hides
                           itself as soon as the part is no longer empty rather than offering to
                           overwrite what the teacher just wrote. #}
                        {% if seanceDefaults[section.value] is defined %}
                            <div class="cm-seance-default" hidden
                                 data-controller="seance-default"
                                 data-seance-default-field-value="{{ field.vars.id }}"
                                 data-seance-default-content-value="{{ seanceDefaults[section.value]|e('html_attr') }}">
                                <button type="button" class="cm-btn cm-btn--outline cm-btn--sm"
                                        data-action="seance-default#paste">{{ 'lessonLogSeanceDefaultPasteAction'|trans }}</button>
                                <span class="cm-seance-default__note">{{ 'lessonLogSeanceDefaultNote'|trans({'%seance%': seanceInstance.titre}) }}</span>
                            </div>
                        {% endif %}
                    {% else %}
                        {# The card may stay for a document that departs from its part: the text,
                           however, keeps quiet as long as the part is not published. #}
                        <div class="cm-readonly-html">{{ view.contentVisible and field.vars.value ? field.vars.value|raw : '—' }}</div>
                    {% endif %}

                    {% include 'program/_lesson_log_documents.html.twig' with {
                        attachments: view.attachments, section: section, canEdit: canEdit,
                        canViewTeacherTools: canViewTeacherTools
                    } %}

                    {% if section.value in ['before', 'after'] %}
                        {% include 'program/_lesson_log_works.html.twig' with {
                            works: view.works, section: section, canEdit: canEdit,
                            canViewTeacherTools: canViewTeacherTools,
                            worksWithProduction: worksWithProduction, workTracking: workTracking
                        } %}
                    {% endif %}
                </div>
            </div>
            {% endif %}
        {% endfor %}

        {# Nothing published: say so, rather than leaving a bare page that looks like a breakdown. #}
        {% if not anySectionShown %}
            <div class="card mb-3">
                <div class="card-body text-secondary">{{ 'lessonLogNothingPublishedMessage'|trans }}</div>
            </div>
        {% endif %}

        {# Overall statistic: only makes sense if the séance carries documents, and only counts the
           students who opened them ALL. #}
        {% if canEdit and documentTracking and log.attachments|length > 0 %}
            <p class="cm-work__meta mb-3">{{ 'lessonLogDocumentsAllOpenedLabel'|trans({'%count%': documentTracking.all, '%total%': documentTracking.total}) }}</p>
        {% endif %}

        {% if canEdit %}
            <div class="cm-footer-actions">
                {{ form_widget(form.submit) }}
            </div>
            {{ form_rest(form) }}
        {{ form_end(form) }}
    {% endif %}

    {# The frame the « Nouveau travail » wizard settles into, as a modal over the séance. Empty until
       it is asked for: it is the « Ajouter un travail » and « Modifier » links of
       _lesson_log_works.html.twig that fill it, and the wizard leaves it through _top. #}
    {% if canEdit %}
        <turbo-frame id="assignment-wizard"></turbo-frame>
    {% endif %}

    {% if canEdit and documentSection is not null %}
        {% include 'program/_lesson_log_attachment_form.html.twig' %}
    {% endif %}
{% endblock %}
