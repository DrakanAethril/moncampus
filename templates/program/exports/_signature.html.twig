<div class="d-print-none">
    {{ form_start(form) }}
        {{ form_errors(form) }}
        <div class="row row-cards">
            <div class="col-md-3">
                {{ form_row(form.startDay) }}
            </div>
            <div class="col-md-3">
                {{ form_row(form.endDay) }}
            </div>
            <div class="col-md-3">
                {# Aligned with the two date fields rather than under them: an empty label keeps the
                   box on the same baseline as the inputs it qualifies. #}
                <div class="form-label">&nbsp;</div>
                {{ form_row(form.alternanceOnly) }}
            </div>
            {# The two gestures share one column and one form. « Export PDF » is a second submitter
               rather than a form of its own: formaction points the very same query string (dates +
               « alternants seulement ») at the PDF route, so the file can never be built from
               parameters other than the ones on screen.

               data-turbo="false" because what comes back is a file, not a page - Turbo would try to
               render the PDF as a document and the download would never start. #}
            <div class="col-md-3 mb-3">
                <div class="form-label">&nbsp;</div>
                <div class="d-flex gap-2">
                    {{ form_widget(form.submit, {attr: {class: 'cm-btn cm-btn--primary flex-fill'}}) }}
                    <button type="submit" class="cm-btn cm-btn--outline flex-fill"
                            formaction="{{ path('app_program_exports_signature_pdf', {id: program.id}) }}"
                            data-turbo="false">
                        <twig:ux:icon name="file" class="icon" width="24" height="24" stroke-width="2"/>
                        {{ 'exportsSignaturePdfButtonLabel'|trans }}
                    </button>
                </div>
            </div>
        </div>
        {{ form_rest(form) }}
    {{ form_end(form) }}
</div>
{% for sheet in sheets %}
    {% include 'program/exports/_signature_sheet.html.twig' with {program: program, sheet: sheet} %}
{% endfor %}
