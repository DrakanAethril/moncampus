{# Standalone print document (no base.html.twig) - rendered by Gotenberg for the « Export PDF »
   button of the Feuilles d'émargement tab (App\Controller\ProgramExportsController). Every asset()
   call is prefixed with assetBase: Gotenberg has no browser origin of its own.

   It prints the very sheets the tab has just previewed - templates/program/exports/
   _signature_sheet.html.twig, same rows in the same order - drawn here with print CSS of its own
   rather than Tabler's, which no standalone document loads. The établissement's identity block is
   the émargement sheet's, reproduced rather than included for the same reason it is there:
   templates/program/exports/_institution_letterhead.html.twig is a <tr> of somebody else's table.

   Orientation is decided HERE rather than by a Gotenberg field: the client sends preferCssPageSize,
   so `@page { size: … }` is what the conversion reads. The margins still come from the exporter, and
   so does the footer band's width - a band sized for a portrait page would sit left of the text it
   underlines. #}
{% set assetBase = assetBaseUrl|default('') %}
<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="utf-8">
<title>{{ documentTitle }}</title>
<style>
    @page { size: A4 landscape; margin: 10mm 10mm 14mm; }
    * { -webkit-print-color-adjust: exact; print-color-adjust: exact; box-sizing: border-box; }
    body { margin: 0; font-family: 'DejaVu Sans', Carlito, Calibri, 'Segoe UI', sans-serif; color: #1b2430; font-size: 10pt; line-height: 1.35; }

    .head { display: flex; align-items: center; gap: 6mm; border: 0.6pt solid #1b2430; padding: 2.5mm 4mm; }
    .head__logo { width: 28mm; flex: 0 0 28mm; }
    .head__logo img { width: 100%; display: block; }
    .head__id { flex: 1; text-align: center; }
    .head__name { font-size: 12pt; font-weight: 700; }
    .head__legal { font-size: 7.5pt; line-height: 1.4; margin-top: 1.5mm; }

    .doc-title { text-align: center; font-size: 13pt; font-weight: 700; letter-spacing: 0.4pt; margin: 4mm 0 1mm; text-transform: uppercase; }
    .doc-class { text-align: center; font-size: 11pt; font-weight: 700; }
    .doc-day { text-align: center; font-size: 11pt; margin-bottom: 4mm; }

    table { width: 100%; border-collapse: collapse; }
    th, td { border: 0.6pt solid #1b2430; padding: 1.5mm 2mm; }
    {# The three heading rows repeat at the top of every page: a signature box is unreadable without
       the hour and the lesson above it, and a class of thirty rarely fits on one page. #}
    thead { display: table-header-group; }
    thead th { background: #eef3f9; font-size: 9pt; text-align: center; vertical-align: middle; }
    thead .col-head { text-align: left; font-size: 9pt; }
    tr { page-break-inside: avoid; }
    .col-name { width: 60mm; }
    {# No width of their own: the name is the only fixed column, so the day's créneaux share whatever
       the page has left - two are wide, eight are narrow. #}
    tbody .col-name { font-size: 11pt; vertical-align: middle; }
    tbody td { height: 10mm; }
    .row-sign td { height: 16mm; }
    .row-sign .col-name { font-size: 9pt; font-weight: 700; }

    {# One sheet per page. The last one carries no break, so the file never ends on a blank page. #}
    .sheet { page-break-after: always; }
    .sheet:last-child { page-break-after: auto; }
</style>
</head>
<body>

{% for sheet in sheets %}
    <div class="sheet">
        <div class="head">
            <div class="head__logo"><img src="{{ assetBase }}{{ asset('images/beaupeyrat-logo.png') }}" alt="Institution Beaupeyrat"></div>
            <div class="head__id">
                <div class="head__name">Institution Beaupeyrat &ndash; Centre de formation</div>
                <div class="head__legal">
                    9ter rue Pétiniaud Beaupeyrat &ndash; 87036 Limoges Cedex<br>
                    Siret : 775 716 715 00013 &ndash; APE 8531 Z<br>
                    Déclaration d'activité enregistrée sous le n° 748 700 407 87 auprès du Préfet de la région Nouvelle Aquitaine.
                </div>
            </div>
        </div>

        <div class="doc-title">{{ 'attendanceSheetDocumentTitle'|trans }}</div>
        <div class="doc-class">{{ program.displayShortName }}{% if sheet.optionLabel is not null %} &ndash; {{ 'reportOptionsFieldLabel'|trans }} {{ sheet.optionLabel }}{% endif %}</div>
        <div class="doc-day">{{ sheet.day }}</div>

        <table>
            <thead>
                <tr>
                    <th class="col-head col-name">{{ 'signatureScheduleColumnLabel'|trans }}</th>
                    {% for session in sheet.sessions %}
                        <th>{{ session.startHour }} - {{ session.endHour }}</th>
                    {% endfor %}
                </tr>
                <tr>
                    <th class="col-head col-name">{{ 'signatureTitleColumnLabel'|trans }}</th>
                    {% for session in sheet.sessions %}
                        <th>{{ session.title }}</th>
                    {% endfor %}
                </tr>
                <tr>
                    <th class="col-head col-name">{{ 'signatureTeacherColumnLabel'|trans }}</th>
                    {% for session in sheet.sessions %}
                        <th>{{ session.teacherName }}</th>
                    {% endfor %}
                </tr>
            </thead>
            <tbody>
                {% for student in sheet.students %}
                    <tr>
                        <td class="col-name">{{ student.displayName ?? student.username }}</td>
                        {% for session in sheet.sessions %}
                            <td></td>
                        {% endfor %}
                    </tr>
                {% endfor %}
                <tr class="row-sign">
                    <td class="col-name">{{ 'signatureTeacherSignatureRowLabel'|trans }}</td>
                    {% for session in sheet.sessions %}
                        <td></td>
                    {% endfor %}
                </tr>
            </tbody>
        </table>
    </div>
{% endfor %}

</body>
</html>
