{# Une séance proposée : d'où elle vient, quand, et le bouton qui reprend son contenu. Le clic ne
   fait que déposer les trois textes dans les éditeurs - c'est Enregistrer qui décide. #}
<div class="cm-import-row">
    <span class="cm-import-row__body">
        {% if label %}<span class="cm-import-row__kind">{{ label }}</span>{% endif %}
        <span class="cm-import-row__meta">{{ meta }}</span>
    </span>
    <button type="button" class="btn btn-sm btn-outline-primary" data-action="lesson-log-import#importFrom" data-url="{{ url }}">{{ 'lessonLogImportSubmitAction'|trans }}</button>
</div>
