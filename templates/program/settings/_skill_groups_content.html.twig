{# Server-rendered, not DataTables-backed: the rows reorder by drag-and-drop, which needs every row
   in the DOM at once and must not be bound inside a subtree DataTables rewraps (see
   App\Repository\SkillGroupRepository::findAllOrderedForProgram()). A program holds a handful of
   blocks, so there is nothing to page. #}
<div data-frankenphp-hot-reload-preserve
     data-controller="deactivable-list"
     data-deactivable-list-deactivate-url-template-value="{{ path(skillRoutes.deactivate, {id: program.id, groupId: '__ID__'}) }}"
     data-deactivable-list-token-value="{{ csrf_token('program_settings_deactivate') }}"
     data-deactivable-list-deactivate-confirm-message-value="{{ 'deactivateConfirmMessage'|trans }}"
     data-deactivable-list-error-message-value="{{ 'deactivateErrorMessage'|trans }}">
    <div class="form-check form-switch mb-2 mt-2">
        <input class="form-check-input" type="checkbox" id="internship-skills-include-inactive" data-deactivable-list-target="includeInactive" data-action="change->deactivable-list#toggleInactive">
        <label class="form-check-label" for="internship-skills-include-inactive">{{ 'showInactiveFilterLabel'|trans }}</label>
    </div>
    <div class="table-responsive">
        <table class="table table-vcenter card-table table-striped">
            <thead>
                <tr>
                    <th></th>
                    <th>{{ 'internshipSkillGroupCodeColumnLabel'|trans }}</th>
                    <th>{{ 'internshipSkillGroupLabelColumnLabel'|trans }}</th>
                    <th class="cm-actions"></th>
                </tr>
            </thead>
            <tbody data-controller="sortable-reorder"
                   data-sortable-reorder-url-value="{{ path(skillRoutes.reorder, {id: program.id}) }}"
                   data-sortable-reorder-token-value="{{ csrf_token('program_settings_skill_groups_reorder') }}">
                {% for skillGroup in skillGroups %}
                    {% set isInactive = skillGroup.inactiveDate is not null %}
                    <tr data-deactivable-list-target="row" data-inactive="{{ isInactive ? 'true' : 'false' }}"{{ isInactive ? ' hidden' : '' }} data-sortable-reorder-id-param="{{ skillGroup.id }}">
                        <td><span class="sortable-reorder-handle" style="cursor: grab; color: var(--cm-faint, #8a99a6);">&#10287;</span></td>
                        <td>
                            {% if skillGroup.code %}
                                <span class="badge bg-blue-lt">{{ skillGroup.code }}</span>
                            {% else %}
                                <span class="text-secondary">&mdash;</span>
                            {% endif %}
                        </td>
                        <td>
                            <a href="{{ path(skillRoutes.skills, {id: program.id, groupId: skillGroup.id}) }}">{{ skillGroup.label }}</a>
                            {% if isInactive %}<span class="badge bg-secondary-lt ms-2">{{ 'deactivatedStatusLabel'|trans }}</span>{% endif %}
                        </td>
                        <td class="cm-actions">
                            <a href="{{ path(skillRoutes.edit, {id: program.id, groupId: skillGroup.id}) }}" class="cm-action--warning">{{ 'editActionLabel'|trans }}</a>
                            {% if not isInactive %}
                                <button type="button" class="cm-action--danger" data-id="{{ skillGroup.id }}" data-action="click->deactivable-list#deactivate">{{ 'deactivateActionLabel'|trans }}</button>
                            {% endif %}
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="4" class="text-center text-secondary">{{ 'datatableZeroRecordsLabel'|trans }}</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
