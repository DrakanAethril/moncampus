{% extends 'layout/app.html.twig' %}

{% block title %}{{ quizInstance.name }}{% endblock %}
{% block page_breadcrumb %}{% endblock %}
{% block page_title %}{{ quizInstance.name }}{% endblock %}

{% block main %}
    {# The journal is only mounted on a supervised évaluation, and it carries the key its beacons
       authenticate with. Nothing is listened to anywhere else. #}
    <div class="d-flex justify-content-center"
         {% if supervisionKey %}data-controller="quiz-supervision"
         data-quiz-supervision-url-value="{{ path('app_program_quiz_event', {id: program.id, instanceId: quizInstance.id, attemptId: attempt.id}) }}"
         data-quiz-supervision-key-value="{{ supervisionKey }}"
         data-quiz-supervision-position-value="{{ position }}"{% endif %}>
        <div style="width: 820px; max-width: 100%;">
        {% if supervisionWarns %}
            {# Sits ABOVE the card without moving it, does not steal focus and does not close. It
               states facts - how many, and how long - not an accusation: that is what makes it
               bearable for the student whose screen went to sleep, and dissuasive for the other. #}
            <div class="cm-audio-warn mb-3" role="status">
                <b>{{ 'quizSupervisionBannerTitleTemplate'|trans({'%count%': supervisionAbsences|length}) }}</b>
                ({{ supervisionAbsences|map(ms => ms|duration_ms)|join(', ') }}).
                {{ 'quizSupervisionBannerHintText'|trans }}
                {% if quizInstance.supervisionPolicy.value == 'autosubmit' and quizInstance.supervisionSubmitAt %}
                    {{ 'quizSupervisionBannerAutosubmitTemplate'|trans({'%count%': quizInstance.supervisionSubmitAt}) }}
                {% endif %}
            </div>
        {% endif %}
        <div class="card">
            <div class="card-body d-flex flex-column gap-3">
                <div class="d-flex align-items-center gap-3">
                    <div>
                        <div style="font: 600 16px var(--cm-font-title); color: var(--cm-ink);">{{ quizInstance.name }}</div>
                        <div class="text-secondary small">{{ quizInstance.mode.labelKey|trans }} · {{ program.displayShortName }}</div>
                    </div>
                    {# The time for THIS question: its own if it has one, the quiz's otherwise, none
                       when either says « unlimited » - the badge then disappears. The countdown
                       starts at what is LEFT of the budget, counted by the server from the first
                       display: reloading no longer hands out a fresh one, and the chip says the
                       same thing the server would answer to a late POST. #}
                    {% if questionSeconds %}
                        <span class="badge bg-warning-lt ms-auto d-flex align-items-center gap-2" style="font-weight:700;font-size:15px;padding:7px 14px;" data-controller="quiz-passation" data-quiz-passation-seconds-value="{{ remainingSeconds }}" data-quiz-passation-form-id-value="quiz-answer-form" data-quiz-passation-target="timer">
                            <span style="width:9px;height:9px;border-radius:50%;background:var(--cm-gold);"></span>
                            <span data-quiz-passation-target="timerText">--:--</span>
                        </span>
                    {% endif %}
                </div>
                <div>
                    <div class="text-secondary text-uppercase small fw-bold" style="letter-spacing:.5px;">{{ 'programQuizProgressTemplate'|trans({'%position%': position + 1, '%total%': total}) }}</div>
                    <div style="height:6px;background:var(--cm-border-soft);border-radius:3px;margin-top:7px;overflow:hidden;">
                        <div style="height:100%;background:var(--cm-brand);border-radius:3px;width:{{ ((position + 1) / total * 100)|round }}%"></div>
                    </div>
                </div>
                {% set is_blanks = question.type.value == 'texte_a_trous' %}
                {% set is_zone = question.type.value == 'zone' %}
                {% set is_legende = question.type.value == 'legende' %}
                {% set is_apparier = question.type.value == 'apparier' %}
                {% set is_numeric = question.type.usesNumericConfig %}
                {% set is_short = question.type.value == 'reponse_courte' %}
                {# A texte à trous *is* its own statement (screens 2c/2d): the sentence carries the
                   blanks, so it is rendered inside the form rather than as a heading above it. The
                   zones types keep their label as the consigne, but their image is the support
                   itself, rendered inside the form by the zone partial - not a heading illustration. #}
                {% if not is_blanks and not is_numeric %}
                    <div style="font: 600 20px var(--cm-font-title); color: var(--cm-ink); line-height:1.4;">{{ question.label }}</div>
                    {% if question.imageStorageKey and not is_zone and not is_legende %}
                        <img src="{{ file_url(question.imageStorageKey) }}" alt="" style="max-height:240px;border-radius:8px;">
                    {% endif %}
                {% endif %}

                <form id="quiz-answer-form" method="post" action="{{ path('app_program_quiz_answer', {id: program.id, instanceId: quizInstance.id, attemptId: attempt.id, position: position}) }}" class="d-flex flex-column gap-3"
                      {% if is_blanks %}data-controller="quiz-blanks-take"
                      data-quiz-blanks-take-mode-value="{{ question.blankMode.value }}"
                      data-quiz-blanks-take-count-template-value="{{ 'quizBlankFilledCountTemplate'|trans }}"{% endif %}
                      {% if is_zone %}data-controller="quiz-zone-take"
                      data-quiz-zone-take-hint-ids-value="{{ hintIds|json_encode }}"{% endif %}
                      {% if is_legende %}data-controller="quiz-legende-take"
                      data-quiz-legende-take-count-template-value="{{ 'quizLegendePlacedCountTemplate'|trans }}"{% endif %}
                      {% if is_apparier %}data-controller="quiz-apparier-take"
                      data-quiz-apparier-take-count-template-value="{{ 'quizApparierPlacedCountTemplate'|trans }}"{% endif %}>
                    <input type="hidden" name="_token" value="{{ csrf_token('quiz_attempt_answer') }}">

                    {% if is_blanks %}
                        {% include 'program/_quiz_blanks_take.html.twig' with {question: question, word_bank: wordBank} only %}
                    {% elseif is_zone %}
                        {% include 'program/_quiz_zone_take.html.twig' with {
                            question: question,
                            image_url: question.imageStorageKey ? file_url(question.imageStorageKey) : null,
                            hint_ids: hintIds,
                        } only %}
                    {% elseif is_legende %}
                        {% include 'program/_quiz_legende_take.html.twig' with {
                            question: question,
                            image_url: question.imageStorageKey ? file_url(question.imageStorageKey) : null,
                            zone_choices: zoneChoices,
                        } only %}
                    {% elseif is_short %}
                        {% include 'program/_quiz_short_answer_take.html.twig' with {question: question} only %}
                    {% elseif is_numeric %}
                        {# Formatted here, like every other caller of the partial: a raw float
                           renders "2.5" where the whole rest of the app - and this question's own
                           correction screen - writes "2,5". #}
                        {% include 'program/_quiz_numeric_take.html.twig' with {
                            question: question,
                            variables: numeric_display_variables(question, numericVariables),
                        } only %}
                    {% elseif is_apparier %}
                        {% include 'program/_quiz_apparier_take.html.twig' with {
                            question: question,
                            matching_pairs: matchingPairs,
                            matching_choices: matchingChoices,
                        } only %}
                    {% elseif question.type.value == 'ordre' %}
                        <div class="cm-answers" data-controller="quiz-reorder" data-quiz-reorder-field-name-value="answers">
                            {% for answer in answers %}
                                <div class="cm-answer-row" data-quiz-reorder-target="row">
                                    <span class="cm-qbank__index">{{ loop.index }}</span>
                                    <span class="cm-answer-input" style="cursor:default;">{{ answer.label }}</span>
                                    <input type="hidden" name="answers[]" value="{{ answer.id }}" data-quiz-reorder-target="input">
                                    <button type="button" class="cm-answer-move" data-action="click->quiz-reorder#moveUp">▲</button>
                                    <button type="button" class="cm-answer-move" data-action="click->quiz-reorder#moveDown">▼</button>
                                </div>
                            {% endfor %}
                        </div>
                        <div class="text-secondary small">{{ 'programQuizOrdreHintText'|trans }}</div>
                    {% else %}
                        {% set inputType = question.type.value == 'qcm_multi' ? 'checkbox' : 'radio' %}
                        <div class="d-flex flex-column gap-2">
                            {% for answer in answers %}
                                <label class="cm-radiocard">
                                    <input type="{{ inputType }}" name="answers[]" value="{{ answer.id }}" class="form-check-input" style="position:absolute;opacity:0;width:1px;height:1px;">
                                    <span class="cm-radiocard__dot" style="{{ inputType == 'checkbox' ? 'border-radius:5px;' }}"></span>
                                    <span class="cm-radiocard__title" style="font-weight:400;">{{ answer.label }}</span>
                                </label>
                            {% endfor %}
                        </div>
                    {% endif %}

                    <div class="d-flex align-items-center gap-3 border-top pt-3">
                        {% if is_blanks %}
                            <span class="text-secondary small" data-quiz-blanks-take-target="counter"></span>
                        {% endif %}
                        {% if is_legende %}
                            <span class="text-secondary small" data-quiz-legende-take-target="counter"></span>
                        {% endif %}
                        {% if is_apparier %}
                            <span class="text-secondary small" data-quiz-apparier-take-target="counter"></span>
                        {% endif %}
                        <span class="text-secondary small">{{ 'programQuizSingleAttemptHintText'|trans }}</span>
                        <button type="submit" class="btn btn-primary ms-auto">{{ (position + 1 < total ? 'programQuizNextQuestionAction' : 'programQuizFinishAction')|trans }}</button>
                    </div>
                </form>
            </div>
        </div>
        </div>
    </div>
{% endblock %}
