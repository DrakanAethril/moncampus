{% extends 'layout/app.html.twig' %}

{% block title %}{{ 'quizLiveNewPageHeading'|trans }} - {{ program.displayShortName }}{% endblock %}

{% block page_breadcrumb %}
    {% include '_breadcrumb.html.twig' with {segments: [
        {label: 'homeNavLabel'|trans, url: path('app_home')},
        {label: 'quizLiveNavLabel'|trans, url: path('app_tools_quiz_live')},
        {label: program.displayShortName, url: path('app_program_quiz_live_history', {id: program.id})},
        {label: 'quizLiveNewPageHeading'|trans, url: app.request.requestUri},
    ]} %}
{% endblock %}
{% block page_title %}{{ 'quizLiveNewPageHeading'|trans }}{% endblock %}

{% block main %}
    <div class="card" style="max-width: 640px;">
        <div class="card-header">
            <h3 class="card-title">{{ 'quizLiveNewPageHeading'|trans }}</h3>
        </div>
        <form method="post" action="{{ path('app_program_quiz_live_create', {id: program.id}) }}">
            <input type="hidden" name="_token" value="{{ csrf_token('quiz_live_create') }}">
            <div class="card-body d-flex flex-column gap-3"
                 data-controller="quiz-pool library-picker"
                 {# JSON_FORCE_OBJECT: a map of identifiers whose first key were 0 would be encoded as
                    an array, and the controller reads it by identifier. #}
                 data-quiz-pool-counts-value="{{ questionCountsByTemplate|json_encode(constant('JSON_FORCE_OBJECT')) }}"
                 data-quiz-pool-prototype-value="{{ include('program/_quiz_live_pool_row.html.twig', {templates: templates})|e('html_attr') }}">
                {% if templates is empty %}
                    <p class="text-secondary mb-0">{{ 'quizLiveNewEmptyTemplatesMessage'|trans }}</p>
                {% else %}
                    <div>
                        <label class="form-label" for="quiz-live-name">{{ 'quizLaunchNameFieldLabel'|trans }}</label>
                        {# No placeholder naming a quiz: the base one is no longer preselected (it is
                           picked in the modal), so the first of the list is nobody's choice. #}
                        <input type="text" class="form-control" id="quiz-live-name" name="name" maxlength="255">
                        <div class="form-hint">{{ 'quizLaunchNameFieldHint'|trans }}</div>
                    </div>
                    <div>
                        {# No `required` on the select: it sits behind the picker modal and is never
                           displayed, and an HTML5 rule on a control the browser cannot focus blocks
                           the submit while showing nothing at all. The create action refuses an
                           empty choice and says so (App\Controller\QuizLiveHostController).

                           The placeholder option is new too: the quiz used to be the first of the
                           list by default, which a button reading a name nobody chose would state
                           as a decision. #}
                        <label class="form-label required" for="quiz-live-template">{{ 'quizLiveNewTemplateFieldLabel'|trans }}</label>
                        {% embed '_library_picker_field.html.twig' with {
                            templates: templates,
                            placeholder: 'quizLaunchAdditionalTemplatePlaceholder'|trans,
                        } only %}
                            {% block select %}
                                <select class="cm-pickfield__select" id="quiz-live-template" name="templateId"
                                        data-quiz-pool-target="select" data-action="change->quiz-pool#update">
                                    <option value=""></option>
                                    {% for template in templates %}
                                        <option value="{{ template.id }}">{{ template.name }}</option>
                                    {% endfor %}
                                </select>
                            {% endblock %}
                        {% endembed %}
                        <div class="form-hint">{{ 'quizLiveNewTemplateFieldHint'|trans }}</div>
                    </div>
                    <div class="cm-quizpool">
                        <div class="cm-quizpool__rows" data-quiz-pool-target="rows"></div>
                        <button type="button" class="cm-dashed-add" data-quiz-pool-target="addButton" data-action="quiz-pool#add">{{ 'quizLaunchAddTemplateAction'|trans }}</button>
                        <div class="form-hint">{{ 'quizLiveNewPoolHintTemplate'|trans({'%count%': '<span data-quiz-pool-target="total"></span>'})|raw }}</div>
                    </div>
                    <div>
                        <label class="form-label" for="quiz-live-seconds">{{ 'quizLiveNewDefaultSecondsFieldLabel'|trans }}</label>
                        <input type="number" class="form-control" id="quiz-live-seconds" name="secondsPerQuestion" min="5" max="300">
                        <div class="form-hint">{{ 'quizLiveNewDefaultSecondsFieldHint'|trans }}</div>
                    </div>

                    {# One modal for the screen: the base quiz and every merge row open the same
                       tree, each filtered by what its own select offers. #}
                    {% include '_library_picker.html.twig' with {
                        tree: pickerTree,
                        title: 'quizPickerTitle'|trans,
                        search_placeholder: 'quizPickerSearchPlaceholder'|trans,
                        count_label: 'quizQuestionsCountLabel'|trans,
                        empty_message: 'quizPickerEmptyMessage'|trans,
                    } only %}
                {% endif %}
            </div>
            <div class="card-footer text-end">
                <a href="{{ path('app_program_quiz', {id: program.id}) }}" class="btn btn-link">{{ 'cancelAction'|trans }}</a>
                {% if templates is not empty %}
                    <button type="submit" class="btn btn-warning">{{ 'quizLiveNewSubmitAction'|trans }}</button>
                {% endif %}
            </div>
        </form>
    </div>
{% endblock %}
