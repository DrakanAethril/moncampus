{% extends 'layout/app.html.twig' %}

{# Outils > Sondages, onglet Modèles - rebuilt on the quiz library's classement
   (templates/library/quiz_list.html.twig): a rail of folders on the left, what the current folder
   holds on the right - sub-folders first, then the models.

   The tabs stay above the whole thing: a folder narrows the Modèles tab, it does not replace the
   shell the Campagnes tab lives in. #}

{% block title %}{{ currentFolder ? currentFolder.name : 'surveysPageHeading'|trans }}{% endblock %}

{% block page_breadcrumb %}
    {% include 'survey/_breadcrumb.html.twig' with {currentFolder: currentFolder, ancestors: ancestors} %}
{% endblock %}

{% block page_title %}{{ 'surveysPageHeading'|trans }}{% endblock %}

{% block page_actions %}
    {# GET, per the repository's rule for a "show me a result" form - a POST would have to redirect. #}
    <form method="get" action="{{ path('app_surveys_templates_search') }}" class="cm-slib__search">
        <input type="search" name="q" class="form-control form-control-sm"
               placeholder="{{ 'surveyLibrarySearchPlaceholder'|trans }}"
               aria-label="{{ 'surveyLibrarySearchPlaceholder'|trans }}">
    </form>
    {# Both doors carry the folder being looked at, which is the whole point of being in one: an
       imported questionnaire is filed where the author was standing, exactly like a new one. #}
    <a href="{{ path('app_survey_import', currentFolder ? {folder: currentFolder.id} : {}) }}" class="btn">{{ 'surveyImportButtonLabel'|trans }}</a>
    <a href="{{ path('app_survey_template_new', currentFolder ? {folder: currentFolder.id} : {}) }}" class="btn btn-primary">{{ 'surveyNewButtonLabel'|trans }}</a>
{% endblock %}

{% block main %}
    {% include 'survey/_page_head.html.twig' %}

    {% include '_tabs.html.twig' with {tabs: tabs|map(t => {url: t.url, label: t.label|trans, active: t.active, count: t.count})} %}

    <div class="cm-slib"
         data-controller="survey-library"
         data-survey-library-folder-url-value="{{ path('app_survey_folder_new') }}"
         data-survey-library-folder-rename-url-template-value="{{ path('app_survey_folder_rename', {folderId: '__FOLDER_ID__'}) }}"
         data-survey-library-folder-move-url-template-value="{{ path('app_survey_folder_move', {folderId: '__FOLDER_ID__'}) }}"
         data-survey-library-template-move-url-template-value="{{ path('app_survey_template_move', {id: '__ID__'}) }}"
         data-survey-library-token-value="{{ csrf_token('survey_folder') }}"
         data-survey-library-labels-value="{{ {
             folderPrompt: 'surveyFolderNamePrompt'|trans,
             renamePrompt: 'surveyFolderRenamePrompt'|trans,
             movePrompt: 'surveyLibraryMovePromptTitle'|trans,
             moveRefused: 'surveyFolderMoveRefusedMessage'|trans,
         }|json_encode|e('html_attr') }}">

        {% include 'survey/_rail.html.twig' with {rail: rail, currentFolder: currentFolder} %}

        <div class="cm-slib__content">
            {% if folderRows is empty and templates is empty %}
                {% if currentFolder %}
                    <p class="cm-slib__empty">{{ 'surveyFolderEmptyText'|trans }}</p>
                {% else %}
                    <p class="fw-semibold mb-1">{{ 'surveyTemplatesEmptyTitle'|trans }}</p>
                    <p class="text-secondary mb-0">{{ 'surveyTemplatesEmptyText'|trans }}</p>
                {% endif %}
            {% else %}
                <div class="table-responsive">
                    <table class="cm-slib__table">
                        <thead>
                            <tr>
                                <th>{{ 'surveyTemplateNameColumnLabel'|trans }}</th>
                                <th>{{ 'surveyTemplateSubjectColumnLabel'|trans }}</th>
                                <th>{{ 'surveyTemplateQuestionCountColumnLabel'|trans }}</th>
                                <th>{{ 'surveyTemplateUpdatedColumnLabel'|trans }}</th>
                                <th><span class="visually-hidden">{{ 'surveyLibraryRowMenuLabel'|trans }}</span></th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for row in folderRows %}
                                {% include 'survey/_folder_row.html.twig' with {row: row} only %}
                            {% endfor %}
                            {% for template in templates %}
                                {% include 'survey/_template_row.html.twig' with {template: template} only %}
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% endif %}
        </div>

        {% include 'survey/_move_box.html.twig' with {rail: rail} %}
    </div>
{% endblock %}
