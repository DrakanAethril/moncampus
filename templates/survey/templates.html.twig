{% extends 'layout/app.html.twig' %}

{% block title %}{{ 'surveysPageHeading'|trans }}{% endblock %}

{% block page_breadcrumb %}
    {% include '_breadcrumb.html.twig' with {segments: [
        {label: 'homeNavLabel'|trans, url: path('app_home')},
        {label: 'surveysPageHeading'|trans, url: path('app_surveys')},
    ]} %}
{% endblock %}

{% block page_title %}{{ 'surveysPageHeading'|trans }}{% endblock %}

{% block page_actions %}
    <a href="{{ path('app_survey_template_new') }}" class="btn btn-primary">{{ 'surveyNewButtonLabel'|trans }}</a>
{% endblock %}

{% block main %}
    {% include 'survey/_page_head.html.twig' %}

    {% include '_tabs.html.twig' with {tabs: tabs|map(t => {url: t.url, label: t.label|trans, active: t.active, count: t.count})} %}

    <div class="card cm-card--tabbed">
        <div class="card-body">
            {% if templates is empty %}
                <p class="fw-semibold mb-1">{{ 'surveyTemplatesEmptyTitle'|trans }}</p>
                <p class="text-secondary mb-0">{{ 'surveyTemplatesEmptyText'|trans }}</p>
            {% else %}
                <div class="table-responsive">
                    <table class="table cm-table align-middle">
                        <thead>
                            <tr>
                                <th>{{ 'surveyTemplateNameColumnLabel'|trans }}</th>
                                <th>{{ 'surveyTemplateSubjectColumnLabel'|trans }}</th>
                                <th class="text-end">{{ 'surveyTemplateQuestionCountColumnLabel'|trans }}</th>
                                <th>{{ 'surveyTemplateUpdatedColumnLabel'|trans }}</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for template in templates %}
                                <tr>
                                    <td><a href="{{ path('app_survey_template_edit', {id: template.id}) }}">{{ template.name }}</a></td>
                                    <td class="text-secondary">{{ template.subject|default('—') }}</td>
                                    {# Intertitles are not questions - the count is the answerable ones (§7.13). #}
                                    <td class="text-end">{{ template.answerableQuestions|length }}</td>
                                    <td class="text-secondary">{{ (template.lastUpdatedDate ?? template.creationDate)|date('d/m/Y') }}</td>
                                    <td>
                                        <div class="cm-actionbar cm-actionbar--inline justify-content-end">
                                            <a class="cm-action cm-action--positive" href="{{ path('app_survey_launch', {id: template.id}) }}">{{ 'surveyLaunchCampaignActionLabel'|trans }}</a>
                                            <a class="cm-action cm-action--neutral" href="{{ path('app_survey_template_edit', {id: template.id}) }}">{{ 'editActionLabel'|trans }}</a>
                                            <form method="post" action="{{ path('app_survey_template_duplicate', {id: template.id}) }}">
                                                <input type="hidden" name="_token" value="{{ csrf_token('survey_template_duplicate') }}">
                                                <button type="submit" class="cm-action cm-action--neutral">{{ 'surveyDuplicateActionLabel'|trans }}</button>
                                            </form>
                                            <form method="post" action="{{ path('app_survey_template_remove', {id: template.id}) }}"
                                                  data-controller="confirm-submit"
                                                  data-confirm-submit-message-value="{{ 'surveyTemplateRemoveConfirmMessage'|trans }}">
                                                <input type="hidden" name="_token" value="{{ csrf_token('survey_template_remove') }}">
                                                <button type="submit" class="cm-action cm-action--danger">{{ 'removeActionLabel'|trans }}</button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% endif %}
        </div>
    </div>
{% endblock %}
