{% extends 'layout/app.html.twig' %}

{% block title %}{{ 'surveysPageHeading'|trans }}{% endblock %}

{% block page_breadcrumb %}
    {% include '_breadcrumb.html.twig' with {segments: [
        {label: 'homeNavLabel'|trans, url: path('app_home')},
        {label: 'surveysPageHeading'|trans, url: path('app_surveys')},
    ]} %}
{% endblock %}

{% block page_title %}{{ 'surveysPageHeading'|trans }}{% endblock %}

{% block page_actions %}
    <a href="{{ path('app_survey_template_new') }}" class="btn btn-primary">{{ 'surveyNewButtonLabel'|trans }}</a>
{% endblock %}

{% block main %}
    {% include 'survey/_page_head.html.twig' %}

    {% include '_tabs.html.twig' with {tabs: tabs|map(t => {url: t.url, label: t.label|trans, active: t.active, count: t.count})} %}

    <div class="card cm-card--tabbed">
        <div class="card-body">
            {% set launched = series|reduce((carry, s) => carry + s.campaigns|filter(c => c.isLaunched)|length, 0) %}
            {% if launched == 0 %}
                <p class="fw-semibold mb-1">{{ 'surveyCampaignsEmptyTitle'|trans }}</p>
                <p class="text-secondary mb-0">{{ 'surveyCampaignsEmptyText'|trans }}</p>
            {% else %}
                <div class="table-responsive">
                    <table class="table cm-table align-middle">
                        <thead>
                            <tr>
                                <th>{{ 'surveyCampaignColumnLabel'|trans }}</th>
                                <th>{{ 'surveyTargetColumnLabel'|trans }}</th>
                                <th>{{ 'surveyResponsesColumnLabel'|trans }}</th>
                                <th>{{ 'surveyStateColumnLabel'|trans }}</th>
                                <th>{{ 'surveyClosesColumnLabel'|trans }}</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for oneSeries in series %}
                                {% set waves = oneSeries.campaigns|filter(c => c.isLaunched)|sort((a, b) => b.waveNumber <=> a.waveNumber) %}
                                {% set waveCount = waves|length %}
                                {% for campaign in waves %}
                                    {% include 'survey/_campaign_row.html.twig' with {
                                        campaign: campaign,
                                        series: oneSeries,
                                        waveCount: waveCount,
                                        rate: rates[campaign.id]|default({targeted: 0, responded: 0}),
                                    } only %}
                                {% endfor %}
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% endif %}
        </div>
    </div>
{% endblock %}
