{# The parts the three results tabs share: the title, the breadcrumb, the action bar and the
   summary banner. Each tab fills `results_body`. #}
{% extends 'layout/app.html.twig' %}

{% block title %}{{ campaign.name }}{% endblock %}

{% block page_breadcrumb %}
    {% include '_breadcrumb.html.twig' with {segments: [
        {label: 'homeNavLabel'|trans, url: path('app_home')},
        {label: 'surveysPageHeading'|trans, url: path('app_surveys')},
        {label: campaign.name, url: path('app_survey_campaign', {id: campaign.id})},
    ]} %}
{% endblock %}

{% block page_title %}{{ campaign.name }}{% endblock %}

{% block page_actions %}
    <a href="{{ path('app_survey_campaign_export', {id: campaign.id}) }}" class="btn btn-outline-secondary">{{ 'surveyExportCsvActionLabel'|trans }}</a>
    {% if campaign.series.campaigns|length > 1 %}
        <a href="{{ path('app_survey_series', {id: campaign.series.id}) }}" class="btn btn-primary">{{ 'surveyCompareWavesActionLabel'|trans }}</a>
    {% endif %}
{% endblock %}

{% block main %}
    <p class="text-secondary mb-3">
        {{ campaign.series.campaigns|length > 1
            ? 'surveyWaveOfCountLabel'|trans({'%number%': campaign.waveNumber, '%count%': campaign.series.campaigns|length})
            : 'surveySingleWaveLabel'|trans }}
        · {{ campaign.anonymous ? 'surveyAnonymousLabel'|trans : 'surveyNominativeLabel'|trans }}
        · {{ campaign.state.labelKey|trans|lower }}
    </p>

    {% include 'survey/_results_head.html.twig' %}

    {% include '_tabs.html.twig' with {tabs: tabs|map(t => {url: t.url, label: t.label|trans, active: t.active, count: t.count})} %}

    <div class="card cm-card--tabbed">
        <div class="card-body">
            {% block results_body %}{% endblock %}
        </div>
    </div>
{% endblock %}
