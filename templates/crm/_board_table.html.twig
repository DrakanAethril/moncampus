{# One table of a formation's page: a row per dossier, grouped by situation, a column per piece
   (« — » where the piece does not apply), the modality when the table is not one modality's. #}
<div class="cm-crm-tablewrap">
    <table class="cm-crm-table cm-crm-board">
        <thead>
            <tr>
                <th class="is-cand">{{ 'crmCandidateColumn'|trans }}</th>
                {% if not table.modality %}<th>{{ 'crmModalityColumn'|trans }}</th>{% endif %}
                <th>{{ 'crmStepColumn'|trans }}</th>
                {% for piece in table.columns %}<th class="is-piece" title="{{ piece.label }}">{{ piece.label }}</th>{% endfor %}
            </tr>
        </thead>
        <tbody>
            {% for group in table.groups %}
                {% set groupKey = keyPrefix ~ '-' ~ (table.modality ? table.modality.value : 'all') ~ '-' ~ group.key %}
                {% set closed = group.key != 'active' %}
                {% if group.labelKey %}
                    <tr class="is-group{% if closed %} is-closed{% endif %}" data-group="{{ groupKey }}">
                        <td colspan="{{ 2 + (table.modality ? 0 : 1) + table.columns|length }}">
                            <button type="button" data-action="crm-board#toggle" aria-expanded="{{ closed ? 'false' : 'true' }}"><twig:ux:icon name="caret-right" width="12" height="12"/>{{ group.labelKey|trans }} <twig:Cm:Badge tone="gray">{{ group.rows|length }}</twig:Cm:Badge></button>
                        </td>
                    </tr>
                {% else %}
                    {% set closed = false %}
                {% endif %}
                {% for progress in group.rows %}
                    {% set dossier = progress.dossier %}
                    <tr data-in-group="{{ groupKey }}"{% if closed %} class="is-hidden"{% endif %}>
                        <td class="is-cand">
                            <a class="cm-crm-cand" href="{{ path('app_crm_dossier', {id: dossier.id}) }}">{{ dossier.candidate.fullName }}</a>
                            {% include 'crm/_tags.html.twig' with {progress: progress, asksOption: asksOption} only %}
                        </td>
                        {% if not table.modality %}<td><twig:Cm:Badge :of="dossier.modality"/></td>{% endif %}
                        <td>{% if dossier.situation.value == 'active' %}<twig:Cm:Badge :of="progress.step"/>{% else %}<twig:Cm:Badge :of="dossier.situation"/>{% endif %}</td>
                        {% for piece in table.columns %}
                            {% if progress.applies(piece) %}
                                <td>{% include 'crm/_cell.html.twig' with {progress: progress, piece: piece, back: back, csrf: csrf} only %}</td>
                            {% else %}
                                <td class="is-na" title="{{ 'crmNotApplicableHint'|trans }}">—</td>
                            {% endif %}
                        {% endfor %}
                    </tr>
                {% endfor %}
            {% endfor %}
        </tbody>
    </table>
</div>
