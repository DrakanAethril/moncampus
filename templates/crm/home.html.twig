{% extends 'crm/_layout.html.twig' %}

{# The CRM's home (design/validated/crm-prototype.html, « proposition 2 »): a search by name that
   opens a dossier, then « Nouveau dossier », the overview, the settings and the history. The work
   year is chosen here alone. #}

{% block title %}{{ 'crmNavLabel'|trans }}{% endblock %}

{% block page_breadcrumb %}
    {{ component('Cm:Breadcrumb', {segments: [{label: 'crmNavLabel'|trans, url: path('app_crm_home')}]}) }}
{% endblock %}

{# The prototype centres the title over the search, with the year under it: the shell's header
   keeps the trail alone, and the title is drawn in the page. #}
{% block page_header %}
    <div class="page-header d-print-none">
        <div class="container-xl">
            {{ block('page_breadcrumb') }}
        </div>
    </div>
{% endblock %}

{% block crm_content %}
    <div class="cm-crm-home">
        <div class="cm-crm-home__head">
        <h1 class="cm-crm-home__title">{{ 'crmHomeHeading'|trans }}</h1>
        {% if workYear is null %}
        </div>
            <div class="cm-crm-callout">
                {{ 'crmNoYearText'|trans }} <a href="{{ path('app_crm_settings') }}">{{ 'crmOpenSettingsLink'|trans }}</a>
            </div>
        {% else %}
            {% if picking and openedYears|length > 1 %}
                <div class="cm-crm-home__year">
                    <span>{{ 'crmSchoolYearLabel'|trans }}</span>
                    {% for year in openedYears %}
                        <form method="post" action="{{ path('app_crm_work_year', {id: year.id}) }}">
                            <input type="hidden" name="_token" value="{{ crm_csrf }}">
                            <twig:Cm:Button variant="{{ year == workYear ? 'primary' : 'outline' }}" size="sm" type="submit">{{ year|crm_year }}{% if year == defaultYear %} {{ 'crmDefaultSuffix'|trans }}{% endif %}</twig:Cm:Button>
                        </form>
                    {% endfor %}
                    <a href="{{ path('app_crm_home') }}">{{ 'crmCancelAction'|trans }}</a>
                </div>
            {% elseif workYear != defaultYear and defaultYear is not null %}
                <div class="cm-crm-yearoff" role="status">
                    <span>{{ 'crmWorkingOnText'|trans({'%year%': workYear|crm_year})|raw }}</span>
                    <form method="post" action="{{ path('app_crm_work_year', {id: defaultYear.id}) }}">
                        <input type="hidden" name="_token" value="{{ crm_csrf }}">
                        <twig:Cm:Button variant="outline" size="sm" type="submit">{{ 'crmBackToYearAction'|trans({'%year%': defaultYear|crm_year}) }}</twig:Cm:Button>
                    </form>
                    {% if openedYears|length > 2 %}<a href="{{ path('app_crm_home', {pick: 1}) }}">{{ 'crmOtherYearAction'|trans }}</a>{% endif %}
                </div>
            {% else %}
                <div class="cm-crm-home__year">
                    <span>{{ 'crmSchoolYearLabel'|trans }} <b>{{ workYear|crm_year }}</b></span>
                    {% if openedYears|length > 1 %}<a href="{{ path('app_crm_home', {pick: 1}) }}">{{ 'crmChangeAction'|trans }}</a>{% endif %}
                </div>
            {% endif %}
        </div>

            <div class="cm-crm-search" data-controller="crm-search" data-crm-search-url-value="{{ path('app_crm_search') }}">
                <twig:ux:icon name="search" width="18" height="18"/>
                <input class="cm-crm-search__input" type="search" autocomplete="off" spellcheck="false" autofocus
                       value="{{ query }}" placeholder="{{ 'crmSearchPlaceholder'|trans }}" aria-label="{{ 'crmSearchPlaceholder'|trans }}"
                       role="combobox" aria-autocomplete="list" aria-controls="crm-hits" aria-expanded="false"
                       data-crm-search-target="input" data-action="input->crm-search#query keydown->crm-search#key">
                <ul class="cm-crm-hits" id="crm-hits" role="listbox" aria-label="{{ 'crmHitsLabel'|trans }}" hidden data-crm-search-target="list" data-action="mouseover->crm-search#hover"></ul>
            </div>

            <div class="cm-crm-home__actions">
                <twig:Cm:Button variant="primary" data-action="crm-dialog#open" data-crm-dialog-url-param="{{ path('app_crm_new') }}"><twig:ux:icon name="plus" width="14" height="14"/>{{ 'crmNewDossierAction'|trans }}</twig:Cm:Button>
                <twig:Cm:Button variant="outline" href="{{ path('app_crm_overview', {id: workYear.id}) }}">{{ 'crmOverviewAction'|trans }}</twig:Cm:Button>
                <twig:Cm:Button variant="outline" href="{{ path('app_crm_settings') }}"><twig:ux:icon name="settings" width="14" height="14"/>{{ 'crmSettingsAction'|trans }}</twig:Cm:Button>
                <twig:Cm:Button variant="outline" href="{{ path('app_crm_history', {id: workYear.id}) }}"><twig:ux:icon name="clock" width="14" height="14"/>{{ 'crmHistoryAction'|trans }}</twig:Cm:Button>
            </div>
            <div class="cm-crm-home__hint">{{ 'crmSearchHint'|trans|raw }}</div>
        {% endif %}
    </div>
{% endblock %}
