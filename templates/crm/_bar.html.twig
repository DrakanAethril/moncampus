{# A formation's progress bar: its active dossiers by step. #}
{% if stats.active == 0 %}
    <div class="cm-crm-bar" aria-label="{{ 'crmNoActiveDossierLabel'|trans }}"></div>
{% else %}
    <div class="cm-crm-bar" role="img" aria-label="{{ 'crmBarLabel'|trans({'%mod%': stats.steps.modality, '%pre%': stats.steps.pre_enrolment, '%send%': stats.steps.file_sending, '%ins%': stats.steps.enrolment, '%di%': stats.steps.di_pieces, '%doc%': stats.steps.documents, '%done%': stats.steps.complete}) }}">
        {% for step in ['modality', 'pre_enrolment', 'file_sending', 'enrolment', 'di_pieces', 'documents', 'complete'] %}
            {% if stats.steps[step] > 0 %}<span class="{{ step }}" style="width: {{ stats.share(step) }}%" title="{{ stats.steps[step] }}"></span>{% endif %}
        {% endfor %}
    </div>
{% endif %}
