{% extends 'crm/_layout.html.twig' %}

{# A formation's page: its figures, then one list of its candidates by surname - the modality and a
   mark per stage (pré-inscription, inscription, dossier complet). The resigned and cancelled are
   shown on demand; the export has them always, with mails and phones. A formation that asks for an
   option filters by option, and so does its export. #}

{% block title %}{{ program.shortName }} · {{ 'crmNavLabel'|trans }}{% endblock %}

{% block page_breadcrumb %}
    {{ component('Cm:Breadcrumb', {segments: [
        {label: 'crmNavLabel'|trans, url: path('app_crm_home')},
        {label: year|crm_year, url: path('app_crm_overview', {id: year.id})},
        {label: program.shortName, url: path('app_crm_program', {id: program.id})},
    ]}) }}
{% endblock %}

{% block page_title %}{{ program.shortName }}{% endblock %}

{% block page_actions %}
    <twig:Cm:Button variant="outline" href="{{ path('app_crm_program_export', {id: program.id}|merge(board.option ? {option: board.option} : {})) }}" data-turbo="false"><twig:ux:icon name="download" width="14" height="14"/>{{ 'crmExportCsvAction'|trans }}</twig:Cm:Button>
    <twig:Cm:Button variant="primary" data-action="crm-dialog#open" data-crm-dialog-url-param="{{ path('app_crm_new', {program: program.id}) }}"><twig:ux:icon name="plus" width="14" height="14"/>{{ 'crmNewDossierAction'|trans }}</twig:Cm:Button>
{% endblock %}

{% block crm_content %}
    <p class="cm-crm-sub">{{ program.name }}</p>

    {% if board.asksOption %}
        <div class="cm-crm-optbar">
            <span>{{ 'crmOptionLabel'|trans }}</span>
            <nav class="cm-crm-seg" aria-label="{{ 'crmOptionLabel'|trans }}">
                {% for link in board.optionLinks %}
                    {% set params = {id: program.id}|merge(link.key is null ? {} : {option: link.key}) %}
                    <a href="{{ path('app_crm_program', params) }}"{% if board.option == link.key %} aria-current="true"{% endif %}>{{ link.key is null ? 'crmAllLabel'|trans : (link.key == 'none' ? 'crmToSpecifyLabel'|trans : link.label) }}<span class="n">{{ link.count }}</span></a>
                {% endfor %}
            </nav>
        </div>
    {% endif %}

    {% set stats = board.stats %}
    <div class="cm-crm-kpis">
        <div class="cm-crm-kpi"><span class="cm-crm-kpi__value">{{ stats.active }}</span><span class="cm-crm-kpi__label">{{ 'crmKpiActiveLabel'|trans }}</span></div>
        <div class="cm-crm-kpi"><span class="cm-crm-kpi__value">{{ stats.steps.complete }}</span><span class="cm-crm-kpi__label">{{ 'crmKpiCompleteShortLabel'|trans }}</span></div>
        <div class="cm-crm-kpi">{% include 'crm/_kpi_modalities.html.twig' with {stats: stats} only %}</div>
        <div class="cm-crm-kpi"><span class="cm-crm-kpi__value">{{ stats.low }}</span><span class="cm-crm-kpi__label">{{ 'crmKpiLowLabel'|trans({'%count%': stats.visaPending}) }}</span></div>
    </div>

    {% set toggleParams = {id: program.id}|merge(board.option ? {option: board.option} : {})|merge(board.showClosed ? {} : {closed: 1}) %}
    <section class="cm-crm-card">
        <div class="cm-crm-subhead">
            <h2 class="cm-crm-subhead__title">{{ 'crmDossiersHeading'|trans({'%count%': board.rows|length}) }}</h2>
            <a class="cm-crm-acc__done" href="{{ path('app_crm_program', toggleParams) }}" data-turbo-action="replace">
                <input type="checkbox" tabindex="-1" aria-hidden="true"{% if board.showClosed %} checked{% endif %}>
                {{ 'crmShowClosedLabel'|trans }} <span class="cm-crm-faint cm-crm-num">({{ board.closedCount }})</span>
            </a>
        </div>
        {% if board.rows is empty %}
            <p class="cm-crm-faint">{% if board.empty %}{{ 'crmProgramEmptyText'|trans }}{% elseif board.filtered %}{{ 'crmListFilteredEmptyText'|trans }}{% else %}{{ 'crmListEmptyText'|trans }}{% endif %}</p>
        {% else %}
            <div class="cm-crm-tablewrap">
                <table class="cm-crm-table cm-crm-list">
                    <thead>
                        <tr>
                            <th>{{ 'crmCandidateColumn'|trans }}</th>
                            <th>{{ 'crmModalityColumn'|trans }}</th>
                            <th class="c">{{ 'crmPhasePreEnrolmentLabel'|trans }}</th>
                            <th class="c">{{ 'crmPhaseEnrolmentLabel'|trans }}</th>
                            <th class="c">{{ 'crmCompleteDossierColumn'|trans }}</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for row in board.rows %}
                            {% set dossier = row.progress.dossier %}
                            <tr class="is-link">
                                <td>
                                    <a class="cm-crm-rowlink" href="{{ path('app_crm_dossier', {id: dossier.id}) }}">{{ dossier.candidate.fullName }}</a>
                                    {% if dossier.situation.value != 'active' %}<twig:Cm:Badge :of="dossier.situation"/>{% endif %}
                                    {% include 'crm/_tags.html.twig' with {progress: row.progress, asksOption: board.asksOption} only %}
                                </td>
                                <td><twig:Cm:Badge :of="dossier.modality"/></td>
                                {% for phase in ['pre_enrolment', 'enrolment'] %}
                                    <td class="c">{% include 'crm/_stage_mark.html.twig' with {state: row.stages[phase]} only %}</td>
                                {% endfor %}
                                <td class="c">{% include 'crm/_stage_mark.html.twig' with {state: row.complete ? 'done' : 'todo'} only %}</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}
    </section>
{% endblock %}
