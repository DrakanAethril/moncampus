{# A course handout rendered from Markdown (App\Service\CourseMaterialRenderer) - standalone, since it
   is either saved as an .html file or printed by Gotenberg's Chromium. `meta charset` is not
   optional: without it Chromium guesses the encoding and the accents come out as ideograms. `body`
   has been through the library sanitizer. #}
<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="utf-8">
<title>{{ title }}</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Source+Sans+3:ital,wght@0,400;0,600;0,700;1,400&family=Spectral:wght@600&display=swap" rel="stylesheet">
<style>
    @page {
        size: A4;
        margin: 18mm 17mm 20mm;
        @bottom-center { content: counter(page) " / " counter(pages); font-family: 'Source Sans 3', sans-serif; font-size: 9pt; color: #7a8699; }
    }
    body { margin: 0; font-family: 'Source Sans 3', 'Segoe UI', sans-serif; color: #1c2b36; font-size: 11pt; line-height: 1.5; }
    .cm-handout__title { font-family: Spectral, Georgia, serif; font-weight: 600; font-size: 22pt; color: #12344d; margin: 0 0 6mm; padding-bottom: 3mm; border-bottom: 2px solid #1b6ba8; }
    h1, h2, h3, h4 { font-family: Spectral, Georgia, serif; font-weight: 600; color: #12344d; break-after: avoid; }
    h1 { font-size: 17pt; margin: 8mm 0 3mm; }
    h2 { font-size: 14pt; margin: 7mm 0 2.5mm; color: #1b6ba8; }
    h3 { font-size: 12pt; margin: 5mm 0 2mm; }
    p { margin: 0 0 2.5mm; }
    ul, ol { margin: 0 0 3mm; padding-left: 7mm; }
    li { margin-bottom: 1mm; }
    table { border-collapse: collapse; width: 100%; margin: 3mm 0 4mm; font-size: 10pt; break-inside: avoid; }
    th, td { border: 1px solid #c2ccd4; padding: 1.5mm 2.5mm; text-align: left; vertical-align: top; }
    th { background: #e8f1f8; color: #12344d; }
    code { font-family: 'SFMono-Regular', Consolas, monospace; font-size: 9.5pt; background: #f2f5f8; padding: 0 1mm; border-radius: 2px; }
    pre { background: #f2f5f8; border-left: 3px solid #1b6ba8; padding: 3mm 4mm; white-space: pre-wrap; break-inside: avoid; }
    pre code { background: none; padding: 0; }
    blockquote { margin: 3mm 0; padding: 2mm 4mm; border-left: 3px solid #c9a04e; background: #fbf8f1; }
    a { color: #1b6ba8; }
</style>
</head>
<body>
    <h1 class="cm-handout__title">{{ title }}</h1>
    {{ body|raw }}
</body>
</html>
