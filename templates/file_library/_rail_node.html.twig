{# One folder of the rail, recursing into its children - the wiki's `_rail_node` shape, minus what
   the library does not have.

   **What is open by default**: the branch leading to the folder being browsed, and that folder's own
   direct children. The rule needs no state and no round trip - the materialized path already says
   who is an ancestor of the current folder, so the server answers it while rendering.

   There is **no re-order drag** here, so a node carries no `data-parent-id`: dropping means "into
   this folder" and nothing else. That is the one gesture the library has, and it is the one the wiki
   already taught its users. #}
{% set hasChildren = row.children is not empty %}
{% set expanded = hasChildren and currentFolder and (currentFolder.id == row.id or ('/' ~ row.id ~ '/') in currentFolder.path) %}
<li class="cm-flib__node{{ hasChildren and not expanded ? ' is-collapsed' }}"
    data-file-library-tree-target="node"
    {# `data-node-name` is what the rename prompt opens on: the controller reads it off the closest
       element carrying a node id, and the rail is one of the two places that element is a folder. #}
    data-node-id="{{ row.id }}" data-node-name="{{ row.name }}" draggable="true">
    <div class="cm-flib__node-row">
        <span class="cm-flib__node-grip" aria-hidden="true">
            <twig:ux:icon name="grip" width="10" height="14"/>
        </span>

        {% if hasChildren %}
            {# One triangle, rotated by CSS: the two states cannot drift apart the way two glyphs would. #}
            <button type="button" class="cm-flib__node-toggle"
                    aria-expanded="{{ expanded ? 'true' : 'false' }}"
                    aria-label="{{ 'fileLibraryToggleBranchAction'|trans({'%name%': row.name}) }}"
                    data-action="file-library-tree#toggleBranch">
                <twig:ux:icon name="caret-right" width="9" height="9"/>
            </button>
        {% else %}
            <span class="cm-flib__node-toggle cm-flib__node-toggle--empty" aria-hidden="true"></span>
        {% endif %}

        <a class="cm-flib__node-link{{ currentFolder and currentFolder.id == row.id ? ' is-current' }}"
           href="{{ path('app_file_library_folder', {nodeId: row.id}) }}" title="{{ row.name }}">
            <span class="cm-flib__node-ico" aria-hidden="true">
                <twig:ux:icon name="folder" width="15" height="15"/>
            </span>
            <span class="cm-flib__node-title">{{ row.name }}</span>
        </a>

        {# The two acts that change the tree, at the row they act on rather than in a bar at the top.

           Renaming rather than the « + » this used to carry: a sub-folder is created from the foot's
           button, which already asks where, whereas renaming a folder had no gesture at all outside
           the listing's row menu - and a rail row is where a badly named folder is actually noticed. #}
        <span class="cm-flib__node-actions">
            {# Hidden where the `file-library` controller is not mounted - the read screens (recherche,
               corbeille, partages). A button that does nothing is worse than an absent one. #}
            {% if not readonly|default(false) %}
                <button type="button" class="cm-flib__node-action"
                        title="{{ 'fileLibraryRenameAction'|trans }}"
                        aria-label="{{ 'fileLibraryRenameFolderNamedAction'|trans({'%name%': row.name}) }}"
                        data-action="file-library#promptRename">
                    <twig:ux:icon name="pencil" width="14" height="14"/>
                </button>
            {% endif %}

            <form method="post" action="{{ path('app_file_library_node_delete', {nodeId: row.id}) }}">
                <input type="hidden" name="_token" value="{{ csrf_token('file_library_node') }}">
                {# The confirmation names the folder, not just "this": deleting one takes everything
                   under it, and the rail is where that is least visible. #}
                <button type="submit" class="cm-flib__node-action cm-flib__node-action--danger"
                        title="{{ 'fileLibraryDeleteFolderAction'|trans }}"
                        aria-label="{{ 'fileLibraryDeleteFolderNamedAction'|trans({'%name%': row.name}) }}"
                        data-controller="confirm-submit"
                        data-confirm-submit-message-value="{{ 'fileLibraryDeleteFolderConfirmText'|trans({'%name%': row.name}) }}"
                        data-action="click->confirm-submit#confirm">
                    <twig:ux:icon name="trash" width="14" height="14"/>
                </button>
            </form>
        </span>
    </div>

    {% if hasChildren %}
        <ul class="cm-flib__tree cm-flib__tree--nested">
            {% for child in row.children %}
                {% include 'file_library/_rail_node.html.twig' with {row: child, currentFolder: currentFolder, readonly: readonly|default(false)} only %}
            {% endfor %}
        </ul>
    {% endif %}
</li>
