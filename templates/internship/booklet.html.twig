    <h2 class="lv-h2" id="section-ii-2">2. Emploi du temps</h2>
    <div style="text-align: center; font-weight: 700; font-size: 13pt; color: #1b2430;">{{ program.displayName }} &ndash; Emploi du temps</div>
    <object data="{{ timetableFileUrl }}" type="application/pdf" style="flex: 1; width: 100%; min-height: 180mm; border: 0.5pt solid #c9d2de; margin-top: 3mm;">
      {# Same fallback as the calendar's: anything that does not display PDFs inline (a browser
         print of the web booklet included) still gets a usable link. #}
