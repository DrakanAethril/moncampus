{# Booklet reader: table of contents on the left, the real document in an iframe on the right (see
   assets/controllers/livret_reader_controller.js). Shared by the four screens that show a booklet,
   which only differ by their header and by the iframe's route - hence the parameters expected:
   `frameUrl`, and `outline`, the booklet's own outline (booklet_outline(tutorLink), see
   App\Service\BookletOutline) - the same one its printed sommaire is made of, plus the evaluation
   periods, which only this menu lists. #}
<div class="row" data-controller="livret-reader">
    <div class="col-md-3">
        <div class="card">
            <div class="card-header"><h3 class="card-title mb-0">{{ 'ufaAlternanceLivretSommaireTitle'|trans }}</h3></div>
            <div class="list-group list-group-flush" data-livret-reader-target="toc">
                {% for entry in outline %}
                    <a href="#{{ entry.anchor }}" class="list-group-item list-group-item-action {{ entry.level == 1 ? 'fw-bold' : 'ps-4' }}" data-action="click->livret-reader#navigate">
                        {{- entry.number ? entry.number ~ ' ' }}{{ entry.labelKey ? entry.labelKey|trans : entry.label -}}
                    </a>
                {% endfor %}
            </div>
            <div class="card-footer text-secondary small">{{ 'ufaAlternanceLivretEmptySectionNote'|trans }}</div>
        </div>
    </div>
    <div class="col-md-9">
        <div class="card">
            <iframe data-livret-reader-target="frame" src="{{ frameUrl }}" style="width: 100%; height: 80vh; border: 0; background: #e8eef3;"></iframe>
        </div>
    </div>
</div>
