{# Gap chip, shared by the student's comparison screen (5c) and the teacher's tracking screen (5d).
   `fair` is decided by the caller: exactness at the grain of a question, a ±1 point tolerance at the
   grain of the total grade (see App\Service\SelfAssessmentComparator). #}
{% if gap is null %}
    <span class="cm-sa-gap cm-sa-gap--none">—</span>
{% elseif fair %}
    <span class="cm-sa-gap cm-sa-gap--fair">{{ 'selfAssessmentGapFairLabel'|trans }}</span>
{% elseif gap > 0 %}
    <span class="cm-sa-gap cm-sa-gap--over">+{{ gap }}</span>
{% else %}
    <span class="cm-sa-gap cm-sa-gap--under">−{{ gap|abs }}</span>
{% endif %}
