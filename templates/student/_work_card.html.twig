{# Carte d'un travail (maquette 4a) : type, intitulé, matière et séance d'origine à gauche, échéance
   puis action à droite. L'action dépend du type - déposer un fichier, ou déclarer que c'est fait. #}
<div class="cm-work-card {{ late ? 'cm-work-card--late' }}">
    {% include 'program/_work_icon.html.twig' with {nature: work.nature} %}
    <div class="cm-work-card__body">
        <div class="cm-work__title">{{ work.title }}</div>
        <div class="cm-work__meta">
            {{ work.program.displayShortName }}
            {%- if work.lessonSession %} · <a href="{{ path('app_program_timetable_session_log', {id: work.program.id, sessionId: work.lessonSession.id}) }}">{{ 'studentWorkSessionLinkLabel'|trans({'%date%': work.lessonSession.day|date('d/m/Y')}) }}</a>{% endif %}
            {%- if work.acceptedFormats is not empty %} · {{ work.acceptedFormats|map(f => f|upper)|join(' / ') }}{% endif %}
            {%- if work.quizInstance %} · {{ work.quizInstance.name }}{% endif %}
        </div>
    </div>
    <div class="cm-work-card__due {{ late ? 'is-late' }}">
        {{ 'studentWorkDueLabel'|trans({'%date%': work.dueDate|date('d/m/Y H:i')}) }}
    </div>
    <div class="cm-work-card__action">
        {% if work.quizInstance %}
            {# Dérouler le quiz : c'est la même entrée que depuis la liste des quiz de la formation,
               l'écran de passation décidant seul s'il faut reprendre une tentative ou en ouvrir une. #}
            <a class="btn btn-primary btn-sm" href="{{ path('app_program_quiz_take', {id: work.program.id, instanceId: work.quizInstance.id}) }}">{{ (done is defined and done ? 'studentWorkQuizResultAction' : 'studentWorkQuizStartAction')|trans }}</a>
        {% elseif work.expectsSubmission %}
            <a class="btn btn-primary btn-sm" href="{{ path('app_program_my_assignment', {id: work.program.id, assignmentId: work.id}) }}">{{ done is defined and done ? 'studentWorkViewSubmissionAction'|trans : 'studentWorkSubmitAction'|trans }}</a>
        {% elseif work.nature.expectsSelfDeclaration %}
            <form method="post" action="{{ path('app_student_work_done', {assignmentId: work.id}) }}">
                <input type="hidden" name="_token" value="{{ csrf_token('student_work_done') }}">
                <button type="submit" class="btn btn-sm {{ done is defined and done ? 'btn-outline-secondary' : 'btn-outline-primary' }}">
                    {{ (done is defined and done ? 'studentWorkUndoneAction' : 'studentWorkMarkDoneAction')|trans }}
                </button>
            </form>
        {% endif %}
    </div>
</div>
