{% extends 'layout/app.html.twig' %}

{% block title %}{{ 'studentWorkPageHeading'|trans }}{% endblock %}

{% block page_breadcrumb %}
    {% include '_breadcrumb.html.twig' with {segments: [
        {label: 'homeNavLabel'|trans, url: path('app_home')},
        {label: 'studentWorkNavLabel'|trans, url: app.request.requestUri},
    ]} %}
{% endblock %}
{% block page_title %}{{ 'studentWorkPageHeading'|trans }}{% endblock %}

{% block page_actions %}
    {% include 'student/_work_topic_filter.html.twig' %}
{% endblock %}

{% block main %}
    {# One controller for the whole screen - list and modal shell alike, which is why it sits on a
       wrapper: it fetches the consigne modal, anchors the "Ignorer" confirmation to the button that
       opened it, and fires the hidden file inputs. #}
    <div data-controller="student-work">
        <div class="cm-tw">
            <div class="cm-tw__list">
                {% if lateDays is not empty %}
                    <span class="cm-tw__group cm-tw__group--late">{{ 'studentWorkLateGroupLabel'|trans }}</span>
                    {% for day in lateDays %}
                        {% include 'student/_work_day.html.twig' with {day: day, late: true} %}
                    {% endfor %}
                {% endif %}

                {% if todoDays is not empty %}
                    <span class="cm-tw__group{{ lateDays is not empty ? ' cm-tw__group--spaced' }}">{{ 'studentWorkTodoGroupLabel'|trans }}</span>
                    {% for day in todoDays %}
                        {% include 'student/_work_day.html.twig' with {day: day, late: false} %}
                    {% endfor %}
                {% endif %}

                {% if lateDays is empty and todoDays is empty %}
                    <div class="cm-tw__empty">{{ 'studentWorkEmptyMessage'|trans }}</div>
                {% endif %}
            </div>

            <div class="cm-tw__side">
                <span class="cm-tw__sidehead">
                    <span class="cm-tw__group">{{ 'studentWorkRecentHeading'|trans }}</span>
                    <a href="{{ path('app_student_work_history', {matiere: topicFilter ?: null}) }}">{{ 'studentWorkSeeAllAction'|trans }}</a>
                </span>
                {% for item in recent %}
                    {% include 'student/_work_recent.html.twig' with {item: item} %}
                {% else %}
                    <div class="cm-tw__empty cm-tw__empty--side">{{ 'studentWorkRecentEmptyMessage'|trans }}</div>
                {% endfor %}
            </div>
        </div>

        {# The modal shell stays empty until "voir la consigne" fills it - one shell for every row. #}
        {% include 'student/_work_brief_shell.html.twig' %}
    </div>
{% endblock %}
