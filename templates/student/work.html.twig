{% extends 'layout/app.html.twig' %}

{% block title %}{{ 'studentWorkPageHeading'|trans }}{% endblock %}

{% block page_breadcrumb %}
    {% include '_breadcrumb.html.twig' with {segments: [
        {label: 'homeNavLabel'|trans, url: path('app_home')},
        {label: 'studentWorkPageHeading'|trans, url: app.request.requestUri},
    ]} %}
{% endblock %}
{% block page_title %}{{ 'studentWorkPageHeading'|trans }}{% endblock %}

{% block page_actions %}
    {% if programs|length > 1 %}
        {# « Toutes les matières » de la maquette : dans cette application, ce qui distingue les
           travaux d'un étudiant est sa formation. #}
        <form method="get" data-controller="auto-submit">
            {% if tab == 'done' %}<input type="hidden" name="onglet" value="done">{% endif %}
            <select name="formation" class="form-select" data-action="change->auto-submit#submit">
                <option value="0">{{ 'studentWorkAllProgramsLabel'|trans }}</option>
                {% for program in programs %}
                    <option value="{{ program.id }}" {{ programFilter == program.id ? 'selected' }}>{{ program.displayShortName }}</option>
                {% endfor %}
            </select>
        </form>
    {% endif %}
{% endblock %}

{% block main %}
    <p class="text-secondary mb-3">
        {{ 'studentWorkSummaryLabel'|trans({'%count%': todoCount}) }}
        {%- if lateCount > 0 %} · <span class="text-danger">{{ 'studentWorkSummaryLateLabel'|trans({'%count%': lateCount}) }}</span>{% endif %}
    </p>

    {% set base = {formation: programFilter ?: null} %}
    <div class="cm-tabs mb-3">
        <a class="cm-tabs__tab {{ tab == 'todo' ? 'is-active' }}" href="{{ path('app_student_work', base) }}">{{ 'studentWorkTodoTabLabel'|trans }} · {{ todoCount }}</a>
        <a class="cm-tabs__tab {{ tab == 'done' ? 'is-active' }}" href="{{ path('app_student_work', base|merge({onglet: 'done'})) }}">{{ 'studentWorkDoneTabLabel'|trans }} · {{ doneCount }}</a>
    </div>

    {% if tab == 'todo' %}
        {% set anything = false %}
        {% for key, works in groups %}
            {% if works is not empty %}
                {% set anything = true %}
                <div class="cm-group-label {{ key == 'late' ? 'cm-group-label--late' }}">{{ ('studentWorkGroup' ~ key|capitalize ~ 'Label')|trans }}</div>
                {% for work in works %}
                    {% include 'student/_work_card.html.twig' with {work: work, late: key == 'late'} %}
                {% endfor %}
            {% endif %}
        {% endfor %}
        {% if not anything %}
            <div class="card"><div class="card-body text-secondary">{{ 'studentWorkEmptyMessage'|trans }}</div></div>
        {% endif %}
    {% else %}
        {% for work in done %}
            {% include 'student/_work_card.html.twig' with {work: work, late: false, done: true} %}
        {% else %}
            <div class="card"><div class="card-body text-secondary">{{ 'studentWorkDoneEmptyMessage'|trans }}</div></div>
        {% endfor %}
    {% endif %}
{% endblock %}
