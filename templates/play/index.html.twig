{# « Jouer », the student's page of games (design/validated/quiz-tournament.md §15), reached from
   the entry of their bar. Formatool's own page, each card in its content's dress: a tournament in
   its palette and emblem (quiz_tournament.css, the list's own card), a serious game with its
   thumbnail (serious_game/_card.html.twig, the catalogue's own card). An empty section is not
   drawn; the page itself exists only when one of the two has something (PlayController).

   The pending challenges are this page's content, not an alert (§7): nothing outside the
   tournament screens and this page counts them, and the menu entry never does. #}
{% extends 'layout/app.html.twig' %}

{% block title %}{{ 'playPageHeading'|trans }}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('styles/quiz_tournament.css') }}">
    <link rel="stylesheet" href="/serious-games/shared/fonts.css">
{% endblock %}

{% block page_breadcrumb %}
    {{ component('Cm:Breadcrumb', {segments: [
        {label: 'playNavLabel'|trans, url: path('app_play')},
    ]}) }}
{% endblock %}
{% block page_title %}{{ 'playPageHeading'|trans }}{% endblock %}

{% block main %}
    <div class="cm-playhub">
        {% if tournaments is not empty %}
            <section class="cm-playhub__section" aria-label="{{ 'playTournamentsHeading'|trans }}">
                <twig:Cm:Subhead :title="'playTournamentsHeading'|trans" :hint="'playTournamentsHint'|trans" class="cm-playhub__head"/>
                <ul class="qt-cards">
                    {% for card in tournaments %}
                        {% set tournament = card.tournament %}
                        <li class="qt qt-card qt-card--play" data-tournament-palette="{{ tournament.palette.value }}">
                            <a class="qt-card__link" href="{{ path('app_quiz_tournament_show', {id: tournament.id}) }}">
                                <div class="qt-head">
                                    <div class="qt-head__titles"><h2 class="qt-head__title">{{ tournament.name }}</h2></div>
                                    {% include 'quiz_tournament/_emblem.html.twig' with {tournament: tournament, size: 52} only %}
                                </div>
                                <div class="qt-card__body">
                                    {% if card.status.value == 'upcoming' %}
                                        <span class="qt-sticker qt-sticker--accent">{{ 'quizTournamentStartsSticker'|trans({'%date%': tournament.startsAt|date('d/m/Y'), '%time%': tournament.startsAt|date('H:i')}) }}</span>
                                    {% elseif card.status.value == 'ended' %}
                                        <span class="qt-sticker">{{ 'quizTournamentEndedSticker'|trans({'%date%': tournament.endsAt|date('d/m/Y')}) }}</span>
                                    {% else %}
                                        <span class="qt-sticker">{{ 'quizTournamentUntilSticker'|trans({'%date%': tournament.endsAt|date('d/m/Y')}) }}</span>
                                    {% endif %}
                                    <span class="qt-card__place">
                                        {% if card.rank is not null %}
                                            <span class="qt-card__rank">#{{ card.rank }}</span>
                                        {% else %}
                                            <span class="qt-card__block">{{ card.block.labelKey|trans }}</span>
                                        {% endif %}
                                        {% if card.block.value != 'not_played' %}
                                            <span class="qt-card__rating">{{ 'playTournamentRating'|trans({'%rating%': card.rating}) }}</span>
                                        {% endif %}
                                    </span>
                                    {% if card.pendingChallenges > 0 %}
                                        <span class="qt-sticker qt-sticker--alert">{{ 'playTournamentPendingChallenges'|trans({'%count%': card.pendingChallenges}) }}</span>
                                    {% endif %}
                                </div>
                            </a>
                        </li>
                    {% endfor %}
                </ul>
            </section>
        {% endif %}

        {% if games is not empty %}
            <section class="cm-playhub__section" aria-label="{{ 'seriousGamesNavLabel'|trans }}" data-controller="sg-launch">
                <twig:Cm:Subhead :title="'seriousGamesNavLabel'|trans" :hint="'playGamesHint'|trans" class="cm-playhub__head"/>
                <div class="cm-sg-catalog__grid">
                    {% for card in games %}
                        {% include 'serious_game/_card.html.twig' with {card: card} only %}
                    {% endfor %}
                </div>
            </section>
        {% endif %}
    </div>
{% endblock %}
