{% extends 'security/_auth_card.html.twig' %}

{% block title %}{{ 'authPageTitle'|trans }}{% endblock %}

{% block auth_content %}
    <div data-controller="login">
        {% if error %}
            <div class="cm-authcard__alert" role="alert">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
        {% endif %}
        {# This page extends _auth_card.html.twig directly (no authenticated navbar), so unlike
           layout/app.html.twig it doesn't render flashes anywhere else - needed here for redirects
           that land a logged-out visitor back on /login with something to say (e.g. an expired
           contact-email confirmation link, see App\Controller\PublicContactEmailController). #}
        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="cm-authcard__alert{{ label == 'success' ? ' cm-authcard__alert--success' }}" role="alert">{{ message|trans }}</div>
            {% endfor %}
        {% endfor %}

        <div class="cm-authcard__tabs" role="tablist" aria-label="{{ 'authPageTitle'|trans }}" data-action="keydown->login#onTablistKeydown">
            <button type="button" role="tab" id="login-tab-password" aria-controls="login-panel-password" aria-selected="true" tabindex="0"
                    class="cm-authcard__tab is-active" data-login-target="passwordTab" data-action="login#switchToPassword">
                <svg class="icon"><use href="{{ asset('icons/tabler-sprite.svg') }}#tabler-icon-lock"></use></svg>
                {{ 'loginPasswordTabLabel'|trans }}
            </button>
            <button type="button" role="tab" id="login-tab-magiclink" aria-controls="login-panel-magiclink" aria-selected="false" tabindex="-1"
                    class="cm-authcard__tab" data-login-target="magicLinkTab" data-action="login#switchToMagicLink">
                <svg class="icon"><use href="{{ asset('icons/tabler-sprite.svg') }}#tabler-icon-mail"></use></svg>
                {{ 'loginMagicLinkTabLabel'|trans }}
            </button>
        </div>

        <div id="login-panel-password" role="tabpanel" aria-labelledby="login-tab-password" data-login-target="passwordPanel">
            <form method="post" autocomplete="off" novalidate class="d-flex flex-column gap-3" data-action="submit->login#submitPasswordForm">
                <div class="cm-authcard__field-group">
                    <label class="cm-authcard__label" for="username">{{ 'usernameFieldLabel'|trans }}</label>
                    <div class="cm-authcard__input-wrap">
                        <input type="text" id="username" name="_username" class="cm-authcard__input" value="{{ last_username }}" placeholder="{{ 'usernameFieldPlaceholder'|trans }}" autocomplete="username" autofocus data-login-target="usernameInput">
                    </div>
                </div>
                <div class="cm-authcard__field-group" data-controller="password-visibility">
                    <label class="cm-authcard__label" for="password">
                        {{ 'passwordFieldLabel'|trans }}
                        <a href="#" class="cm-authcard__label-link" data-action="login#forgotPassword">{{ 'loginForgotPasswordLinkLabel'|trans }}</a>
                    </label>
                    <div class="cm-authcard__input-wrap">
                        <input type="password" id="password" name="_password" class="cm-authcard__input cm-authcard__input--password" placeholder="{{ 'passwordFieldPlaceholder'|trans }}" autocomplete="current-password" data-password-visibility-target="input">
                        <button type="button" class="cm-authcard__eye" aria-pressed="false" title="{{ 'togglePasswordVisibilityHint'|trans }}" data-action="password-visibility#toggle">
                            <svg class="icon" data-password-visibility-target="shownIcon"><use href="{{ asset('icons/tabler-sprite.svg') }}#tabler-icon-eye"></use></svg>
                            <svg class="icon d-none" data-password-visibility-target="hiddenIcon"><use href="{{ asset('icons/tabler-sprite.svg') }}#tabler-icon-eye-off"></use></svg>
                        </button>
                    </div>
                </div>
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
                <button type="submit" class="cm-authcard__btn" data-login-target="passwordSubmitButton">
                    <span class="spinner-border d-none" role="status" aria-hidden="true" data-login-target="passwordSubmitSpinner"></span>
                    {{ 'submitLoginAction'|trans }}
                </button>
            </form>
        </div>

        <div id="login-panel-magiclink" role="tabpanel" aria-labelledby="login-tab-magiclink" data-login-target="magicLinkPanel" hidden>
            {{ form_start(magicLinkForm, {action: path('app_login_magic_request'), attr: {class: 'd-flex flex-column gap-3'}}) }}
                {{ form_errors(magicLinkForm) }}
                <div class="cm-authcard__field-group">
                    <label class="cm-authcard__label" for="{{ magicLinkForm.email.vars.id }}">{{ 'loginMagicLinkFieldLabel'|trans }}</label>
                    <div class="cm-authcard__input-wrap">
                        {{ form_widget(magicLinkForm.email, {attr: {class: 'cm-authcard__input', 'data-login-target': 'magicLinkEmailInput'}}) }}
                    </div>
                </div>
                {# Honeypot - hidden off-screen, never rendered with a real label, checked
                   server-side in PublicMagicLoginController, never persisted either way. #}
                <div style="position: absolute; left: -9999px;" aria-hidden="true">
                    {{ form_widget(magicLinkForm.website, {attr: {tabindex: '-1', autocomplete: 'off'}}) }}
                </div>
                {{ form_widget(magicLinkForm.submit, {label: 'loginMagicLinkSubmitAction', attr: {class: 'cm-authcard__btn'}}) }}
                <p class="cm-authcard__hint">{{ 'loginMagicLinkHintPrefix'|trans }} <b>{{ 'loginMagicLinkHintDuration'|trans }}</b> {{ 'loginMagicLinkHintSuffix'|trans }}</p>
                {{ form_rest(magicLinkForm) }}
            {{ form_end(magicLinkForm) }}
        </div>
    </div>
{% endblock %}

{% block auth_footer_link %}
    <a href="{{ path('app_login_help') }}">{{ 'lostAccountAccessLinkLabel'|trans }}</a>
{% endblock %}
