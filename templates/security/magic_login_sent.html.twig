{% extends 'security/_auth_card.html.twig' %}

{% block title %}{{ 'magicLoginSentPageHeading'|trans }}{% endblock %}

{% block auth_content %}
    <div class="cm-authcard__state">
        <div class="cm-authcard__pastille cm-authcard__pastille--info">
            <svg class="icon"><use href="{{ asset('icons/tabler-sprite.svg') }}#tabler-icon-mail"></use></svg>
        </div>
        <h2>{{ 'magicLoginSentPageHeading'|trans }}</h2>
        <p>{{ 'magicLoginSentExplanation'|trans }}</p>
    </div>
    {# The email field is a real, hidden (type override, not display:none) field on a genuine
       Symfony form instance rather than a hand-rolled hidden input, so its CSRF token is still
       generated/checked normally - only pre-fills what this same browser just typed a moment ago
       (see PublicMagicLoginController::request()'s flash hand-off), never reveals anything new. #}
    {{ form_start(resendForm, {action: path('app_login_magic_request'), attr: {class: 'd-flex flex-column gap-3'}}) }}
        {{ form_widget(resendForm.email, {type: 'hidden'}) }}
        <div style="position: absolute; left: -9999px;" aria-hidden="true">
            {{ form_widget(resendForm.website, {attr: {tabindex: '-1', autocomplete: 'off'}}) }}
        </div>
        {{ form_widget(resendForm.submit, {
            label: 'magicLoginResendButtonReadyLabel',
            attr: {
                class: 'cm-authcard__btn',
                'data-controller': 'resend-cooldown',
                'data-resend-cooldown-seconds-value': 60,
                'data-resend-cooldown-ready-label-value': 'magicLoginResendButtonReadyLabel'|trans,
                'data-resend-cooldown-countdown-label-template-value': 'magicLoginResendButtonCountdownLabel'|trans({'%seconds%': '%seconds%'}),
            }
        }) }}
        {{ form_rest(resendForm) }}
    {{ form_end(resendForm) }}
{% endblock %}

{% block auth_footer_link %}
    <a href="{{ path('app_login') }}">{{ 'backToLoginLinkLabel'|trans }}</a>
{% endblock %}
