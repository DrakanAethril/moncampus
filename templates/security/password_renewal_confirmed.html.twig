{% extends 'security/_auth_card.html.twig' %}

{# design/design_handoff_pages_arrivee's screen 22 - shown right after
   App\Controller\PasswordRenewalController::renewal() clears $mustChangePassword and redirects
   here. Mirrors security/contact_email_confirmed.html.twig's shape (same pastille/state/footer
   pattern), reusing its backToSpaceAction/notYouText/contactSupportLinkLabel keys verbatim. #}

{% block auth_card_modifier %}cm-authcard--themed{% endblock %}

{% block title %}{{ 'passwordChangedPageHeading'|trans }}{% endblock %}

{% block auth_content %}
    <div class="cm-authcard__state">
        <div class="cm-authcard__pastille cm-authcard__pastille--success">
            <svg class="icon"><use href="{{ asset('icons/tabler-sprite.svg') }}#tabler-icon-check"></use></svg>
        </div>
        <h2>{{ 'passwordChangedPageHeading'|trans }}</h2>
        <p>{{ 'passwordChangedExplanation'|trans }}</p>
    </div>
    <div class="cm-authcard__banner">
        <span class="cm-authcard__banner-icon" aria-hidden="true">
            <svg class="icon" style="width: 12px; height: 12px"><use href="{{ asset('icons/tabler-sprite.svg') }}#tabler-icon-clock"></use></svg>
        </span>
        <span>{{ 'passwordChangedPropagationPrefix'|trans }} <b>{{ 'passwordChangedPropagationHighlight'|trans }}</b>{{ 'passwordChangedPropagationSuffix'|trans }}</span>
    </div>
    <a href="{{ path('app_home') }}" class="cm-authcard__btn">{{ 'backToSpaceAction'|trans }}</a>
{% endblock %}

{% block auth_footer_link %}
    <span>{{ 'notYouText'|trans }} <a href="{{ path('app_login_help') }}">{{ 'contactSupportLinkLabel'|trans }}</a></span>
{% endblock %}
