{% extends 'security/_auth_card.html.twig' %}

{# design/design_handoff_pages_arrivee's screen 17 - forced password renewal, reached only while
   App\Entity\User::$mustChangePassword is true (App\EventSubscriber\ForcePasswordRenewalSubscriber
   redirects everything else here). Adds a 5th "une minuscule" criterion the mockup's 4-item list
   doesn't show, so the client-side checklist stays in sync with App\Form\ChangePasswordType's
   actual server-side Regex (which does require a lowercase letter) - see PROMPT.md's own
   "mêmes règles, mêmes messages" requirement. #}

{% block auth_card_modifier %}cm-authcard--themed{% endblock %}

{% block title %}{{ 'passwordRenewalPageHeading'|trans }}{% endblock %}

{% block auth_content %}
    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="cm-authcard__alert" role="alert">{{ message|trans }}</div>
        {% endfor %}
    {% endfor %}

    <h2 class="cm-authcard__title">{{ 'passwordRenewalPageHeading'|trans }}</h2>

    <div class="cm-authcard__banner">
        <span class="cm-authcard__banner-icon" aria-hidden="true">!</span>
        <span>{{ 'passwordRenewalMandatoryBannerText'|trans }}</span>
    </div>

    {{ form_start(form, {attr: {
        novalidate: 'novalidate',
        class: 'd-flex flex-column gap-3',
        'data-controller': 'password-strength',
        'data-password-strength-too-weak-label-value': 'passwordStrengthTooWeakLabel'|trans,
        'data-password-strength-medium-label-value': 'passwordStrengthMediumLabel'|trans,
        'data-password-strength-good-label-value': 'passwordStrengthGoodLabel'|trans,
        'data-password-strength-strong-label-value': 'passwordStrengthStrongLabel'|trans,
    }}) }}
        <div class="cm-authcard__field-group" data-controller="password-visibility">
            <label class="cm-authcard__label" for="{{ form.newPassword.first.vars.id }}">{{ 'newPasswordFieldLabel'|trans }}</label>
            <div class="cm-authcard__input-wrap">
                {{ form_widget(form.newPassword.first, {attr: {
                    class: 'cm-authcard__input cm-authcard__input--password',
                    autocomplete: 'new-password',
                    'data-password-visibility-target': 'input',
                    'data-password-strength-target': 'newPasswordInput',
                    'data-action': 'input->password-strength#update',
                }}) }}
                <button type="button" class="cm-authcard__eye" aria-pressed="false" title="{{ 'togglePasswordVisibilityHint'|trans }}" data-action="password-visibility#toggle">
                    <svg class="icon" data-password-visibility-target="shownIcon"><use href="{{ asset('icons/tabler-sprite.svg') }}#tabler-icon-eye"></use></svg>
                    <svg class="icon d-none" data-password-visibility-target="hiddenIcon"><use href="{{ asset('icons/tabler-sprite.svg') }}#tabler-icon-eye-off"></use></svg>
                </button>
            </div>
            <div class="cm-authcard__strength">
                <div class="cm-authcard__strength-track">
                    <span class="cm-authcard__strength-seg" data-password-strength-target="strengthSeg"></span>
                    <span class="cm-authcard__strength-seg" data-password-strength-target="strengthSeg"></span>
                    <span class="cm-authcard__strength-seg" data-password-strength-target="strengthSeg"></span>
                    <span class="cm-authcard__strength-seg" data-password-strength-target="strengthSeg"></span>
                </div>
                <span class="cm-authcard__strength-label" data-password-strength-target="strengthLabel" aria-live="polite"></span>
            </div>
        </div>

        <div class="cm-authcard__field-group">
            <label class="cm-authcard__label" for="{{ form.newPassword.second.vars.id }}">{{ 'newPasswordConfirmationFieldLabel'|trans }}</label>
            <div class="cm-authcard__input-wrap">
                {{ form_widget(form.newPassword.second, {attr: {
                    class: 'cm-authcard__input',
                    autocomplete: 'new-password',
                    'data-password-strength-target': 'confirmInput',
                    'data-action': 'input->password-strength#update',
                }}) }}
                <span class="cm-authcard__match-icon" data-password-strength-target="matchIcon" aria-live="polite"></span>
            </div>
        </div>

        <div class="cm-authcard__criteria" aria-live="polite">
            <span class="cm-authcard__criterion" data-password-strength-target="criterion" data-rule="length">
                <span class="cm-authcard__criterion-dot">•</span>{{ 'passwordCriterionLengthLabel'|trans }}
            </span>
            <span class="cm-authcard__criterion" data-password-strength-target="criterion" data-rule="upper">
                <span class="cm-authcard__criterion-dot">•</span>{{ 'passwordCriterionUppercaseLabel'|trans }}
            </span>
            <span class="cm-authcard__criterion" data-password-strength-target="criterion" data-rule="lower">
                <span class="cm-authcard__criterion-dot">•</span>{{ 'passwordCriterionLowercaseLabel'|trans }}
            </span>
            <span class="cm-authcard__criterion" data-password-strength-target="criterion" data-rule="digit">
                <span class="cm-authcard__criterion-dot">•</span>{{ 'passwordCriterionDigitLabel'|trans }}
            </span>
            <span class="cm-authcard__criterion" data-password-strength-target="criterion" data-rule="special">
                <span class="cm-authcard__criterion-dot">•</span>{{ 'passwordCriterionSpecialLabel'|trans }}
            </span>
        </div>

        {{ form_widget(form.submit, {
            label: 'passwordRenewalSubmitAction',
            attr: {class: 'cm-authcard__btn', disabled: 'disabled', 'data-password-strength-target': 'submitButton'},
        }) }}
        {{ form_rest(form) }}
    {{ form_end(form) }}
{% endblock %}

{% block auth_footer_link %}
    <a href="{{ path('app_logout') }}" data-turbo-prefetch="false">{{ 'logoutAction'|trans }}</a>
{% endblock %}
