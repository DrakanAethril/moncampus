{% extends 'security/_auth_card.html.twig' %}

{% block title %}{{ 'magicLoginConfirmPageHeading'|trans }}{% endblock %}

{% block auth_content %}
    <div class="cm-authcard__state">
        <div class="cm-authcard__pastille cm-authcard__pastille--info">
            <svg class="icon"><use href="{{ asset('icons/tabler-sprite.svg') }}#tabler-icon-mail"></use></svg>
        </div>
        <h2>{{ 'magicLoginConfirmPageHeading'|trans }}</h2>
        <p>{{ 'magicLoginConfirmExplanation'|trans }}</p>
    </div>
    {# Deliberately a POST, not a plain link - see PublicMagicLoginController::confirm()'s
       docblock: this button is the only thing that actually consumes the token
       (App\Security\MagicLinkAuthenticator), so an automated link prefetch by a mail
       client/gateway (a GET on the page above) never burns it before the real recipient clicks. #}
    <form method="post" action="{{ path('app_login_magic_confirm', {token: token}) }}" class="d-flex flex-column gap-3">
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('magic_login_consume') }}">
        <button type="submit" class="cm-authcard__btn">{{ 'magicLoginConfirmSubmitAction'|trans }}</button>
    </form>
{% endblock %}

{% block auth_footer_link %}
    <a href="{{ path('app_login') }}">{{ 'backToLoginLinkLabel'|trans }}</a>
{% endblock %}
