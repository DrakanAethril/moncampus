{% extends 'security/_auth_card.html.twig' %}

{% block title %}{{ 'magicLoginRequestPageHeading'|trans }}{% endblock %}

{% block auth_content %}
    <div class="cm-authcard__state">
        <h2>{{ 'magicLoginRequestPageHeading'|trans }}</h2>
        <p>{{ 'magicLoginRequestExplanation'|trans }}</p>
    </div>
    {{ form_start(form, {attr: {class: 'd-flex flex-column gap-3'}}) }}
        {{ form_errors(form) }}
        <div class="cm-authcard__field-group">
            <label class="cm-authcard__label" for="{{ form.email.vars.id }}">{{ 'magicLoginEmailFieldLabel'|trans }}</label>
            <div class="cm-authcard__input-wrap">
                {{ form_widget(form.email, {attr: {class: 'cm-authcard__input'}}) }}
            </div>
        </div>
        {# Honeypot: positioned off-screen, not merely display:none, and never rendered
           with a real label - a human never sees or fills this field. Checked server-side
           in PublicMagicLoginController, never persisted either way. #}
        <div style="position: absolute; left: -9999px;" aria-hidden="true">
            {{ form_widget(form.website, {attr: {tabindex: '-1', autocomplete: 'off'}}) }}
        </div>
        {{ form_widget(form.submit, {label: 'magicLoginRequestSubmitAction', attr: {class: 'cm-authcard__btn'}}) }}
        {{ form_rest(form) }}
    {{ form_end(form) }}
{% endblock %}

{% block auth_footer_link %}
    <a href="{{ path('app_login') }}">{{ 'backToLoginLinkLabel'|trans }}</a>
{% endblock %}
