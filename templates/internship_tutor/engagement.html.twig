{% extends 'layout/external.html.twig' %}

{% block title %}{{ 'ufaAlternanceEngagementPageHeading'|trans }}{% endblock %}
{% block page_title %}{{ 'ufaAlternanceEngagementPageHeading'|trans }}{% endblock %}

{% block main %}
    <div class="card">
        <div class="card-header"><h3 class="card-title">{{ 'ufaAlternanceEngagementClausesTitle'|trans }}</h3></div>
        <div class="card-body">
            <ol class="mb-0">
                <li class="mb-2">{{ 'ufaAlternanceEngagementClause1'|trans }}</li>
                <li class="mb-2">{{ 'ufaAlternanceEngagementClause2'|trans }}</li>
                <li class="mb-2">{{ 'ufaAlternanceEngagementClause3'|trans }}</li>
                <li>{{ 'ufaAlternanceEngagementClause4'|trans }}</li>
            </ol>
        </div>
        <div class="card-footer d-flex justify-content-between align-items-center">
            {% if engagement.signedTutorAt %}
                <span class="badge bg-green-lt">{{ 'ufaAlternanceEngagementSignedOnLabel'|trans({'%date%': engagement.signedTutorAt|date('d/m/Y')}) }}</span>
            {% else %}
                <span class="text-secondary small">{{ 'ufaAlternanceEngagementTutorPromptLabel'|trans }}</span>
                <form method="post" action="{{ path('app_internship_tutor_engagement_sign', {tutorLinkId: tutorLink.id}) }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('internship_tutor_engagement_sign') }}">
                    <button type="submit" class="btn btn-primary btn-sm">{{ 'ufaAlternanceEngagementSignButtonLabel'|trans }}</button>
                </form>
            {% endif %}
        </div>
    </div>
{% endblock %}
