{# The rows of the list, rendered here and nowhere else: the first page and « Afficher 40 offres de
   plus » both come through this file, so a row cannot say two different things depending on which
   door it came from.

   The row IS the link to the advert. There is no detail panel any more - everything the platform
   knows about an offer is on the row - so the only thing left to do with one is to go and read it
   at the source. A real <a> rather than a click handler: middle-click, Ctrl-click and « copier
   l'adresse du lien » come for free, and no keyboard handling has to be written back by hand. #}
{% for offer in page.offers %}
    <a class="cm-jb-row" href="{{ offer.url }}" target="_blank" rel="noopener noreferrer">
        <div class="cm-jb-cell cm-jb-cell--position">
            <span class="cm-jb-position">{{ offer.position }}</span>
            <span class="cm-jb-subline">
                {% if offer.category %}
                    <span class="cm-jb-tag cm-jb-tag--cat{{ offer.category == 'sisr' ? ' cm-jb-tag--cat-sisr' }}">{{ offer.category|upper }}</span>
                {% endif %}
                <span class="cm-jb-company">{{ offer.company }}</span>
                {# The advert's own aside - « Débutant accepté », « 2 ans d'expérience minimum ».
                   Two thirds of the offers carry one and it is the only field of the row that says
                   something no column does, so it reads here rather than nowhere. #}
                {% if offer.note %}
                    <span class="cm-jb-note">{{ offer.note }}</span>
                {% endif %}
            </span>
        </div>
        <div class="cm-jb-cell cm-jb-cell--place">
            {{ offer.city ?? offer.region ?? '—' }}{% if offer.departement %} ({{ offer.departement }}){% endif %}
        </div>
        <div class="cm-jb-cell">
            <span class="cm-jb-tag cm-jb-tag--contract cm-jb-tag--{{ offer.contract.slug }}">{{ offer.contract.labelKey|trans }}</span>
        </div>
        <div class="cm-jb-cell">
            {# Nothing at all when the advert did not raise the subject: « non précisé » is not
               « aucun », and a grey « Aucun » tag would answer a question nobody asked. #}
            {% if offer.remote.isStated %}
                <span class="cm-jb-tag cm-jb-tag--remote cm-jb-tag--remote-{{ offer.remote.value }}">{{ offer.remote.labelKey|trans }}</span>
            {% endif %}
        </div>
        <div class="cm-jb-cell cm-jb-cell--date cm-jb-cell--published">
            {% if offer.publishedAt %}
                {% if offer.publishedAtApprox %}<span class="cm-jb-approx" title="{{ 'jobboardDateApproxTitle'|trans }}" aria-label="{{ 'jobboardDateApproxTitle'|trans }}">≈</span> {% endif %}
                {{ offer.publishedAt|localized_date('d MMM') }}
            {% else %}
                —
            {% endif %}
        </div>
        {# The day the veille brought the advert back, and the column the list is ordered on. Never
           empty and never « ≈ »: it is the platform's own observation, not the advert's word. #}
        <div class="cm-jb-cell cm-jb-cell--date cm-jb-cell--first-seen">
            {{ offer.firstSeenAt|localized_date('d MMM') }}
        </div>
    </a>
{% endfor %}
