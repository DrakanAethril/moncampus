{# The detail modal's content, rendered server-side and injected into the dialog. Server-side
   because of one line of this file: Source and Référence exist only for an administrator, and a
   fragment that never carries them cannot leak them to a reader who opens the browser's
   inspector. #}
<div class="cm-jb-panel__head">
    <div>
        <h2 class="cm-jb-panel__title" id="jb-detail-title">{{ offer.position }}</h2>
        <p class="cm-jb-panel__company">{{ offer.company }}</p>
    </div>
    <button type="button" class="cm-jb-panel__close" data-action="jobboard#closeDetail"
            aria-label="{{ 'jobboardDetailCloseAction'|trans }}" title="{{ 'jobboardDetailCloseAction'|trans }}">×</button>
</div>

<div class="cm-jb-panel__tags">
    <span class="cm-jb-tag cm-jb-tag--contract cm-jb-tag--{{ offer.contract.slug }}">{{ offer.contract.labelKey|trans }}</span>
    {% if offer.category %}
        <span class="cm-jb-tag cm-jb-tag--cat{{ offer.category == 'sisr' ? ' cm-jb-tag--cat-sisr' }}">{{ offer.category|upper }}</span>
    {% endif %}
    {% if offer.remote.isStated %}
        <span class="cm-jb-tag cm-jb-tag--remote cm-jb-tag--remote-{{ offer.remote.value }}">{{ 'jobboardRemotePrefixLabel'|trans }} {{ offer.remote.labelKey|trans|lower }}</span>
    {% endif %}
</div>

<dl class="cm-jb-panel__lines">
    <div class="cm-jb-panel__line">
        <dt>{{ 'jobboardDetailPlaceLabel'|trans }}</dt>
        <dd>
            {% set place = [offer.city, offer.departement ? 'dépt ' ~ offer.departement : null, offer.region, offer.country.label]|filter(v => v is not empty) %}
            {{ place|join(' · ') }}
        </dd>
    </div>
    <div class="cm-jb-panel__line">
        <dt>{{ 'jobboardDetailPublishedLabel'|trans }}</dt>
        <dd>
            {% if offer.publishedAt %}
                {{ offer.publishedAt|localized_date('d MMMM y') }}{% if offer.publishedAtApprox %} <span class="cm-jb-panel__hint">— {{ 'jobboardDateApproxHint'|trans }}</span>{% endif %}
            {% else %}
                <span class="cm-jb-panel__hint">{{ 'jobboardDateMissingHint'|trans }}</span>
            {% endif %}
        </dd>
    </div>
    <div class="cm-jb-panel__line">
        <dt>{{ 'jobboardDetailFirstSeenLabel'|trans }}</dt>
        <dd>{{ offer.firstSeenAt|localized_date('d MMMM y') }}</dd>
    </div>
    {% if isAdmin %}
        <div class="cm-jb-panel__line">
            <dt>{{ 'jobboardDetailSourceLabel'|trans }}</dt>
            <dd>{{ offer.source.label }}</dd>
        </div>
        <div class="cm-jb-panel__line">
            <dt>{{ 'jobboardDetailReferenceLabel'|trans }}</dt>
            <dd>{{ offer.sourceRef }}</dd>
        </div>
    {% endif %}
</dl>

{% if offer.note %}
    <p class="cm-jb-panel__note">{{ offer.note }}</p>
{% endif %}

<div class="cm-jb-panel__foot">
    <a class="cm-btn cm-btn--primary cm-jb-panel__link" href="{{ offer.url }}" target="_blank" rel="noopener noreferrer">{{ 'jobboardDetailOpenAction'|trans }}</a>
</div>
