{% extends 'layout/app.html.twig' %}

{% block title %}{{ 'teacherTimetablePageHeading'|trans }}{% endblock %}
{% block page_title %}{{ 'teacherTimetablePageHeading'|trans }}{% endblock %}

{% block main %}
    {# See templates/program/timetable.html.twig: the controller wraps the card so the subscription
       banner is a descendant of it and its URL can follow the legend. #}
    <div data-frankenphp-hot-reload-preserve
         data-controller="lesson-timetable"
         data-lesson-timetable-feed-url-value="{{ path('app_teacher_timetable_feed') }}"
         data-lesson-timetable-editable-value="false"
         data-lesson-timetable-ical-rotate-url-value="{{ path('app_timetable_ical_rotate') }}"
         data-lesson-timetable-ical-rotate-token-value="{{ csrf_token('timetable_ical_rotate') }}"
         data-lesson-timetable-ical-rotate-error-message-value="{{ 'timetableIcalRotateErrorMessage'|trans }}"
         data-lesson-timetable-event-detail-fields-value="{{ ['program', 'topic', 'classRoom']|json_encode }}">
        <div class="card">
            <div class="card-body">
                <div class="cm-calendar" data-lesson-timetable-target="calendar"></div>
                {% include 'teacher/_timetable_legend.html.twig' %}
            </div>
        </div>
        {% include 'partials/_timetable_ical_banner.html.twig' %}
    </div>
{% endblock %}
