{% extends 'layout/app.html.twig' %}

{# One sequence, its published séances, and the resources of each - the séance's own plus those of
   its phases, already flattened by CourseSpaceBoard. Phases themselves are never shown: they carry
   the teacher's preparation (enseignant, difficultés, moyens), which is not the student's business. #}
{% block title %}{{ sequence.titre }}{% endblock %}

{% block page_breadcrumb %}
    {% include '_breadcrumb.html.twig' with {segments: [
        {label: 'homeNavLabel'|trans, url: path('app_home')},
        {label: 'courseSpaceNavLabel'|trans, url: path('app_my_courses')},
        {label: program.displayName, url: path('app_my_courses_program', {programId: program.id})},
        {label: sequence.titre, url: path('app_my_courses_sequence', {programId: program.id, id: sequence.id})},
    ]} %}
{% endblock %}
{% block page_title %}{{ sequence.titre }}{% endblock %}

{% block main %}
    {% if sequence.capacitesAttendues is not empty or sequence.objectifs is not empty %}
        <div class="card mb-3">
            <div class="card-body">
                {% if sequence.capacitesAttendues is not empty %}
                    <div class="cm-label">{{ 'courseSpaceExpectedSkillsLabel'|trans }}</div>
                    <div class="cm-prose mb-2">{{ sequence.capacitesAttendues|raw }}</div>
                {% endif %}
                {% if sequence.objectifs is not empty %}
                    <div class="cm-label">{{ 'courseSpaceObjectivesLabel'|trans }}</div>
                    <div class="cm-prose">{{ sequence.objectifs|raw }}</div>
                {% endif %}
            </div>
        </div>
    {% endif %}

    {% if seances is empty %}
        <div class="cm-empty">{{ 'courseSpaceNoSeanceMessage'|trans }}</div>
    {% endif %}

    {% for seance in seances %}
        <div class="card mb-3">
            <div class="card-header">
                <h3 class="card-title mb-0">{{ seance.ordre }}. {{ seance.titre }}</h3>
            </div>
            <div class="card-body">
                {% if seance.objectifs is not empty %}
                    <div class="cm-label">{{ 'courseSpaceObjectivesLabel'|trans }}</div>
                    <div class="cm-prose mb-3">{{ seance.objectifs|raw }}</div>
                {% endif %}

                {% set seanceResources = resources[seance.id] ?? [] %}
                {% if seanceResources is not empty %}
                    <div class="cm-label">{{ 'courseSpaceResourcesLabel'|trans }}</div>
                    <div class="list-group list-group-flush">
                        {% for resource in seanceResources %}
                            <a class="list-group-item list-group-item-action d-flex align-items-center gap-2"
                               href="{{ path('app_my_courses_resource_open', {id: resource.id}) }}"
                               target="_blank" rel="noopener">
                                <span>{{ resource.label }}</span>
                                {% if opened[resource.id] is defined %}
                                    <span class="cm-badge cm-badge--neutral">{{ 'courseSpaceResourceOpenedLabel'|trans }}</span>
                                {% endif %}
                            </a>
                        {% endfor %}
                    </div>
                {% endif %}
            </div>
        </div>
    {% endfor %}
{% endblock %}
