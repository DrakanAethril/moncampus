{# A teacher's rounds on the tournament's page (design/validated/quiz-tournament.md §8 and §10.3):
   « Lancer une ronde » while they may open one for a targeted class they teach, and the rounds they
   opened lately, to project again. Parameters: `tournament`, `canOpenRound`, `teacherRounds`. #}
{% import 'quiz_tournament/_round_macros.html.twig' as rounds %}
{% if canOpenRound or teacherRounds is not empty %}
    <section class="qt-round-teacher" aria-labelledby="qt-round-teacher-head">
        <h2 class="qt-section__head" id="qt-round-teacher-head">{{ 'quizTournamentRoundTeacherHeading'|trans }}</h2>
        <p class="qt-round-teacher__text">{{ 'quizTournamentRoundTeacherText'|trans }}</p>
        {% if teacherRounds is not empty %}
            <ul class="qt-round-teacher__list">
                {% for round in teacherRounds %}
                    <li>
                        <a class="qt-round-teacher__item" href="{{ path('app_quiz_tournament_round', {id: tournament.id, round: round.id}) }}">
                            <span class="qt-person__text">
                                <span class="qt-person__name">{{ rounds.where(round) }}</span>
                                <span class="qt-person__meta">
                                    {%- if round.open -%}
                                        {{ 'quizTournamentRoundTeacherOpenMeta'|trans({'%time%': round.openedAt|date('H:i')}) }}
                                    {%- else -%}
                                        {{ 'quizTournamentRoundTeacherPairedMeta'|trans({'%time%': round.pairedAt|date('H:i')}) }}
                                    {%- endif -%}
                                </span>
                            </span>
                            <span class="qt-round-teacher__go">{{ 'quizTournamentRoundProjectAction'|trans }}</span>
                        </a>
                    </li>
                {% endfor %}
            </ul>
        {% endif %}
        {% if canOpenRound %}
            <a class="qt-btn qt-btn--primary qt-btn--big" href="{{ path('app_quiz_tournament_round_new', {id: tournament.id}) }}">{{ 'quizTournamentRoundOpenAction'|trans }}</a>
        {% endif %}
    </section>
{% endif %}
