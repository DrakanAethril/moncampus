{# The tournament's tab bar (H « Pop »): Classement · Défis · Mes duels. « Défis » and « Mes duels »
   arrive with the challenges and the duels (lot 3 of design/validated/quiz-tournament.md §17): until
   then they are drawn, dimmed, without a link - give them a `url` here when their screens exist. The
   « Défis » counter (§7) belongs on that tab, and only there. #}
{% set tabs = [
    {key: 'standings', label: 'quizTournamentTabStandings'|trans, url: path('app_quiz_tournament_show', {id: tournament.id})},
    {key: 'challenges', label: 'quizTournamentTabChallenges'|trans, url: null},
    {key: 'duels', label: 'quizTournamentTabDuels'|trans, url: null},
] %}
<nav class="qt-tabs" aria-label="{{ 'quizTournamentTabsLabel'|trans }}">
    {% for tab in tabs %}
        {% if tab.url %}
            <a class="qt-tab{{ tab.key == activeTab ? ' is-active' }}" href="{{ tab.url }}"{{ tab.key == activeTab ? ' aria-current="page"' }}>{{ tab.label }}</a>
        {% else %}
            <span class="qt-tab is-unavailable" aria-disabled="true">{{ tab.label }}</span>
        {% endif %}
    {% endfor %}
</nav>
