{# The shell of every tournament screen (design/validated/quiz-tournament.md §10, direction H « Pop »):
   Formatool's own navigation and breadcrumb around it, then the tournament in its dress - the
   palette as custom properties on the root (assets/styles/quiz_tournament.css), the name in
   head, the emblem top right, the tab bar at the foot.

   A screen extends this and fills `tournament_body`; it may also set:
   - `activeTab` - 'standings', 'challenges' or 'duels' (templates/quiz_tournament/_tabbar.html.twig);
   - `tournamentCrumbs` - the levels after the tournament's name in the trail;
   - `tournamentLive` - QuizTournamentLive::screen(): the « Défis » counter and its live link;
   - the `tournament_attributes` block - attributes of the root (a screen's Stimulus controller);
   - the `tournament_kicker` / `tournament_heading` blocks - a screen other than the standings
     carries the tournament's name small and its own title big (H-defis);
   - the `tournament_head` block - a screen that draws its own head (the duel's score bar, the
     correction's back button), and the `tournament_foot` block - one whose foot is its own actions
     rather than the tab bar (the duel, its result). #}
{% extends 'layout/app.html.twig' %}

{% block title %}{{ tournament.name }}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('styles/quiz_tournament.css') }}">
{% endblock %}

{% block page_breadcrumb %}
    {{ component('Cm:Breadcrumb', {segments: [
        {label: 'quizTournamentsBreadcrumbLabel'|trans, url: path('app_quiz_tournaments')},
        {label: tournament.name, url: path('app_quiz_tournament_show', {id: tournament.id})},
    ]|merge(tournamentCrumbs|default([]))}) }}
{% endblock %}

{% block page_header %}
    <div class="page-header d-print-none">
        <div class="container-xl">
            {# The tournament draws its own title: the layout's header is reduced to the trail, which
               has to be called here since this block replaces the one that would. #}
            {{ block('page_breadcrumb') }}
        </div>
    </div>
{% endblock %}

{% block main %}
    <div class="qt" data-tournament-palette="{{ tournament.palette.value }}" {% block tournament_attributes %}{% endblock %}>
        {% block tournament_head %}
            <header class="qt-head">
                <div class="qt-head__titles">
                    {% block tournament_kicker %}{% endblock %}
                    <h1 class="qt-head__title">{% block tournament_heading %}{{ tournament.name }}{% endblock %}</h1>
                </div>
                {% include 'quiz_tournament/_emblem.html.twig' with {tournament: tournament} only %}
            </header>
        {% endblock %}
        <div class="qt-body">
            {% block tournament_body %}{% endblock %}
        </div>
        {% block tournament_foot %}
            {% include 'quiz_tournament/_tabbar.html.twig' with {tournament: tournament, activeTab: activeTab|default('standings'), live: tournamentLive|default(null)} only %}
        {% endblock %}
    </div>
{% endblock %}
