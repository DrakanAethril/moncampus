{% extends 'ufa/ecf/_layout.html.twig' %}

{% set ecfScreenLabel = 'ecfCoverTitle'|trans %}

{% block ecf_main %}
    <div class="card">
        <div class="card-body d-flex flex-column gap-3">
            <form method="post" action="{{ path('app_ufa_ecf_cover', {id: tutorLink.id}) }}" class="d-flex flex-column gap-3">
                <input type="hidden" name="_token" value="{{ csrf_token('ufa_ecf') }}">
                <div class="row g-3">
                    <div class="col-md-3">
                        <div class="form-label">{{ 'ecfCivilityFieldLabel'|trans }}</div>
                        <div class="d-flex gap-3">
                            {% for civility in civilities %}
                                <label class="form-check">
                                    <input class="form-check-input" type="radio" name="civility" value="{{ civility.value }}" {{ ecf.booklet.civility == civility ? 'checked' }} {{ not canEdit ? 'disabled' }}>
                                    <span class="form-check-label">{{ civility.labelKey|trans }}</span>
                                </label>
                            {% endfor %}
                        </div>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label" for="ecf-birth-date">{{ 'ecfBirthDateFieldLabel'|trans }}</label>
                        <input class="form-control" type="date" id="ecf-birth-date" name="birthDate" value="{{ ecf.booklet.birthDate ? ecf.booklet.birthDate|date('Y-m-d') }}" {{ not canEdit ? 'disabled' }}>
                        <div class="form-text">{{ 'ecfBirthDateFieldHelp'|trans }}</div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-label">{{ 'ecfLastnameFieldLabel'|trans }}</div>
                        <div class="form-control-plaintext">{{ tutorLink.student.lastname }}</div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-label">{{ 'ecfFirstnameFieldLabel'|trans }}</div>
                        <div class="form-control-plaintext">{{ tutorLink.student.firstname }}</div>
                    </div>
                </div>
                <div class="cm-note">
                    <span class="cm-note__icon">i</span>
                    <div>
                        {{ 'ecfCoverTitleNote'|trans({'%title%': ecf.title.label, '%level%': ecf.title.level ?? '—', '%organisation%': ecf.settings.organisation ?? '—'}) }}
                        {% if is_granted('ROLE_ADMIN') %}
                            <a href="{{ path('app_ufa_formation_ecf', {id: tutorLink.program.id}) }}">{{ 'ecfCoverSettingsLink'|trans }}</a>
                        {% endif %}
                    </div>
                </div>
                {% if canEdit %}
                    <twig:Cm:ActionBar>
                        <a href="{{ path('app_ufa_ecf', {id: tutorLink.id}) }}" class="btn btn-link">{{ 'cancelAction'|trans }}</a>
                        <twig:Cm:Button variant="primary" type="submit">{{ 'submitSaveAction'|trans }}</twig:Cm:Button>
                    </twig:Cm:ActionBar>
                {% endif %}
            </form>
        </div>
    </div>
{% endblock %}
