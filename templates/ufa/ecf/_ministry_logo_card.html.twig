{# UFA > Configuration > Centre de formation: the bloc-marque the ECF booklet prints on its cover.
   Rendered by App\Controller\Ufa\EcfMinistryLogoController::card() for administrators only. #}
<div class="card mt-3">
    <div class="card-body d-flex flex-column gap-3">
        <twig:Cm:Subhead :title="'ecfMinistryLogoTitle'|trans" :hint="'ecfMinistryLogoHint'|trans"/>
        <div class="d-flex flex-wrap align-items-start gap-4">
            <div class="border rounded d-flex align-items-center justify-content-center bg-white" style="width: 140px; height: 116px;">
                {% if logoUrl %}
                    <img src="{{ logoUrl }}" alt="{{ 'ecfMinistryLogoTitle'|trans }}" style="max-width: 130px; max-height: 106px;">
                {% else %}
                    <span class="text-secondary small text-center px-2">{{ 'ecfMinistryLogoEmptyText'|trans }}</span>
                {% endif %}
            </div>
            <div class="flex-grow-1" style="min-width: 260px; max-width: 520px;">
                {{ form_start(form) }}
                    {{ form_row(form.logo) }}
                    {{ form_widget(form.submit, {attr: {class: 'btn btn-primary'}}) }}
                {{ form_end(form) }}
                {% if logoUrl %}
                    <form method="post" action="{{ path('app_ufa_ecf_logo_remove') }}" class="mt-2">
                        <input type="hidden" name="_token" value="{{ csrf_token('ufa_ecf_logo_remove') }}">
                        <button type="submit" class="btn btn-link text-danger p-0">{{ 'ecfMinistryLogoRemoveAction'|trans }}</button>
                    </form>
                {% endif %}
            </div>
        </div>
    </div>
</div>
