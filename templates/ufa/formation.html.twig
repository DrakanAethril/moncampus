{% extends 'layout/app.html.twig' %}

{% block title %}{{ program.displayShortName }} - {{ 'ufaFormationsNavLabel'|trans }}{% endblock %}

{% block page_breadcrumb %}
    {% include '_breadcrumb.html.twig' with {segments: [
        {label: 'homeNavLabel'|trans, url: path('app_home')},
        {label: 'ufaNavLabel'|trans, url: path('app_ufa')},
        {label: 'ufaFormationsNavLabel'|trans, url: path('app_ufa')},
        {label: program.displayShortName, url: app.request.requestUri},
    ]} %}
{% endblock %}
{% block page_title %}{{ program.displayShortName }}{% endblock %}

{% block main %}
    {% include '_tabs.html.twig' with {
        tabs: [
            {url: path('app_ufa_formation_evaluation_periods', {id: program.id}), label: 'programInternshipEvaluationPeriodsTabLabel'|trans, active: activeTab == 'evaluation_periods'},
            {url: path('app_ufa_formation_denomination', {id: program.id}), label: 'programInternshipDenominationTabLabel'|trans, active: activeTab == 'denomination'},
            {url: path('app_ufa_formation_contract_modalities', {id: program.id}), label: 'programInternshipContractModalitiesTabLabel'|trans, active: activeTab == 'contract_modalities'},
            {url: path('app_ufa_formation_exam_modalities', {id: program.id}), label: 'programInternshipExamModalitiesTabLabel'|trans, active: activeTab == 'exam_modalities'},
        ],
        tabs_action: activeTab == 'evaluation_periods' ? 'ufa/formation/_evaluation_periods_button.html.twig' : null,
    } %}
    <div class="card cm-card--tabbed">
        {# Turn-24 content partials (templates/ufa/formation/_*_content.html.twig) - own layouts
           for this UFA path (plain periods table, collapsible modality blocks), but the same
           form field names/routes conventions as the old Program > Paramétrage > Livret
           Alternant pages, so both nav paths keep writing the same underlying rows. Only the
           periods tab has a tab-row action (rule 5: page actions live on the title row; the
           other tabs' save action is their own footer bar). #}
        {% include 'ufa/formation/_' ~ activeTab ~ '_content.html.twig' %}
    </div>
{% endblock %}
