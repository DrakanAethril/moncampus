{% extends 'layout/app.html.twig' %}

{% block title %}{{ 'ufaAlternanceEngagementPageHeading'|trans }}{% endblock %}

{% block page_breadcrumb %}
    {% include '_breadcrumb.html.twig' with {segments: [
        {label: 'homeNavLabel'|trans, url: path('app_home')},
        {label: 'ufaAlternanceDashboardPageHeading'|trans, url: path('app_ufa')},
        {label: tutorLink.student.displayName ?? tutorLink.student.username, url: path('app_ufa_alternance_show', {id: tutorLink.id})},
        {label: 'ufaAlternanceEngagementPageHeading'|trans, url: app.request.requestUri},
    ]} %}
{% endblock %}
{% block page_title %}{{ 'ufaAlternanceEngagementPageHeading'|trans }} — {{ tutorLink.student.displayName ?? tutorLink.student.username }}{% endblock %}

{% block main %}
    <div class="row">
        <div class="col-md-7">
            <div class="card">
                <div class="card-header"><h3 class="card-title">{{ 'ufaAlternanceEngagementClausesTitle'|trans }}</h3></div>
                <div class="card-body">
                    <ol class="mb-3">
                        <li class="mb-2">{{ 'ufaAlternanceEngagementClause1'|trans }}</li>
                        <li class="mb-2">{{ 'ufaAlternanceEngagementClause2'|trans }}</li>
                        <li class="mb-2">{{ 'ufaAlternanceEngagementClause3'|trans }}</li>
                        <li>{{ 'ufaAlternanceEngagementClause4'|trans }}</li>
                    </ol>
                    <div class="alert alert-info mb-0">{{ 'ufaAlternanceEngagementInfoCallout'|trans }}</div>
                </div>
            </div>
        </div>
        <div class="col-md-5">
            <div class="card">
                <div class="card-header"><h3 class="card-title">{{ 'ufaAlternanceEngagementSignaturesTitle'|trans }}</h3></div>
                <div class="card-body">
                    <div class="mb-3 p-3 rounded {{ engagement.signedTutorAt ? 'bg-green-lt' : 'border' }}">
                        <div class="fw-bold">{{ 'ufaAlternanceRoleTutorLabel'|trans }}</div>
                        {% if engagement.signedTutorAt %}
                            <div class="text-secondary small">{{ 'ufaAlternanceEngagementSignedOnLabel'|trans({'%date%': engagement.signedTutorAt|date('d/m/Y')}) }}</div>
                        {% else %}
                            <div class="text-secondary small">{{ 'ufaAlternanceEngagementNotYetSignedLabel'|trans }}</div>
                        {% endif %}
                    </div>
                    <div class="mb-3 p-3 rounded {{ engagement.signedStudentAt ? 'bg-green-lt' : 'border' }}">
                        <div class="fw-bold">{{ 'ufaAlternanceRoleStudentLabel'|trans }}</div>
                        {% if engagement.signedStudentAt %}
                            <div class="text-secondary small">{{ 'ufaAlternanceEngagementSignedOnLabel'|trans({'%date%': engagement.signedStudentAt|date('d/m/Y')}) }}</div>
                        {% else %}
                            <div class="text-secondary small">{{ 'ufaAlternanceEngagementNotYetSignedLabel'|trans }}</div>
                        {% endif %}
                    </div>
                    <div class="p-3 rounded {{ engagement.signedCenterAt ? 'bg-green-lt' : 'border border-primary' }}">
                        <div class="fw-bold">{{ 'ufaAlternanceRoleCenterLabel'|trans }}</div>
                        {% if engagement.signedCenterAt %}
                            <div class="text-secondary small">{{ 'ufaAlternanceEngagementSignedOnLabel'|trans({'%date%': engagement.signedCenterAt|date('d/m/Y')}) }}</div>
                        {% elseif engagement.signedTutorAt and engagement.signedStudentAt %}
                            <div class="text-secondary small mb-2">{{ tutorLink.supervisor.displayName ?? tutorLink.supervisor.username ?? app.user.displayName }}</div>
                            <form method="post" action="{{ path('app_ufa_alternance_engagement_sign', {id: tutorLink.id}) }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('ufa_alternance_engagement_sign') }}">
                                <button type="submit" class="btn btn-primary btn-sm">{{ 'ufaAlternanceEngagementSignButtonLabel'|trans }}</button>
                            </form>
                        {% else %}
                            <div class="text-secondary small">{{ 'ufaAlternanceEngagementCenterWaitingLabel'|trans }}</div>
                        {% endif %}
                    </div>
                    {% if not engagement.signedCenterAt %}
                        {# Replaces the mockup's « Relance automatique à J+7 » mention: no automation
                           exists (a product decision), the reminder stays a manual send. #}
                        <div class="text-secondary small mt-3">{{ 'ufaAlternanceEngagementReminderNote'|trans }}</div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
{% endblock %}
