{% extends 'layout/app.html.twig' %}

{% block title %}{{ 'ufaAlternanceDashboardPageHeading'|trans }}{% endblock %}

{% block page_breadcrumb %}
    {% include '_breadcrumb.html.twig' with {segments: [
        {label: 'homeNavLabel'|trans, url: path('app_home')},
        {label: 'ufaAlternanceDashboardPageHeading'|trans, url: app.request.requestUri},
    ]} %}
{% endblock %}
{% block page_title %}{{ 'ufaAlternanceDashboardPageHeading'|trans }}{% endblock %}
{% block page_actions %}
    <a href="{{ path('app_ufa_alternance_new') }}" class="btn btn-primary">
        <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M12 5l0 14" /><path d="M5 12l14 0" /></svg>
        {{ 'ufaAlternanceNewButtonLabel'|trans }}
    </a>
{% endblock %}

{% block main %}
    {% set year_label = selectedYear ? selectedYear.startDate|date('Y') ~ '-' ~ selectedYear.endDate|date('Y') : '—' %}
    {# `filters` comes from the controller (DashboardController::readListFilters()): every filter
       except "all", so the Actives/Toutes links can flip that one and keep the rest. #}

    {# 33a: value first, then a sentence-case label, then the muted qualifier line -
       the two contract-type cards carry no qualifier in the design. #}
    <div class="cm-statgrid mb-3">
        <div class="cm-stat">
            <span class="cm-stat__value">{{ kpiTotal }}</span>
            <span class="cm-stat__label">{{ 'ufaAlternanceKpiTotalLabel'|trans }}</span>
            <span class="cm-stat__hint">{{ 'ufaAlternanceKpiTotalHint'|trans({'%year%': year_label}) }}</span>
        </div>
        <div class="cm-stat">
            <span class="cm-stat__value">{{ kpiFormations }}</span>
            <span class="cm-stat__label">{{ 'ufaAlternanceKpiFormationsLabel'|trans }}</span>
            <span class="cm-stat__hint">{{ 'ufaAlternanceKpiFormationsHint'|trans({'%year%': year_label}) }}</span>
        </div>
        <div class="cm-stat">
            <span class="cm-stat__value">{{ kpiApprentissage }}</span>
            <span class="cm-stat__label">{{ 'ufaAlternanceKpiApprentissageLabel'|trans }}</span>
        </div>
        <div class="cm-stat">
            <span class="cm-stat__value">{{ kpiProfessionnalisation }}</span>
            <span class="cm-stat__label">{{ 'ufaAlternanceKpiProfessionnalisationLabel'|trans }}</span>
        </div>
    </div>

    <div class="card">
        {# Inline "label + pill" pairs on one row, search pushed right (33a) - not stacked
           form fields. The Actives/Toutes pair stays two real submit buttons so the filter
           keeps working without JS; only its skin is the design's segmented control. #}
        <form method="get" class="cm-filterbar" data-controller="auto-submit">
            <label class="cm-filterbar__field">
                {{ 'ufaAlternanceFilterSchoolYearLabel'|trans }}
                <select name="year" class="cm-filterbar__select" data-action="change->auto-submit#submit">
                    {% for schoolYear in schoolYears %}
                        <option value="{{ schoolYear.id }}"{{ selectedYear and selectedYear.id == schoolYear.id ? ' selected' }}>{{ schoolYear.startDate|date('Y') }}-{{ schoolYear.endDate|date('Y') }}</option>
                    {% endfor %}
                </select>
            </label>
            <label class="cm-filterbar__field">
                {{ 'ufaAlternanceFilterFormationLabel'|trans }}
                <select name="formation" class="cm-filterbar__select {{ selectedFormation ? '' : 'cm-filterbar__select--any' }}" data-action="change->auto-submit#submit">
                    <option value="">{{ 'ufaAlternanceFilterFormationAllLabel'|trans }}</option>
                    {% for formation in formations %}
                        <option value="{{ formation.id }}"{{ selectedFormation and selectedFormation.id == formation.id ? ' selected' }}>{{ formation.displayShortName }}</option>
                    {% endfor %}
                </select>
            </label>
            <label class="cm-filterbar__field">
                {{ 'ufaAlternanceFilterEnterpriseLabel'|trans }}
                <select name="enterprise" class="cm-filterbar__select {{ selectedEnterprise ? '' : 'cm-filterbar__select--any' }}" data-action="change->auto-submit#submit">
                    <option value="">{{ 'ufaAlternanceFilterEnterpriseAllLabel'|trans }}</option>
                    {% for enterprise in enterprises %}
                        <option value="{{ enterprise.id }}"{{ selectedEnterprise and selectedEnterprise.id == enterprise.id ? ' selected' }}>{{ enterprise.name }}</option>
                    {% endfor %}
                </select>
            </label>
            {# Links, not submit buttons: pressing Enter in the search box implicitly submits
               through the form's *first* submit button, which silently reset the toggle back to
               "Actives". The hidden field is what carries the current state on the other
               filters' own submissions. #}
            <input type="hidden" name="all" value="{{ showAll ? 1 : 0 }}">
            <span class="cm-filterbar__segmented">
                <a href="{{ path('app_ufa', filters|merge({all: 0})) }}" class="cm-filterbar__seg {{ showAll ? '' : 'is-active' }}"{{ showAll ? '' : ' aria-current="true"' }}>{{ 'ufaAlternanceFilterActiveLabel'|trans }}</a>
                <a href="{{ path('app_ufa', filters|merge({all: 1})) }}" class="cm-filterbar__seg {{ showAll ? 'is-active' : '' }}"{{ showAll ? ' aria-current="true"' : '' }}>{{ 'ufaAlternanceFilterAllLabel'|trans }}</a>
            </span>
            {# Unchecked submits nothing at all, which is exactly the default the controller reads -
               so this one needs no hidden companion field like "all" above. #}
            <label class="cm-filterbar__check">
                <input type="checkbox" name="test" value="1"{{ showTestData ? ' checked' : '' }} data-action="change->auto-submit#submit">
                {{ 'ufaAlternanceFilterTestDataLabel'|trans }}
            </label>
            <span class="cm-filterbar__search">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" style="flex: none;"><circle cx="11" cy="11" r="6.5"></circle><path d="m16 16 4 4"></path></svg>
                <input type="search" name="search" value="{{ search }}" aria-label="{{ 'ufaAlternanceFilterSearchLabel'|trans }}" placeholder="{{ 'ufaAlternanceFilterSearchPlaceholder'|trans }}" data-action="change->auto-submit#submit">
            </span>
        </form>
        {% include 'ufa/alternance/_dashboard_list.html.twig' %}
        {% if isPastYear %}
            <div class="card-footer text-secondary small">{{ 'ufaAlternancePastYearNoteLabel'|trans }}</div>
        {% endif %}
    </div>

    <div class="card mt-3">
        <div class="card-header">
            <h3 class="card-title mb-0">{{ 'activityRecentCardTitle'|trans }}</h3>
            <div class="card-actions"><a href="{{ path('app_ufa_activity_history', showTestData ? {test: 1} : {}) }}">{{ 'activitySeeAllLabel'|trans }}</a></div>
        </div>
        <div class="card-body">
            {% include 'activity/_list.html.twig' with {activities: activities, emptyMessage: 'activityEmptyMessage'|trans} only %}
        </div>
    </div>
{% endblock %}
