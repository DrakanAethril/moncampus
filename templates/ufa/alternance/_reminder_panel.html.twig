{# 34c - fetched raw via reminder_modal_controller.js and injected into show.html.twig's modal. #}
<div class="modal-header">
    <h5 class="modal-title">
        {{ 'ufaAlternanceReminderModalTitle'|trans }}
        <span class="badge bg-red-lt ms-2">{{ status.period ? status.period.name : 'ufaAlternanceEngagementPageHeading'|trans }}</span>
    </h5>
    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
</div>
<div class="modal-body">
    {% if queuedItem %}
        <div class="alert alert-warning">{{ 'reminderBatchQueuedWarningText'|trans({'%batch%': queuedItem.batch.step.shortLabelKey|trans({'%rank%': queuedItem.batch.periodRank})}) }}
            <a href="{{ path('app_ufa_reminder_batch_show', {id: queuedItem.batch.id}) }}">{{ 'reminderBatchNavLabel'|trans }}</a></div>
    {% endif %}
    <div class="mb-3">
        <label class="form-label">{{ 'ufaAlternanceReminderRecipientLabel'|trans }}</label>
        <div class="form-control-plaintext">
            {% if status.pendingActor %}
                {# contactEmail, like the fallback branch below and like
                   AlternanceReminderService::emailForStep(), which actually sends the mail:
                   User::$email is the internal @beaupeyrat.lan address, and displaying it made one
                   believe the reminder went there. #}
                {{ tutorLink.nameOf(status.pendingActor) }} — {{ status.pendingActor.contactEmail ?? '—' }}
            {% else %}
                {{ tutorLink.tutor.displayName ?? tutorLink.tutor.username }} — {{ tutorLink.tutor.contactEmail ?? '—' }}
            {% endif %}
        </div>
    </div>
    <div class="mb-3">
        <label class="form-label">{{ 'ufaAlternanceReminderCcLabel'|trans }}</label>
        {% if step.value not in ['tutor', 'engagement_tutor'] %}
            <div class="form-check">
                <input class="form-check-input" type="checkbox" name="cc[]" value="tutor" id="cc-tutor" checked>
                <label class="form-check-label" for="cc-tutor">{{ 'ufaAlternanceReminderCcTutorLabel'|trans }} — {{ tutorLink.tutors|map(t => t.displayName ?? t.username)|join(', ') }}</label>
            </div>
        {% elseif tutorLink.secondaryTutor %}
            {# Not a choice: on the tutors' own steps the secondary tutor is always in copy
               (AlternanceReminderService::sendSingle()). #}
            <div class="form-control-plaintext">{{ 'ufaAlternanceSecondaryTutorShortLabel'|trans }} — {{ tutorLink.secondaryTutor.displayName ?? tutorLink.secondaryTutor.username }} — {{ tutorLink.secondaryTutor.contactEmail ?? '—' }}</div>
        {% endif %}
        {% if tutorLink.supervisor %}
            <div class="form-check">
                <input class="form-check-input" type="checkbox" name="cc[]" value="supervisor" id="cc-supervisor">
                <label class="form-check-label" for="cc-supervisor">{{ 'ufaAlternanceReminderCcSupervisorLabel'|trans }} — {{ tutorLink.supervisor.displayName ?? tutorLink.supervisor.username }}</label>
            </div>
        {% endif %}
    </div>
    <div class="mb-3">
        <label class="form-label">{{ 'ufaAlternanceReminderMessageLabel'|trans }}</label>
        <div class="cm-wizard-readonly-block">
            {# Preview of the mail body: it must branch exactly like
               emails/internship_alternance_reminder.html.twig, otherwise the reminder about the
               booklet being made available - which has neither period nor deadline - announces itself
               here as "pour la période , avant le ." while the mail actually sent says something else. #}
            {% if status.period %}
                {{ 'ufaAlternanceReminderEmailPeriodBody'|trans({'%period%': status.period.name, '%deadline%': status.dueDate ? status.dueDate|date('d/m/Y') : ''})|raw }}
            {% else %}
                {{ 'ufaAlternanceReminderEmailEngagementBody'|trans|raw }}
            {% endif %}
        </div>
        {# The legend describes what fills the template: it therefore follows the same branching as
           the preview above, otherwise it announces a period and a deadline the reminder about the
           booklet being made available does not have. #}
        <div class="text-secondary small mt-1">{{ (status.period ? 'ufaAlternanceReminderMessageCaption' : 'ufaAlternanceReminderMessageEngagementCaption')|trans }}</div>
    </div>
    {% if reminders|length %}
        <div>
            <label class="form-label">{{ 'ufaAlternanceReminderHistoryLabel'|trans }}</label>
            <ul class="list-unstyled text-secondary small mb-0">
                {% for reminder in reminders %}
                    {% set by = reminder.sentBy.displayName ?? reminder.sentBy.username %}
                    <li>{{ reminder.sentAt|date('d/m/Y') }} —
                        {% if reminder.batch %}
                            <a href="{{ path('app_ufa_reminder_batch_show', {id: reminder.batch.id}) }}">{{ 'ufaAlternanceReminderHistoryBatchEntryLabel'|trans({'%batch%': reminder.batch.step.shortLabelKey|trans({'%rank%': reminder.batch.periodRank}), '%by%': by}) }}</a>
                        {% else %}
                            {{ 'ufaAlternanceReminderHistoryEntryLabel'|trans({'%by%': by}) }}
                        {% endif %}
                    </li>
                {% endfor %}
            </ul>
        </div>
    {% endif %}
</div>
<div class="modal-footer d-flex justify-content-between align-items-center">
    <span class="text-secondary small">{{ 'ufaAlternanceReminderFooterNoteLabel'|trans }}</span>
    <div>
        <button type="button" class="btn btn-link" data-bs-dismiss="modal">{{ 'cancelAction'|trans }}</button>
        <button type="button" class="btn btn-primary" data-action="click->reminder-modal#send" data-url="{{ path('app_ufa_alternance_reminder_send', {id: tutorLink.id}) }}" data-token="{{ csrf_token('ufa_alternance_reminder_send') }}">{{ 'ufaAlternanceReminderSendButtonLabel'|trans }}</button>
    </div>
</div>
