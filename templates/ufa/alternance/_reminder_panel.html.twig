{# 34c - fetched raw via reminder_modal_controller.js and injected into show.html.twig's modal. #}
<div class="modal-header">
    <h5 class="modal-title">
        {{ 'ufaAlternanceReminderModalTitle'|trans }}
        <span class="badge bg-red-lt ms-2">{{ status.period ? status.period.name : 'ufaAlternanceEngagementPageHeading'|trans }}</span>
    </h5>
    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
</div>
<div class="modal-body">
    <div class="mb-3">
        <label class="form-label">{{ 'ufaAlternanceReminderRecipientLabel'|trans }}</label>
        <div class="form-control-plaintext">
            {% if status.pendingActor %}
                {{ status.pendingActor.displayName ?? status.pendingActor.username }} — {{ status.pendingActor.email }}
            {% else %}
                {{ tutorLink.tutorFirstName }} {{ tutorLink.tutorLastName }} — {{ tutorLink.tutorEmail }}
            {% endif %}
        </div>
    </div>
    <div class="mb-3">
        <label class="form-label">{{ 'ufaAlternanceReminderCcLabel'|trans }}</label>
        {% if step.value not in ['tutor', 'engagement_tutor'] %}
            <div class="form-check">
                <input class="form-check-input" type="checkbox" name="cc[]" value="tutor" id="cc-tutor" checked>
                <label class="form-check-label" for="cc-tutor">{{ 'ufaAlternanceReminderCcTutorLabel'|trans }} — {{ tutorLink.tutorFirstName }} {{ tutorLink.tutorLastName }}</label>
            </div>
        {% endif %}
        {% if tutorLink.supervisor %}
            <div class="form-check">
                <input class="form-check-input" type="checkbox" name="cc[]" value="supervisor" id="cc-supervisor">
                <label class="form-check-label" for="cc-supervisor">{{ 'ufaAlternanceReminderCcSupervisorLabel'|trans }} — {{ tutorLink.supervisor.displayName ?? tutorLink.supervisor.username }}</label>
            </div>
        {% endif %}
    </div>
    <div class="mb-3">
        <label class="form-label">{{ 'ufaAlternanceReminderMessageLabel'|trans }}</label>
        <div class="cm-wizard-readonly-block">
            {{ 'ufaAlternanceReminderEmailPeriodBody'|trans({'%period%': status.period ? status.period.name : '', '%deadline%': status.dueDate ? status.dueDate|date('d/m/Y') : ''})|raw }}
        </div>
        <div class="text-secondary small mt-1">{{ 'ufaAlternanceReminderMessageCaption'|trans }}</div>
    </div>
    {% if reminders|length %}
        <div>
            <label class="form-label">{{ 'ufaAlternanceReminderHistoryLabel'|trans }}</label>
            <ul class="list-unstyled text-secondary small mb-0">
                {% for reminder in reminders %}
                    <li>{{ reminder.sentAt|date('d/m/Y') }} — {{ 'ufaAlternanceReminderHistoryEntryLabel'|trans({'%by%': reminder.sentBy.displayName ?? reminder.sentBy.username}) }}</li>
                {% endfor %}
            </ul>
        </div>
    {% endif %}
</div>
<div class="modal-footer d-flex justify-content-between align-items-center">
    <span class="text-secondary small">{{ 'ufaAlternanceReminderFooterNoteLabel'|trans }}</span>
    <div>
        <button type="button" class="btn btn-link" data-bs-dismiss="modal">{{ 'cancelAction'|trans }}</button>
        <button type="button" class="btn btn-primary" data-action="click->reminder-modal#send" data-url="{{ path('app_ufa_alternance_reminder_send', {id: tutorLink.id}) }}" data-token="{{ csrf_token('ufa_alternance_reminder_send') }}">{{ 'ufaAlternanceReminderSendButtonLabel'|trans }}</button>
    </div>
</div>
