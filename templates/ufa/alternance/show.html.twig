{% extends 'layout/app.html.twig' %}

{% block title %}{{ 'ufaAlternanceShowPageHeading'|trans }} — {{ tutorLink.student.displayName ?? tutorLink.student.username }}{% endblock %}

{% block page_breadcrumb %}
    {% include '_breadcrumb.html.twig' with {segments: [
        {label: 'homeNavLabel'|trans, url: path('app_home')},
        {label: 'ufaAlternanceDashboardPageHeading'|trans, url: path('app_ufa')},
        {label: tutorLink.student.displayName ?? tutorLink.student.username, url: app.request.requestUri},
    ]} %}
{% endblock %}
{% block page_title %}{{ 'ufaAlternanceShowPageHeading'|trans }} — {{ tutorLink.student.displayName ?? tutorLink.student.username }}{% endblock %}
{% block page_actions %}
    {# Une seule action ici : imprimer et exporter en PDF vivent sur la liseuse du livret, où
       elles portent sur ce qu'on est en train de lire - même règle pour tous les rôles. #}
    <a href="{{ path('app_ufa_alternance_livret', {id: tutorLink.id}) }}" class="btn btn-primary">{{ 'ufaAlternanceActionConsultLivretLabel'|trans }}</a>
{% endblock %}

{% block main %}
    {# Sous-titre 34a : formation · entreprise · tuteur · chargé de suivi #}
    <div class="text-secondary mb-3" style="margin-top: -8px;">
        {% if tutorLink.testAlternance %}<span class="badge bg-purple-lt me-1">{{ 'ufaAlternanceTestBadgeLabel'|trans }}</span>{% endif %}
        {{ tutorLink.program.displayShortName }}
        {%- if tutorLink.enterprise %} · {{ tutorLink.enterprise.name }}{% endif %}
        · {{ 'ufaAlternanceRoleTutorLabel'|trans|lower }} {{ tutorLink.tutor.displayName ?? tutorLink.tutor.username }}
        {%- if tutorLink.supervisor %} · {{ 'ufaAlternanceRoleSupervisorLabel'|trans|lower }} {{ tutorLink.supervisor.displayName ?? tutorLink.supervisor.username }}{% endif %}
    </div>
    {% set currentActorName = currentStatus.pendingActor
        ? (currentStatus.pendingActor.displayName ?? currentStatus.pendingActor.username)
        : (currentStatus.step in ['tutor', 'engagement_tutor']
            ? (tutorLink.tutor.displayName ?? tutorLink.tutor.username)
            : (currentStatus.step == 'supervisor' ? 'ufaAlternanceRoleSupervisorLabel'|trans : 'ufaAlternanceRoleCenterLabel'|trans)) %}
    <div data-controller="reminder-modal">
    {% if canRemind %}
        <div class="alert mb-3" style="border-color: #e0b25f; background: #fdf6e820;">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                <div>
                    <strong>{{ 'ufaAlternanceSuiviBannerLateTitleLabel'|trans }}</strong>
                    {# La mise à disposition du livret n'est pas rattachée à une période et n'a donc
                       pas d'échéance : son message se passe de date, plutôt que d'afficher
                       "depuis le ." (même raison pour le repli sans dueDate - InternshipEvaluationPeriod
                       ::getEndDate() est nullable). #}
                    {% if currentStatus.isEngagementStep %}
                        {{ 'ufaAlternanceSuiviBannerEngagementBodyLabel'|trans({'%actor%': currentActorName}) }}
                    {% elseif currentStatus.dueDate %}
                        {{ 'ufaAlternanceSuiviBannerLateBodyLabel'|trans({
                            '%actor%': currentActorName,
                            '%date%': currentStatus.dueDate|date('d/m'),
                        }) }}
                    {% else %}
                        {{ 'ufaAlternanceSuiviBannerPendingBodyLabel'|trans({'%actor%': currentActorName}) }}
                    {% endif %}
                    {% if lastReminder %}{{ 'ufaAlternanceSuiviBannerLastReminderLabel'|trans({'%date%': lastReminder.sentAt|date('d/m/Y')}) }}{% endif %}
                </div>
                <button type="button" class="btn btn-outline-warning" data-url="{{ path('app_ufa_alternance_reminder', {id: tutorLink.id}) }}" data-action="click->reminder-modal#open">
                    {{ 'ufaAlternanceSuiviRelancerButtonLabel'|trans({'%actor%': currentActorName}) }}
                </button>
            </div>
        </div>
    {% else %}
        <div class="alert alert-secondary mb-3">
            <strong>{{ 'ufaAlternanceSuiviBannerOkTitleLabel'|trans }}</strong>
            {{ 'ufaAlternanceSuiviBannerOkBodyLabel'|trans }}
        </div>
    {% endif %}

    <div class="card mb-3">
        <div class="card-header d-flex align-items-center gap-2">
            <h3 class="card-title mb-0">{{ 'ufaAlternanceSuiviEngagementCardTitle'|trans }}</h3>
            {% if engagement.signedCenterAt %}
                <span class="badge bg-green-lt">{{ 'ufaAlternanceSuiviCompleteLabel'|trans }}</span>
                <span class="text-secondary small">{{ 'ufaAlternanceSuiviNoReminderNeededLabel'|trans }}</span>
            {% endif %}
            <a href="{{ path('app_ufa_alternance_engagement', {id: tutorLink.id}) }}" class="btn btn-link btn-sm ms-auto">{{ 'ufaAlternanceSuiviViewDetailLabel'|trans }}</a>
        </div>
        <div class="card-body row">
            <div class="col-md-4">
                <div class="fw-bold">{{ 'ufaAlternanceRoleTutorLabel'|trans }}</div>
                <div class="text-secondary small">{{ engagement.signedTutorAt ? 'ufaAlternanceEngagementSignedOnLabel'|trans({'%date%': engagement.signedTutorAt|date('d/m/Y')}) : 'ufaAlternanceEngagementNotYetSignedLabel'|trans }}</div>
            </div>
            <div class="col-md-4">
                <div class="fw-bold">{{ 'ufaAlternanceRoleStudentLabel'|trans }}</div>
                <div class="text-secondary small">{{ engagement.signedStudentAt ? 'ufaAlternanceEngagementSignedOnLabel'|trans({'%date%': engagement.signedStudentAt|date('d/m/Y')}) : 'ufaAlternanceEngagementNotYetSignedLabel'|trans }}</div>
            </div>
            <div class="col-md-4">
                <div class="fw-bold">{{ 'ufaAlternanceRoleCenterLabel'|trans }}</div>
                <div class="text-secondary small">{{ engagement.signedCenterAt ? 'ufaAlternanceEngagementSignedOnLabel'|trans({'%date%': engagement.signedCenterAt|date('d/m/Y')}) : 'ufaAlternanceEngagementNotYetSignedLabel'|trans }}</div>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-header d-flex align-items-baseline gap-2">
            <h3 class="card-title mb-0">{{ 'ufaAlternanceSuiviPeriodsCardTitle'|trans }}</h3>
            <span class="text-secondary small">{{ 'ufaAlternanceSuiviPeriodsHelpText'|trans }}</span>
        </div>
        <div class="card-body">
            {% for row in periodRows %}
                <div class="py-3{{ not loop.last ? ' border-bottom' }}">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <div class="fw-bold">{{ row.period.name }}</div>
                        <div>
                            <span class="badge {{ row.badge.class }}">{{ row.badge.label }}</span>
                            {% if row.status.isLate %}
                                {% set rowActorName = row.status.pendingActor
                                    ? (row.status.pendingActor.displayName ?? row.status.pendingActor.username)
                                    : (row.status.step in ['tutor', 'engagement_tutor']
                                        ? (tutorLink.tutor.displayName ?? tutorLink.tutor.username)
                                        : (row.status.step == 'supervisor' ? 'ufaAlternanceRoleSupervisorLabel'|trans : 'ufaAlternanceRoleCenterLabel'|trans)) %}
                                <a href="#" class="ms-2 text-warning" data-url="{{ path('app_ufa_alternance_reminder', {id: tutorLink.id}) }}" data-action="click->reminder-modal#open">
                                    {{ 'ufaAlternanceSuiviRelancerLinkLabel'|trans({'%actor%': rowActorName}) }}
                                </a>
                            {% elseif row.status.dueDate and 'closed' != row.status.step %}
                                <span class="text-secondary small ms-2">{{ 'ufaAlternanceSuiviDueDateLabel'|trans({'%date%': row.status.dueDate|date('d/m')}) }}</span>
                            {% endif %}
                        </div>
                    </div>
                    {# Chaîne des 4 rôles (34a) - chaque pastille ouvre le parcours du rôle
                       correspondant : c'est la navigation staff vers les wizards. #}
                    {% if row.status.step != 'not_opened' %}
                        {% set roleLinks = [
                            {label: 'ufaAlternanceRoleTutorLabel'|trans, url: path('app_ufa_alternance_period_tuteur', {id: tutorLink.id, periodId: row.period.id, step: 'comportement'}), signedAt: row.tutorEvaluation ? row.tutorEvaluation.signedAt : null, reached: true},
                            {label: 'ufaAlternanceRoleStudentLabel'|trans, url: path('app_ufa_alternance_period_alternant', {id: tutorLink.id, periodId: row.period.id, step: 'comportement'}), signedAt: row.studentEvaluation ? row.studentEvaluation.signedAt : null, reached: row.tutorEvaluation and row.tutorEvaluation.signedAt},
                            {label: 'ufaAlternanceRoleTeamLabel'|trans, url: path('app_ufa_alternance_period_equipe', {id: tutorLink.id, periodId: row.period.id, step: 'comportement'}), signedAt: row.teamEvaluation ? row.teamEvaluation.signedAt : null, reached: row.studentEvaluation and row.studentEvaluation.signedAt},
                            {label: 'ufaAlternanceRoleSupervisorLabel'|trans, url: path('app_ufa_alternance_period_suivi', {id: tutorLink.id, periodId: row.period.id, step: 'comportement'}), signedAt: row.supervisorEvaluation ? row.supervisorEvaluation.closedAt : null, reached: row.teamEvaluation and row.teamEvaluation.signedAt},
                        ] %}
                        <div class="cm-role-progress" style="justify-content: flex-start;">
                            {% for role in roleLinks %}
                                {% if not loop.first %}<span class="cm-role-progress__arrow">→</span>{% endif %}
                                <a href="{{ role.reached or role.signedAt ? role.url : '#' }}" class="cm-role-progress__chip text-decoration-none{{ not (role.reached or role.signedAt) ? ' pe-none' }}">
                                    {% if role.signedAt %}
                                        <span class="cm-role-progress__icon cm-role-progress__icon--done">✓</span>
                                    {% elseif role.reached %}
                                        <span class="cm-role-progress__icon cm-role-progress__icon--current">{{ loop.index }}</span>
                                    {% else %}
                                        <span class="cm-role-progress__icon cm-role-progress__icon--waiting">🔒</span>
                                    {% endif %}
                                    <div>
                                        <div class="cm-role-progress__label">{{ role.label }}</div>
                                        <div class="cm-role-progress__status">
                                            {% if role.signedAt %}
                                                {{ 'ufaAlternanceEngagementSignedOnLabel'|trans({'%date%': role.signedAt|date('d/m')}) }}
                                            {% elseif role.reached %}
                                                {{ 'ufaAlternanceWizardRoleInProgressLabel'|trans }}
                                            {% else %}
                                                {{ 'ufaAlternanceWizardRoleWaitingLabel'|trans }}
                                            {% endif %}
                                        </div>
                                    </div>
                                </a>
                            {% endfor %}
                        </div>
                    {% endif %}
                </div>
            {% endfor %}
        </div>
    </div>

    <div class="modal modal-blur fade" tabindex="-1" data-reminder-modal-target="modal">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content" data-reminder-modal-target="content"></div>
        </div>
    </div>
    </div>
{% endblock %}
