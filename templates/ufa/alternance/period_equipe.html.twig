{% extends 'layout/app.html.twig' %}

{% block title %}{{ 'ufaAlternanceRoleTeamLabel'|trans }} — {{ period.name }}{% endblock %}

{% block page_breadcrumb %}
    {% include '_breadcrumb.html.twig' with {segments: [
        {label: 'homeNavLabel'|trans, url: path('app_home')},
        {label: 'ufaAlternanceDashboardPageHeading'|trans, url: path('app_ufa')},
        {label: tutorLink.student.displayName ?? tutorLink.student.username, url: path('app_ufa_alternance_show', {id: tutorLink.id})},
        {label: period.name ~ ' — ' ~ 'ufaAlternanceRoleTeamLabel'|trans, url: app.request.requestUri},
    ]} %}
{% endblock %}
{% block page_title %}{{ period.name }} — {{ 'ufaAlternanceRoleTeamLabel'|trans }}{% endblock %}

{% block main %}
    <div style="max-width: 900px; margin: 0 auto;">
        {% include 'ufa/alternance/_wizard_role_progress.html.twig' %}
        {% include '_wizard_steps.html.twig' %}

        <div class="card mb-3">
            <div class="card-body">
                {% if step in ['comportement', 'competences'] %}
                    <span class="cm-wizard-readonly-badge">🔒 {{ 'ufaAlternanceWizardReadOnlyTutorLabel'|trans }}</span>
                    {% include 'ufa/alternance/_wizard_evaluation_readonly.html.twig' %}
                    <div class="d-flex justify-content-between align-items-center mt-3 pt-3 border-top">
                        <span class="text-secondary small">{{ 'ufaAlternanceWizardEquipeReadHelpText'|trans }}</span>
                        <div>
                            {% if backPath %}<a href="{{ backPath }}" class="btn btn-link">{{ 'ufaAlternanceWizardPreviousStepButtonLabel'|trans }}</a>{% endif %}
                            <a href="{{ path('app_ufa_alternance_period_equipe', {id: tutorLink.id, periodId: period.id, step: 'comportement' == step ? 'competences' : 'forces'}) }}" class="btn btn-primary">{{ 'ufaAlternanceWizardContinueButtonLabel'|trans }}</a>
                        </div>
                    </div>
                {% elseif step == 'forces' %}
                    <span class="cm-wizard-readonly-badge">🔒 {{ 'ufaAlternanceWizardReadOnlyGroupedLabel'|trans }}</span>
                    {% include 'ufa/alternance/_wizard_remarks_grouped.html.twig' with {readOnly: true, teamEvaluation: null} %}
                    <div class="d-flex justify-content-between align-items-center mt-3 pt-3 border-top">
                        <span class="text-secondary small">{{ 'ufaAlternanceWizardEquipeGroupedHelpText'|trans }}</span>
                        <div>
                            {% if backPath %}<a href="{{ backPath }}" class="btn btn-link">{{ 'ufaAlternanceWizardPreviousStepButtonLabel'|trans }}</a>{% endif %}
                            <a href="{{ path('app_ufa_alternance_period_equipe', {id: tutorLink.id, periodId: period.id, step: 'remarques'}) }}" class="btn btn-primary">{{ 'ufaAlternanceWizardContinueButtonLabel'|trans }}</a>
                        </div>
                    </div>
                {% elseif readOnly %}
                    <span class="cm-wizard-readonly-badge">🔒 {{ 'ufaAlternanceWizardReadOnlyLockedLabel'|trans }}</span>
                    <div class="cm-wizard-readonly-block">
                        <div class="text-secondary small mb-1">
                            {{ 'internshipTeamEvaluationRemarksFieldLabel'|trans }}
                            {% if teamEvaluation.signedAt %}· {{ teamEvaluation.signedBy.displayName ?? teamEvaluation.signedBy.username }}, {{ teamEvaluation.signedAt|date('d/m/Y') }}{% endif %}
                        </div>
                        {{ (teamEvaluation.remarksText ?: '—')|nl2br }}
                    </div>
                    {% if backPath %}<div class="mt-3 pt-3 border-top"><a href="{{ backPath }}" class="btn btn-link">{{ 'ufaAlternanceWizardPreviousStepButtonLabel'|trans }}</a></div>{% endif %}
                {% else %}
                    {{ form_start(form) }}
                        {# A plain textarea, like the tutor's remarks: the booklet renders this field as
                           plain text (white-space: pre-line), and the rich editor's HTML showed up
                           there, tags included. #}
                        {{ form_row(form.remarksText, {attr: {rows: 6}}) }}
                        {{ form_row(form._token) }}
                        <div class="d-flex justify-content-between align-items-center mt-3 pt-3 border-top">
                            <span class="text-secondary small">{{ 'ufaAlternanceWizardEquipeSignHelpText'|trans }}</span>
                            <div>
                                {% if backPath %}<a href="{{ backPath }}" class="btn btn-link">{{ 'ufaAlternanceWizardPreviousStepButtonLabel'|trans }}</a>{% endif %}
                                {{ form_widget(form.submit, {label: 'ufaAlternanceWizardEquipeSignButtonLabel'}) }}
                            </div>
                        </div>
                    {{ form_end(form) }}
                {% endif %}
            </div>
        </div>
    </div>
{% endblock %}
