{#
    Shared step content for the alternant's own wizard (29a-29d) - steps 1-3 read-only, step 4 is
    their own remarksText + signature. Reused by both the staff on-behalf page
    (ufa/alternance/period_alternant.html.twig) and the self-service page
    (program/internship_my_period_step.html.twig). Expects: step, tutorEvaluation,
    studentEvaluation, readOnly, form, backPath, continueUrl (next step's URL, only used on
    steps 1-3).
#}
<div class="card mb-3">
    <div class="card-body">
        {% if step != 'remarques' %}
            <span class="cm-wizard-readonly-badge">🔒 {{ 'ufaAlternanceWizardReadOnlyTutorLabel'|trans }}</span>
            {% include 'ufa/alternance/_wizard_evaluation_readonly.html.twig' %}
            <div class="d-flex justify-content-between align-items-center mt-3 pt-3 border-top">
                <span class="text-secondary small">{{ 'ufaAlternanceWizardAlternantReadHelpText'|trans }}</span>
                <div>
                    {% if backPath %}<a href="{{ backPath }}" class="btn btn-link">{{ 'ufaAlternanceWizardPreviousStepButtonLabel'|trans }}</a>{% endif %}
                    <a href="{{ continueUrl }}" class="btn btn-primary">{{ 'ufaAlternanceWizardContinueButtonLabel'|trans }}</a>
                </div>
            </div>
        {% elseif readOnly %}
            <span class="cm-wizard-readonly-badge">🔒 {{ 'ufaAlternanceWizardReadOnlyLockedLabel'|trans }}</span>
            <div class="cm-wizard-readonly-block">
                <div class="text-secondary small mb-1">
                    {{ 'internshipStudentEvaluationRemarksFieldLabel'|trans }}
                    {% if studentEvaluation.signedAt %}· {{ studentEvaluation.signedBy.displayName ?? studentEvaluation.signedBy.username }}, {{ studentEvaluation.signedAt|date('d/m/Y') }}{% endif %}
                </div>
                {{ (studentEvaluation.remarksText ?: '—')|nl2br }}
            </div>
            {% if backPath %}<div class="mt-3 pt-3 border-top"><a href="{{ backPath }}" class="btn btn-link">{{ 'ufaAlternanceWizardPreviousStepButtonLabel'|trans }}</a></div>{% endif %}
        {% else %}
            {{ form_start(form) }}
                {# A plain textarea, like the tutor's remarks: the booklet renders this field as plain
                   text (white-space: pre-line), and the rich editor's HTML showed up there, tags
                   included. #}
                {{ form_row(form.remarksText, {attr: {rows: 6}}) }}
                {{ form_row(form._token) }}
                <div class="d-flex justify-content-between align-items-center mt-3 pt-3 border-top">
                    <span class="text-secondary small">{{ 'ufaAlternanceWizardAlternantSignHelpText'|trans }}</span>
                    <div>
                        {% if backPath %}<a href="{{ backPath }}" class="btn btn-link">{{ 'ufaAlternanceWizardPreviousStepButtonLabel'|trans }}</a>{% endif %}
                        {{ form_widget(form.submit, {label: 'ufaAlternanceWizardAlternantSignButtonLabel'}) }}
                    </div>
                </div>
            {{ form_end(form) }}
        {% endif %}
    </div>
</div>
