{#
    Step-tab row + progress bar shared by the tuteur/alternant/équipe/chargé de suivi wizards.
    Expects: stepLabels (list of 4 strings), currentStepIndex (1-based int).
#}
<div class="cm-stepper">
    <div class="cm-stepper__steps">
        {% for label in stepLabels %}
            {% set index = loop.index %}
            {% if not loop.first %}
                <div class="cm-stepper__rule{{ index - 1 < currentStepIndex ? ' cm-stepper__rule--done' }}"></div>
            {% endif %}
            <div class="cm-stepper__step">
                <span class="cm-stepper__step-circle {{ index < currentStepIndex ? 'cm-stepper__step-circle--done' : (index == currentStepIndex ? 'cm-stepper__step-circle--current' : 'cm-stepper__step-circle--future') }}">
                    {{ index < currentStepIndex ? '✓' : index }}
                </span>
                <span class="cm-stepper__step-name">{{ label }}</span>
            </div>
        {% endfor %}
    </div>
    <div class="cm-stepper__progress">
        <div class="cm-stepper__progress-fill" style="width: {{ (currentStepIndex / stepLabels|length * 100)|round }}%"></div>
    </div>
    <div class="cm-stepper__caption">{{ 'ufaAlternanceWizardStepCaptionLabel'|trans({'%step%': currentStepIndex, '%total%': stepLabels|length, '%name%': stepLabels[currentStepIndex - 1]}) }}</div>
</div>
