{% extends 'layout/app.html.twig' %}

{% block title %}{{ 'ufaAlternanceRoleStudentLabel'|trans }} — {{ period.name }}{% endblock %}

{% block page_breadcrumb %}
    {% include '_breadcrumb.html.twig' with {segments: [
        {label: 'homeNavLabel'|trans, url: path('app_home')},
        {label: 'ufaAlternanceDashboardPageHeading'|trans, url: path('app_ufa')},
        {label: tutorLink.student.displayName ?? tutorLink.student.username, url: path('app_ufa_alternance_show', {id: tutorLink.id})},
        {label: period.name ~ ' — ' ~ 'ufaAlternanceRoleStudentLabel'|trans, url: app.request.requestUri},
    ]} %}
{% endblock %}
{% block page_title %}{{ period.name }} — {{ 'ufaAlternanceRoleStudentLabel'|trans }}{% endblock %}

{% block main %}
    <div style="max-width: 900px; margin: 0 auto;">
        {% include 'ufa/alternance/_wizard_role_progress.html.twig' %}
        {% include '_wizard_steps.html.twig' %}
        {% include 'ufa/alternance/_wizard_alternant_content.html.twig' with {
            continueUrl: path('app_ufa_alternance_period_alternant', {id: tutorLink.id, periodId: period.id, step: 'comportement' == step ? 'competences' : ('competences' == step ? 'forces' : 'remarques')}),
        } %}
    </div>
{% endblock %}
