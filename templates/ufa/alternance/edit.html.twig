{% extends 'layout/app.html.twig' %}

{% block title %}{{ 'ufaAlternanceEditPageHeading'|trans }} — {{ tutorLink.student.displayName ?? tutorLink.student.username }}{% endblock %}

{% block page_breadcrumb %}
    {% include '_breadcrumb.html.twig' with {segments: [
        {label: 'homeNavLabel'|trans, url: path('app_home')},
        {label: 'ufaAlternanceDashboardPageHeading'|trans, url: path('app_ufa')},
        {label: tutorLink.student.displayName ?? tutorLink.student.username, url: path('app_ufa_alternance_show', {id: tutorLink.id})},
        {label: 'ufaAlternanceEditPageHeading'|trans, url: app.request.requestUri},
    ]} %}
{% endblock %}
{% block page_title %}{{ 'ufaAlternanceEditPageHeading'|trans }} — {{ tutorLink.student.displayName ?? tutorLink.student.username }}{% endblock %}

{% block main %}
    <div class="card">
        <div class="card-body">
            {{ form_start(form) }}
                {{ form_errors(form) }}
                <div class="row">
                    <div class="col-md-6">
                        <label class="form-label" for="student">{{ 'internshipTutorLinkStudentFieldLabel'|trans }}</label>
                        <select id="student" name="student" class="form-select"
                                data-controller="tom-select"
                                data-tom-select-url-value="{{ path('app_ufa_formation_tutors_students_search', {id: program.id}) }}"
                                data-tom-select-placeholder-value="{{ 'internshipTutorLinkStudentFieldLabel'|trans }}">
                            {% if form.vars.data.student %}
                                <option value="{{ form.vars.data.student.id }}" selected>{{ form.vars.data.student.displayName ?? form.vars.data.student.username }}</option>
                            {% endif %}
                        </select>
                    </div>
                    <div class="col-md-6"></div>
                    <div class="col-md-6">{{ form_row(form.contractType) }}</div>
                    <div class="col-md-6">{{ form_row(form.contractStartDate) }}</div>
                    <div class="col-md-6">{{ form_row(form.contractEndDate) }}</div>
                </div>
                <div class="mb-3">
                    <h3 class="h4">{{ 'ufaAlternanceNewSection2Label'|trans }}</h3>
                    {% include 'ufa/alternance/_tutor_fields.html.twig' with {tutorField: form.tutor, currentTutor: tutorLink.tutor} %}
                </div>
                <div data-controller="enterprise-picker">
                    {{ form_row(form.enterprise, {attr: {'data-enterprise-picker-target': 'select', 'data-action': 'change->enterprise-picker#toggle'}}) }}
                    <div data-enterprise-picker-target="newFields" class="row">
                        <div class="col-md-6">{{ form_row(form.newEnterpriseName) }}</div>
                        <div class="col-md-6">{{ form_row(form.newEnterpriseAddress) }}</div>
                    </div>
                </div>
                <div class="d-flex justify-content-between align-items-center gap-2 flex-wrap">
                    <div class="d-flex align-items-center gap-2 flex-wrap">
                        <a href="{{ path('app_ufa_alternance_show', {id: tutorLink.id}) }}" class="btn btn-link">{{ 'cancelAction'|trans }}</a>
                        {# « Terminer l'alternance » belongs to the modification screen only - there is
                           nothing to end while the alternance is being created. The button sits here
                           but posts the sibling form below through its form="…" attribute: a <form>
                           cannot be nested inside the edit form, and this keeps the gesture where the
                           decision is taken. #}
                        {% if tutorLink.terminated %}
                            <span class="text-secondary small">{{ 'ufaAlternanceTerminatedOnLabel'|trans({'%date%': tutorLink.inactiveDate|date('d/m/Y')}) }}</span>
                        {% else %}
                            <button type="submit" form="ufa-alternance-terminate" class="cm-btn cm-btn--danger"
                                    data-controller="confirm-submit"
                                    data-confirm-submit-message-value="{{ 'ufaAlternanceTerminateConfirmText'|trans({'%student%': tutorLink.student.displayName ?? tutorLink.student.username}) }}"
                                    data-action="click->confirm-submit#confirm">{{ 'ufaAlternanceTerminateButtonLabel'|trans }}</button>
                        {% endif %}
                    </div>
                    {{ form_widget(form.submit, {'label': 'submitEditAction'}) }}
                </div>
                {{ form_rest(form) }}
            {{ form_end(form) }}
        </div>
    </div>

    {% if not tutorLink.terminated %}
        <form id="ufa-alternance-terminate" method="post" action="{{ path('app_ufa_alternance_terminate', {id: tutorLink.id}) }}">
            <input type="hidden" name="_token" value="{{ csrf_token('ufa_alternance_terminate') }}">
        </form>
    {% endif %}
{% endblock %}
