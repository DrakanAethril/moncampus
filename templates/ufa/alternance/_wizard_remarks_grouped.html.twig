{#
    Grouped remarks step of the chargé de suivi's wizard (31c, always editable) - tutor's
    strengths/weaknesses/goals + tutor's own remark + student's own remark.
    Expects: tutorEvaluation, studentEvaluation, readOnly. When not readOnly, plain named fields
    (not a Symfony form) are rendered directly - this step edits 2 different entities at once
    (InternshipTutorEvaluation/InternshipStudentEvaluation), which doesn't map onto a single
    Symfony Form/data_class - the controller reads request fields by name directly instead (same
    plain-request-field pattern as Program\InternshipContractModalityController::syncContractModalities()).
#}
<div class="cm-wizard-readonly-block mb-3">
    <div class="text-secondary small mb-1">{{ 'ufaAlternanceWizardGroupedStrengthsLabel'|trans }} — {{ 'ufaAlternanceRoleTutorLabel'|trans }}</div>
    {% if readOnly %}
        {{ tutorEvaluation.strengthsText|default('—') }}
    {% else %}
        <textarea name="tutorStrengthsText" class="form-control" rows="2">{{ tutorEvaluation.strengthsText }}</textarea>
    {% endif %}
</div>
<div class="cm-wizard-readonly-block mb-3">
    <div class="text-secondary small mb-1">{{ 'ufaAlternanceWizardGroupedWeaknessesLabel'|trans }} — {{ 'ufaAlternanceRoleTutorLabel'|trans }}</div>
    {% if readOnly %}
        {{ tutorEvaluation.weaknessesText|default('—') }}
    {% else %}
        <textarea name="tutorWeaknessesText" class="form-control" rows="2">{{ tutorEvaluation.weaknessesText }}</textarea>
    {% endif %}
</div>
<div class="cm-wizard-readonly-block mb-3">
    <div class="text-secondary small mb-1">{{ 'ufaAlternanceWizardGroupedGoalsLabel'|trans }} — {{ 'ufaAlternanceRoleTutorLabel'|trans }}</div>
    {% if readOnly %}
        {{ tutorEvaluation.goalsText|default('—') }}
    {% else %}
        <textarea name="tutorGoalsText" class="form-control" rows="2">{{ tutorEvaluation.goalsText }}</textarea>
    {% endif %}
</div>
<hr>
<div class="cm-wizard-readonly-block mb-3">
    <div class="text-secondary small mb-1">
        {{ 'internshipTutorEvaluationRemarksFieldLabel'|trans }}
        {% if tutorEvaluation.signedAt %}· {{ tutorEvaluation.signedBy.displayName ?? tutorEvaluation.signedBy.username }}, {{ tutorEvaluation.signedAt|date('d/m/Y') }}{% endif %}
    </div>
    {% if readOnly %}
        {# Same reason as in _wizard_evaluation_readonly.html.twig: plain text. #}
        {{ (tutorEvaluation.remarksText ?: '—')|nl2br }}
    {% else %}
        <textarea name="tutorRemarksText" class="form-control" rows="3">{{ tutorEvaluation.remarksText }}</textarea>
    {% endif %}
</div>
<div class="cm-wizard-readonly-block">
    <div class="text-secondary small mb-1">
        {{ 'internshipStudentEvaluationRemarksFieldLabel'|trans }}
        {% if studentEvaluation.signedAt %}· {{ studentEvaluation.signedBy.displayName ?? studentEvaluation.signedBy.username }}, {{ studentEvaluation.signedAt|date('d/m/Y') }}{% endif %}
    </div>
    {% if readOnly %}
        {{ (studentEvaluation.remarksText ?: '—')|nl2br }}
    {% else %}
        <textarea name="studentRemarksText" class="form-control" rows="3">{{ studentEvaluation.remarksText }}</textarea>
    {% endif %}
</div>
