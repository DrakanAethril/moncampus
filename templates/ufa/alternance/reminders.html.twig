{% extends 'layout/app.html.twig' %}

{% block title %}{{ 'ufaAlternanceRemindersPageHeading'|trans }}{% endblock %}

{% block page_breadcrumb %}
    {% include '_breadcrumb.html.twig' with {segments: [
        {label: 'homeNavLabel'|trans, url: path('app_home')},
        {label: 'ufaAlternanceDashboardPageHeading'|trans, url: path('app_ufa')},
        {label: 'ufaAlternanceRemindersPageHeading'|trans, url: app.request.requestUri},
    ]} %}
{% endblock %}
{% block page_title %}{{ 'ufaAlternanceRemindersPageHeading'|trans }}{% endblock %}

{% block main %}
    <div class="card">
        {# No bilan left to chase: the picker itself goes away rather than offering an empty list -
           the screen then has exactly one thing to say, and says it. #}
        {% if selectedPeriod is null %}
            <div class="card-body text-center text-secondary py-5">{{ 'ufaAlternanceRemindersNothingPendingLabel'|trans }}</div>
        {% else %}
            <div class="card-body border-bottom">
                <form method="get" data-controller="auto-submit" class="d-flex align-items-end gap-3 flex-wrap">
                    <div>
                        <label class="form-label">{{ 'ufaAlternanceRemindersPeriodFieldLabel'|trans }}</label>
                        <select name="period" class="form-select form-select-sm" data-action="change->auto-submit#submit">
                            {% for period in periods %}
                                <option value="{{ period.id }}"{{ selectedPeriod.id == period.id ? ' selected' }}>{{ period.program.displayShortName }} — {{ period.name }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <span class="small cm-deadline cm-deadline--{{ selectedTone }}">{{ 'ufaAlternanceRemindersDeadlineLabel'|trans({'%date%': selectedPeriod.endDate|date('d/m/Y')}) }}</span>
                    <span class="badge bg-secondary-lt ms-auto">{{ 'ufaAlternanceRemindersSelectedCountLabel'|trans({'%count%': rows|length}) }}</span>
                </form>
            </div>
            <form method="post" action="{{ path('app_ufa_alternance_reminders_send') }}">
                <input type="hidden" name="_token" value="{{ csrf_token('ufa_alternance_reminders_send') }}">
                <input type="hidden" name="period" value="{{ selectedPeriod.id }}">
                <div class="table-responsive">
                    <table class="table table-vcenter card-table">
                        <thead>
                            <tr>
                                <th></th>
                                <th>{{ 'ufaAlternanceRemindersRecipientColumnLabel'|trans }}</th>
                                <th>{{ 'ufaAlternanceRemindersRoleColumnLabel'|trans }}</th>
                                <th>{{ 'ufaAlternanceRemindersPeriodColumnLabel'|trans }}</th>
                                <th>{{ 'ufaAlternanceRemindersStatusColumnLabel'|trans }}</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for row in rows %}
                                <tr>
                                    <td><input type="checkbox" class="form-check-input" name="tutorLinkIds[]" value="{{ row.tutorLink.id }}" checked></td>
                                    <td>
                                        {% if row.status.step == 'tutor' %}{{ row.tutorLink.tutor.displayName ?? row.tutorLink.tutor.username }}
                                        {% else %}{{ row.tutorLink.student.displayName ?? row.tutorLink.student.username }}{% endif %}
                                    </td>
                                    <td>{{ (row.status.step == 'tutor' ? 'ufaAlternanceRoleTutorLabel' : 'ufaAlternanceRoleStudentLabel')|trans }}</td>
                                    {# Green while the bilan's own end date is far off, red once it is near or
                                       past. The tone sits on the inner block, never on the <td>: Bootstrap's
                                       own `.table > :not(caption) > * > *` sets a cell colour and outranks a
                                       single class, so a coloured cell would silently read like every other. #}
                                    <td>
                                        <div class="cm-deadline cm-deadline--{{ row.tone }}">
                                            <div class="fw-medium">{{ row.status.period.name }}</div>
                                            <div class="small">{{ 'ufaAlternanceRemindersPeriodRangeLabel'|trans({
                                                '%start%': row.status.period.startDate|date('d/m/Y'),
                                                '%end%': row.status.period.endDate|date('d/m/Y'),
                                            }) }}</div>
                                        </div>
                                    </td>
                                    <td><span class="badge {{ row.badge.class }}">{{ row.badge.label }}</span></td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
                <div class="card-footer d-flex justify-content-between align-items-center">
                    <span class="text-secondary small">{{ 'ufaAlternanceRemindersFooterNoteLabel'|trans }}</span>
                    <button type="submit" class="btn btn-primary">{{ 'ufaAlternanceRemindersSendButtonLabel'|trans({'%count%': rows|length}) }}</button>
                </div>
            </form>
        {% endif %}
    </div>
{% endblock %}
