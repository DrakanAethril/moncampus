{# One label+static-value row, used to render the tutor's own entries read-only (29a/29c, 30c).

   `color` (optional): the color of the level chosen, as defined on the platform
   (SkillLevel::$color). Without it, every value looked alike - acquired, not assessable and the rest
   came out in the same hue, where the booklet itself already tells them apart. #}
<div class="row mb-2 align-items-center">
    <div class="col-md-6 text-secondary">{{ label }}</div>
    <div class="col-md-6">
        <span class="cm-wizard-readonly-value"{% if color is defined and color and value %} style="background: {{ color }}; color: #ffffff;"{% endif %}>{{ value ?? '—' }}</span>
    </div>
</div>
