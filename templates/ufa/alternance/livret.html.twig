{% extends 'layout/app.html.twig' %}

{% block title %}{{ 'ufaAlternanceLivretPageHeading'|trans }} — {{ tutorLink.student.displayName ?? tutorLink.student.username }}{% endblock %}

{% block page_breadcrumb %}
    {% include '_breadcrumb.html.twig' with {segments: [
        {label: 'homeNavLabel'|trans, url: path('app_home')},
        {label: 'ufaAlternanceDashboardPageHeading'|trans, url: path('app_ufa')},
        {label: tutorLink.student.displayName ?? tutorLink.student.username, url: path('app_ufa_alternance_show', {id: tutorLink.id})},
        {label: 'ufaAlternanceLivretPageHeading'|trans, url: app.request.requestUri},
    ]} %}
{% endblock %}
{% block page_title %}{{ 'ufaAlternanceLivretPageHeading'|trans }} — {{ tutorLink.student.displayName ?? tutorLink.student.username }}{% endblock %}
{% block page_actions %}
    {% if is_staff() and periods|length > 0 %}
        {% include 'internship/_booklet_partial_export.html.twig' with {
            periods: periods,
            route: 'app_ufa_alternance_livret_pdf_period',
            routeParams: {id: tutorLink.id},
        } only %}
    {% endif %}
    <a href="{{ path('app_ufa_alternance_livret_pdf', {id: tutorLink.id}) }}" class="btn btn-primary ms-2"
       data-controller="pdf-download"
       data-action="pdf-download#download"
       data-pdf-download-loading-label-value="{{ 'pdfExportLoadingLabel'|trans }}"
       data-pdf-download-fallback-filename-value="livret-alternant.pdf">
        <span class="spinner-border spinner-border-sm d-none me-1" role="status" aria-hidden="true" data-pdf-download-target="spinner"></span>
        <span data-pdf-download-target="label">{{ 'ufaAlternanceLivretExportButtonLabel'|trans }}</span>
    </a>
{% endblock %}

{% block main %}
    {% include 'internship/_livret_reader.html.twig' with {
        frameUrl: path('app_ufa_alternance_livret_frame', {id: tutorLink.id}),
        periods: periods,
    } only %}
{% endblock %}
