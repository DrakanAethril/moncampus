{{ form_start(form) }}
    {{ form_errors(form) }}
    <div class="row g-4 align-items-start">
        <div class="col-12 col-lg-6 d-flex flex-column gap-3">
            <twig:Cm:Subhead :title="'internshipLegalNameDefaultSectionTitle'|trans" :hint="'internshipLegalNameDefaultSectionHint'|trans"/>
            <div style="max-width: 420px;">
                {{ form_row(form.legalName) }}
            </div>
            <div class="cm-note">
                <span class="cm-note__icon">i</span>
                <div>{{ 'internshipLegalNamePriorityNoteText'|trans|raw }}</div>
            </div>
        </div>

        {% if program.options is not empty %}
            <div class="col-12 col-lg-6 d-flex flex-column gap-2">
                <twig:Cm:Subhead :title="'internshipOptionLegalNamesSectionTitle'|trans" :hint="'internshipOptionLegalNamesHelpText'|trans"/>
                {% for option in program.options %}
                    <div class="cm-optionrow">
                        <div>
                            <div class="cm-optionrow__name">{{ option.name }}</div>
                            <div class="cm-optionrow__sub">{{ 'optionShortNameSubLabel'|trans({'%shortName%': option.shortName}) }}</div>
                        </div>
                        <input type="text" class="form-control" name="legalNames[{{ option.id }}]" placeholder="{{ form.legalName.vars.value ?: program.name }}" value="{{ legalNamesByOptionId[option.id] ?? '' }}">
                    </div>
                {% endfor %}
            </div>
        {% endif %}
    </div>

    {# The ECF booklet's own zone (design/validated/ecf-booklet.md §14), there only when `ufa_ecf`
       is lit: what holds for the whole formation - the switch, then the organisme. The titre and
       its dates differ from one option to the next and sit in the certification blocks below.
       The administration reads it; the fields are disabled for anyone but an administrator. #}
    {% if form.ecf is defined %}
        <div class="d-flex flex-column gap-3 mt-4">
            <div>
                {{ form_row(form.ecf.enabled, {label_attr: {class: 'checkbox-switch'}, help: 'ecfSettingsEnabledFieldHelp'|trans}) }}
            </div>
            {% if not ecfHasActivityTypes or ecfOptionsWithoutTitle is not empty %}
                <div class="cm-note cm-note--gold">
                    <span class="cm-note__icon">!</span>
                    <div>
                        {% if not ecfHasActivityTypes %}
                            <div>{{ 'ecfSettingsRefusalNoGroupMessage'|trans }}</div>
                        {% endif %}
                        {% for option in ecfOptionsWithoutTitle %}
                            <div>{{ (option ? 'ecfSettingsOptionWithoutTitleMessage' : 'ecfSettingsProgramWithoutTitleMessage')|trans({'%option%': option ? option.name : ''}) }}</div>
                        {% endfor %}
                    </div>
                </div>
            {% endif %}

            <twig:Cm:Subhead :title="'ecfSettingsOrganisationSectionTitle'|trans" :hint="'ecfSettingsOrganisationSectionHint'|trans"/>
            <div class="row">
                <div class="col-md-6">{{ form_row(form.ecf.organisation) }}</div>
                <div class="col-md-6">{{ form_row(form.ecf.place) }}</div>
            </div>
        </div>
    {% endif %}

    {# Last zone of the same form and the same actionbar - what the formation is called, then
       what it awards. #}
    <div class="d-flex flex-column gap-2 mt-4">
        <twig:Cm:Subhead :title="'programCertificationSectionTitle'|trans" :hint="'programCertificationSectionHint'|trans"/>
        {% for row in certificationRows %}
            {% set subForm = attribute(form, row.fieldName) %}
            <div class="cm-editorblock">
                <div class="cm-editorblock__head">
                    <div>
                        <div class="cm-editorblock__name">{{ row.option ? row.option.name : 'programCertificationWholeProgramLabel'|trans }}</div>
                        {% if row.option %}
                            <div class="cm-editorblock__sub">{{ 'optionShortNameSubLabel'|trans({'%shortName%': row.option.shortName}) }}</div>
                        {% endif %}
                    </div>
                    {% if row.certification.id %}
                        <span class="badge bg-green-lt ms-auto">{{ 'programCertificationSetBadge'|trans }}</span>
                    {% else %}
                        <span class="badge bg-secondary-lt ms-auto">{{ 'programCertificationUnsetBadge'|trans }}</span>
                    {% endif %}
                </div>
                <div class="cm-editorblock__body">
                    <div class="row">
                        <div class="col-md-3">{{ form_row(subForm.kind) }}</div>
                        <div class="col-md-9">{{ form_row(subForm.label) }}</div>
                        <div class="col-md-4">{{ form_row(subForm.rncpCode) }}</div>
                        <div class="col-md-3">{{ form_row(subForm.level) }}</div>
                        <div class="col-md-5">{{ form_row(subForm.certifier) }}</div>
                        <div class="col-md-4">{{ form_row(subForm.titleCode) }}</div>
                        <div class="col-md-3">{{ form_row(subForm.millesime) }}</div>
                    </div>
                    {# The dates the ECF booklet prints for this titre. #}
                    <div class="row">
                        <div class="col-md-3">{{ form_row(subForm.decreeDate) }}</div>
                        <div class="col-md-3">{{ form_row(subForm.journalDate) }}</div>
                        <div class="col-md-3">{{ form_row(subForm.effectiveDate) }}</div>
                        <div class="col-md-3">{{ form_row(subForm.modelUpdatedDate, {help: 'programCertificationModelUpdatedDateFieldHelp'|trans}) }}</div>
                    </div>
                </div>
            </div>
        {% endfor %}
    </div>

    <twig:Cm:ActionBar :lastModified="info">
        <a href="{{ path('app_ufa_formation_denomination', {id: program.id}) }}" class="btn btn-link">{{ 'cancelAction'|trans }}</a>
        {{ form_widget(form.submit) }}
    </twig:Cm:ActionBar>
    {{ form_rest(form) }}
{{ form_end(form) }}
