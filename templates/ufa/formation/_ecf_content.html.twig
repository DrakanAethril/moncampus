{# « Livret ECF » - the switch, the dates the ministry's template prints and the organisme
   (design/validated/ecf-booklet.md §4). The titre is read from « Dénomination » and the
   activity-types from « Compétences », so neither is shown here - only what keeps a student from
   getting a booklet. The administration reads it; the form is disabled for anyone but an
   administrator. #}
{{ form_start(form) }}
    {{ form_errors(form) }}
    <div class="d-flex flex-column gap-3">
        <div>
            {{ form_row(form.enabled, {label_attr: {class: 'checkbox-switch'}, help: 'ecfSettingsEnabledFieldHelp'|trans}) }}
        </div>
        {% if not hasActivityTypes or optionsWithoutTitle is not empty %}
            <div class="cm-note cm-note--gold">
                <span class="cm-note__icon">!</span>
                <div>
                    {% if not hasActivityTypes %}
                        <div>{{ 'ecfSettingsRefusalNoGroupMessage'|trans }}</div>
                    {% endif %}
                    {% for option in optionsWithoutTitle %}
                        <div>{{ (option ? 'ecfSettingsOptionWithoutTitleMessage' : 'ecfSettingsProgramWithoutTitleMessage')|trans({'%option%': option ? option.name : ''}) }}</div>
                    {% endfor %}
                    {% if optionsWithoutTitle is not empty %}
                        <a href="{{ path('app_ufa_formation_denomination', {id: program.id}) }}">{{ 'ecfSettingsDenominationLinkLabel'|trans }}</a>
                    {% endif %}
                </div>
            </div>
        {% endif %}

        <twig:Cm:Subhead :title="'ecfSettingsDatesSectionTitle'|trans" :hint="'ecfSettingsDatesSectionHint'|trans"/>
        <div class="row">
            <div class="col-md-3">{{ form_row(form.decreeDate) }}</div>
            <div class="col-md-3">{{ form_row(form.journalDate) }}</div>
            <div class="col-md-3">{{ form_row(form.effectiveDate) }}</div>
            <div class="col-md-3">{{ form_row(form.modelUpdatedDate, {help: 'ecfSettingsModelUpdatedDateFieldHelp'|trans}) }}</div>
        </div>

        <twig:Cm:Subhead :title="'ecfSettingsOrganisationSectionTitle'|trans"/>
        <div class="row">
            <div class="col-md-6">{{ form_row(form.organisation) }}</div>
            <div class="col-md-6">{{ form_row(form.place) }}</div>
        </div>
    </div>

    {% if canEdit %}
        <twig:Cm:ActionBar :lastModified="settings.id ? settings : null">
            <a href="{{ path('app_ufa_formation_ecf', {id: program.id}) }}" class="btn btn-link">{{ 'cancelAction'|trans }}</a>
            {{ form_widget(form.submit) }}
        </twig:Cm:ActionBar>
    {% else %}
        {% do form.submit.setRendered %}
    {% endif %}
    {{ form_rest(form) }}
{{ form_end(form) }}
