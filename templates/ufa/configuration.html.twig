{% extends 'layout/app.html.twig' %}

{% set page_heading_key = {
    formation_center: 'internshipFormationCenterTabLabel',
    contract_modalities: 'ufaContractModalitiesTabLabel',
    behavior: 'ufaBehaviorPageHeading',
}[activeTab] %}

{% block title %}{{ page_heading_key|trans }}{% endblock %}

{% block page_breadcrumb %}
    {% include '_breadcrumb.html.twig' with {segments: [
        {label: 'homeNavLabel'|trans, url: path('app_home')},
        {label: 'ufaNavLabel'|trans, url: path('app_ufa')},
        {label: 'ufaConfigurationNavLabel'|trans, url: path('app_ufa_configuration_formation_center')},
        {label: page_heading_key|trans, url: app.request.requestUri},
    ]} %}
{% endblock %}
{% block page_title %}{{ page_heading_key|trans }}{% endblock %}

{% block main %}
    {% include '_tabs.html.twig' with {
        tabs: [
            {url: path('app_ufa_configuration_formation_center'), label: 'internshipFormationCenterTabLabel'|trans, active: activeTab == 'formation_center'},
            {url: path('app_ufa_configuration_contract_modalities'), label: 'ufaContractModalitiesTabLabel'|trans, active: activeTab == 'contract_modalities'},
            {url: path('app_ufa_configuration_behavior'), label: 'internshipBehaviorTabLabel'|trans, active: activeTab == 'behavior'},
        ],
        tabs_action: 'ufa/_' ~ activeTab ~ '_button.html.twig',
    } %}
    <div class="card cm-card--tabbed">
        {% include 'ufa/_' ~ activeTab ~ '_content.html.twig' %}
    </div>
{% endblock %}
