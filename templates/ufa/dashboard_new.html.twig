{% extends 'layout/app.html.twig' %}

{% block title %}{{ 'ufaNewPageHeading'|trans }}{% endblock %}

{% block page_breadcrumb %}
    {% include '_breadcrumb.html.twig' with {segments: [
        {label: 'homeNavLabel'|trans, url: path('app_home')},
        {label: 'ufaDashboardPageHeading'|trans, url: path('app_ufa')},
        {label: 'ufaNewPageHeading'|trans, url: app.request.requestUri},
    ]} %}
{% endblock %}
{% block page_title %}{{ 'ufaNewPageHeading'|trans }}{% endblock %}

{% block main %}
    {{ form_start(form) }}
        {{ form_errors(form) }}
        <div class="row g-3 align-items-start">
            <div class="col-12 col-lg-8">
                <div class="card">
                    <div class="card-body">
                        <h3 class="card-title">{{ 'ufaNewDenominationSectionTitle'|trans }}</h3>
                        <div class="row">
                            <div class="col-md-6">{{ form_row(form.shortName) }}</div>
                        </div>
                        {{ form_row(form.name) }}
                        <hr class="my-4">
                        <h3 class="card-title">{{ 'ufaNewPedagogicalSectionTitle'|trans }}</h3>
                        <div class="row">
                            <div class="col-md-6">{{ form_row(form.cohort) }}</div>
                            <div class="col-md-6">{{ form_row(form.schoolYear) }}</div>
                            <div class="col-md-6">
                                <label class="form-label" for="responsable">{{ 'ufaNewResponsableFieldLabel'|trans }}</label>
                                <select id="responsable" name="responsable" class="form-select"
                                        data-controller="tom-select"
                                        data-tom-select-url-value="{{ path('app_ufa_new_responsable_search') }}"
                                        data-tom-select-placeholder-value="{{ 'ufaNewResponsableFieldLabel'|trans }}">
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">{{ 'ufaNewEvaluationPeriodsFieldLabel'|trans }}</label>
                                <div class="form-control-plaintext text-secondary" style="font-size: 13px;">{{ 'ufaNewEvaluationPeriodsHelpText'|trans }}</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-12 col-lg-4 d-flex flex-column gap-3">
                <div class="card">
                    <div class="card-body">
                        <h3 class="card-title">{{ 'ufaNewInheritedModelsSectionTitle'|trans }}</h3>
                        <div class="text-secondary mb-3" style="font-size: 12.5px;">{{ 'ufaNewInheritedModelsHelpText'|trans }}</div>
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" id="ufa-new-reuse-tutors" name="reuseTutors" value="1" checked>
                            <label class="form-check-label" for="ufa-new-reuse-tutors">{{ 'ufaNewReuseTutorsFieldLabel'|trans }}</label>
                        </div>
                    </div>
                </div>
                <div class="cm-note">
                    <span class="cm-note__icon">i</span>
                    <div>{{ 'ufaNewHelpNoteText'|trans|raw }}</div>
                </div>
            </div>
        </div>
        <div class="cm-actionbar">
            <div class="cm-actionbar__buttons">
                <a href="{{ path('app_ufa') }}" class="btn btn-link">{{ 'cancelAction'|trans }}</a>
                {{ form_widget(form.submit) }}
            </div>
        </div>
        {{ form_rest(form) }}
    {{ form_end(form) }}
{% endblock %}
