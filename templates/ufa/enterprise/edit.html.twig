{% extends 'layout/app.html.twig' %}

{% block title %}{{ 'ufaEnterpriseEditPageHeading'|trans }}{% endblock %}

{% block page_breadcrumb %}
    {% include '_breadcrumb.html.twig' with {segments: [
        {label: 'homeNavLabel'|trans, url: path('app_home')},
        {label: 'ufaNavLabel'|trans, url: path('app_ufa')},
        {label: 'ufaEnterprisesPageHeading'|trans, url: path('app_ufa_enterprises')},
        {label: enterprise.name, url: path('app_ufa_enterprise_show', {id: enterprise.id})},
        {label: 'ufaEnterpriseEditPageHeading'|trans, url: app.request.requestUri},
    ]} %}
{% endblock %}
{% block page_title %}{{ 'ufaEnterpriseEditPageHeading'|trans }}{% endblock %}

{% block main %}
    <div class="card">
        {{ form_start(form) }}
            {{ form_errors(form) }}
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6">{{ form_row(form.name) }}</div>
                    <div class="col-md-3">{{ form_row(form.siret) }}</div>
                    <div class="col-md-3">{{ form_row(form.phone) }}</div>
                </div>
                <div class="row">
                    <div class="col-md-4">{{ form_row(form.city) }}</div>
                    <div class="col-md-8">{{ form_row(form.address) }}</div>
                </div>
            </div>
            <div class="card-footer d-flex justify-content-end gap-2">
                <a href="{{ path('app_ufa_enterprise_show', {id: enterprise.id}) }}" class="btn btn-link">{{ 'cancelAction'|trans }}</a>
                {{ form_widget(form.submit, {attr: {class: 'btn btn-primary'}}) }}
            </div>
        {{ form_end(form) }}
    </div>
{% endblock %}
