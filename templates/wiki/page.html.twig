{% extends 'layout/app.html.twig' %}

{# Rail (tree) + page + attachments panel + outline. The sommaire is derived from the page's own
   headings at read time and hidden when there are none - most wiki pages are a paragraph. #}

{% block title %}{{ node.title }}{% endblock %}

{# KaTeX renders with CSS alone - the formula's markup is already in the body, stored at insert
   time - so the read side needs this stylesheet and no JavaScript at all. Vendored under
   public/katex/ (MIT), never CDN-loaded, and the same reason the PDF export can inline it. #}
{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('katex/katex.min.css') }}">
{% endblock %}

{% block page_breadcrumb %}
    {% include 'wiki/_breadcrumb.html.twig' with {wiki: wiki, ancestors: ancestors, node: node} %}
{% endblock %}

{% block page_title %}{{ node.title }}{% endblock %}

{# One button, and only one. Everything the bar used to carry moved to where it belongs: the whole-
   wiki export and the import to the réglages screen, adding and deleting a page to the rail's own
   icons - beside the page they act on - and the history and this page's PDF to the foot of the text,
   where somebody who has just finished reading it is looking. #}
{% block page_actions %}
    {% include 'wiki/_search_form.html.twig' with {wiki: wiki} %}
    {% if is_granted('WIKI_EDIT', wiki) %}
        <a href="{{ path('app_wiki_page_edit', {id: wiki.id, nodeId: node.id}) }}" class="cm-btn cm-btn--primary">{{ 'wikiEditPageAction'|trans }}</a>
    {% endif %}
{% endblock %}

{% block main %}
    <div class="cm-wiki{{ outline is not empty ? ' cm-wiki--with-outline' }}">
        {% include 'wiki/_rail.html.twig' with {wiki: wiki, tree: tree, node: node} %}

        <div class="cm-wiki__content">
            {% if body %}
                {# The copy buttons on the code blocks are added to the rendered body, not stored in
                   it - see assets/controllers/wiki_code_copy_controller.js. #}
                <div class="cm-wiki__body"
                     data-controller="wiki-code-copy"
                     data-wiki-code-copy-label-value="{{ 'wikiCodeCopyAction'|trans }}">{{ body|raw }}</div>
            {% else %}
                <p class="cm-wiki__placeholder">{{ 'wikiPageEmptyText'|trans }}</p>
            {% endif %}

            {% include 'wiki/_attachments.html.twig' with {wiki: wiki, node: node} %}

            <p class="cm-wiki__meta">
                <span>{{ 'wikiPageUpdatedMeta'|trans({
                    '%date%': node.updatedAt|date('d/m/Y'),
                    '%author%': node.updatedBy ? (node.updatedBy.displayName ?? node.updatedBy.username) : '—',
                }) }}</span>
                <a class="cm-wiki__meta-link" href="{{ path('app_wiki_page_history', {id: wiki.id, nodeId: node.id}) }}">{{ 'wikiViewHistoryAction'|trans }}</a>
                <a class="cm-wiki__meta-link" href="{{ path('app_wiki_export_pdf', {id: wiki.id, node: node.id, page: 1}) }}">{{ 'wikiExportPagePdfAction'|trans }}</a>
            </p>
        </div>

        {% if outline is not empty %}
            <aside class="cm-wiki__outline">
                <span class="cm-wiki__outline-title">{{ 'wikiOutlineHeading'|trans }}</span>
                <ul>
                    {% for entry in outline %}
                        <li class="cm-wiki__outline-entry cm-wiki__outline-entry--h{{ entry.level }}">
                            <a href="#{{ entry.id }}">{{ entry.title }}</a>
                        </li>
                    {% endfor %}
                </ul>
            </aside>
        {% endif %}
    </div>
{% endblock %}
