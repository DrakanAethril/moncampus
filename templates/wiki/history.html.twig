{% extends 'layout/app.html.twig' %}

{# Revisions, compare, restore. One row per save, capped at the two most recent per page - without
   the cap a wiki used seriously for a year is the biggest table in the schema.

   The cap is short enough to be surprising, so the screen says it out loud: a user who believes
   every save is kept would only find out by looking for one that is gone. #}

{% block title %}{{ node.title }}{% endblock %}

{# The compare panes render past bodies, formulas included. #}
{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('katex/katex.min.css') }}">
{% endblock %}

{% block page_breadcrumb %}
    {% include 'wiki/_breadcrumb.html.twig' with {
        wiki: wiki,
        ancestors: ancestors,
        node: node,
        extra: [{label: 'wikiHistoryAction'|trans, url: path('app_wiki_page_history', {id: wiki.id, nodeId: node.id})}],
    } %}
{% endblock %}

{% block page_title %}{{ 'wikiHistoryPageHeading'|trans }}{% endblock %}

{% block main %}
    <div class="cm-wiki">
        {% include 'wiki/_rail.html.twig' with {wiki: wiki, tree: tree, node: node} %}

        <div class="cm-wiki__content">
            <p class="cm-wiki-history-cap">{{ 'wikiHistoryCapNoticeText'|trans({'%count%': revisionCap}) }}</p>

            {% if revisions is empty %}
                <p class="cm-wiki__placeholder">{{ 'wikiHistoryEmptyText'|trans }}</p>
            {% else %}
                <ul class="cm-wiki-list">
                    {% for revision in revisions %}
                        <li class="cm-wiki-list__row">
                            <span class="cm-wiki-list__title">{{ revision.title }}</span>
                            <span class="cm-wiki-list__subtitle">
                                {{ 'wikiRevisionMeta'|trans({
                                    '%date%': revision.createdAt|date('d/m/Y H:i'),
                                    '%author%': revision.author ? (revision.author.displayName ?? revision.author.username) : '—',
                                }) }}
                            </span>
                            {# A GET link, not a form: showing a past version is a "montre-moi un
                               résultat" action. #}
                            <a class="cm-btn cm-btn--sm cm-btn--outline"
                               href="{{ path('app_wiki_page_history', {id: wiki.id, nodeId: node.id, compare: revision.id}) }}">{{ 'wikiRevisionViewAction'|trans }}</a>
                            {% if is_granted('WIKI_EDIT', wiki) %}
                                <form method="post" action="{{ path('app_wiki_page_restore', {id: wiki.id, nodeId: node.id, revisionId: revision.id}) }}" class="cm-wiki__inline-form">
                                    <input type="hidden" name="_token" value="{{ csrf_token('wiki_history') }}">
                                    <button type="submit" class="cm-btn cm-btn--sm cm-btn--outline">{{ 'wikiRevisionRestoreAction'|trans }}</button>
                                </form>
                            {% endif %}
                        </li>
                    {% endfor %}
                </ul>
            {% endif %}

            {% if selected %}
                <div class="cm-wiki-compare">
                    <div class="cm-wiki-compare__pane">
                        <span class="cm-wiki-compare__title">{{ 'wikiRevisionPastHeading'|trans({'%date%': selected.createdAt|date('d/m/Y H:i')}) }}</span>
                        <div class="cm-wiki__body">{{ selected.body|raw }}</div>
                    </div>
                    <div class="cm-wiki-compare__pane">
                        <span class="cm-wiki-compare__title">{{ 'wikiRevisionCurrentHeading'|trans }}</span>
                        <div class="cm-wiki__body">{{ node.body|raw }}</div>
                    </div>
                </div>
            {% endif %}
        </div>
    </div>
{% endblock %}
