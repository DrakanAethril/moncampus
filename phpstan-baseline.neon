# Empty on purpose: every finding that predated PHPStan's introduction has been fixed.
# Keep the file and the include wired so `composer phpstan-baseline` stays usable if a future
# upgrade (a new PHPStan version, a raised level) ever needs to park findings again - but adding
# to it is a decision, not a reflex. Standing, explained exemptions belong in phpstan.dist.neon's
# own ignoreErrors instead, where the reason sits next to the rule.
parameters:
	ignoreErrors: []
