* text=auto eol=lf
*.conf text eol=lf
*.html text eol=lf
*.ini text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.php text eol=lf
*.sh text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
bin/console text eol=lf
composer.lock text eol=lf merge=ours
*.ico binary
*.png binary
public/downloads/*.apk filter=lfs diff=lfs merge=lfs -text
public/downloads/*.ipa filter=lfs diff=lfs merge=lfs -text
# The e-CO PWA is a build output (the e-CO repo's tool/build_pwa.sh): kept byte for byte, never normalised.
public/eco-app/** -text
# The Campus PWA likewise (the moncampus-mobile repo's tool/build_pwa.sh).
public/campus-app/** -text
