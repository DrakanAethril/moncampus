###> symfony/ldap ###
# Real values (host/port/base DN/bind DN/bind password) are credential-shaped and live in
# .env.dev.local for dev (see .env.dev.local.example), and as required real env vars in
# production - see compose.prod.yaml and docs/production.md.
#
# Placeholders below exist only so the prod Docker build's cache:clear step can compile the
# container (it eagerly constructs the LDAP adapter/S3 client, see DATABASE_URL's fuller
# explanation above) - real environment variables always override these at runtime.
# LDAP_ENCRYPTION must be one of none/ssl/tls (App\Service\LdapAdapterFactory validates it eagerly).
LDAP_HOST=
LDAP_PORT=389
LDAP_BASE_DN=
# Optional - scopes the Directory > Users bulk sync (App\Service\LdapUserSyncer). On a Samba 4 AD
# DC, leaving this blank (falling back to LDAP_BASE_DN) means the sync also matches computer/
# service accounts, since those are objectClass=user entries too - set this to wherever real
# people live (e.g. OU=People) to avoid that. Login itself is unaffected either way.
LDAP_USER_BASE_DN=
# Optional - only needed when groups live under a different subtree than LDAP_BASE_DN (e.g. a
# Samba 4 AD DC with users under OU=People and groups under OU=Groups). Leave blank to search
# groups under LDAP_BASE_DN itself, same as dev's single-OU tree.
LDAP_GROUP_BASE_DN=
# Same idea as LDAP_GROUP_BASE_DN, for the Directory > Services/Computers pages - e.g. a Samba 4
# AD DC's OU=Services / CN=Computers containers. Blank falls back to LDAP_BASE_DN.
LDAP_SERVICE_BASE_DN=
LDAP_COMPUTER_BASE_DN=
LDAP_SEARCH_DN=
LDAP_SEARCH_PASSWORD=
LDAP_ENCRYPTION=none
LDAP_TLS_CA_CERT_PATH=
LDAP_USERNAME_ATTRIBUTE=
LDAP_USER_OBJECT_CLASS=
LDAP_GROUP_OBJECT_CLASS=
# The attribute that says whether an account is closed, read back by App\Service\LdapAccountVerifier
# to check for itself that a disable/enable request actually took effect - the second of the two
# proofs, the script's own exit code being the first. `userAccountControl` on a Samba 4 AD DC, whose
# 0x0002 bit is ACCOUNTDISABLE.
#
# Blank on purpose in development: the OpenLDAP container has no equivalent attribute at all. The
# verification then leaves the row "réussi, non vérifié" and says why, and that is the right answer -
# it must never be read as the directory contradicting the script. A rename is verified either way,
# by looking the two uids up.
LDAP_ACCOUNT_STATUS_ATTRIBUTE=
###< symfony/ldap ###

###> league/flysystem-aws-s3-v3 ###
# S3-compatible storage for uploaded files (avatars/ first, more feature prefixes later - see
# App\Service\FileUploadService, App\Service\S3ClientFactory). Real values are credential-shaped
# and live in .env.dev.local for dev (see .env.dev.local.example), and as required real env vars
# in production - see compose.prod.yaml and docs/production.md.
#
# Placeholders below exist only so the prod Docker build's cache:clear step can compile the
# container - see DATABASE_URL's fuller explanation above. AWS_S3_REGION must be non-blank (the
# AWS SDK validates it eagerly at client construction); the rest can stay blank.
AWS_S3_BUCKET=
AWS_S3_REGION=us-east-1
AWS_S3_ENDPOINT=
AWS_S3_PUBLIC_ENDPOINT=
AWS_S3_PREFIX=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_CLOUDFRONT_DOMAIN=
###< league/flysystem-aws-s3-v3 ###

###> app/school-mail ###
# Courrier école : boîte mail d'établissement des élèves, sur une infrastructure AWS *distincte*
# de celle des uploads ci-dessus - autre compte (celui qui porte SES et la zone Route 53) et autre
# région (eu-west-3, imposée par la réception SES, qui exige un bucket colocalisé avec la règle).
#
# Comme pour AWS_S3_REGION, AWS_MAIL_REGION doit rester non vide même dans un environnement où
# rien ne consomme de file : le client AWS valide sa région dès sa construction, pas au premier
# appel. Les identifiants, eux, peuvent rester vides.
#
# Les deux endpoints n'existent que pour un éventuel émulateur local ; contre du vrai AWS ils
# doivent rester vides, l'option étant alors entièrement omise (voir S3ClientFactory).
AWS_MAIL_REGION=eu-west-3
AWS_MAIL_ACCESS_KEY_ID=
AWS_MAIL_SECRET_ACCESS_KEY=
AWS_MAIL_BUCKET=
AWS_MAIL_S3_ENDPOINT=
AWS_MAIL_SQS_ENDPOINT=
AWS_MAIL_INBOUND_QUEUE_URL=
AWS_MAIL_EVENTS_QUEUE_URL=
# Configuration Set SES attaché à chaque envoi Courrier école (handoff infra §5/§6) : c'est lui qui
# fait publier les événements de délivrance et d'échec sur la file « events » ci-dessus. Laissé
# vide, les envois partent quand même - mais aucun statut ne remontera jamais.
AWS_MAIL_CONFIGURATION_SET=
# Le domaine des adresses élèves - c'est *lui* qui distingue dev de production, la base ne stockant
# que la partie locale (voir App\Entity\EmailAlias).
MAIL_STUDENT_DOMAIN=devetu.beaupeyrat.org
###< app/school-mail ###

###> app/gotenberg ###
# Placeholder for the same reason as above - real value comes from compose.yaml (not a secret,
# see that file's comment on GOTENBERG_URL).
GOTENBERG_URL=
###< app/gotenberg ###

###> app/antivirus ###
# clamd's TCP address, e.g. clamav://clamav:3310 (App\Service\AntivirusScanner).
#
# **Blank means scanning is disabled**, and that is a deliberately different state from "configured
# but unreachable", which refuses every upload. Dev and CI run blank; production sets it, and gets
# the `clamav` service from compose.prod.yaml. Dev can turn it on with
# `docker compose --profile antivirus up -d` plus ANTIVIRUS_DSN in .env.dev.local, which is how the
# EICAR test string is exercised against a real clamd.
#
# Not a secret - a fixed internal Docker-network hostname, same treatment as GOTENBERG_URL above.
ANTIVIRUS_DSN=
###< app/antivirus ###

###> app/file-library ###
# How much every teacher's and staff member's file library may hold, unless an admin raises it for
# that account (App\Service\FileLibraryQuota, design/validated/file-library.md).
#
# Read by App\Service\ByteSize::parse(), which is the same parser the admin's quota field uses -
# "1G", "1 Go", "2500 Mo" all work. Binary units: 1 Go is 1 073 741 824 bytes.
#
# It is configuration and not a constant on purpose: a deployment that wants 2 Go should not need a
# code change. And it is *the default*, never a stored value - User::$fileLibraryQuotaBytes stays
# null for everyone who was never overridden, so raising this raises it for all of them at once.
FILE_LIBRARY_DEFAULT_QUOTA=1G
###< app/file-library ###

###> app/matomo ###
# Self-hosted Matomo analytics. Blank here on purpose: templates/base.html.twig only emits the
# tracking snippet when both are non-empty, so leaving them blank in .env/.env.dev.local/staging
# keeps analytics production-only without a separate feature flag. Real values belong in
# .env.prod.local, never here. Tracking itself is opt-in (see assets/controllers/matomo_consent_controller.js) -
# nothing is sent to Matomo until a visitor accepts the consent banner.
MATOMO_URL=
MATOMO_SITE_ID=
###< app/matomo ###

###> symfony/amazon-mailer ###
# MAILER_DSN=ses://ACCESS_KEY:SECRET_KEY@default?region=eu-west-1
# MAILER_DSN=ses+smtp://ACCESS_KEY:SECRET_KEY@default?region=eu-west-1
#
# Placeholders below exist only so the prod Docker build's cache:clear step can compile the
# container (see DATABASE_URL's fuller explanation above) - config/packages/mailer.yaml's
# when@prod block builds the real SES DSN from these at runtime; real values are credential-shaped
# and live in .env.prod.local, never here.
AWS_SES_ACCESS_KEY_ID=
AWS_SES_SECRET_ACCESS_KEY=
AWS_SES_REGION=eu-west-1
