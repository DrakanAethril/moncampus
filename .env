LOCK_DSN=flock
###< symfony/lock ###

###> app/proxmox ###
# Clé de chiffrement des secrets de la console Proxmox (App\Service\Crypto\SecretBox) : 32 octets
# bruts, encodés en base64. En générer une avec :
#   php -r 'echo base64_encode(random_bytes(32)), "\n";'
#
# Volontairement sa propre variable, et surtout pas APP_SECRET : faire tourner le secret de
# l'application doit rester une opération anodine, ce qu'elle ne serait plus si chaque hyperviseur
# déclaré devenait injoignable du même coup. Vide, la console affiche un bandeau « chiffrement
# indisponible » plutôt qu'une liste vide - un état que App\Service\Crypto\SecretBoxProvider existe
# pour rendre visible au lieu de silencieux. La vraie valeur vit dans .env.local / .env.dev.local
# (git-ignorés), même convention qu'APP_SECRET et AES_KEY plus haut.
PROXMOX_SECRET_KEY=

# Nombre de consoles de machine ouvertes en même temps, toutes personnes confondues.
#
# Un plafond, pas un réglage oublié : chaque console ouverte immobilise un fil FrankenPHP pendant
# toute la durée de son échange long, et un fil bloqué huit secondes n'est pas un fil libre. La
# cinquième console est refusée avec un message qui nomme les personnes qui tiennent les autres -
# un plafond anonyme est une panne, un plafond nommé est une conversation.
CONSOLE_MAX_SESSIONS=4
###< app/proxmox ###

###> app/deployment ###
# Shared secret the deploy workflow presents to raise and lower the « une mise à jour est en cours »
# banner (App\Controller\DeploymentNoticeController). Empty here on purpose: with no token the
# write route answers 404, so an environment that never sets one has no open door rather than an
# unprotected one. The real value lives in .env.prod.local and, as a GitHub secret, in
# BEAUP_DEPLOYMENT_NOTICE_TOKEN - the two have to be the same string.
#
# Generate one with:
#   php -r 'echo bin2hex(random_bytes(32)), "\n";'
DEPLOYMENT_NOTICE_TOKEN=
###< app/deployment ###
