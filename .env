###> symfony/discord-notifier ###
# Two consumers, one webhook: App\Service\TicketDiscordNotifier (support tickets, every
# environment) and App\Monolog\DiscordWebhookHandler (error alerting, production only - see
# config/packages/monolog.yaml). The latter reads these two variables directly rather than going
# through the Notifier transport below, so it stays independent of the container's http_client.
#
# Placeholders below exist so the prod Docker build's cache:clear step can compile the container
# (see DATABASE_URL's fuller explanation above) - config/packages/notifier.yaml builds the real
# Discord webhook DSN from these at runtime; real values are credential-shaped and live in
# .env.dev.local/.env.prod.local, never here.
#
# Unlike every other credential placeholder in this file, these must NOT be left blank: Symfony
# Notifier builds every configured chatter transport (parsing its DSN) as soon as ChatterInterface
# is first injected anywhere - not lazily on first send() like the AWS/LDAP clients - so an empty
# webhook_id/token 500s any page that injects App\Service\TicketDiscordNotifier, before that
# service's own try/catch around send() ever gets a chance to run. A syntactically-valid but wrong
# placeholder defers the failure to send() time instead, which the try/catch does cover.
DISCORD_WEBHOOK_TOKEN=unconfigured
DISCORD_WEBHOOK_ID=0
###< symfony/discord-notifier ###

###> app/ldap-password-queue ###
# AES key used by MySQL's AES_ENCRYPT/AES_DECRYPT for the password a user chose themselves, which
# has to survive in ldap_manage_password until the external consumer script picks the row up (see
# App\Entity\LdapManagePassword, App\Repository\LdapManagePasswordRepository::setRequestedPassword()).
# This application only ever writes with it - the script decrypts, applies, then clears the column.
# Must be the exact same value configured on that external script's side (its own AES_KEY) - a
# mismatch doesn't error, it just silently decrypts to garbage/NULL, and the user gets a password
# nobody knows. Real value lives in .env.local (git-ignored), same convention as
# APP_SECRET/LDAP_SEARCH_PASSWORD.
AES_KEY=
###< app/ldap-password-queue ###

###> lexik/jwt-authentication-bundle ###
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
# Real value in .env.local (git-ignored), same convention as APP_SECRET/LDAP_SEARCH_PASSWORD
# above - never commit the passphrase actually protecting config/jwt/private.pem.
JWT_PASSPHRASE=
###< lexik/jwt-authentication-bundle ###

###> symfony/mercure-bundle ###
# MERCURE_URL/MERCURE_PUBLIC_URL are already injected into the php container's OS environment by
